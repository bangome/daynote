<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product">

    <!--
      The account and billing screens, in the design's vocabulary.

      These redefine keys that Daynote.Product.Account.xaml and Daynote.Product.Settings.xaml already
      declare, rather than restyling the markup that reads them. The two account views are five
      hundred lines of billing screen — the one place where moving markup around to change a colour
      risks changing what it says — and the same layering already retunes the palette and the face.
      Merged last, so these win by key; every other consumer of them is retuned with them, which is
      the point.
    -->

    <!-- ── The card every block sits in ─────────────────────────────────────────────────── -->

    <Style x:Key="Daynote.Product.Style.Settings.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Settings.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Settings.RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Settings.Desc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="20.6" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Settings.Status" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Settings.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
    </Style>

    <!-- The quiet aside: the privacy footnote, the "what is stored" note. -->
    <Style x:Key="Daynote.Product.Style.Settings.Note" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ── Buttons ──────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="Daynote.Product.Style.Button.Primary" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Accent}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Quiet}" />

    <Style x:Key="Daynote.Product.Style.Button.Mini" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Quiet}" />

    <Style x:Key="Daynote.Product.Style.Button.Link" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.LinkSun}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Signing in. The mark is drawn by the markup; this is the box around it. -->
    <Style x:Key="Daynote.Product.Style.Account.GoogleButton" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="Height" Value="44" />
        <Setter Property="product:DeskVisual.CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── The account's own marks ──────────────────────────────────────────────────────── -->

    <Style x:Key="Daynote.Product.Style.Account.AvatarText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.OnPri}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.SyncDot.Flat" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource Daynote.Desk.Brush.Saved}" />
    </Style>

    <!-- The plan pill: sun-soft, as every chip in this design is. -->
    <Style x:Key="Daynote.Product.Style.Account.PlanPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.SunSoft}" />
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.PlanPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.SunInk}" />
    </Style>

    <!-- A trial running out, a payment being retried: the design's sun-soft notice. -->
    <Style x:Key="Daynote.Product.Style.Account.Banner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.SunSoft}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.BannerTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ── The price ────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="Daynote.Product.Style.Account.SegTray" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.SegButton" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.Price" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.PriceUnit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="5,0,0,5" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.SavingPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.SunSoft}" />
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="9,0,0,6" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.SavingText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.SunInk}" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.FeatureText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ── The subscription's own rows ──────────────────────────────────────────────────── -->

    <Style x:Key="Daynote.Product.Style.Account.RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.RowValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
    </Style>

    <!-- ── Signing in: the hero, and what an account buys ───────────────────────────────── -->

    <Style x:Key="Daynote.Product.Style.Account.HeroMark" TargetType="Border">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.SunSoft}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.HeroTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.HeroLead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="20.6" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.Perk" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,9" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.PerkTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Account.PerkDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
