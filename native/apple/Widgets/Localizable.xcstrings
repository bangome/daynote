{
  "sourceLanguage": "ko",
  "strings": {
    "widget.today.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘"
          }
        }
      }
    },
    "widget.today.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s to-dos and what’s next. Tap a ring to complete it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 할 일과 다음 일정. 링을 탭하면 바로 완료됩니다."
          }
        }
      }
    },
    "widget.todos.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To-dos"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일"
          }
        }
      }
    },
    "widget.todos.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next three to-dos for today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 남은 할 일 세 개."
          }
        }
      }
    },
    "widget.next.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up next"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 일정"
          }
        }
      }
    },
    "widget.next.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next event and how long until it starts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧 시작하는 일정과 남은 시간."
          }
        }
      }
    },
    "widget.capture.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick add"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 기록"
          }
        }
      }
    },
    "widget.capture.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open today’s note, or add a to-do or event with @."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 노트를 열거나 @ 바로 할 일·일정을 만듭니다."
          }
        }
      }
    },
    "widget.captureAccessory.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go straight to today’s note with the @ bar open."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@ 바가 열린 오늘 노트로 바로 갑니다."
          }
        }
      }
    },
    "widget.week.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
