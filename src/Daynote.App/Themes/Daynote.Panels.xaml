<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="Daynote.Template.Panel" TargetType="{x:Type ContentControl}">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding Tag}" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
        </Border>
    </ControlTemplate>
    <Style x:Key="Daynote.Style.SearchOverlay" TargetType="{x:Type ContentControl}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.Panel}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Pane.Regular}" />
        <Setter Property="Tag" Value="{DynamicResource Daynote.Radius.Panel}" />
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
    </Style>
    <Style x:Key="Daynote.Style.ConsentPanel" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.SearchOverlay}" />
    <Style x:Key="Daynote.Style.ClipboardDrawer.Inline" TargetType="{x:Type ContentControl}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.Panel}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Pane.Regular}" />
        <Setter Property="Tag" Value="{DynamicResource Daynote.Radius.None}" />
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform /></Setter.Value></Setter>
    </Style>
    <Style x:Key="Daynote.Style.ClipboardDrawer.Overlay" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.ClipboardDrawer.Inline}">
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Setter Property="Tag" Value="{DynamicResource Daynote.Radius.Panel}" />
    </Style>

    <ControlTemplate x:Key="Daynote.Template.SemanticStatus" TargetType="{x:Type ContentControl}">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Daynote.Radius.Control}" Padding="{TemplateBinding Padding}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Path Data="{TemplateBinding Tag}" Style="{DynamicResource Daynote.Style.IconPresenter.Small}" />
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </Grid>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="Daynote.Template.BusyStatus" TargetType="{x:Type ContentControl}">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Daynote.Radius.Control}" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal"><ProgressBar Width="{DynamicResource Daynote.Icon.Size.Small}" Height="{DynamicResource Daynote.Icon.Size.Small}" IsIndeterminate="True" /><ContentPresenter VerticalAlignment="Center" /></StackPanel>
        </Border>
    </ControlTemplate>

    <Style x:Key="Daynote.Style.StatusBanner.Base" TargetType="{x:Type ContentControl}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.SemanticStatus}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="Tag" Value="{DynamicResource Daynote.Radius.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Status.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.Status.FontWeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="Daynote.Style.StatusBanner.Info" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Base}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Accent.100}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Accent.700}" /><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.Info}" />
    </Style>
    <Style x:Key="Daynote.Style.StatusBanner.Success" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Base}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Status.Success.Surface}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Status.Success}" /><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.Checkmark}" />
    </Style>
    <Style x:Key="Daynote.Style.StatusBanner.Warning" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Base}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Status.Warning.Surface}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Status.Warning}" /><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.Warning}" />
    </Style>
    <Style x:Key="Daynote.Style.StatusBanner.Error" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Base}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Status.Error.Surface}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Status.Error}" /><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.Error}" />
    </Style>
    <Style x:Key="Daynote.Style.StatusBanner.CaptureEnabled" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Success}"><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.Capture}" /></Style>
    <Style x:Key="Daynote.Style.StatusBanner.CapturePaused" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Warning}"><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.Pause}" /></Style>
    <Style x:Key="Daynote.Style.StatusBanner.Busy" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Info}"><Setter Property="Template" Value="{StaticResource Daynote.Template.BusyStatus}" /></Style>

    <Style x:Key="Daynote.Style.SaveStatus.Dirty" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Warning}"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" /></Style>
    <Style x:Key="Daynote.Style.SaveStatus.Saving" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Busy}"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" /></Style>
    <Style x:Key="Daynote.Style.SaveStatus.Saved" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Success}"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" /></Style>
    <Style x:Key="Daynote.Style.SaveStatus.Error" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Error}"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" /></Style>

    <Style x:Key="Daynote.Style.ClipboardSource.Text" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Info}"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.TextItem}" /></Style>
    <Style x:Key="Daynote.Style.ClipboardSource.Image" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Info}"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.ImageItem}" /></Style>

    <Style x:Key="Daynote.Style.SearchSource.Note" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Info}"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.Notes}" /></Style>
    <Style x:Key="Daynote.Style.SearchSource.Clipboard" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.StatusBanner.Info}"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="Tag" Value="{DynamicResource Daynote.Icon.Geometry.Clipboard}" /></Style>

    <Style x:Key="Daynote.Style.SettingsRow" TargetType="{x:Type ContentControl}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.Panel}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Control}" />
        <Setter Property="Tag" Value="{DynamicResource Daynote.Radius.Control}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="Daynote.Template.SettingsToggle" TargetType="{x:Type ToggleButton}">
        <Border x:Name="FocusRing" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.Focus}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
            <Border x:Name="FocusGap" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.FocusGap}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Daynote.Radius.Control}" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal"><Path x:Name="Check" Data="{DynamicResource Daynote.Icon.Geometry.Checkmark}" Style="{DynamicResource Daynote.Style.IconPresenter.Small}" Visibility="Collapsed" /><ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" /></StackPanel>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" /><Setter TargetName="FocusGap" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus.Gap}" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Daynote.Style.SettingsToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.SettingsToggle}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource Daynote.Size.Target.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Label.FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Pressed}" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Selected}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Disabled}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="Daynote.Template.TrayMenuItem" TargetType="{x:Type MenuItem}">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" MinHeight="{DynamicResource Daynote.Size.Target.Primary}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
            <Grid><Path x:Name="Check" Data="{DynamicResource Daynote.Icon.Geometry.Checkmark}" Style="{DynamicResource Daynote.Style.IconPresenter.Small}" Visibility="Collapsed" HorizontalAlignment="Left" /><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Daynote.Style.TrayMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.TrayMenuItem}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Label.FontSize}" />
    </Style>
    <Style x:Key="Daynote.Style.TrayMenuItem.Destructive" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource Daynote.Style.TrayMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Status.Error}" />
    </Style>
    <Style x:Key="Daynote.Style.TrayMenu" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Control}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Menu}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Daynote.Radius.Panel}" Padding="{TemplateBinding Padding}"><ItemsPresenter /></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
