<UserControl
    x:Class="Daynote.App.Shell.Product.EditorCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border Style="{DynamicResource Daynote.Product.Style.Card}">
        <Grid>
            <!-- Panel collapse/expand lives in the titlebar's right icon cluster (ProductWindow) as a
                 single both-sidebars toggle; the card carries no toggle affordance of its own. -->

            <!-- Empty state: no note selected -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical"
                        Visibility="{Binding HasOpenNote, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
                <Path Data="{DynamicResource Daynote.Product.Geo.DocGlyph}" Width="44" Height="44" Stretch="Uniform"
                      Stroke="{DynamicResource Daynote.Product.Brush.Text2}" StrokeThickness="1.3" Opacity="0.5"
                      HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="{loc:Tr NoNoteSelected}" FontSize="13"
                           Foreground="{DynamicResource Daynote.Product.Brush.Text2}" HorizontalAlignment="Center" />
                <Button HorizontalAlignment="Center" Margin="0,14,0,0" Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                        Command="{Binding NewNoteCommand}" AutomationProperties.Name="{loc:Tr NewNote}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Plus}"
                              Stroke="{DynamicResource Daynote.Product.Brush.OnAccent}" StrokeThickness="1.6" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr NewNote}" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Editor: a note is selected -->
            <Grid Visibility="{Binding HasOpenNote, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Selected date, small and centered above the note -->
                <TextBlock Grid.Row="0" Text="{Binding DayLabel}" FontSize="11" HorizontalAlignment="Center"
                           Margin="16,8,16,0" Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                           AutomationProperties.Name="{Binding DayLabel}" />

                <!-- Title + new note + favorite + post-it + delete -->
                <Grid Grid.Row="1" Margin="16,4,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" Grid.Column="0"
                             Style="{DynamicResource Daynote.Product.Style.PlainTextBox}"
                             FontSize="{DynamicResource Daynote.Product.Type.Title}" FontWeight="SemiBold"
                             Text="{Binding Notes.SelectedTab.Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             LostFocus="OnTitleLostFocus"
                             AutomationProperties.Name="{loc:Tr TitlePlaceholder}" />
                    <Button Grid.Column="1" Width="30" Height="30" Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                            Command="{Binding NewNoteCommand}" ToolTip="{loc:Tr NewNote}"
                            AutomationProperties.Name="{loc:Tr NewNote}">
                        <Path Width="12" Height="12" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Plus}"
                              Style="{DynamicResource Daynote.Product.Style.Icon.Stroked}" StrokeThickness="1.4" />
                    </Button>
                    <Button Grid.Column="2" Width="30" Height="30" Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                            Command="{Binding ToggleFavoriteCommand}" ToolTip="{loc:Tr Favorite}"
                            AutomationProperties.Name="{loc:Tr Favorite}">
                        <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Star}"
                              StrokeThickness="1">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{x:Null}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Notes.SelectedTab.IsFavorite}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Extras}" />
                                            <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.Extras}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Grid.Column="3" Width="30" Height="30" Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                            Click="OnOpenStickyNote" ToolTip="{loc:Tr OpenStickyNote}"
                            AutomationProperties.Name="{loc:Tr OpenStickyNote}">
                        <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.StickyNote}"
                              Style="{DynamicResource Daynote.Product.Style.Icon.Stroked}" StrokeThickness="1.2" />
                    </Button>
                    <Button Grid.Column="4" Width="30" Height="30" Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                            Command="{Binding DeleteSelectedNoteCommand}" ToolTip="{loc:Tr DeleteNoteTip}"
                            AutomationProperties.Name="{loc:Tr DeleteNoteTip}">
                        <Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Trash}"
                              Style="{DynamicResource Daynote.Product.Style.Icon.Stroked}" StrokeThickness="1.2" />
                    </Button>
                </Grid>

                <!-- Tag chips + inline add: the "+ 태그" input flows right after the last chip (design row) -->
                <WrapPanel Grid.Row="2" Margin="16,8,16,8" Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Notes.SelectedTab.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Daynote.Product.Brush.AccentSoft}"
                                        CornerRadius="{DynamicResource Daynote.Product.Radius.Pill}" Padding="9,2" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Daynote.Product.Brush.Accent}">
                                            <Run Text="#" /><Run Text="{Binding Mode=OneWay}" />
                                        </TextBlock>
                                        <Button Margin="5,0,0,0" Padding="0" Content="✕" FontSize="12"
                                                Foreground="{DynamicResource Daynote.Product.Brush.Accent}"
                                                Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                                                Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="TagInputBox" Width="80"
                                 Style="{DynamicResource Daynote.Product.Style.PlainTextBox}" FontSize="11"
                                 Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                                 Text="{Binding TagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnTagKeyDown"
                                 AutomationProperties.Name="{loc:Tr TagAddPlaceholder}" />
                        <!-- Watermark: WPF TextBox renders no placeholder, so without this the tag entry is invisible -->
                        <TextBlock Text="{loc:Tr TagAddPlaceholder}" FontSize="11"
                                   Foreground="{DynamicResource Daynote.Product.Brush.Text2}" Margin="2,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=TagInputBox}" Value="" />
                                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=TagInputBox}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </WrapPanel>

                <!-- Divider -->
                <Border Grid.Row="3" Height="1" Margin="16,0" Background="{DynamicResource Daynote.Product.Brush.Stroke}" />

                <!-- Body: highlight layer under a transparent-foreground editor -->
                <Grid Grid.Row="4">
                    <ScrollViewer x:Name="HighlightScroll" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False" Focusable="False">
                        <TextBlock x:Name="Highlight" TextWrapping="Wrap" Padding="16,12"
                                   FontFamily="{DynamicResource Daynote.Product.Font.Mono}"
                                   FontSize="{DynamicResource Daynote.Product.Type.Editor}"
                                   Foreground="{DynamicResource Daynote.Product.Brush.Text}" />
                    </ScrollViewer>
                    <TextBox x:Name="BodyBox" Background="Transparent" Foreground="Transparent" BorderThickness="0"
                             CaretBrush="{DynamicResource Daynote.Product.Brush.Text}" Padding="16,12"
                             FontFamily="{DynamicResource Daynote.Product.Font.Mono}"
                             FontSize="{DynamicResource Daynote.Product.Type.Editor}"
                             TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" SpellCheck.IsEnabled="False"
                             VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                             VerticalContentAlignment="Top"
                             Text="{Binding Notes.EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnBodyTextChanged"
                             AutomationProperties.Name="{loc:Tr MarkdownEditor}" />
                </Grid>

                <!-- Footer meta -->
                <Grid Grid.Row="5" Margin="16,6">
                    <TextBlock x:Name="MetaLeft" HorizontalAlignment="Left" FontSize="11"
                               Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
