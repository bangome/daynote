<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daynote.Mobile.ViewModels"
             xmlns:views="using:Daynote.Mobile.Views"
             xmlns:motion="using:Daynote.Motion"
             x:Class="Daynote.Mobile.Views.DayPage"
             x:DataType="vm:MobileShellViewModel">
  <!--
    The home screen: the day, large, over the week it sits in, and what was written on it. The full
    month is one tap away in the sheet the month button opens; the home screen gives its room to the
    notes instead, because on a phone the day is what gets opened, not the calendar.
  -->
  <ScrollViewer>
    <StackPanel Margin="20,4,20,120">

      <!--
        The month, which opens the sheet, and the way back to today when the day is another. Not on
        a tablet, whose sidebar holds the month; nor the week strip below, for the same reason.
      -->
      <Grid ColumnDefinitions="Auto,*,Auto" Height="44" IsVisible="{Binding !IsTabletLayout}">
        <Button Grid.Column="0" Height="44" CornerRadius="0" Command="{Binding OpenMonthPickerCommand}"
                AutomationProperties.Name="{Binding Strings[CalendarMonth]}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="muted line" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       Text="{Binding Calendar.MonthLabel}" />
            <views:Glyph Kind="ChevronDown" Width="11" Height="11" VerticalAlignment="Center"
                         Foreground="{DynamicResource Mobile.Text2}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="pill sun" Height="30" Padding="12,0" FontSize="13"
                IsVisible="{Binding !IsTodaySelected}" Command="{Binding GoToTodayCommand}">
          <TextBlock Text="{Binding Strings[MobileBackToToday]}" FontWeight="Bold" />
        </Button>
      </Grid>

      <!--
        "30일 수요일" on one baseline, and the sun dot when it is today. Two text blocks rather than
        two runs, because the design tracks the two sizes differently (-2 and -0.6), and a run takes
        its block's spacing. The row is the 40 points the design's line gives it; Avalonia hangs a
        line's glyphs from the font's full ascent where CSS centres them in the line, so the numbers
        sit 5 points up and the weekday is placed on the same baseline by hand.
      -->
      <StackPanel Orientation="Horizontal" Height="40" Margin="0,2,0,16">
        <!-- Padded on both sides and pulled back by the same amount: at this weight and tracking a wide
             first digit ("30") draws a couple of points left of the text's box, and a device clips it
             there; the padding gives the ink room without moving the number. -->
        <TextBlock Classes="line" FontSize="40" FontWeight="ExtraBold" LetterSpacing="-2" LineHeight="40"
                   VerticalAlignment="Top" Margin="-6,-5,-4,0" Padding="6,0,4,0" Text="{Binding BigDayText}" />
        <TextBlock Classes="line" FontSize="20" FontWeight="Bold" LetterSpacing="-0.6"
                   VerticalAlignment="Top" Margin="10,14,0,0" Text="{Binding BigWeekdayText}" />
        <Ellipse Width="8" Height="8" Margin="12,16,0,0" VerticalAlignment="Top"
                 Fill="{DynamicResource Mobile.Sun}" IsVisible="{Binding IsTodaySelected}" />
      </StackPanel>

      <!-- The week strip. -->
      <Grid x:Name="WeekStrip" ColumnDefinitions="24,*,24" Margin="-8,0,-8,22" IsVisible="{Binding !IsTabletLayout}"
            SwipeGesture="OnWeekStripSwipe" SwipeGestureEnded="OnWeekStripSwipeEnded">
        <Grid.GestureRecognizers>
          <SwipeGestureRecognizer CanHorizontallySwipe="True" CanVerticallySwipe="False" />
        </Grid.GestureRecognizers>
        <Button Grid.Column="0" Height="60" CornerRadius="0" Command="{Binding PreviousWeekCommand}"
                AutomationProperties.Name="{Binding Strings[MobilePreviousWeek]}">
          <views:Glyph Kind="ChevronLeft" Width="11" Height="11" Foreground="{DynamicResource Mobile.Text3}" />
        </Button>
        <!--
          The days, over the selected day's pill. The pill is its own shape rather than the selected
          button's background so it can travel between days (motion spec M5); a week change slides
          the whole strip, pill and all, over a still of the week it leaves (DayPage.axaml.cs).
        -->
        <Panel Grid.Column="1" x:Name="WeekTrack" ClipToBounds="True">
          <Image x:Name="WeekGhost" IsVisible="False" IsHitTestVisible="False" Stretch="Fill"
                 HorizontalAlignment="Left" VerticalAlignment="Top" />
          <Panel x:Name="WeekLive">
            <Border x:Name="Pill" Classes="weekpill" HorizontalAlignment="Left" />
            <ItemsControl x:Name="WeekDays" ItemsSource="{Binding Week}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WeekDayViewModel">
                  <Button Classes="weekday" Classes.selected="{Binding IsSelected}" Classes.today="{Binding IsTodayRing}"
                          Classes.sunday="{Binding IsSunday}" Command="{Binding SelectCommand}">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock Classes="wd" Text="{Binding WeekdayLabel}" />
                      <TextBlock Classes="num" Text="{Binding DayText}" />
                      <Ellipse Classes="dot" Classes.has="{Binding HasNotes}" Width="4" Height="4" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </Panel>
        <Button Grid.Column="2" Height="60" CornerRadius="0" Command="{Binding NextWeekCommand}"
                AutomationProperties.Name="{Binding Strings[MobileNextWeek]}">
          <views:Glyph Kind="ChevronRight" Width="11" Height="11" Foreground="{DynamicResource Mobile.Text3}" />
        </Button>
      </Grid>

      <!--
        Everything that belongs to the day, as one block: on a date change it is pushed a little in
        the direction of travel and cross-faded with a still of the day it replaces (M5).
      -->
      <Panel x:Name="DayBody">
      <Image x:Name="DayGhost" IsVisible="False" IsHitTestVisible="False" Stretch="Fill"
             HorizontalAlignment="Left" VerticalAlignment="Top" />
      <StackPanel x:Name="DayContent">

      <!-- 노트 n -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
        <TextBlock Classes="section" Text="{Binding Strings[MobileNotesHeader]}" VerticalAlignment="Bottom" />
        <TextBlock Classes="count" Text="{Binding DayCards.Count}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding DayCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DayNoteCardViewModel">
            <Button Classes="row" CornerRadius="20"
                    Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).OpenNoteCommand}"
                    CommandParameter="{Binding Tab}">
              <Border Classes="card" Padding="18">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="line" FontSize="17" FontWeight="ExtraBold" LetterSpacing="-0.43"
                               Text="{Binding Tab.Title}" />
                    <views:Glyph Grid.Column="1" Kind="Star" Width="13" Height="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Mobile.Sun}" Fill="{DynamicResource Mobile.Sun}"
                                 IsVisible="{Binding Tab.IsFavorite}" />
                  </Grid>
                  <TextBlock Classes="muted" FontSize="14" LineHeight="22.4" Margin="0,6,0,0" MaxLines="3"
                             TextTrimming="CharacterEllipsis" Text="{Binding Preview}" />
                  <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0"
                        IsVisible="{Binding HasFooter}">
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Tab.Tags}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="line" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Mobile.SunInk}" Text="{Binding StringFormat='#{0}'}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- A day with nothing on it: the dashed card that starts the first note. -->
      <Button Classes="row" CornerRadius="20" IsVisible="{Binding IsDayEmpty}" Command="{Binding NewNoteCommand}">
        <Panel>
          <Rectangle RadiusX="20" RadiusY="20" StrokeThickness="1.5" StrokeDashArray="3,2"
                     Stroke="{DynamicResource Mobile.Stroke}" />
          <StackPanel Margin="18,30" Spacing="4">
            <TextBlock FontSize="15" FontWeight="Bold" TextAlignment="Center" Text="{Binding Strings[MobileDayEmptyTitle]}" />
            <TextBlock Classes="muted" FontSize="13" TextAlignment="Center" Text="{Binding Strings[MobileDayEmptyHint]}" />
          </StackPanel>
        </Panel>
      </Button>

      <!--
        이 날의 할 일: this day's to-dos, ticked off here, and + 할 일 for another on this day - the
        way in to a to-do, since a note's text never makes one. Built like 파일 below it. A tablet
        shows them in its day panel instead (DayTodoPanel).
      -->
      <StackPanel IsVisible="{Binding !IsTabletLayout}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,26,0,10">
          <TextBlock Grid.Column="0" Classes="section" Text="{Binding Strings[MobileDayTodosHeader]}" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="1" Classes="count" Text="{Binding DayTodoCountText}" VerticalAlignment="Bottom" Margin="8,0,0,1"
                     IsVisible="{Binding HasDayTodos}" />
          <Button Grid.Column="3" x:Name="AddTodoButton" Classes="pill sun" Height="30" Padding="12,0" FontSize="13"
                  Command="{Binding AddDayTodoCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <views:Glyph Kind="Plus" Width="12" Height="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Mobile.SunInk}" />
              <TextBlock Text="{Binding Strings[MobileTodoAddShort]}" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <!-- A row made since the list was last seen arrives (motion spec M2); a tick draws itself (M3). -->
        <ItemsControl ItemsSource="{Binding DayTodos}" IsVisible="{Binding HasDayTodos}" motion:RowArrivals.IsEnabled="True"
                      motion:RowArrivals.Context="{Binding SelectedDate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodoRowViewModel">
              <views:SwipeRow DeleteCommand="{Binding DeleteCommand}"
                AsksBeforeDelete="{Binding Item.IsRepeat}" IsDone="{Binding Item.Checked}">
                <Panel Classes="todorow">
                  <Border Classes="rowflash" />
                  <Grid Classes="rowcontent" ColumnDefinitions="22,*,Auto" MinHeight="44">
                    <views:TodoCheck Grid.Column="0" IsChecked="{Binding Item.Checked}" Toggle="{Binding Item.ToggleCommand}" Key="{Binding Item.Key}" />
                    <Button Grid.Column="1" Classes="row" Margin="12,0,0,0" MinHeight="44" HorizontalContentAlignment="Left"
                            Command="{Binding OpenCommand}">
                      <Panel HorizontalAlignment="Left">
                        <TextBlock Classes="todo line" Classes.done="{Binding Item.Checked}" FontSize="15" Text="{Binding Item.Text}" />
                        <Border Classes="strike" />
                      </Panel>
                    </Button>
                    <TextBlock Grid.Column="2" Classes="due" Classes.overdue="{Binding Item.Overdue}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Item.DueLabel}" IsVisible="{Binding Item.HasDue}" />
                  </Grid>
                </Panel>
              </views:SwipeRow>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!--
        파일 n: what was attached to this day. Compact rows as in the desktop's day panel - a tile with
        the picture or the extension, the name, and the size or the state that matters more than the
        size. A tap opens it; the dots, or a long press, offer a copy and the delete.
      -->
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,26,0,10">
        <TextBlock Grid.Column="0" Classes="section" Text="{Binding Strings[MobileFilesHeader]}" VerticalAlignment="Bottom" />
        <TextBlock Grid.Column="1" Classes="count" Margin="8,0,0,1" VerticalAlignment="Bottom"
                   Text="{Binding DayFiles.Count}" IsVisible="{Binding HasDayFiles}" />
        <Button Grid.Column="3" x:Name="AttachButton" Classes="pill sun" Height="30" Padding="12,0" FontSize="13"
                Command="{Binding OpenAttachSheetCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <views:Glyph Kind="Paperclip" Width="13" Height="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource Mobile.SunInk}" />
            <TextBlock Text="{Binding Strings[MobileFilesAdd]}" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Classes="card" Padding="0,4" IsVisible="{Binding HasDayFiles}">
        <ItemsControl ItemsSource="{Binding DayFiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MobileFileRowViewModel">
              <Grid ColumnDefinitions="*,44" Margin="0,0,6,0">
                <Button Grid.Column="0" Classes="row filerow" Padding="12,8,4,8" Command="{Binding OpenCommand}"
                        ContextRequested="OnFileRowContextRequested">
                  <Grid ColumnDefinitions="40,*">
                    <Border Grid.Column="0" Classes="filetile">
                      <Panel>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                        <TextBlock Classes="muted" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" Text="{Binding Ext}"
                                   IsVisible="{Binding !HasThumbnail}" />
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Classes="line" FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Classes="line filedetail" Classes.alert="{Binding IsAlert}" Classes.busy="{Binding IsBusy}"
                                 FontSize="12.5" Margin="0,2,0,0" Text="{Binding Detail}" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Grid.Column="1" Classes="iconbtn" Command="{Binding ShowMenuCommand}"
                        AutomationProperties.Name="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Strings[MobileFileMore]}">
                  <views:Glyph Kind="More" Width="18" Height="18" Foreground="{DynamicResource Mobile.Text3}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Classes="faint" FontSize="13" Margin="0,2,0,0" Text="{Binding Strings[MobileFilesEmpty]}"
                 IsVisible="{Binding !HasDayFiles}" />
      <TextBlock Classes="muted" FontSize="12.5" LineHeight="18" Margin="4,10,4,0" Text="{Binding FilesSyncNote}"
                 IsVisible="{Binding HasFilesSyncNote}" />
      <TextBlock FontSize="12.5" LineHeight="18" Margin="4,8,4,0" Foreground="{DynamicResource Mobile.Danger}"
                 Text="{Binding FilesNotice}" IsVisible="{Binding HasFilesNotice}" />
      </StackPanel>
      </Panel>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <Style Selector="Border.filetile">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Seg}" />
    </Style>
    <Style Selector="TextBlock.filedetail">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="TextBlock.filedetail.busy">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.SunInk}" />
    </Style>
    <Style Selector="TextBlock.filedetail.alert">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Danger}" />
    </Style>
    <Style Selector="Button.weekday">
      <Setter Property="Height" Value="62" />
      <Setter Property="Margin" Value="1.5,0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.weekday TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Button.weekday TextBlock.wd">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="Button.weekday.sunday TextBlock.wd">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Sunday}" />
    </Style>
    <Style Selector="Button.weekday TextBlock.num">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.weekday Ellipse.dot">
      <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="Button.weekday Ellipse.dot.has">
      <Setter Property="Fill" Value="{DynamicResource Mobile.Sun}" />
    </Style>
    <Style Selector="Button.weekday.today">
      <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Sun}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <!-- The selected day's fill: drawn by the pill under the strip, so the button itself stays clear. -->
    <Style Selector="Border.weekpill">
      <Setter Property="Height" Value="62" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Pri}" />
    </Style>
    <Style Selector="Button.weekday.selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.OnPri}" />
    </Style>
    <Style Selector="Button.weekday.selected Ellipse.dot.has">
      <Setter Property="Fill" Value="{DynamicResource Mobile.OnPri}" />
    </Style>
  </UserControl.Styles>
</UserControl>
