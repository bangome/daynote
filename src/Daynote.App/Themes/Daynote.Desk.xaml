<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
      The half of "Daynote Desktop B" that does not change with the theme: the marks that are one
      colour in both, the face, and the line icons. Merged once, like the styles; the light and dark
      halves are Daynote.Desk.Light/Dark.xaml.

      Transcribed from the Avalonia shell's Daynote.Desk.axaml. The geometries are the same path data
      on the same viewBoxes, so a mark drawn at a given size lands identically in both shells.
    -->

    <!-- Theme-independent marks. The avatar disc is the sun in both themes, and its initial stays
         navy on it, as the design draws it. Sunday on the navy sidebar is its own warmer red. -->
    <SolidColorBrush x:Key="Daynote.Desk.Brush.AvatarInk" Color="#FF161A36" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.SideSunday" Color="#FFFF8F86" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.Saved" Color="#FF2FB574" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.PostItShadow" Color="#403C2800" po:Freeze="True" />

    <!--
      Pretendard, bundled (OFL). The design asks for weights 400-800; the four static cuts cover
      them, and 500 resolves to the regular cut.

      The family is addressed by a pack-relative folder plus the family name, which is how WPF finds
      a font shipped as a resource. The trailing "./" matters: without it the URI is read as a file
      name rather than a folder and the family never resolves, which shows up as silent Segoe rather
      than as an error.
    -->
    <FontFamily x:Key="Daynote.Desk.Font.Sans">pack://application:,,,/Daynote.App;component/Assets/Fonts/#Pretendard</FontFamily>
    <FontFamily x:Key="Daynote.Desk.Font.Mono">Consolas, Menlo, monospace</FontFamily>

    <!--
      And the same face under the key the existing styles already ask for. Every Setter in
      Daynote.Product.Styles.xaml and its siblings binds FontFamily to Daynote.Product.Font.UI, so
      defining only the Desk key above would have added a face nothing reads — the shell would keep
      Segoe and the design would look unapplied, which is exactly how this was found.

      This dictionary is therefore merged AFTER the styles (WpfProductThemeApplier), because the
      styles declare these two keys themselves and the later dictionary wins.
    -->
    <FontFamily x:Key="Daynote.Product.Font.UI">pack://application:,,,/Daynote.App;component/Assets/Fonts/#Pretendard</FontFamily>
    <FontFamily x:Key="Daynote.Product.Font.Mono">Consolas, Cascadia Mono, Malgun Gothic</FontFamily>

    <!-- The design's line icons, each on the viewBox it was drawn on (noted per mark). -->
    <!-- 10x10 chevrons and the plus. -->
    <PathGeometry x:Key="Daynote.Desk.Geo.ChevronLeft" Figures="M6.5,1 L2.5,5 L6.5,9" />
    <PathGeometry x:Key="Daynote.Desk.Geo.ChevronRight" Figures="M3.5,1 L7.5,5 L3.5,9" />
    <PathGeometry x:Key="Daynote.Desk.Geo.Plus" Figures="M5,1 V9 M1,5 H9" />
    <PathGeometry x:Key="Daynote.Desk.Geo.Close" Figures="M2,2 L8,8 M8,2 L2,8" />
    <PathGeometry x:Key="Daynote.Desk.Geo.Check" Figures="M1.5,5.5 L4,8 L8.5,2.5" />
    <!-- 16x16. -->
    <PathGeometry x:Key="Daynote.Desk.Geo.Search" Figures="M7,2.5 A4.5,4.5 0 1 1 7,11.5 A4.5,4.5 0 1 1 7,2.5 Z M10.5,10.5 L14,14" />
    <PathGeometry x:Key="Daynote.Desk.Geo.Sliders" Figures="M2.5,5 H4.2 M7.8,5 H13.5 M2.5,11 H8.2 M11.8,11 H13.5 M6,3.2 A1.8,1.8 0 1 1 6,6.8 A1.8,1.8 0 1 1 6,3.2 Z M10,9.2 A1.8,1.8 0 1 1 10,12.8 A1.8,1.8 0 1 1 10,9.2 Z" />
    <PathGeometry x:Key="Daynote.Desk.Geo.Sun" Figures="M8,4.8 A3.2,3.2 0 1 1 8,11.2 A3.2,3.2 0 1 1 8,4.8 Z M8,1 V2.6 M8,13.4 V15 M1,8 H2.6 M13.4,8 H15" />
    <PathGeometry x:Key="Daynote.Desk.Geo.Moon" Figures="M13.5,9.5 A5.8,5.8 0 1 1 6.5,2.5 A4.6,4.6 0 0 0 13.5,9.5 Z" />
    <PathGeometry x:Key="Daynote.Desk.Geo.Panel" Figures="M3.5,2.5 H12.5 A2,2 0 0 1 14.5,4.5 V11.5 A2,2 0 0 1 12.5,13.5 H3.5 A2,2 0 0 1 1.5,11.5 V4.5 A2,2 0 0 1 3.5,2.5 Z M10,2.5 V13.5" />
    <!-- 12x12 star (filled or stroked by the consumer). -->
    <PathGeometry x:Key="Daynote.Desk.Geo.Star" Figures="M6,0.8 L7.5,4.2 L11.2,4.6 L8.4,7 L9.2,10.7 L6,8.8 L2.8,10.7 L3.6,7 L0.8,4.6 L4.5,4.2 Z" />
    <!-- 14x14 post-it and trash. -->
    <PathGeometry x:Key="Daynote.Desk.Geo.PostIt" Figures="M2,2 H12 V8.5 L8.5,12 H2 Z M12,8.5 H8.5 V12" />
    <PathGeometry x:Key="Daynote.Desk.Geo.Trash" Figures="M2,3.5 H12 M5.5,3.5 V2 H8.5 V3.5 M3.5,3.5 L4.2,12 H9.8 L10.5,3.5" />
</ResourceDictionary>
