<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Daynote.Mobile.App"
             Name="Daynote"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The phone's own palette, from the mobile design's tokens. The control styles are the
             phone's too, because a finger is not a mouse pointer. -->
        <ResourceInclude Source="avares://Daynote.Mobile/Themes/Daynote.Mobile.Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Daynote.Mobile/Themes/Daynote.Mobile.Styles.axaml" />
  </Application.Styles>
</Application>
