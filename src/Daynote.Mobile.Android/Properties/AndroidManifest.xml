<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    INTERNET is for cloud sync only. No storage permission: attachments arrive through the document
    picker, which grants access per file.
  -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!--
    To-do reminders (Platform/AndroidReminderScheduler.cs). POST_NOTIFICATIONS is the Android 13
    runtime permission, asked the first time a to-do has a due date ahead, never at launch.
    SCHEDULE_EXACT_ALARM lets a reminder fire on the minute where the user allows it (Android 14
    no longer grants it on install); without it the alarm is inexact. Deliberately not
    USE_EXACT_ALARM, which Play restricts to alarm-clock and calendar apps.
    RECEIVE_BOOT_COMPLETED re-arms the alarms after a restart, which clears them all.
  -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application android:label="Daynote"
               android:icon="@mipmap/ic_launcher"
               android:roundIcon="@mipmap/ic_launcher_round"
               android:allowBackup="true"
               android:supportsRtl="true">
    <!--
      Hands an attachment to the app that views it (a PDF reader, a gallery) as a content URI with
      read access for that app only. Serves one cache folder and nothing else; see
      Resources/xml/daynote_file_paths.xml.
    -->
    <provider android:name="androidx.core.content.FileProvider"
              android:authorities="cc.arachat.daynote.files"
              android:exported="false"
              android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                 android:resource="@xml/daynote_file_paths" />
    </provider>
  </application>

  <!--
    Android 11 and later hide other packages from an app unless it declares which it needs. Without
    this the Custom Tab cannot resolve a browser and sign-in would silently do nothing.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>
</manifest>
