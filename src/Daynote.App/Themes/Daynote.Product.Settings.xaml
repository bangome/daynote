<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ==== Settings dialog (v3: the "Daynote v3.dc.html" settings modal) ====
         A 580px card on a scrim: 16px-radius panel, 12px-radius cards on the panel ground with a
         Stroke2 hairline, 13/700 card titles over 11.5 Text2 descriptions, keycap chips for chords,
         and mini bordered buttons. Kept together so the modal reads as one component. -->
    <CornerRadius x:Key="Daynote.Product.Radius.Dialog">16</CornerRadius>
    <CornerRadius x:Key="Daynote.Product.Radius.SettingsCard">12</CornerRadius>
    <CornerRadius x:Key="Daynote.Product.Radius.Kbd">5</CornerRadius>
    <sys:Double x:Key="Daynote.Product.Size.SettingsDialog.Width">580</sys:Double>

    <Style x:Key="Daynote.Product.Style.Settings.Dialog" TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource Daynote.Product.Size.SettingsDialog.Width}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Daynote.Product.Radius.Dialog}" />
        <Setter Property="Effect" Value="{DynamicResource Daynote.Product.Effect.DropdownShadow}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Settings.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Daynote.Product.Radius.SettingsCard}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Daynote.Product.Style.Settings.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Settings.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Base}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Settings.Desc" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <!-- Field caption above an input (email / password). -->
    <Style x:Key="Daynote.Product.Style.Settings.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Meta}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <!-- One line in a list inside a card (a shortcut row name). -->
    <Style x:Key="Daynote.Product.Style.Settings.RowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Item}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Settings.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- Accent status line under an action (backup done, hotkey conflict). Collapses when empty. -->
    <Style x:Key="Daynote.Product.Style.Settings.Status" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Style.Triggers>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Keycap chip: the mono chord shown for a shortcut. -->
    <Style x:Key="Daynote.Product.Style.Kbd" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Daynote.Product.Radius.Kbd}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Kbd.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Meta}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Mini bordered button (change / default): 7px radius, quiet until hovered. -->
    <Style x:Key="Daynote.Product.Style.Button.Mini" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Daynote.Product.Radius.Small}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text link inside a card (the "forgot password?" disclosure): accent text, no chrome. -->
    <Style x:Key="Daynote.Product.Style.Button.Link" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Content" Property="TextBlock.TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footnote block inside a card: the standing privacy notes, gathered into one quiet panel
         instead of trailing loose paragraphs after every state section. -->
    <Style x:Key="Daynote.Product.Style.Settings.Note" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Daynote.Product.Radius.Control}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Pill switch (run at sign-in): 40x22 track, 18px knob, accent when on. Replaces the
         checkmark-button toggle: a preference that takes effect at once reads as a switch. -->
    <Style x:Key="Daynote.Product.Style.Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{DynamicResource Daynote.Product.Brush.SwitchKnob}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,1,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings inputs: white field, hairline stroke, 8px radius (the mock input token). -->
    <Style x:Key="Daynote.Product.Style.Settings.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Item}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Daynote.Product.Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Daynote.Product.Style.Settings.PasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Item}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Daynote.Product.Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
