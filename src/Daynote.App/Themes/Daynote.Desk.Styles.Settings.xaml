<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product">

    <!--
      The settings dialog's own controls, transcribed from the Avalonia shell's Daynote.Styles.axaml:
      the section list down the left, one settings row, the key-chord button and the switch.

      A third styles file rather than more of Daynote.Desk.Styles.Shell.xaml, so either stays
      reviewable. Merged after it, because the section button builds on the bare one there.
    -->

    <!-- One of the four pages, in the list down the left. IsActive carries which page is open. -->
    <Style x:Key="Daynote.Desk.Button.SettingsSection" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="product:DeskVisual.CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
            </Trigger>
            <Trigger Property="product:DeskVisual.IsActive" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One setting: a title and a description, the control at the right, a hairline under it. -->
    <Style x:Key="Daynote.Desk.Style.SettingsRow" TargetType="Border">
        <Setter Property="Padding" Value="0,16" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="Daynote.Desk.Text.SettingsLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Daynote.Desk.Text.SettingsDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- What a row reports after it acted: a saved backup's path, a registration result. -->
    <Style x:Key="Daynote.Desk.Text.SettingsStatus" TargetType="TextBlock" BasedOn="{StaticResource Daynote.Desk.Text.SettingsDesc}">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
    </Style>

    <!-- A key chord, clicked to reassign it. Capturing rings it in the sun. -->
    <Style x:Key="Daynote.Desk.Button.Combo" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Desk.Font.Mono}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="product:DeskVisual.CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
            </Trigger>
            <Trigger Property="product:DeskVisual.IsActive" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Desk.Brush.Sun}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The design's switch: 38x22, a white knob that slides right when on. -->
    <Style x:Key="Daynote.Desk.Style.Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Daynote.Product.Brush.Stroke}">
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect ShadowDepth="1" Direction="270" BlurRadius="3" Opacity="0.25" Color="Black" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Daynote.Desk.Brush.Pri}" />
                            <Setter TargetName="Knob" Property="Margin" Value="18,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A read-only line of text the user copies out: the MCP command. -->
    <Style x:Key="Daynote.Desk.TextBox.Inline" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Daynote.Product.Brush.SelectionBg}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Daynote.Product.Brush.SelectionText}" />
        <Setter Property="SelectionOpacity" Value="1" />
    </Style>

    <!-- The language segments: a Seg track with the chosen half raised to a card. -->
    <Style x:Key="Daynote.Desk.Style.Segments" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <Style x:Key="Daynote.Desk.Style.Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
