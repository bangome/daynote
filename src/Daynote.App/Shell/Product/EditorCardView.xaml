<UserControl
    x:Class="Daynote.App.Shell.Product.EditorCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notes="clr-namespace:Daynote.App.Notes;assembly=Daynote.Presentation"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance product:ProductShellViewModel}">

    <!--
      The note, as design B draws it: the day's notes as tabs along the top, then a 760px column
      holding the heading, the date and tags, the body, and the save footer. No card of its own any
      more — the page is the surface, and the header above supplies the frame.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The day's notes as tabs, the selected one underlined in sun. Right-click a tab to
             rename, copy or delete it; Delete on a focused tab deletes it. -->
        <Border Grid.Row="0" Padding="28,0" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
            <!--
              The strip scrolls with the wheel and shows no bar. A horizontal bar under a 46px row of
              tabs is most of the row, and it only ever says what the fades already say: the two
              gradients appear at whichever end still has tabs behind it. EditorCardView drives both.
            -->
            <Grid>
                <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="TabItems" ItemsSource="{Binding Notes.Tabs}" VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type notes:NoteTabViewModel}">
                                <!-- A projection (the blank note of an empty day) is not a note yet, so it
                                     gets no tab; the empty-day state stands in for it. -->
                                <Button Style="{DynamicResource Daynote.Desk.Button.NoteTab}" Margin="0,0,2,0"
                                        Visibility="{Binding IsProjection, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}"
                                        Command="{Binding DataContext.SelectDayNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.InputBindings>
                                        <KeyBinding Key="Delete" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.DeleteDayNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Button.InputBindings>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Tr NoteMenuRename}"
                                                      Command="{Binding PlacementTarget.DataContext.RenameDayNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="{loc:Tr NoteMenuDuplicate}"
                                                      Command="{Binding PlacementTarget.DataContext.DuplicateDayNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Tr NoteMenuDelete}"
                                                      Command="{Binding PlacementTarget.DataContext.DeleteDayNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                              Data="{DynamicResource Daynote.Desk.Geo.Star}"
                                              Fill="{DynamicResource Daynote.Desk.Brush.Sun}" Stroke="{x:Null}"
                                              Visibility="{Binding IsFavorite, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{DynamicResource Daynote.Desk.Button.GhostSmall}" Margin="4,0,0,6" VerticalAlignment="Bottom"
                            Command="{Binding NewNoteCommand}" ToolTip="{loc:Tr NewNote}"
                            AutomationProperties.Name="{loc:Tr NewNote}">
                        <Path Style="{DynamicResource Daynote.Desk.Style.Icon}" Data="{DynamicResource Daynote.Desk.Geo.Plus}" />
                    </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- The fades sit over the strip in the page colour, so the tabs run under them. -->
                <Rectangle x:Name="TabFadeLeft" Width="28" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="{DynamicResource Daynote.Product.Color.Bg1}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="TabFadeRight" Width="28" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="1" Color="{DynamicResource Daynote.Product.Color.Bg1}" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Border>

        <!-- The note: a 760px column, title and actions, the meta line, the body, the footer. -->
        <Grid Grid.Row="1" MaxWidth="760"
              Visibility="{Binding IsDayEmpty, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="48,35,48,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                      A heading until it is double-clicked. It was always editable, so a stray click
                      in the heading put a caret there; editing is a deliberate gesture — double
                      click, or Rename on a tab's context menu. The control does not change, only
                      its read-only state, so nothing shifts.
                    -->
                    <TextBox x:Name="TitleBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"
                             Style="{DynamicResource Daynote.Desk.TextBox.Title}" VerticalAlignment="Center"
                             Text="{Binding Notes.SelectedTab.Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             MouseDoubleClick="OnTitleDoubleClick" LostFocus="OnTitleLostFocus"
                             AutomationProperties.Name="{loc:Tr DeskTitlePlaceholder}" />

                    <Button Grid.Column="1" Style="{DynamicResource Daynote.Desk.Button.Quiet}" Margin="0,0,6,0"
                            VerticalAlignment="Center" Content="{loc:Tr RetrySave}" Command="{Binding Notes.RetryCommand}"
                            Visibility="{Binding Notes.HasSaveError, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    <Button Grid.Column="2" Style="{DynamicResource Daynote.Desk.Button.Ghost}"
                            Command="{Binding ToggleFavoriteCommand}" IsEnabled="{Binding HasOpenNote}"
                            ToolTip="{loc:Tr Favorite}" AutomationProperties.Name="{loc:Tr Favorite}">
                        <Path Width="17" Height="17" Style="{DynamicResource Daynote.Desk.Style.Star}"
                              product:DeskVisual.IsActive="{Binding Notes.SelectedTab.IsFavorite, FallbackValue=False}"
                              Data="{DynamicResource Daynote.Desk.Geo.Star}" />
                    </Button>
                    <Button Grid.Column="3" Style="{DynamicResource Daynote.Desk.Button.Ghost}"
                            Click="OnOpenStickyNote" IsEnabled="{Binding HasOpenNote}"
                            ToolTip="{Binding StickyTip}" AutomationProperties.Name="{loc:Tr OpenStickyNote}">
                        <Path Width="15" Height="15" Stretch="Uniform" Style="{DynamicResource Daynote.Desk.Style.Icon}"
                              StrokeThickness="1.3" Data="{DynamicResource Daynote.Desk.Geo.PostIt}" />
                    </Button>
                    <Button Grid.Column="4" Style="{DynamicResource Daynote.Desk.Button.GhostDanger}"
                            Command="{Binding DeleteSelectedNoteCommand}" IsEnabled="{Binding HasOpenNote}"
                            ToolTip="{loc:Tr DeleteNoteTip}" AutomationProperties.Name="{loc:Tr DeleteNoteTip}">
                        <Path Width="15" Height="15" Stretch="Uniform" Style="{DynamicResource Daynote.Desk.Style.Icon}"
                              StrokeThickness="1.2" Data="{DynamicResource Daynote.Desk.Geo.Trash}" />
                    </Button>
                </Grid>

                <!-- Meta: the date, the tags (sun ink, a cross to remove), the entry for another. -->
                <WrapPanel Orientation="Horizontal" Margin="0,12,0,20">
                    <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" FontSize="12.5" Margin="0,0,14,0"
                               VerticalAlignment="Center" Text="{Binding NoteDateText}" />
                    <ItemsControl ItemsSource="{Binding Notes.SelectedTab.Tags}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}">
                                        <Run Text="#" /><Run Text="{Binding Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Style="{DynamicResource Daynote.Desk.Button.TagX}" Margin="4,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Mode=OneWay}">
                                        <Path Width="8" Height="8" Stretch="Uniform"
                                              Style="{DynamicResource Daynote.Desk.Style.Icon}" Data="{DynamicResource Daynote.Desk.Geo.Close}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="TagInputBox" Style="{DynamicResource Daynote.Desk.TextBox.TagEntry}"
                                 Text="{Binding TagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnTagKeyDown" AutomationProperties.Name="{loc:Tr TagAddPlaceholder}" />
                        <!-- WPF renders no placeholder, so without this the tag entry is invisible. -->
                        <TextBlock Text="{loc:Tr TagAddPlaceholder}" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Daynote.Desk.Brush.Text3}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=TagInputBox}" Value="" />
                                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=TagInputBox}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </WrapPanel>
            </StackPanel>

            <!--
              The body: a highlight layer with the editor over it, the editor's own text drawn in
              nothing so the caret sits over the coloured glyphs. WPF's TextBox has no inline
              formatting, so marking up what the app understood — checkboxes, due dates, #tags,
              links — means a second layer drawing the same string with the same metrics.
            -->
            <Grid Grid.Row="1" Margin="48,0">
                <ScrollViewer x:Name="HighlightScroll" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False" Focusable="False">
                    <!-- Padding is overwritten on load with the editor's padding plus the TextBoxView
                         gutter; see EditorCardView.OnEditorLoaded. This value only covers the frames
                         before then and the design-time preview. -->
                    <TextBlock x:Name="Highlight" Style="{DynamicResource Daynote.Desk.Text.EditorHighlight}"
                               Padding="0,0,0,40" Foreground="{DynamicResource Daynote.Product.Brush.Text}" />
                </ScrollViewer>
                <TextBox x:Name="BodyBox" Style="{DynamicResource Daynote.Desk.TextBox.Editor}" Padding="0,0,0,40"
                         AcceptsTab="True" SpellCheck.IsEnabled="False"
                         VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                         Text="{Binding Notes.EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="OnBodyTextChanged"
                         AutomationProperties.Name="{loc:Tr MarkdownEditor}" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="48,10,48,14">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource Daynote.Desk.Brush.Saved}"
                         Visibility="{Binding IsSaveSettled, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource Daynote.Desk.Brush.Text3}"
                         Visibility="{Binding IsSaveSettled, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />
                <TextBlock Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="11.5" Margin="6,0,12,0"
                           VerticalAlignment="Center" Text="{Binding SaveFooterText}" />
                <TextBlock x:Name="MetaLeft" Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="11.5"
                           VerticalAlignment="Center" Text="{Binding CharLineText}" />
            </StackPanel>
        </Grid>

        <!-- An empty day: say so, and offer the one thing to do about it. -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsDayEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Text="{loc:Tr DeskEmptyDayTitle}" />
            <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" FontSize="13" Margin="0,10,0,0"
                       HorizontalAlignment="Center" Text="{loc:Tr DeskEmptyDayBody}" />
            <Button Style="{DynamicResource Daynote.Desk.Button.Accent}" Height="38" Padding="18,0" Margin="0,18,0,0"
                    product:DeskVisual.CornerRadius="10" HorizontalAlignment="Center"
                    Command="{Binding NewNoteCommand}" Content="{Binding EmptyDayButtonText}" />
        </StackPanel>
    </Grid>
</UserControl>
