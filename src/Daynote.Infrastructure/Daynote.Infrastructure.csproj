<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Two flavours of one assembly. The Windows-specific TFM is what the WPF app, the MSIX and the
      existing tests consume; it carries the WinRT projections (StartupTask, Package.Current). The plain
      net10.0 flavour is what the Avalonia app builds against on macOS/Linux (and, later, Windows). The
      few WinRT call sites are fenced with #if WINDOWS; everything else compiles for both.
    -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">x64</PlatformTarget>
    <!--
      Also restored for the Mac RIDs: publishing Daynote.Desktop for osx-arm64/osx-x64 records those
      targets in this project's lock file, which locked-mode restore rejects unless declared here. The
      WPF projects must NOT list them (no WindowsDesktop runtime pack exists for macOS).
    -->
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <!--
      The Android RIDs, for the same reason the Mac ones are here: an Android head always builds
      RID-specific, so it asks this project for an android-arm64 target and locked-mode restore
      rejects one the project never declared. Only arm64 and x64 (the emulator): .NET 10 dropped
      32-bit Android, and its RIDs map to runtime packs that are not published.

      iOS is deliberately absent. Its runtime packs only resolve under a net10.0-ios target, so
      declaring ios-arm64 on a net10.0 project fails outright; the iOS head reaches this assembly
      through the framework-dependent path instead and needs nothing here.
    -->
    <RuntimeIdentifiers>$(RuntimeIdentifiers);android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Daynote.Core\Daynote.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
  </ItemGroup>
</Project>
