<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    Avalonia draws every pixel of the UI, so the Android theme only has to get out of the way: no
    action bar, and a window background that matches the app's own so the launch frame does not
    flash white before the first Avalonia frame lands.
  -->
  <style name="MyTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:windowBackground">@color/window_background</item>
    <!--
      Transparent bars and shortEdges, because the app draws edge to edge: its own background fills
      the status bar strip and the bottom bar's fill runs under the gesture area, instead of each
      being a band of the platform's own colour. MainView.axaml.cs keeps the content clear of both.
    -->
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
  </style>
</resources>
