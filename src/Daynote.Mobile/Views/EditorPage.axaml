<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daynote.Mobile.ViewModels"
             xmlns:views="using:Daynote.Mobile.Views"
             xmlns:agenda="using:Daynote.Core.Agenda"
             x:Class="Daynote.Mobile.Views.EditorPage"
             x:DataType="vm:MobileShellViewModel"
             Background="{DynamicResource Mobile.Bg}">
  <!--
    The note, full screen: the date it belongs to, its title and tags, its text, and the three
    helpers that put the body's small syntax within reach of a thumb. It covers the tabs, because a
    390-point screen has room for the text and nothing else.
  -->
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- Back, the note's date, and the two actions worth a permanent place. -->
    <Grid Grid.Row="0" Height="48" Margin="6,0" ColumnDefinitions="44,*,44,44">
      <Button Grid.Column="0" Classes="iconbtn" Command="{Binding CloseEditorCommand}"
              AutomationProperties.Name="{Binding Strings[Back]}">
        <views:Glyph Kind="Back" Width="18" Height="18" Foreground="{DynamicResource Mobile.Text}" />
      </Button>
      <TextBlock Grid.Column="1" Classes="muted line" FontSize="14" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding EditorDateText}" />
      <Button Grid.Column="2" Classes="iconbtn" Command="{Binding ToggleFavoriteCommand}"
              AutomationProperties.Name="{Binding Strings[Favorite]}">
        <views:Glyph Kind="Star" Width="21" Height="21"
                     Classes.on="{Binding Notes.SelectedTab.IsFavorite, FallbackValue=False}" Classes="star" />
      </Button>
      <Button Grid.Column="3" Classes="iconbtn" Command="{Binding DeleteNoteCommand}"
              CommandParameter="{Binding Notes.SelectedTab}"
              AutomationProperties.Name="{Binding Strings[NoteMenuDelete]}">
        <views:Glyph Kind="Trash" Width="19" Height="19" Foreground="{DynamicResource Mobile.Text2}" />
      </Button>
    </Grid>

    <!-- The title, then the save state and the tags on one wrapping line. -->
    <StackPanel Grid.Row="1" Margin="22,10,22,0">
      <!-- The title is text until it is tapped, then a box over a draft, at the same size and on
           the same line so nothing moves. A tap rather than the desktop's double-click: a phone has
           no second click, and a note that cannot be renamed here is stuck with "노트 1". -->
      <Button Classes="row" HorizontalContentAlignment="Left" Command="{Binding BeginRenameTitleCommand}"
              IsVisible="{Binding !IsRenamingTitle}"
              AutomationProperties.Name="{Binding Strings[NoteMenuRename]}">
        <TextBlock Classes="title" Text="{Binding Notes.SelectedTab.Title, FallbackValue=''}" />
      </Button>
      <TextBox x:Name="TitleBox" Classes="bare title" Text="{Binding TitleDraft}"
               PlaceholderText="{Binding Strings[MobileTitlePlaceholder]}"
               IsVisible="{Binding IsRenamingTitle}" KeyDown="OnTitleKeyDown" LostFocus="OnTitleLostFocus" />

      <!-- 22-point rows for the tap, so 9 and 3 around them make the design's 12 and 6 around 16. -->
      <WrapPanel Margin="0,9,0,3">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" Height="22">
          <Ellipse Width="6" Height="6" VerticalAlignment="Center" Classes="savedot"
                   Classes.saved="{Binding IsEditorSaved}" Classes.error="{Binding Notes.HasSaveError}" />
          <TextBlock Classes="faint line" FontSize="13.5" VerticalAlignment="Center" Text="{Binding EditorSaveText}" />
        </StackPanel>
        <Button Height="22" Margin="0,0,12,0" IsVisible="{Binding Notes.HasSaveError}" Command="{Binding Notes.RetryCommand}">
          <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Mobile.Danger}"
                     Text="{Binding Strings[RetrySave]}" />
        </Button>
        <ItemsControl ItemsSource="{Binding Notes.SelectedTab.Tags, FallbackValue={x:Null}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <!-- A tap takes the tag off, as in the design. -->
              <Button Height="22" Margin="0,0,12,0"
                      Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).RemoveTagCommand}"
                      CommandParameter="{Binding}">
                <TextBlock Classes="line" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Mobile.SunInk}"
                           Text="{Binding StringFormat='#{0}'}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox Classes="bare" Width="70" Height="22" FontSize="13.5" Foreground="{DynamicResource Mobile.Text2}"
                 Text="{Binding TagInput}" PlaceholderText="{Binding Strings[TagAddPlaceholder]}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding CommitTagCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </WrapPanel>
    </StackPanel>

    <!--
      AcceptsReturn lets the box take a line break, but the phone's keyboard is told separately what
      the field is: left at the defaults it got a single-line field whose return key is "Done", so
      Enter closed the keyboard instead of starting a new line.
    -->
    <TextBox Grid.Row="2" x:Name="Body" Classes="bare body" Text="{Binding Notes.EditorText}"
             TextInputOptions.Multiline="True" TextInputOptions.ReturnKeyType="Return"
             PlaceholderText="{Binding Strings[MobileBodyPlaceholder]}"
             PropertyChanged="OnBodyPropertyChanged" />

    <!--
      The writing helpers. The note body carries a small syntax - a checkbox opens a line, a (M/D) or
      (M/D H:mm) at the end of one gives it a due time - and on a desktop you simply type it. On a
      phone those brackets are two keyboard layers away, which is enough to stop people using it.

      The buttons are not focusable on purpose: taking focus would close the keyboard and move the
      caret, which is the opposite of what a helper should do.
    -->
    <!--
      The day's files, one line of chips over the helpers: what is attached is in sight while writing,
      and a tap opens it, as on the day screen.
    -->
    <Border Grid.Row="3" Background="{DynamicResource Mobile.Panel}" BorderBrush="{DynamicResource Mobile.Stroke2}"
            BorderThickness="0,1,0,0" IsVisible="{Binding HasDayFiles}">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,8">
          <TextBlock Classes="faint" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,2,0"
                     TextWrapping="NoWrap" Text="{Binding Strings[MobileFilesHeader]}" />
          <ItemsControl ItemsSource="{Binding DayFiles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MobileFileRowViewModel">
                <Button Classes="filechip" Command="{Binding OpenCommand}" ContextRequested="OnFileChipContextRequested">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="28" Height="28" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource Mobile.Seg}">
                      <Panel>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                        <TextBlock Classes="muted" FontSize="8.5" FontWeight="ExtraBold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" Text="{Binding Ext}"
                                   IsVisible="{Binding !HasThumbnail}" />
                      </Panel>
                    </Border>
                    <TextBlock Classes="line" MaxWidth="140" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="{Binding Name}" />
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource Mobile.Sun}"
                             IsVisible="{Binding IsBusy}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Clipped, so the @ bar rises out of its bottom edge - from behind the keyboard (motion spec M1). -->
    <Border Grid.Row="4" x:Name="Toolbar" Background="{DynamicResource Mobile.Panel}"
            BorderBrush="{DynamicResource Mobile.Stroke2}" BorderThickness="0,1,0,0" ClipToBounds="True">
      <!--
        No `-[]` button. It wrote the syntax the panels used to read; a to-do is its own row now,
        so the only thing it could insert is text that looks like a checkbox. The phone's own @
        bar takes its place (phone §01); until that lands, a to-do is captured on the desktop or
        made in the list. Date and time stay: they stamp ordinary prose, which still reads.
      -->
      <Panel>
        <StackPanel IsVisible="{Binding !Capture.IsOpen}">
          <!--
            What this note made (phone §02). The chip the body draws around the @ span says the
            characters changed; it does not say which date or which list the thing went to. So the
            confirmation appears where the object actually lives — the note's own collection — and
            a row rising there is the thing arriving rather than a toast claiming it did.
          -->
          <Grid x:Name="NoteItemsRow" ColumnDefinitions="40,*,Auto" Margin="12,6,12,0" IsVisible="{Binding JustMade, Converter={x:Static ObjectConverters.IsNull}}">
            <!-- The @ itself, two keyboard layers away on a Korean keyboard, and the only
                 discoverable way in now that the `-[]` button is gone. -->
            <Button Grid.Column="0" Classes="attool" Focusable="False" Click="OnInsertAt">
              <TextBlock Text="@" />
            </Button>
            <TextBlock Grid.Column="1" Classes="faint" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextWrapping="NoWrap" Text="{Binding Strings[MobileCaptureKinds]}" />
            <Button Grid.Column="2" x:Name="NoteItemsButton" Classes="noteitems" Focusable="False" IsVisible="{Binding HasNoteItems}"
                    RenderTransformOrigin="50%,50%"
                    Command="{Binding OpenNoteItemsCommand}">
              <TextBlock Text="{Binding NoteItemCountText}" />
            </Button>
          </Grid>

          <!-- The row that rises in its place, then settles back into the count. -->
          <Grid x:Name="JustMadeRow" ColumnDefinitions="*,Auto" Margin="12,6,12,0" IsVisible="{Binding JustMade, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                      Background="{DynamicResource Mobile.Sun}" />
              <TextBlock Classes="line" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                         Text="{Binding JustMade.Text}" />
              <TextBlock Classes="faint" FontSize="12.5" VerticalAlignment="Center"
                         IsVisible="{Binding JustMade.HasDue}" Text="{Binding JustMade.DueLabel}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="faint" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap"
                         Text="{Binding JustMadeWhenText}" />
              <!-- Only when it landed on another day: otherwise there is nowhere to go. -->
              <Button Classes="viewmade" Focusable="False" IsVisible="{Binding IsJustMadeElsewhere}"
                      Command="{Binding ViewJustMadeCommand}">
                <TextBlock Text="{Binding Strings[MobileNoteItemsView]}" />
              </Button>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,4,*,4,44" Margin="12,8,12,0">
          <Button Grid.Column="0" Classes="tool" Focusable="False" Click="OnInsertDate">
            <TextBlock Text="{Binding Strings[InsertDate]}" />
          </Button>
          <Button Grid.Column="2" Classes="tool" Focusable="False" Click="OnInsertTime">
            <TextBlock Text="{Binding Strings[MobileInsertTime]}" />
          </Button>
          <!-- Attach: files belong to the day, so this is the day screen's same sheet. -->
          <Button Grid.Column="4" x:Name="AttachTool" Classes="tool" Focusable="False" Command="{Binding OpenAttachSheetCommand}"
                  AutomationProperties.Name="{Binding Strings[MobileFilesAdd]}">
            <views:Glyph Kind="Paperclip" Width="18" Height="18" Foreground="{DynamicResource Mobile.Text}" />
          </Button>
          </Grid>
        </StackPanel>

        <!--
          The @ bar (phone §01). It takes the helpers' place rather than floating over the text:
          the caret on a phone is almost always just above the keyboard, so a card that followed it
          would cover the words it is reading back.

          Nothing here is focusable. Taking focus would close the keyboard and move the caret, and
          the whole bar exists to be read while the phrase after the @ is still being typed.
        -->
        <StackPanel x:Name="CaptureBar" Margin="12,8,12,0" Spacing="6" IsVisible="{Binding Capture.IsOpen}">
          <Grid ColumnDefinitions="Auto,*,36">
            <TextBlock Grid.Column="0" Classes="faint" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"
                       Text="{Binding Strings[AgendaCaptureTitleLabel]}" />
            <!-- The title is already typed; the bar shows it rather than asking for it again (§7). -->
            <TextBlock Grid.Column="1" Classes="line" Margin="8,0,0,0" FontSize="13.5" FontWeight="ExtraBold"
                       VerticalAlignment="Center" Text="{Binding Capture.Title}" />
            <Button Grid.Column="2" Classes="capclose" Focusable="False" Click="OnDismissCapture"
                    AutomationProperties.Name="{Binding Strings[MobileCancel]}">
              <views:Glyph Kind="Close" Width="13" Height="13" Foreground="{DynamicResource Mobile.Text2}" />
            </Button>
          </Grid>

          <!-- Nothing typed after the @ yet: an invitation and four examples, not an error. -->
          <StackPanel Spacing="8" Margin="0,0,0,4" IsVisible="{Binding Capture.IsPrompting}">
            <TextBlock Classes="faint" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Capture.Prompt}" />
            <ItemsControl ItemsSource="{Binding Capture.Examples}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <!-- A tap types the example for you; the parser then reads it like any other. -->
                  <Button Classes="pill" Focusable="False" Click="OnCaptureExample">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel IsVisible="{Binding !Capture.IsPrompting}">
            <!--
              The two readings, one above the other. They describe the same phrase in the two
              shapes it could take, so choosing is choosing a shape, not re-entering a date. Each
              row is its own tap target: a phone has no Tab key, and a swipe nobody can see is not
              an affordance.
            -->
            <!-- The selected reading's background is one shape under both lines, so a switch slides it (M1). -->
            <Panel IsVisible="{Binding !IsCaptureBarCompact}">
            <Border x:Name="CapHighlight" Classes="caphighlight" VerticalAlignment="Top" />
            <StackPanel Spacing="2">
              <Button Classes="capline" Classes.on="{Binding Capture.IsTaskSelected}" Focusable="False"
                      Command="{Binding SelectCaptureKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Task}">
                <Grid ColumnDefinitions="46,*,Auto">
                  <TextBlock Grid.Column="0" Classes="capkind" Text="{Binding Strings[AgendaCaptureTask]}" />
                  <TextBlock Grid.Column="1" Classes="capread" Text="{Binding Capture.TaskLine}" />
                  <Button Grid.Column="2" Classes="capmake" Focusable="False" IsVisible="{Binding Capture.IsTaskSelected}"
                          Command="{Binding CommitCaptureCommand}">
                    <TextBlock Text="{Binding Strings[AgendaCaptureCreate]}" />
                  </Button>
                </Grid>
              </Button>
              <Button Classes="capline" Classes.on="{Binding Capture.IsEventSelected}" Focusable="False"
                      Command="{Binding SelectCaptureKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Event}">
                <Grid ColumnDefinitions="46,*,Auto">
                  <TextBlock Grid.Column="0" Classes="capkind" Text="{Binding Strings[AgendaCaptureEvent]}" />
                  <TextBlock Grid.Column="1" Classes="capread" Text="{Binding Capture.EventLine}" />
                  <Button Grid.Column="2" Classes="capmake" Focusable="False" IsVisible="{Binding Capture.IsEventSelected}"
                          Command="{Binding CommitCaptureCommand}">
                    <TextBlock Text="{Binding Strings[AgendaCaptureCreate]}" />
                  </Button>
                </Grid>
              </Button>
            </StackPanel>
            </Panel>

            <!--
              Too little room above the keyboard for two lines (§01 ⑤): the kind becomes a pair of
              chips and only the reading that would be made is spelled out. Folding is better than
              scrolling here - a readback you have to scroll to is one nobody reads.
            -->
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsCaptureBarCompact}">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button Classes="capchip" Classes.on="{Binding Capture.IsTaskSelected}" Focusable="False"
                        Command="{Binding SelectCaptureKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Task}">
                  <TextBlock Text="{Binding Strings[AgendaCaptureTask]}" />
                </Button>
                <Button Classes="capchip" Classes.on="{Binding Capture.IsEventSelected}" Focusable="False"
                        Command="{Binding SelectCaptureKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Event}">
                  <TextBlock Text="{Binding Strings[AgendaCaptureEvent]}" />
                </Button>
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="capread" Margin="10,0" Text="{Binding Capture.SelectedLine}" />
              <Button Grid.Column="2" Classes="capmake" Focusable="False" Command="{Binding CommitCaptureCommand}">
                <TextBlock Text="{Binding Strings[AgendaCaptureCreate]}" />
              </Button>
            </Grid>
          </StackPanel>

          <!--
            The one thing worth saying out loud: a time read as tomorrow, or a repeat that will not
            remind yet. Absent when there is nothing to warn about, so its presence is the signal.
          -->
          <TextBlock Classes="capnote" IsVisible="{Binding Capture.HasNote}" Text="{Binding Capture.Note}" />
        </StackPanel>
      </Panel>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="LetterSpacing" Value="-1.2" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.title">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="LetterSpacing" Value="-1.2" />
    </Style>
    <Style Selector="TextBox.body">
      <Setter Property="FontSize" Value="16.5" />
      <Setter Property="LineHeight" Value="29.7" />
      <Setter Property="Padding" Value="22,12,22,24" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="views|Glyph.star">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text2}" />
      <Setter Property="Fill" Value="{x:Null}" />
    </Style>
    <Style Selector="views|Glyph.star.on">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Sun}" />
      <Setter Property="Fill" Value="{DynamicResource Mobile.Sun}" />
    </Style>
    <Style Selector="Ellipse.savedot">
      <Setter Property="Fill" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="Ellipse.savedot.saved">
      <Setter Property="Fill" Value="{StaticResource Mobile.Saved}" />
    </Style>
    <Style Selector="Ellipse.savedot.error">
      <Setter Property="Fill" Value="{DynamicResource Mobile.Danger}" />
    </Style>
    <Style Selector="Button.filechip">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="8,0,12,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Seg}" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Height" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Seg}" />
    </Style>
    <Style Selector="Button.tool TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool.primary">
      <Setter Property="Background" Value="{DynamicResource Mobile.Pri}" />
    </Style>
    <Style Selector="Button.attool">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Seg}" />
    </Style>
    <Style Selector="Button.attool TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text2}" />
    </Style>
    <Style Selector="Button.noteitems">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.noteitems TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text2}" />
    </Style>
    <Style Selector="Button.viewmade">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Seg}" />
    </Style>
    <Style Selector="Button.viewmade TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.SunInk}" />
    </Style>
    <!-- ── The @ bar ─────────────────────────────────────────────────────────────────────────── -->
    <Style Selector="Button.capclose">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- 44 points, so each reading is its own thumb target rather than a line of text. -->
    <Style Selector="Button.capline">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.caphighlight">
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Seg}" />
    </Style>
    <Style Selector="TextBlock.capkind">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="Button.capline.on TextBlock.capkind">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.SunInk}" />
    </Style>
    <Style Selector="TextBlock.capread">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text2}" />
    </Style>
    <Style Selector="Button.capline.on TextBlock.capread">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text}" />
    </Style>
    <Style Selector="Button.capmake">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Pri}" />
    </Style>
    <Style Selector="Button.capmake TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.OnPri}" />
    </Style>
    <Style Selector="Button.capchip">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Seg}" />
    </Style>
    <Style Selector="Button.capchip TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="Button.capchip.on">
      <Setter Property="Background" Value="{DynamicResource Mobile.Pri}" />
    </Style>
    <Style Selector="Button.capchip.on TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.OnPri}" />
    </Style>
    <Style Selector="TextBlock.capnote">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="4,2,4,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.SunInk}" />
    </Style>
    <Style Selector="Button.tool.primary TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.OnPri}" />
    </Style>
  </UserControl.Styles>
</UserControl>
