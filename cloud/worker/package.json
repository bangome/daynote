{
  "name": "daynote-cloud-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daynote cloud sync API: auth gateway in front of Cloudflare D1 and R2.",
  "scripts": {
    "dev": "wrangler dev",
    "build:site": "node ../site/build.mjs",
    "predeploy": "node ../site/build.mjs",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "db:apply:local": "wrangler d1 migrations apply daynote --local",
    "db:apply:remote": "wrangler d1 migrations apply daynote --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "4.124.0"
  }
}
