<Window
    x:Class="Daynote.App.Shell.Product.ProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pvm="clr-namespace:Daynote.App.Shell.Product;assembly=Daynote.Presentation"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:settings="clr-namespace:Daynote.App.Settings"
    xmlns:onboarding="clr-namespace:Daynote.App.Onboarding"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:account="clr-namespace:Daynote.App.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance product:ProductShellViewModel}"
    Title="{loc:Tr AppTitle}"
    Icon="pack://application:,,,/Daynote.App;component/Assets/Brand/daynote-favicon-v1.ico"
    Width="1240" Height="800" MinWidth="900" MinHeight="560"
    WindowStyle="None" ResizeMode="CanResize"
    Background="{DynamicResource Daynote.Product.Brush.Bg1}"
    FontFamily="{DynamicResource Daynote.Product.Font.UI}"
    Foreground="{DynamicResource Daynote.Product.Brush.Text}"
    SizeChanged="OnWindowSizeChanged"
    UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <!--
      Design "Daynote Desktop B": a navy sidebar, a header with the big date and the week, the
      editor (or the timeline, or a list) in the middle, the day's to-dos and files at the right.
      Overlays — the palette, settings, the account card, the tutorial — sit over all of it in the
      same root grid.

      There is no title bar of its own any more; a thin strip at the top of the main column carries
      the caption buttons, and the header drags the window. The sidebar and the header are the same
      view models the Avalonia shell draws from, so the two windows show the same thing.
    -->

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- In-app shortcuts are built at runtime from the user-configurable set (ProductWindow.AttachShortcuts). -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═ Sidebar ═ -->
        <product:DeskSidebarView Grid.Column="0" WindowChrome.IsHitTestVisibleInChrome="True"
                                 Visibility="{Binding LeftCollapsed, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />

        <!-- ═ Main column ═ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The caption buttons, drawn by the app so they match it. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{DynamicResource Daynote.Desk.Button.Caption}" Click="OnMinimize"
                        AutomationProperties.Name="{loc:Tr WindowMinimize}">
                    <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Min}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                </Button>
                <Button x:Name="MaxButton" Style="{DynamicResource Daynote.Desk.Button.Caption}" Click="OnMaximizeRestore"
                        AutomationProperties.Name="{loc:Tr WindowMaximize}">
                    <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Max}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Fill="{x:Null}" />
                </Button>
                <Button x:Name="CloseButton" Style="{DynamicResource Daynote.Desk.Button.CaptionClose}" Click="OnClose"
                        AutomationProperties.Name="{loc:Tr WindowClose}">
                    <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Close}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                </Button>
            </StackPanel>

            <!-- ═ Header: the big date, the week, and the view toggles ═ -->
            <Border Grid.Row="1" Padding="28,10,28,16" Background="Transparent"
                    BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The sidebar is gone: the only way back. -->
                    <Button Grid.Column="0" Style="{DynamicResource Daynote.Desk.Button.GhostOutlined}" Margin="0,0,24,0"
                            Command="{Binding ToggleLeftCommand}" ToolTip="{loc:Tr SidebarsExpand}"
                            AutomationProperties.Name="{loc:Tr SidebarsExpand}"
                            Visibility="{Binding LeftCollapsed, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                        <Path Style="{DynamicResource Daynote.Desk.Style.Icon}" Data="{DynamicResource Daynote.Desk.Geo.ChevronRight}" />
                    </Button>

                    <Button Grid.Column="1" Style="{DynamicResource Daynote.Desk.Button.Bare}"
                            Command="{Binding GoToTodayCommand}" ToolTip="{Binding TodayTip}"
                            AutomationProperties.Name="{loc:Tr GoToToday}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="44" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,-4,12,4"
                                       Text="{Binding BigDay}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding BigMeta}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" FontSize="12"
                                               VerticalAlignment="Center" Text="{Binding BigSub}" />
                                    <Border Style="{DynamicResource Daynote.Desk.Style.Chip}" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsTodaySelected, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.Chip}" Text="{loc:Tr Today}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- The week of the selected date. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="24,0" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Style="{DynamicResource Daynote.Desk.Button.WeekStep}" Command="{Binding Week.PreviousWeekCommand}"
                                AutomationProperties.Name="{loc:Tr DeskPreviousWeek}">
                            <Path Style="{DynamicResource Daynote.Desk.Style.Icon}" Data="{DynamicResource Daynote.Desk.Geo.ChevronLeft}" />
                        </Button>
                        <ItemsControl ItemsSource="{Binding Week.Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pvm:WeekStripDayViewModel}">
                                    <Button Style="{DynamicResource Daynote.Desk.Button.WeekDay}" Margin="2,0"
                                            Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding DayText}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.WeekDayName}"
                                                       HorizontalAlignment="Center" Text="{Binding WeekdayLabel}" />
                                            <TextBlock FontSize="16" FontWeight="Bold" Margin="0,3"
                                                       HorizontalAlignment="Center" Text="{Binding DayText}" />
                                            <Ellipse Style="{DynamicResource Daynote.Desk.Style.WeekDot}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{DynamicResource Daynote.Desk.Button.WeekStep}" Command="{Binding Week.NextWeekCommand}"
                                AutomationProperties.Name="{loc:Tr DeskNextWeek}">
                            <Path Style="{DynamicResource Daynote.Desk.Style.Icon}" Data="{DynamicResource Daynote.Desk.Geo.ChevronRight}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource Daynote.Desk.Button.ToolPrimary}" Padding="12,0" Margin="0,0,6,0"
                                product:DeskVisual.IsActive="{Binding IsTimelineMode}"
                                Command="{Binding ToggleTimelineCommand}" ToolTip="{loc:Tr TimelineToggle}"
                                Content="{loc:Tr DeskTimelineButton}" />
                        <Button Style="{DynamicResource Daynote.Desk.Button.Tool}" Margin="0,0,6,0"
                                Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeTip}"
                                AutomationProperties.Name="{loc:Tr ThemeToggle}">
                            <Grid>
                                <Path Width="15" Height="15" Stretch="Uniform" Style="{DynamicResource Daynote.Desk.Style.Icon}"
                                      StrokeThickness="1.4" Data="{DynamicResource Daynote.Desk.Geo.Moon}"
                                      Visibility="{Binding IsDark, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />
                                <Path Width="15" Height="15" Stretch="Uniform" Style="{DynamicResource Daynote.Desk.Style.Icon}"
                                      StrokeThickness="1.4" Data="{DynamicResource Daynote.Desk.Geo.Sun}"
                                      Visibility="{Binding IsDark, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                            </Grid>
                        </Button>
                        <Button Style="{DynamicResource Daynote.Desk.Button.Tool}" Margin="0,0,4,0"
                                product:DeskVisual.IsActive="{Binding RightCollapsed, Converter={StaticResource Daynote.Convert.InverseBool}}"
                                Command="{Binding ToggleRightCommand}" ToolTip="{Binding DayPanelTip}"
                                AutomationProperties.Name="{Binding DayPanelTip}">
                            <Path Width="15" Height="15" Stretch="Uniform" Style="{DynamicResource Daynote.Desk.Style.Icon}"
                                  StrokeThickness="1.3" Data="{DynamicResource Daynote.Desk.Geo.Panel}" />
                        </Button>
                        <Button Style="{DynamicResource Daynote.Desk.Button.Accent}" Height="34" Padding="14,0" Margin="4,0,0,0"
                                Command="{Binding NewNoteCommand}" ToolTip="{Binding NewNoteTip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Daynote.Desk.Style.Icon}" StrokeThickness="1.7"
                                      Data="{DynamicResource Daynote.Desk.Geo.Plus}" />
                                <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Text="{loc:Tr NewNote}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═ Body: the middle view, and the day panel at the right ═ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <product:EditorCardView x:Name="TutEditor" Grid.Column="0" DataContext="{Binding}"
                                        StickyNoteRequested="OnStickyNoteRequested"
                                        Visibility="{Binding IsEditorMode, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />

                <product:TimelineView Grid.Column="0" DataContext="{Binding Timeline}"
                                      Visibility="{Binding DataContext.IsTimelineMode, RelativeSource={RelativeSource AncestorType=Window},
                                                           Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />

                <product:DeskListsView Grid.Column="0"
                                       Visibility="{Binding IsListMode, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />

                <product:DeskDayPanelView Grid.Column="1"
                                          Visibility="{Binding RightCollapsed, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />
            </Grid>
        </Grid>

        <!-- ═ Overlays ═ -->

        <settings:SettingsView x:Name="SettingsHost" Grid.ColumnSpan="2" Panel.ZIndex="20"
                               DataContext="{Binding SettingsViewModel}"
                               Visibility="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />

        <!-- The cloud account card, opened from the sidebar's account row. -->
        <Border Grid.ColumnSpan="2" Panel.ZIndex="25" Style="{DynamicResource Daynote.Desk.Style.Scrim}"
                Visibility="{Binding IsAccountOpen, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <Border Style="{DynamicResource Daynote.Desk.Style.Modal}" Width="560" MaxHeight="680" Margin="24"
                    Padding="28,24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource Daynote.Desk.Text.H1}" Text="{loc:Tr AccountWindowTitle}" />
                        <Button Grid.Column="1" Style="{DynamicResource Daynote.Desk.Button.GhostSmall}"
                                Command="{Binding CloseAccountCommand}" AutomationProperties.Name="{loc:Tr CloseSettings}">
                            <Path Style="{DynamicResource Daynote.Desk.Style.Icon}" Data="{DynamicResource Daynote.Desk.Geo.Close}" />
                        </Button>
                    </Grid>
                    <account:AccountSection Grid.Row="1" DataContext="{Binding Account}" />
                </Grid>
            </Border>
        </Border>

        <onboarding:TutorialView x:Name="TutorialHost" Grid.ColumnSpan="2" Panel.ZIndex="30"
                                 DataContext="{Binding Tutorial}"
                                 Visibility="{Binding IsOpen, FallbackValue=Collapsed,
                                                      Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />

        <product:DeskPaletteView Grid.ColumnSpan="2" Panel.ZIndex="40" DataContext="{Binding}"
                                 Visibility="{Binding IsPaletteOpen, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
    </Grid>
</Window>
