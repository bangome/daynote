<UserControl
    x:Class="Daynote.App.Shell.Product.FavoritesPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance product:FavoritesPanelViewModel}">
    <!-- 즐겨찾기 tab body (Daynote v3): every starred note across all dates, newest first; click opens
         the note on its own date. Hosted inside the right rail's tab area by ProductWindow. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type product:FavoriteItemViewModel}">
                        <Border BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="1"
                                CornerRadius="{DynamicResource Daynote.Product.Radius.Panel}" Padding="12,10" Margin="0,0,0,5" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                          Data="{DynamicResource Daynote.Product.Geo.Star}" Fill="{DynamicResource Daynote.Product.Brush.Extras}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Daynote.Product.Brush.Text}" />
                                    <TextBlock Grid.Column="2" Text="{Binding DateLabel}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                                </Grid>
                                <TextBlock Text="{Binding Preview}" FontSize="11" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{loc:Tr FavoritesPanelEmpty}" TextAlignment="Center" Margin="12,28" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
