<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Product Dark theme brushes. Mirrors Daynote.Product.Light.xaml key-for-key. -->
    <Color x:Key="Daynote.Product.Color.Bg1">#FF1C1E24</Color>
    <Color x:Key="Daynote.Product.Color.Bg2">#FF23262E</Color>
    <SolidColorBrush x:Key="Daynote.Product.Brush.Bg1" Color="#FF1C1E24" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Bg2" Color="#FF23262E" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Panel" Color="#B8282A30" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Card" Color="#FF2B2D33" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Stroke" Color="#17FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Text" Color="#FFF0F0F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Text2" Color="#FF9D9FA5" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Accent" Color="#FF4CC2FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.AccentSoft" Color="#214CC2FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Hover" Color="#0FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Input" Color="#0FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.OnAccent" Color="#FF10151B" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.OnClose" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Extras" Color="#FFE8A33D" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Sticky" Color="#FF5B4A20" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.StickyStroke" Color="#FF907B3B" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.CloseHover" Color="#FFC42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sun" Color="#FFD13438" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sat" Color="#FF4CC2FF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Overdue" Color="#FFF2686C" po:Freeze="True" />

    <DropShadowEffect x:Key="Daynote.Product.Effect.CardShadow" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#000000" />
    <DropShadowEffect x:Key="Daynote.Product.Effect.DropdownShadow" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000" />
</ResourceDictionary>
