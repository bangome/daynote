<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Daynote.Mobile.Views">
  <!--
    The phone's control styles, after the "Daynote Mobile B" design. Sizes are the design's own CSS
    pixels, which are the same unit as an Avalonia point. Anything tapped keeps a target of about
    44 points even where the drawn shape is smaller (a 22-point checkbox sits in a 44-point row).
  -->
  <!-- The window's own ground, which is what shows behind the status bar and the notch. -->
  <Style Selector=":is(TopLevel)">
    <Setter Property="Background" Value="{DynamicResource Mobile.Bg}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Text2}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
  </Style>
  <Style Selector="TextBlock.line">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- 목록, 검색, 설정: the page title. -->
  <Style Selector="TextBlock.pagetitle">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LetterSpacing" Value="-1.28" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- 노트, 이 날의 할 일: a section heading with its count beside it. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- 최근, 화면, 데이터: a smaller heading inside a page. -->
  <Style Selector="TextBlock.subhead">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="TextBlock.count">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.empty">
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Text2}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Margin" Value="24,40" />
  </Style>

  <!-- No scroll bar in the gutter: a phone list scrolls under the finger, and the bar only took
       width from the right edge of every row. -->
  <Style Selector="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
  </Style>

  <!--
    One template for every button: a content presenter and nothing else. Fluent's own paints a
    grey hover and a pressed fill over whatever the button asked for, which on a touch screen
    lingers after the finger has gone. A press dims instead. The presenter keeps Fluent's name so a
    style that reaches into it (the Apple button) still finds it.
  -->
  <Style Selector="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          FontSize="{TemplateBinding FontSize}"
                          FontWeight="{TemplateBinding FontWeight}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- A 44-point square around an icon. -->
  <Style Selector="Button.iconbtn">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>
  <!-- A row the width of the page: the whole row takes the tap, its content lays itself out. -->
  <Style Selector="Button.row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- The account page's actions, kept from the old card: filled and quiet, full width. -->
  <Style Selector="Button.solid">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Mobile.Pri}" />
    <Setter Property="Foreground" Value="{DynamicResource Mobile.OnPri}" />
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Mobile.Seg}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Mobile.Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- A pill: a tag chip, a recent search, a theme or language choice, a month in the sheet. -->
  <Style Selector="Button.pill">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="99" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Mobile.Seg}" />
  </Style>
  <Style Selector="Button.pill.small">
    <Setter Property="Height" Value="34" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.pill.month">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.pill.sun">
    <Setter Property="Background" Value="{DynamicResource Mobile.SunSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Mobile.SunInk}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.pill.on">
    <Setter Property="Background" Value="{DynamicResource Mobile.Pri}" />
    <Setter Property="Foreground" Value="{DynamicResource Mobile.OnPri}" />
  </Style>
  <Style Selector="Button.pill TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Mobile.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Stroke2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <!-- The account page's grouped blocks. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Mobile.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Stroke2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <!-- A hairline under a list row. -->
  <Style Selector="Border.rule">
    <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Stroke2}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- The to-do checkbox: a 22-point rounded square, filled when done. -->
  <Style Selector="Button.check">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="-11,-11,-11,-11" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.checkbox">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Text3}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.checkbox.checked">
    <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Pri}" />
    <Setter Property="Background" Value="{DynamicResource Mobile.Pri}" />
  </Style>
  <Style Selector="TextBlock.todo.done">
    <Setter Property="TextDecorations" Value="Strikethrough" />
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
  </Style>
  <Style Selector="TextBlock.due">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Mobile.SunInk}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="TextBlock.due.overdue">
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Danger}" />
  </Style>

  <!-- Text entry: a quiet box for the account page, and a bare one for the editor and the search. -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Mobile.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource Mobile.Sun}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Mobile.SunSoft}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Mobile.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[TextBox].BorderBrush}" />
    <Setter Property="BorderThickness" Value="{Binding $parent[TextBox].BorderThickness}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Pri}" />
    <Setter Property="BorderThickness" Value="{Binding $parent[TextBox].BorderThickness}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[TextBox].BorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource Mobile.Text}" />
  </Style>
  <Style Selector="TextBox.bare">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
