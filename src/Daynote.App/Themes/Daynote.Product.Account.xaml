<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ==== Account surfaces ("Daynote Account.dc.html" + the v3 titlebar avatar) ====
         Three places share these styles: the round avatar in the titlebar, the menu that drops from
         it, and the account window. Kept in one dictionary because the avatar, the plan pill and the
         status dot have to look identical wherever they appear — the titlebar avatar and the window's
         identity row are the same object at two sizes. -->
    <sys:Double x:Key="Daynote.Product.Size.AccountWindow.Width">520</sys:Double>
    <sys:Double x:Key="Daynote.Product.Size.AccountMenu.Width">290</sys:Double>

    <!-- ── Avatar: an accent disc with one letter. Size is set per use (34 titlebar, 38 menu, 40 row). ── -->
    <Style x:Key="Daynote.Product.Style.Account.Avatar" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.AvatarText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The titlebar button the avatar sits in. Its own style because Button.Round targets Button
         and this has to be a ToggleButton: the menu's open state belongs to the button, so there is
         no third place holding "is the menu showing". -->
    <Style x:Key="Daynote.Product.Style.Account.AvatarButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="17">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <!-- Open: a ring, so the button reads as pressed while the menu is on screen. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Sync dot: the badge on the titlebar avatar, and the same dot inside the menu row.
         Green while it is working, amber while it wants attention, muted otherwise. The dot is the
         only sync indicator in the titlebar now, which is why it carries a 2px ring in the window
         background — without it the dot dissolves into whatever is behind the avatar. ── -->
    <Style x:Key="Daynote.Product.Style.Account.SyncDot" TargetType="Ellipse">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,-1,-1" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.Bg1}" />
        <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status.Kind}" Value="Synced">
                <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Ok}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.Kind}" Value="Syncing">
                <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.Kind}" Value="Pending">
                <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.NeedsAttention}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Warn}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- The same dot without the ring, for use on a flat card. -->
    <Style x:Key="Daynote.Product.Style.Account.SyncDot.Flat" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status.Kind}" Value="Synced">
                <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Ok}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.Kind}" Value="Syncing">
                <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.Kind}" Value="Pending">
                <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.NeedsAttention}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Warn}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Plan pill. Filled accent for a running subscription, tinted for everything else, so the
         paid state is the only one that reads as a badge rather than a label. ── -->
    <Style x:Key="Daynote.Product.Style.Account.PlanPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlanPaid}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPlanAttention}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.WarnSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.PlanPillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlanPaid}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPlanAttention}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Warn}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Status banner. Accent while it is a countdown, danger once something actually failed. ── -->
    <Style x:Key="Daynote.Product.Style.Account.Banner" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Daynote.Product.Radius.SettingsCard}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBannerUrgent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.DangerSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.DangerSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.BannerTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBannerUrgent}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Monthly / yearly picker: two buttons in a recessed tray, the selected one lifted onto the
         card color. A ToggleButton pair would carry a checked state nobody can see; the selection is
         bound, so plain buttons keep the state in one place. ── -->
    <Style x:Key="Daynote.Product.Style.Account.SegTray" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.SegButton" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- A ToggleButton rather than a Button so the selected interval can drive a
                             typed IsChecked trigger. Tag would arrive as the string "True" and never
                             match, which is exactly the bug that made both segments look unselected. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── The price, and the line under it. ── -->
    <Style x:Key="Daynote.Product.Style.Account.Price" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="29" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.PriceUnit" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="6,0,0,4" />
    </Style>
    <!-- "31% 절약" next to the yearly price. -->
    <Style x:Key="Daynote.Product.Style.Account.SavingPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.OkSoft}" />
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="8,0,0,4" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.SavingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Ok}" />
    </Style>

    <!-- ── A feature line: ticked disc, then the text. ── -->
    <Style x:Key="Daynote.Product.Style.Account.FeatureText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ── Detail rows in the subscription card: fixed-width label, then the value. ── -->
    <Style x:Key="Daynote.Product.Style.Account.RowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="Width" Value="106" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.RowValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
    </Style>

    <!-- ── The signed-out hero: app mark, headline, lead. ── -->
    <Style x:Key="Daynote.Product.Style.Account.HeroMark" TargetType="Border">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{DynamicResource Daynote.Product.Effect.CardShadow}" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.HeroTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.HeroLead" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,7,0,0" />
    </Style>
    <!-- Google's own button: white card, its four-color mark, never restyled to the accent. -->
    <Style x:Key="Daynote.Product.Style.Account.GoogleButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="10" Padding="0,12"
                            Background="{DynamicResource Daynote.Product.Brush.Card}"
                            BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The Google "G", drawn as its four brand segments. -->
    <Geometry x:Key="Daynote.Product.Geo.GoogleBlue">M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92a8.78 8.78 0 0 0 2.68-6.62Z</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.GoogleGreen">M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.84.86-3.04.86a5.33 5.33 0 0 1-5-3.68H1v2.34A9 9 0 0 0 9 18Z</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.GoogleYellow">M4 10.74a5.4 5.4 0 0 1 0-3.48V4.96H1a9 9 0 0 0 0 8.08L4 10.74Z</Geometry>
    <!-- Brand colors live with the palettes (Daynote.Product.Light/Dark.xaml) because raw ARGB
         belongs there; these four are identical in both themes, like the post-it yellow. -->
    <Geometry x:Key="Daynote.Product.Geo.GoogleRed">M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.59A9 9 0 0 0 1 4.96l3 2.3A5.33 5.33 0 0 1 9 3.58Z</Geometry>

    <!-- A perk tile on the signed-out screen. -->
    <Style x:Key="Daynote.Product.Style.Account.Perk" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.PerkTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Account.PerkDesc" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
</ResourceDictionary>
