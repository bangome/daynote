<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    INTERNET is the only permission Daynote asks for, and only cloud sync uses it. No storage
    permission: attachments arrive through the document picker, which grants access per file, and no
    notification permission until there is something to notify about.
  -->
  <uses-permission android:name="android.permission.INTERNET" />

  <application android:label="Daynote"
               android:icon="@mipmap/ic_launcher"
               android:roundIcon="@mipmap/ic_launcher_round"
               android:allowBackup="true"
               android:supportsRtl="true">
    <!--
      Hands an attachment to the app that views it (a PDF reader, a gallery) as a content URI with
      read access for that app only. Serves one cache folder and nothing else; see
      Resources/xml/daynote_file_paths.xml.
    -->
    <provider android:name="androidx.core.content.FileProvider"
              android:authorities="cc.arachat.daynote.files"
              android:exported="false"
              android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                 android:resource="@xml/daynote_file_paths" />
    </provider>
  </application>

  <!--
    Android 11 and later hide other packages from an app unless it declares which it needs. Without
    this the Custom Tab cannot resolve a browser and sign-in would silently do nothing.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>
</manifest>
