<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product">

    <!--
      Control styles for "Daynote Desktop B", transcribed from the Avalonia shell's
      Daynote.Styles.axaml so the two Windows shells draw the same controls.

      Avalonia states a control's states as selectors on classes — Button.navitem.active. WPF has no
      classes, so each of those becomes a keyed Style with triggers, and a call site says which
      binding turns a state on through product:DeskVisual.IsActive. The radius arrives the same way,
      because Control has no CornerRadius of its own.

      Every button the design draws is a plain box: a fill, maybe a border, a radius, a hover wash.
      They all run on the bare template below rather than the system one, whose per-state chrome
      would otherwise have to be undone one trigger at a time.
    -->

    <!-- ── The bare button ──────────────────────────────────────────────────────────────── -->

    <ControlTemplate x:Key="Daynote.Desk.Template.Bare" TargetType="ButtonBase">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{Binding (product:DeskVisual.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Daynote.Desk.Button.Bare" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource Daynote.Desk.Template.Bare}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
    </Style>

    <!-- ── Type ─────────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="Daynote.Desk.Text.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
    </Style>
    <Style x:Key="Daynote.Desk.Text.Faint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
    </Style>
    <Style x:Key="Daynote.Desk.Text.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style x:Key="Daynote.Desk.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Desk.Font.Mono}" />
    </Style>
    <Style x:Key="Daynote.Desk.Text.Empty" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="Daynote.Desk.Text.Done" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>

    <!-- The due chip's ink: sun normally, danger once the day has passed (the call site binds
         Overdue through DeskVisual.IsActive). -->
    <Style x:Key="Daynote.Desk.Text.Due" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.SunInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="product:DeskVisual.IsActive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Stroked line icons, always inside a button: every consumer sets only Data (and a size when
         it scales). The stroke follows the button's Foreground, so a hover or an active state that
         changes the button's ink reaches the mark. -->
    <Style x:Key="Daynote.Desk.Style.Icon" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Surfaces ─────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="Daynote.Desk.Style.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- A dialog card over the scrim: the account, the palette. -->
    <Style x:Key="Daynote.Desk.Style.Modal" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Effect" Value="{DynamicResource Daynote.Desk.Shadow.Pop}" />
    </Style>

    <Style x:Key="Daynote.Desk.Style.Scrim" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Scrim.Modal}" />
    </Style>

    <!-- A pill of text: "오늘", the plan badge. The design's sun-soft chip. -->
    <Style x:Key="Daynote.Desk.Style.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.SunSoft}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,1" />
    </Style>
    <Style x:Key="Daynote.Desk.Text.Chip" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.SunInk}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Daynote.Desk.Style.Kind" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.SunSoft}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style x:Key="Daynote.Desk.Style.Keycap" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,1" />
    </Style>

    <!-- ── Buttons on the page ──────────────────────────────────────────────────────────── -->

    <!-- Outlined text button: the account card's secondary actions, "더 보기". -->
    <Style x:Key="Daynote.Desk.Button.Quiet" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="product:DeskVisual.CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary: the design's pri fill (navy in light, orange in dark). -->
    <Style x:Key="Daynote.Desk.Button.Accent" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="product:DeskVisual.CornerRadius" Value="9" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.Pri}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.OnPri}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A 34px square ghost (the editor's favourite, post-it and delete). -->
    <Style x:Key="Daynote.Desk.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="product:DeskVisual.CornerRadius" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Daynote.Desk.Button.GhostDanger" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Ghost}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Daynote.Desk.Button.GhostSmall" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Ghost}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="product:DeskVisual.CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
    </Style>

    <Style x:Key="Daynote.Desk.Button.GhostOutlined" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Ghost}">
        <Setter Property="product:DeskVisual.CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- The favourite star: an outline in Text2 until it is one, then filled sun. IsActive carries
         the note's IsFavorite. -->
    <Style x:Key="Daynote.Desk.Style.Star" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="StrokeThickness" Value="0.9" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="product:DeskVisual.IsActive" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource Daynote.Desk.Brush.Sun}" />
                <Setter Property="Fill" Value="{DynamicResource Daynote.Desk.Brush.Sun}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text that acts as a link: the timeline's titles and expanders, "+ 추가", "삭제". -->
    <Style x:Key="Daynote.Desk.Button.Link" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.SunInk}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Daynote.Desk.Button.LinkSun" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Link}">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.SunInk}" />
    </Style>

    <Style x:Key="Daynote.Desk.Button.LinkFaint" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A clickable row that only washes on hover (todo rows, tag notes, palette rows, file rows). -->
    <Style x:Key="Daynote.Desk.Button.Row" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="product:DeskVisual.CornerRadius" Value="9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A card that is itself the button (favourites). -->
    <Style x:Key="Daynote.Desk.Button.Card" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="product:DeskVisual.CornerRadius" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      The round to-do check: an outline in Text3, filled with the primary when done. The tick inside
      is drawn only in the ticked state, which the template hides rather than the call site, so a row
      states the check once.
    -->
    <Style x:Key="Daynote.Desk.Button.Check" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Bare}">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="product:DeskVisual.CornerRadius" Value="9" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.OnPri}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Opacity" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Checked}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.Pri}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Desk.Brush.Pri}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Daynote.Desk.Button.CheckLarge" TargetType="Button" BasedOn="{StaticResource Daynote.Desk.Button.Check}">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="product:DeskVisual.CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1.6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The tick: invisible until the item is ticked. -->
    <Style x:Key="Daynote.Desk.Style.CheckMark" TargetType="Path" BasedOn="{StaticResource Daynote.Desk.Style.Icon}">
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Checked}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
