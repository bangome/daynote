<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:account="using:Daynote.App.Account"
             xmlns:vm="using:Daynote.Mobile.ViewModels"
             x:Class="Daynote.Mobile.Views.AccountPanel"
             x:Name="Root"
             x:DataType="account:AccountViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <!-- Apple's button styles: black on a light screen, white on a dark one. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppleButtonBackground" Color="#000000" />
          <SolidColorBrush x:Key="AppleButtonForeground" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppleButtonBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppleButtonForeground" Color="#000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Apple's guidelines let a custom button keep its colours in every state, so the template's
         hover and pressed brushes are pinned rather than left to the theme. -->
    <Style Selector="Button.apple">
      <Setter Property="Foreground" Value="{DynamicResource AppleButtonForeground}" />
    </Style>
    <Style Selector="Button.apple /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppleButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AppleButtonForeground}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.apple:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppleButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AppleButtonForeground}" />
    </Style>
    <Style Selector="Button.apple:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppleButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AppleButtonForeground}" />
    </Style>
  </UserControl.Styles>
  <!--
    The cloud account on a phone: sign in when signed out, otherwise the sync state, the optional
    note lock and the subscription. Same view model as the desktop panel, so a change to what an
    account can do reaches both; the layout is a single column of cards, and the subscription is
    read-only here - see the note on the upgrade row.
  -->
  <StackPanel Spacing="14">

    <!-- After a sign-in from this device's own notes: bring them along, or leave them here
         (docs/PROFILES.md §5.2). Asked once, and only when there is something to move. -->
    <Border Classes="panel" Padding="14,12" IsVisible="{Binding IsChoosingHandOff}">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" TextWrapping="Wrap" Text="{Binding #Root.Strings[ProfileMoveTitle]}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding HandOffMessage}" />
        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="accent" HorizontalAlignment="Stretch"
                Content="{Binding #Root.Strings[ProfileMoveConfirm]}" Command="{Binding MoveLocalNotesCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Classes="quiet" HorizontalAlignment="Stretch"
                Content="{Binding #Root.Strings[ProfileMoveKeep]}" Command="{Binding KeepLocalNotesCommand}"
                IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Border>

    <!-- The account is gone on the server: keep its notes here as local notes, or remove them
         (docs/PROFILES.md §5.5). -->
    <Border Classes="panel" Padding="14,12" IsVisible="{Binding IsChoosingDeletedNotes}">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" TextWrapping="Wrap" Text="{Binding #Root.Strings[DeletedNotesTitle]}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding DeletedNotesMessage}" />
        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="accent" HorizontalAlignment="Stretch"
                Content="{Binding #Root.Strings[DeletedNotesKeep]}" Command="{Binding KeepDeletedNotesCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Classes="quiet" HorizontalAlignment="Stretch" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                IsVisible="{Binding !IsConfirmingRemoveDeletedNotes}"
                Content="{Binding #Root.Strings[DeletedNotesRemove]}" Command="{Binding RemoveDeletedNotesCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <!-- After the server delete this device holds the only copy: removing it is asked twice. -->
        <Border Classes="panel" Padding="12,10" IsVisible="{Binding IsConfirmingRemoveDeletedNotes}"
                Background="{DynamicResource Daynote.Product.Brush.DangerSoft}">
          <StackPanel Spacing="10">
            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding RemoveDeletedNotesMessage}" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="40"
                    Background="{DynamicResource Daynote.Product.Brush.Danger}" Foreground="White"
                    Content="{Binding #Root.Strings[DeletedNotesRemoveConfirm]}" Command="{Binding RemoveDeletedNotesCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Classes="quiet" HorizontalAlignment="Stretch"
                    Content="{Binding #Root.Strings[DeletedNotesRemoveCancel]}" Command="{Binding CancelRemoveDeletedNotesCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <TextBlock Classes="muted" FontSize="12.5" TextAlignment="Center" IsVisible="{Binding IsSwitchingProfile}"
               Text="{Binding #Root.Strings[ProfileSwitching]}" />

    <!-- The switch could not finish (the open note would not save). The next start opens the new
         profile; this is the way to try again now. -->
    <StackPanel Spacing="8" IsVisible="{Binding IsProfileSwitchStalled}">
      <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                 Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Button Classes="accent" HorizontalAlignment="Stretch"
              Content="{Binding #Root.Strings[ProfileSwitchRetry]}" Command="{Binding RetryProfileSwitchCommand}" />
    </StackPanel>

    <!-- Signed out -->
    <StackPanel Spacing="12" IsVisible="{Binding ShowsSignIn}">
      <TextBlock Classes="muted" FontSize="12.5" Text="{Binding #Root.Strings[AccountSignInLeadMobile]}" />
      <StackPanel Spacing="10">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding #Root.Strings[AccountPerkSyncTitle]}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Classes="muted" Text="{Binding #Root.Strings[AccountPerkSyncDescMobile]}" FontSize="12" />
        </StackPanel>
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding #Root.Strings[AccountPerkLockTitle]}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Classes="muted" Text="{Binding #Root.Strings[AccountPerkLockDesc]}" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <TextBlock FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap"
                 Text="{Binding NoticeMessage}"
                 IsVisible="{Binding NoticeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <!-- Sign in with Apple first and just as large: App Store 4.8 wants it offered on equal terms
           beside Google, and Apple's guidelines ask for its logo with an approved title. Only on iOS. -->
      <StackPanel Spacing="6" IsVisible="{Binding CanSignInWithApple}">
        <Button Classes="apple" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                MinHeight="44" Command="{Binding SignInWithAppleCommand}" IsEnabled="{Binding !IsBusy}"
                AutomationProperties.Name="{Binding #Root.Strings[AccountSignInWithApple]}">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Path Width="15" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                  Fill="{Binding $parent[Button].Foreground}"
                  Data="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
            <!-- Bound like the logo: the app-wide TextBlock style would otherwise repaint it in the
                 body colour, which vanishes on the black (or white) button. -->
            <TextBlock Text="{Binding #Root.Strings[AccountSignInWithApple]}" FontWeight="SemiBold" FontSize="15"
                       Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center"
                   Text="{Binding #Root.Strings[AccountAppleOnlyNote]}" />
      </StackPanel>
      <Button Classes="accent" HorizontalAlignment="Stretch"
              Content="{Binding #Root.Strings[AccountSignInWithGoogle]}"
              Command="{Binding SignInCommand}" IsEnabled="{Binding !IsBusy}" />
      <TextBlock Classes="muted" FontSize="12" TextAlignment="Center" IsVisible="{Binding IsBrowserSignInRunning}"
                 Text="{Binding #Root.Strings[AccountSignInBrowserHint]}" />
      <TextBlock FontSize="12" TextAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                 Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <!-- This profile's database names another account (docs/PROFILES.md §4): the way out. -->
      <Button Classes="quiet" HorizontalAlignment="Stretch" IsVisible="{Binding IsOwnerMismatch}"
              Content="{Binding #Root.Strings[ProfileLeaveMismatched]}" Command="{Binding LeaveMismatchedProfileCommand}"
              IsEnabled="{Binding !IsBusy}" />
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
        <Button Classes="quiet" FontSize="12" MinHeight="36" Content="{Binding #Root.Strings[AccountTerms]}"
                Command="{Binding OpenTermsCommand}" />
        <Button Classes="quiet" FontSize="12" MinHeight="36" Content="{Binding #Root.Strings[AccountPrivacy]}"
                Command="{Binding OpenPrivacyCommand}" />
      </StackPanel>
    </StackPanel>

    <!-- Signed in -->
    <StackPanel Spacing="14" IsVisible="{Binding IsSignedIn}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="quiet" Content="{Binding #Root.Strings[AccountSyncNow]}"
                Command="{Binding SyncCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Classes="quiet" Content="{Binding #Root.Strings[AccountSignOut]}"
                Command="{Binding SignOutCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>

      <TextBlock FontSize="12" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                 Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Signing out: keep this account's notes on the device, or remove them (docs/PROFILES.md
           §5.4). Removing with changes that never synced asks a second time. -->
      <Border Classes="panel" Padding="14,12" IsVisible="{Binding IsChoosingSignOut}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding #Root.Strings[SignOutChoiceTitle]}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding #Root.Strings[SignOutChoiceBody]}" />
          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                     Text="{Binding UnsyncedChangesMessage}" IsVisible="{Binding HasUnsyncedChanges}" />
          <Button Classes="accent" HorizontalAlignment="Stretch"
                  Content="{Binding #Root.Strings[SignOutKeep]}" Command="{Binding SignOutKeepCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <Button Classes="quiet" HorizontalAlignment="Stretch" IsVisible="{Binding !IsConfirmingRemoveUnsynced}"
                  Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                  Content="{Binding #Root.Strings[SignOutRemove]}" Command="{Binding SignOutRemoveCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <Border Classes="panel" Padding="12,10" IsVisible="{Binding IsConfirmingRemoveUnsynced}"
                  Background="{DynamicResource Daynote.Product.Brush.DangerSoft}">
            <StackPanel Spacing="10">
              <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding RemoveUnsyncedMessage}" />
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="40"
                      Background="{DynamicResource Daynote.Product.Brush.Danger}" Foreground="White"
                      Content="{Binding #Root.Strings[SignOutRemoveConfirm]}" Command="{Binding SignOutRemoveCommand}"
                      IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
          </Border>
          <Button Classes="quiet" HorizontalAlignment="Stretch"
                  Content="{Binding #Root.Strings[SignOutCancel]}" Command="{Binding CancelSignOutCommand}" />
        </StackPanel>
      </Border>

      <!-- Entitlement banner: text only, as on the desktop. -->
      <Border Classes="panel" Padding="14,12" IsVisible="{Binding HasBanner}"
              Background="{DynamicResource Daynote.Product.Brush.DangerSoft}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding BannerTitle}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Classes="muted" Text="{Binding BannerBody}" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- Key missing on this device -->
      <Border Classes="panel" Padding="14,12" IsVisible="{Binding IsKeyMissing}">
        <StackPanel Spacing="10">
          <TextBlock Classes="muted" FontSize="12.5" Text="{Binding #Root.Strings[AccountKeyMissingBlurbMobile]}" />
          <Button Classes="accent" HorizontalAlignment="Stretch"
                  Content="{Binding #Root.Strings[AccountRestoreKey]}" Command="{Binding RestoreKeyCommand}" />
        </StackPanel>
      </Border>

      <!-- Locked -->
      <Border Classes="panel" Padding="14,12" IsVisible="{Binding IsLocked}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding #Root.Strings[AccountUnlockTitle]}" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding #Root.Strings[AccountUnlockBlurbMobile]}" />
          <TextBox x:Name="UnlockPassphraseBox" PasswordChar="•" IsVisible="{Binding !IsUsingRecoveryKey}"
                   PlaceholderText="{Binding #Root.Strings[AccountPassphrase]}" />
          <TextBox Text="{Binding RecoveryKeyEntry}" IsVisible="{Binding IsUsingRecoveryKey}"
                   PlaceholderText="{Binding #Root.Strings[AccountRecoveryKeyLabel]}" />
          <Button Classes="accent" HorizontalAlignment="Stretch"
                  Content="{Binding #Root.Strings[AccountUnlock]}" Click="OnUnlock" IsEnabled="{Binding !IsBusy}" />
          <Button Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding ToggleRecoveryKeyEntryCommand}"
                  Content="{Binding IsUsingRecoveryKey, Converter={x:Static vm:MobileConverters.UnlockMethodLabel}}" />
        </StackPanel>
      </Border>

      <!-- Lock settings -->
      <Border Classes="panel" Padding="14,12" IsVisible="{Binding !IsLocked}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding #Root.Strings[AccountLockTitle]}" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding #Root.Strings[AccountLockBlurbMobile]}" />
          <Button Classes="quiet" HorizontalAlignment="Stretch" IsVisible="{Binding !IsLockEnabled}"
                  Content="{Binding #Root.Strings[AccountLockEnable]}" Command="{Binding ToggleEnableLockCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <Button Classes="quiet" HorizontalAlignment="Stretch" IsVisible="{Binding IsLockEnabled}"
                  Content="{Binding #Root.Strings[AccountLockDisable]}" Command="{Binding DisableLockCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <StackPanel Spacing="8" IsVisible="{Binding IsEnablingLock}">
            <TextBox x:Name="NewPassphraseBox" PasswordChar="•"
                     PlaceholderText="{Binding #Root.Strings[AccountPassphrase]}" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding PassphraseHint}" />
            <Button Classes="accent" HorizontalAlignment="Stretch"
                    Content="{Binding #Root.Strings[AccountLockConfirm]}" Click="OnEnableLock" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="quiet" HorizontalAlignment="Stretch"
                    Content="{Binding #Root.Strings[AccountLockCancel]}" Command="{Binding ToggleEnableLockCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- One-time recovery key -->
      <Border Classes="panel" Padding="14,12" IsVisible="{Binding IsShowingRecoveryKey}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding #Root.Strings[RecoveryKeyTitle]}" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding #Root.Strings[RecoveryKeyBlurb]}" />
          <SelectableTextBlock Text="{Binding RecoveryKeyDisplay}" FontFamily="Menlo, monospace" FontSize="14" TextWrapping="Wrap" />
          <Button Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding CopyRecoveryKeyCommand}"
                  Content="{Binding RecoveryKeyCopied, Converter={x:Static vm:MobileConverters.CopyLabel}}" />
          <Button Classes="quiet" HorizontalAlignment="Stretch"
                  Content="{Binding #Root.Strings[RecoveryKeySaveToFile]}" Command="{Binding SaveRecoveryKeyCommand}" />
          <CheckBox IsChecked="{Binding RecoveryKeyAcknowledged}" FontSize="12.5"
                    Content="{Binding #Root.Strings[RecoveryKeyConfirm]}" />
          <Button Classes="accent" HorizontalAlignment="Stretch"
                  Content="{Binding #Root.Strings[RecoveryKeyDone]}" Command="{Binding DismissRecoveryKeyCommand}"
                  IsEnabled="{Binding RecoveryKeyAcknowledged}" />
        </StackPanel>
      </Border>

      <!-- Conflict copies -->
      <Border Classes="panel" Padding="14,12" IsVisible="{Binding HasReplacedNotes}">
        <TextBlock Classes="muted" FontSize="12.5" Text="{Binding ReplacedNotesMessage}" />
      </Border>

      <!-- Subscription, read only.
           Deliberately without a checkout button: Apple and Google require their own in-app purchase
           for a digital subscription, so offering the web checkout here would have the app rejected.
           What a subscriber already has is still shown, because reading it is not selling it. -->
      <Border Classes="panel" Padding="14,12" IsVisible="{Binding ShowSubscription}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="{Binding #Root.Strings[BillingDetailTitle]}" />
          <TextBlock FontSize="13" Text="{Binding SubscriptionPlanText}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="muted" FontSize="12.5" Text="{Binding #Root.Strings[BillingRowState]}" />
            <TextBlock FontSize="12.5" Text="{Binding SubscriptionStateText}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSubscriptionDate}">
            <TextBlock Classes="muted" FontSize="12.5" Text="{Binding SubscriptionDateLabel}" />
            <TextBlock FontSize="12.5" Text="{Binding SubscriptionDateText}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Deleting the account: asked, then done. Last on the page, away from Sign out. -->
      <Button Classes="quiet" HorizontalAlignment="Stretch" IsVisible="{Binding !IsConfirmingDelete}"
              Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
              Content="{Binding #Root.Strings[AccountDelete]}" Command="{Binding BeginDeleteAccountCommand}"
              IsEnabled="{Binding !IsBusy}" />
      <Border Classes="panel" Padding="14,12" IsVisible="{Binding IsConfirmingDelete}"
              Background="{DynamicResource Daynote.Product.Brush.DangerSoft}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding #Root.Strings[AccountDeleteTitle]}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding #Root.Strings[AccountDeleteBody]}" />
          <!-- The failure is said here, next to the button that caused it, not at the top of a long page. -->
          <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                     Text="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="40"
                  Background="{DynamicResource Daynote.Product.Brush.Danger}" Foreground="White"
                  Content="{Binding #Root.Strings[AccountDeleteConfirm]}" Command="{Binding DeleteAccountCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <Button Classes="quiet" HorizontalAlignment="Stretch"
                  Content="{Binding #Root.Strings[AccountDeleteCancel]}" Command="{Binding CancelDeleteAccountCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
