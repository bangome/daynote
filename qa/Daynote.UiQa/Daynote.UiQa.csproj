<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- UseWPF gives us the UI Automation client (UIAutomationClient/UIAutomationTypes) and the
         PngBitmapEncoder used for evidence screenshots without adding any NuGet dependency. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>Daynote.UiQa</RootNamespace>
    <AssemblyName>Daynote.UiQa</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Daynote.Core\Daynote.Core.csproj" />
    <ProjectReference Include="..\..\src\Daynote.Infrastructure\Daynote.Infrastructure.csproj" />
  </ItemGroup>
</Project>
