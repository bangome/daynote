    <Color x:Key="Daynote.Color.Surface.Secondary">#FFF2F4F7</Color>
    <Color x:Key="Daynote.Color.Surface.Hover">#FFECEFF3</Color>
    <Color x:Key="Daynote.Color.Surface.Pressed">#FFE4E8EE</Color>
    <Color x:Key="Daynote.Color.Surface.Selected">#FFEAF3FB</Color>
    <Color x:Key="Daynote.Color.Surface.Disabled">#FFEFF1F5</Color>
    <Color x:Key="Daynote.Color.Text.Primary">#FF21262E</Color>
    <Color x:Key="Daynote.Color.Text.Secondary">#FF575F6C</Color>
    <Color x:Key="Daynote.Color.Text.Muted">#FF5D6470</Color>
    <Color x:Key="Daynote.Color.Text.Disabled">#FF8E96A3</Color>
    <Color x:Key="Daynote.Color.Border.Subtle">#FFE3E6EB</Color>
    <Color x:Key="Daynote.Color.Border.Strong">#FFC8CED8</Color>
    <Color x:Key="Daynote.Color.Border.Control">#FF6C7583</Color>
    <Color x:Key="Daynote.Color.Accent.100">#FFEAF3FB</Color>
