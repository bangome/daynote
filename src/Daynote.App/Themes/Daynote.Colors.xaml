    <SolidColorBrush x:Key="Daynote.Brush.Surface.Selected" Color="{StaticResource Daynote.Color.Surface.Selected}" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Brush.Surface.Disabled" Color="{StaticResource Daynote.Color.Surface.Disabled}" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Brush.Text.Primary" Color="{StaticResource Daynote.Color.Text.Primary}" po:Freeze="True" />
