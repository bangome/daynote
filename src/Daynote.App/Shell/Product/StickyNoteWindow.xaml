<Window
    x:Class="Daynote.App.Shell.Product.StickyNoteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    Title="{Binding Shell.Notes.SelectedTab.Title}"
    Width="320" Height="260" MinWidth="220" MinHeight="160"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None" ResizeMode="CanResize"
    Topmost="True"
    FontFamily="{DynamicResource Daynote.Product.Font.UI}"
    Foreground="{DynamicResource Daynote.Product.Brush.StickyText}"
    UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
    AutomationProperties.Name="{Binding Shell.Notes.SelectedTab.Title}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        Background="{DynamicResource Daynote.Product.Brush.Sticky}"
        BorderBrush="{DynamicResource Daynote.Product.Brush.StickyStroke}"
        BorderThickness="1"
        CornerRadius="6"
        Effect="{DynamicResource Daynote.Product.Effect.DropdownShadow}"
        ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    Text="{Binding Shell.Notes.SelectedTab.Title}"
                    FontSize="{DynamicResource Daynote.Product.Type.Item}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.Name="{Binding Shell.Notes.SelectedTab.Title}" />
                <Button
                    x:Name="PinButton"
                    Grid.Column="1"
                    Width="30" Height="30"
                    Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                    Click="OnToggleTopmost"
                    ToolTip="{Binding PinToolTip}"
                    AutomationProperties.Name="{Binding PinToolTip}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Pin}">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource Daynote.Product.Style.Icon.Stroked}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button
                    x:Name="CloseButton"
                    Grid.Column="2"
                    Width="30" Height="30"
                    Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                    Click="OnClose"
                    ToolTip="{loc:Tr CloseStickyNote}"
                    AutomationProperties.Name="{loc:Tr CloseStickyNote}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="12" Height="12" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Close}"
                          Style="{DynamicResource Daynote.Product.Style.Icon.Stroked}" />
                </Button>
            </Grid>

            <TextBox
                x:Name="BodyText"
                Grid.Row="1"
                Margin="14,0,14,14"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource Daynote.Product.Brush.StickyText}"
                CaretBrush="{DynamicResource Daynote.Product.Brush.StickyText}"
                Text="{Binding Shell.Notes.EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                FontFamily="{DynamicResource Daynote.Product.Font.Mono}"
                FontSize="{DynamicResource Daynote.Product.Type.Editor}"
                TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" SpellCheck.IsEnabled="False"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.Name="{loc:Tr StickyNoteBody}" />
        </Grid>
    </Border>
</Window>
