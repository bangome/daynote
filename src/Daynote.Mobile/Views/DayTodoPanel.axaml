<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daynote.Mobile.ViewModels"
             xmlns:views="using:Daynote.Mobile.Views"
             xmlns:motion="using:Daynote.Motion"
             x:Class="Daynote.Mobile.Views.DayTodoPanel"
             x:DataType="vm:MobileShellViewModel">
  <!--
    The tablet's day panel (Daynote Tablet T1-T4): this date's to-dos down the right, beside the day
    or the note being written, which is why a to-do made with @ is confirmed here the way the
    desktop confirms it - it slides in (motion spec M2) - and one made for another date says so in a
    line at the top that opens its own room (M4).
  -->
  <Border Width="300" Background="{DynamicResource Mobile.Panel}" BorderBrush="{DynamicResource Mobile.Stroke2}"
          BorderThickness="1,0,0,0">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16,14,16,24">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,10">
          <TextBlock FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Bottom" Text="{Binding Strings[DeskDayTodoTitle]}" />
          <TextBlock x:Name="LeftCount" Classes="faint" FontSize="12.5" VerticalAlignment="Bottom" Margin="0,0,0,1" />
        </StackPanel>

        <!-- M4: "10/8에 추가됨 · 보기", in the layout and not floating over it. -->
        <Border x:Name="Notice" Classes="notice" IsVisible="False" ClipToBounds="True">
          <Grid ColumnDefinitions="*,Auto" Margin="12,0">
            <TextBlock x:Name="NoticeText" Grid.Column="0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Mobile.SunInk}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Height="32" Padding="8,0" Click="OnNoticeView">
              <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Mobile.SunInk}"
                         Text="{Binding Strings[MobileNoteItemsView]}" />
            </Button>
          </Grid>
        </Border>

        <Border Classes="card" Padding="6,4" x:Name="OpenCard">
          <ItemsControl x:Name="OpenList" motion:RowArrivals.IsEnabled="True" motion:RowArrivals.Context="{Binding SelectedDate}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TodoRowViewModel">
                <Panel Classes="todorow">
                  <Border Classes="rowflash" Margin="-2,0" />
                  <Grid Classes="rowcontent" ColumnDefinitions="22,*,Auto" MinHeight="44" Margin="8,0">
                    <views:TodoCheck Grid.Column="0" IsChecked="{Binding Item.Checked}" Toggle="{Binding Item.ToggleCommand}" />
                    <Button Grid.Column="1" Classes="row" Margin="12,0,0,0" MinHeight="44" HorizontalContentAlignment="Left"
                            Command="{Binding Item.JumpCommand}">
                      <Panel HorizontalAlignment="Left">
                        <TextBlock Classes="todo line" Classes.done="{Binding Item.Checked}" FontSize="14.5" Text="{Binding Item.Text}" />
                        <Border Classes="strike" />
                      </Panel>
                    </Button>
                    <TextBlock Grid.Column="2" Classes="due" Classes.overdue="{Binding Item.Overdue}" Margin="10,0,0,0"
                               VerticalAlignment="Center" Text="{Binding Item.DueLabel}" IsVisible="{Binding Item.HasDue}" />
                  </Grid>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <TextBlock x:Name="Empty" Classes="faint" FontSize="13" Margin="4,8,4,0" TextWrapping="Wrap"
                   Text="{Binding Strings[MobileWideNoTodos]}" />

        <!-- What was finished, folded behind its count the way the desktop folds it. -->
        <Button x:Name="DoneToggle" Classes="row" Margin="2,10,0,0" HorizontalContentAlignment="Left" Click="OnDoneToggle">
          <TextBlock x:Name="DoneLabel" Classes="faint" FontSize="13" FontWeight="Bold" />
        </Button>
        <ItemsControl x:Name="DoneList" IsVisible="False" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodoRowViewModel">
              <Grid Classes="todorow" ColumnDefinitions="22,*" MinHeight="44" Margin="14,0,8,0">
                <views:TodoCheck Grid.Column="0" IsChecked="{Binding Item.Checked}" Toggle="{Binding Item.ToggleCommand}" />
                <TextBlock Grid.Column="1" Classes="todo line done" Margin="12,0,0,0" FontSize="14.5" VerticalAlignment="Center"
                           Text="{Binding Item.Text}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Border>

  <UserControl.Styles>
    <Style Selector="Border.notice">
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="{DynamicResource Mobile.SunSoft}" />
    </Style>
  </UserControl.Styles>
</UserControl>
