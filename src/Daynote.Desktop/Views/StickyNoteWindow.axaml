<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Daynote.Desktop.ViewModels"
        xmlns:views="using:Daynote.Desktop.Views"
        x:Class="Daynote.Desktop.Views.StickyNoteWindow"
        x:DataType="vm:DesktopShellViewModel"
        Title="{Binding Notes.SelectedTab.Title, FallbackValue=Daynote}"
        Width="272" Height="260" MinWidth="220" MinHeight="160"
        Topmost="True"
        CanMaximize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Daynote.Product.Brush.Sticky}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="34">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.StickyText}" />
    </Style>
    <!-- The design's post-it: #FFE99A paper, dark-olive ink, 13px at a 1.7 line height. -->
    <Style Selector="TextBox.sticky">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.StickyText}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Daynote.Product.Brush.StickyText}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="22.1" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBox.sticky:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.sticky:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 22px squares at 60% until hovered, as the design's close cross is. -->
    <Style Selector="Button.stickybtn">
      <Setter Property="Theme" Value="{StaticResource Daynote.Bare}" />
      <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.StickyText}" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.stickybtn:pointerover">
      <Setter Property="Background" Value="#0F000000" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The shared line marks, not the 📌 and ✕ this row used to carry: a colour emoji that ignored
         the note's ink and a maths character that sat off the button's centre. Both are stroked in
         the sticky text colour, so they belong to the paper rather than to the system font. -->
    <Style Selector="Button.stickybtn Path">
      <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.StickyText}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Fill" Value="{x:Null}" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <!-- Pinned is the note's one piece of state, so the pin is filled when it is on rather than
         merely less faded, which is what the opacity swap used to say. -->
    <Style Selector="Button.stickybtn.pinned Path">
      <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.StickyText}" />
    </Style>
  </Window.Styles>
  <!-- The left inset clears the macOS traffic lights drawn over the extended client area, and is
       applied from the code-behind because Windows has nothing there — the same split as
       MainWindow.Chrome.cs. Hard-coding the macOS value left a 70px hole in the Windows sticky. -->
  <Grid x:Name="Layout" RowDefinitions="34,*" Margin="16,0,12,16">
    <!-- Background="Transparent" is load-bearing, as in MainWindow: a Grid with no brush takes no
         part in hit testing, so the strip would report client area and the note could not be dragged
         by it. -->
    <Grid x:Name="TitleBarRow" Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Background="Transparent">
      <TextBlock Grid.Column="0" Text="{Binding Notes.SelectedTab.Title, FallbackValue=''}" FontWeight="ExtraBold" FontSize="13"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
      <Button Grid.Column="1" x:Name="PinButton" Classes="stickybtn" Click="OnTogglePin" Margin="0,0,2,0">
        <Path Data="{StaticResource Daynote.Geo.Pin}" />
      </Button>
      <Button Grid.Column="2" x:Name="CloseButton" Classes="stickybtn" Click="OnClose">
        <Path Data="{StaticResource Daynote.Desk.Geo.Close}" Width="10" Height="10" StrokeThickness="1.5" />
      </Button>
    </Grid>
    <TextBox Grid.Row="1" x:Name="Body" Classes="sticky" Margin="0,6,4,0" Text="{Binding Notes.EditorText}" VerticalContentAlignment="Top" />
  </Grid>
</Window>
