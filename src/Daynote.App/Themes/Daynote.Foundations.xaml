<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <Style x:Key="Daynote.Style.IconPresenter" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="{DynamicResource Daynote.Icon.Size.Standard}" />
        <Setter Property="Height" Value="{DynamicResource Daynote.Icon.Size.Standard}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
        <Setter Property="Stroke" Value="{x:Null}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource Daynote.Icon.Stroke}" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="Daynote.Style.IconPresenter.Small" TargetType="{x:Type Path}" BasedOn="{StaticResource Daynote.Style.IconPresenter}">
        <Setter Property="Width" Value="{DynamicResource Daynote.Icon.Size.Small}" />
        <Setter Property="Height" Value="{DynamicResource Daynote.Icon.Size.Small}" />
    </Style>
    <Style x:Key="Daynote.Style.IconPresenter.Large" TargetType="{x:Type Path}" BasedOn="{StaticResource Daynote.Style.IconPresenter}">
        <Setter Property="Width" Value="{DynamicResource Daynote.Icon.Size.Large}" />
        <Setter Property="Height" Value="{DynamicResource Daynote.Icon.Size.Large}" />
    </Style>


    <Style x:Key="Daynote.Style.Type.DateTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.Display}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.DateTitle.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.DateTitle.FontWeight}" />
        <Setter Property="LineHeight" Value="{DynamicResource Daynote.Type.DateTitle.LineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
    </Style>
    <Style x:Key="Daynote.Style.Type.PaneTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.Display}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.PaneTitle.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.PaneTitle.FontWeight}" />
        <Setter Property="LineHeight" Value="{DynamicResource Daynote.Type.PaneTitle.LineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxHeight" Value="{DynamicResource Daynote.Size.PaneTitle.MaxHeight}" />
    </Style>
    <Style x:Key="Daynote.Style.Type.ItemTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.ItemTitle.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.ItemTitle.FontWeight}" />
        <Setter Property="LineHeight" Value="{DynamicResource Daynote.Type.ItemTitle.LineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
    </Style>
    <Style x:Key="Daynote.Style.Type.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Body.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.Body.FontWeight}" />
        <Setter Property="LineHeight" Value="{DynamicResource Daynote.Type.Body.LineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Daynote.Style.Type.Label" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Label.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.Label.FontWeight}" />
        <Setter Property="LineHeight" Value="{DynamicResource Daynote.Type.Label.LineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
    </Style>
    <!-- Mini-calendar month title: quiet 14 SemiBold so the date header stays the only large text (Revision 2026-07-21). -->
    <Style x:Key="Daynote.Style.CalendarMonthTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Label.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.Status.FontWeight}" />
        <Setter Property="LineHeight" Value="{DynamicResource Daynote.Type.Label.LineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Settings card heading: one step above Label so each card announces itself without
         competing with the dialog's PaneTitle. -->
    <Style x:Key="Daynote.Style.Type.SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.SectionTitle.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.SectionTitle.FontWeight}" />
        <Setter Property="LineHeight" Value="{DynamicResource Daynote.Type.SectionTitle.LineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Daynote.Style.Type.Status" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Status.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.Status.FontWeight}" />
        <Setter Property="LineHeight" Value="{DynamicResource Daynote.Type.Status.LineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Muted}" />
    </Style>
</ResourceDictionary>
