<UserControl
    x:Class="Daynote.App.Shell.Product.SearchDropdownView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pvm="clr-namespace:Daynote.App.Shell.Product;assembly=Daynote.Presentation"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance pvm:SearchDropdownViewModel}">
    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Width="480" Margin="0,4,0,0"
        MaxHeight="420" Style="{DynamicResource Daynote.Product.Style.Card}"
        Effect="{DynamicResource Daynote.Product.Effect.DropdownShadow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pvm:SearchResultRowViewModel}">
                            <Button HorizontalContentAlignment="Stretch" Command="{Binding ActivateCommand}"
                                Style="{DynamicResource Daynote.Product.Style.SearchResultButton}" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" MinWidth="38" Background="{DynamicResource Daynote.Product.Brush.AccentSoft}"
                                        CornerRadius="{DynamicResource Daynote.Product.Radius.Chip}" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"
                                            Foreground="{DynamicResource Daynote.Product.Brush.Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                Foreground="{DynamicResource Daynote.Product.Brush.Text}"
                                                product:SearchHighlight.Query="{Binding Query}" product:SearchHighlight.Text="{Binding Title}" />
                                                <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                    Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                                                    product:SearchHighlight.Query="{Binding Query}" product:SearchHighlight.Text="{Binding Sub}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DateLabel}" FontSize="11" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Tr SearchNoResultsRow}" TextAlignment="Center" Margin="14" FontSize="12"
                                    Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                                    Visibility="{Binding NoResults, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
</UserControl>
