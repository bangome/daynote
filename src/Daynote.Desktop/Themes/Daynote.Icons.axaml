<!--
  Line icons, transcribed from the WPF Daynote.Product.Styles.xaml geometries so both shells draw the
  same marks. Each is authored on a 16x16 box (the calendar on 20x20) and stroked, not filled, which
  is why every consumer sets Stroke and leaves Fill null.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StreamGeometry x:Key="Daynote.Geo.Search">M7,2.5 A4.5,4.5 0 1 0 7.01,2.5 M10.5,10.5 L14,14</StreamGeometry>

  <!-- Today: a calendar leaf. Drawn on 20x20, so it is scaled by its Viewbox like the others. -->
  <StreamGeometry x:Key="Daynote.Geo.Today">M2,3 h16 v15 h-16 Z M2,7.5 L18,7.5 M6.5,1.5 L6.5,4.5 M13.5,1.5 L13.5,4.5</StreamGeometry>

  <!-- Timeline: stacked list rows, each a bullet dot plus a line, reading as a vertical feed. -->
  <StreamGeometry x:Key="Daynote.Geo.Timeline">M2,2.5 h1 M5.5,2.5 H14 M2,8 h1 M5.5,8 H14 M2,13.5 h1 M5.5,13.5 H14</StreamGeometry>

  <StreamGeometry x:Key="Daynote.Geo.Settings">M1.5,3.5 H14.5 M1.5,8 H14.5 M1.5,12.5 H14.5 M3,3.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M9,8 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M4,12.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0</StreamGeometry>

  <StreamGeometry x:Key="Daynote.Geo.Moon">M13.5,9.5 A5.8,5.8 0 1 1 6.5,2.5 A4.6,4.6 0 0 0 13.5,9.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Geo.Sun">M8,4.6 A3.4,3.4 0 1 0 8.01,4.6 M8,0.8 L8,2.6 M8,13.4 L8,15.2 M0.8,8 L2.6,8 M13.4,8 L15.2,8 M2.9,2.9 L4.2,4.2 M11.8,11.8 L13.1,13.1 M2.9,13.1 L4.2,11.8 M11.8,4.2 L13.1,2.9</StreamGeometry>

  <!--
    Person. The head is two half-arcs closed with Z, not the `a r,r 0 1 0 0.01,0` trick the WPF
    geometry uses: that trick leaves a seam where the path starts and ends, which at 19px reads as a
    nick in the circle. The shoulders are an arc that stops at the sides rather than curling under,
    so the mark stays a head-and-shoulders and not a face in a bowl.
  -->
  <StreamGeometry x:Key="Daynote.Geo.Person">M8,2.6 a2.9,2.9 0 1 1 0,5.8 a2.9,2.9 0 1 1 0,-5.8 Z M2.6,13.9 a5.4,4.1 0 0 1 10.8,0</StreamGeometry>

  <!--
    Right-rail tabs (14x14): a checkbox with its tick, a tag with its hole, a paperclip. The tag's
    hole is closed with two half-arcs like the person mark, not the `a r,r 0 1 0 0.01,0` trick the WPF
    geometry uses, so it has no seam.
  -->
  <StreamGeometry x:Key="Daynote.Geo.TabTodo">M2,2 H12 V12 H2 Z M4.4,7.2 L6.2,9 L9.6,5</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Geo.TabTag">M1.5,6.2 V2.5 a1,1 0 0 1 1,-1 h3.7 a1.4,1.4 0 0 1 1,0.4 l5,5 a1.4,1.4 0 0 1 0,2 l-3.3,3.3 a1.4,1.4 0 0 1 -2,0 l-5,-5 a1.4,1.4 0 0 1 -0.4,-1 Z M4.6,2.6 a1,1 0 1 1 0,2 a1,1 0 1 1 0,-2 Z</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Geo.TabClip">M4.5,7 L7.7,3.8 a2,2 0 0 1 2.8,2.8 L6,11.1 a3.1,3.1 0 0 1 -4.4,-4.4 L6.3,2</StreamGeometry>

  <!-- Editor-card actions. Star is a closed outline so it can be filled when the note is a
       favourite; the rest are stroked line drawings like everything else here. -->
  <StreamGeometry x:Key="Daynote.Geo.Star">M6,0.8 L7.5,4.2 L11.2,4.6 L8.4,7 L9.2,10.7 L6,8.8 L2.8,10.7 L3.6,7 L0.8,4.6 L4.5,4.2 Z</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Geo.StickyNote">M2,1.5 H14 V10.5 L10.5,14 H2 Z M14,10.5 H10.5 V14 M5,5 H11 M5,8 H9</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Geo.Trash">M2,3.5 h10 M5.5,3.5 V2 h3 v1.5 M3.5,3.5 l0.7,8.5 h5.6 l0.7,-8.5 M5.8,6 v4 M8.2,6 v4</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Geo.Plus">M5,0.5 L5,9.5 M0.5,5 L9.5,5</StreamGeometry>

  <!-- Sticky note: a drawing pin seen head-on, and the close cross. -->
  <StreamGeometry x:Key="Daynote.Geo.Pin">M5,1 L11,1 L10,5 L12,7 L4,7 L6,5 Z M8,7 L8,13</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Geo.Close">M0,0 L10,10 M10,0 L0,10</StreamGeometry>

  <!-- Chevron for the account strip: shallower than a 45-degree caret so it reads as "opens upward"
       rather than as an arrow. -->
  <StreamGeometry x:Key="Daynote.Geo.ChevronUp">M3.5,9.5 L8,5.5 L12.5,9.5</StreamGeometry>
</ResourceDictionary>
