<UserControl
    x:Class="Daynote.App.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:Daynote.App.Settings"
    xmlns:psettings="clr-namespace:Daynote.App.Settings;assembly=Daynote.Presentation"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:account="clr-namespace:Daynote.App.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance settings:SettingsViewModel}">

    <!--
      The settings dialog (Daynote Desktop B): general, shortcuts, data and account down the left,
      one page at a time on the right. Every row the old single-column panel had is here, grouped
      into the design's four sections — language, the tutorial and "about" under general; the MCP
      registration, the storage path and the privacy note under data — so nothing that was settable
      before has gone, and the page no longer scrolls past nine cards to reach one of them.

      The Avalonia shell draws the same dialog from the same view model.
    -->

    <Grid x:Name="SettingsRoot" Background="{DynamicResource Daynote.Product.Brush.Scrim.Modal}">
        <Border Style="{DynamicResource Daynote.Desk.Style.Modal}" Width="760" MaxHeight="560" Margin="24"
                ClipToBounds="True" AutomationProperties.Name="{loc:Tr SettingsTitle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- The four pages. -->
                <Border Grid.Column="0" Background="{DynamicResource Daynote.Product.Brush.Bg1}" Padding="10,20"
                        BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="ExtraBold" Margin="10,0,10,14" Text="{loc:Tr SettingsTitle}" />
                        <Button Style="{DynamicResource Daynote.Desk.Button.SettingsSection}" Margin="0,0,0,2"
                                product:DeskVisual.IsActive="{Binding IsGeneralSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static settings:SettingsSection.General}"
                                Content="{loc:Tr DeskSettingsGeneral}" />
                        <Button Style="{DynamicResource Daynote.Desk.Button.SettingsSection}" Margin="0,0,0,2"
                                product:DeskVisual.IsActive="{Binding IsShortcutsSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static settings:SettingsSection.Shortcuts}"
                                Content="{loc:Tr DeskSettingsShortcuts}" />
                        <Button Style="{DynamicResource Daynote.Desk.Button.SettingsSection}" Margin="0,0,0,2"
                                product:DeskVisual.IsActive="{Binding IsDataSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static settings:SettingsSection.Data}"
                                Content="{loc:Tr DeskSettingsData}" />
                        <Button Style="{DynamicResource Daynote.Desk.Button.SettingsSection}"
                                product:DeskVisual.IsActive="{Binding IsAccountSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static settings:SettingsSection.Account}"
                                Content="{loc:Tr DeskSettingsAccount}"
                                Visibility="{Binding Account, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button x:Name="CloseButton" Grid.Row="0" HorizontalAlignment="Right" Margin="0,14,14,0"
                            Style="{DynamicResource Daynote.Desk.Button.GhostSmall}"
                            ToolTip="{loc:Tr CloseSettings}" AutomationProperties.Name="{loc:Tr CloseSettings}">
                        <Path Style="{DynamicResource Daynote.Desk.Style.Icon}" Data="{DynamicResource Daynote.Desk.Geo.Close}"
                              IsHitTestVisible="False" />
                    </Button>

                    <ScrollViewer Grid.Row="1" Padding="32,0,32,28" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>

                            <!-- ═ 일반 ═ -->
                            <StackPanel Visibility="{Binding IsGeneralSection, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.H1}" Margin="0,0,0,18" Text="{loc:Tr DeskSettingsGeneral}" />

                                <!-- Display language: the segments switch the whole UI live, no restart. -->
                                <Border Style="{DynamicResource Daynote.Desk.Style.SettingsRow}"
                                        AutomationProperties.Name="{loc:Tr SettingsLanguageRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsLabel}" Text="{loc:Tr SettingsLanguageLabel}" />
                                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{loc:Tr SettingsLanguageDesc}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{DynamicResource Daynote.Desk.Style.Segments}" VerticalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding LanguageOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- GroupName ties the segments into one radio group for arrow-key navigation. -->
                                                        <RadioButton GroupName="SettingsLanguage"
                                                                     Style="{DynamicResource Daynote.Desk.Style.Segment}"
                                                                     Content="{Binding Label}"
                                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                     Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                     CommandParameter="{Binding Language}"
                                                                     AutomationProperties.Name="{Binding Label}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Startup task: a switch, because the change takes effect the moment it is flipped. -->
                                <Border Style="{DynamicResource Daynote.Desk.Style.SettingsRow}"
                                        AutomationProperties.Name="{loc:Tr SettingsStartupRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsLabel}" Text="{loc:Tr SettingsStartupLabel}" />
                                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{Binding StartupStateText}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                                      Style="{DynamicResource Daynote.Desk.Style.Switch}"
                                                      IsChecked="{Binding StartupIsOn, Mode=OneWay}"
                                                      IsEnabled="{Binding StartupToggleEnabled}"
                                                      Command="{Binding ToggleStartupCommand}"
                                                      AutomationProperties.Name="{loc:Tr SettingsStartupAutomation}" />
                                    </Grid>
                                </Border>

                                <Border Style="{DynamicResource Daynote.Desk.Style.SettingsRow}"
                                        AutomationProperties.Name="{loc:Tr SettingsTutorialRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Style="{DynamicResource Daynote.Desk.Text.SettingsLabel}" Text="{loc:Tr SettingsTutorialLabel}" />
                                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource Daynote.Desk.Button.Quiet}"
                                                Content="{loc:Tr SettingsTutorialButton}" Command="{Binding ShowTutorialCommand}"
                                                AutomationProperties.Name="{loc:Tr SettingsTutorialButton}" />
                                    </Grid>
                                </Border>

                                <Border Style="{DynamicResource Daynote.Desk.Style.SettingsRow}" BorderThickness="0"
                                        AutomationProperties.Name="{loc:Tr SettingsAboutRow}">
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsLabel}" Text="{loc:Tr SettingsAboutLabel}" />
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{Binding AuthorName}" />
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Margin="0,2,0,0" Text="{Binding AuthorEmail}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═ 단축키 ═ -->
                            <StackPanel Visibility="{Binding IsShortcutsSection, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.H1}" Margin="0,0,0,18" Text="{loc:Tr DeskSettingsShortcuts}" />

                                <!-- The global summon chord, set apart: it works from anywhere, not only in the window. -->
                                <Border Background="{DynamicResource Daynote.Desk.Brush.SunSoft}" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsLabel}" Text="{loc:Tr SettingsSummonHotkeyLabel}" />
                                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{loc:Tr SettingsSummonHotkeyDesc}" />
                                            </StackPanel>
                                            <!-- The chord is the button: clicking it starts the capture. -->
                                            <Button Grid.Column="1" VerticalAlignment="Center" FontSize="12" Padding="9,4"
                                                    Style="{DynamicResource Daynote.Desk.Button.Combo}"
                                                    Background="{DynamicResource Daynote.Product.Brush.Card}"
                                                    product:DeskVisual.IsActive="{Binding IsCapturingHotkey}"
                                                    Content="{Binding SummonHotkeyDisplay}" Command="{Binding StartHotkeyCaptureCommand}"
                                                    ToolTip="{loc:Tr DeskShortcutChangeTip}"
                                                    AutomationProperties.Name="{loc:Tr SettingsSummonHotkeyLabel}" />
                                            <Button Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11.5"
                                                    Style="{DynamicResource Daynote.Desk.Button.LinkFaint}"
                                                    Content="{loc:Tr HotkeyReset}" Command="{Binding ResetSummonHotkeyCommand}"
                                                    AutomationProperties.Name="{loc:Tr HotkeyReset}" />
                                        </Grid>
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsStatus}" Text="{Binding HotkeyStatusText}"
                                                   Visibility="{Binding HotkeyStatusText, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Click the chord, press a new one; 기본값 puts it back. -->
                                <ItemsControl ItemsSource="{Binding InAppShortcuts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type psettings:ShortcutRowViewModel}">
                                            <Border Padding="0,11" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                   TextWrapping="Wrap" Text="{Binding Label}" />
                                                        <Button Grid.Column="1" VerticalAlignment="Center" MinWidth="84"
                                                                Style="{DynamicResource Daynote.Desk.Button.Combo}"
                                                                product:DeskVisual.IsActive="{Binding IsCapturing}"
                                                                Content="{Binding Display}" Command="{Binding StartCaptureCommand}"
                                                                ToolTip="{loc:Tr DeskShortcutChangeTip}"
                                                                AutomationProperties.Name="{Binding Label}" />
                                                        <Button Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11.5"
                                                                Style="{DynamicResource Daynote.Desk.Button.LinkFaint}"
                                                                Content="{loc:Tr HotkeyReset}" Command="{Binding ResetCommand}"
                                                                AutomationProperties.Name="{loc:Tr HotkeyReset}" />
                                                    </Grid>
                                                    <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsStatus}" Text="{Binding StatusText}"
                                                               Visibility="{Binding StatusText, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ═ 데이터 ═ -->
                            <StackPanel Visibility="{Binding IsDataSection, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.H1}" Margin="0,0,0,18" Text="{loc:Tr DeskSettingsData}" />

                                <Border Style="{DynamicResource Daynote.Desk.Style.SettingsRow}"
                                        AutomationProperties.Name="{loc:Tr SettingsBackupRow}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsLabel}" Text="{loc:Tr SettingsBackupLabel}" />
                                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{loc:Tr SettingsBackupDesc}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource Daynote.Desk.Button.Quiet}"
                                                    Content="{loc:Tr BackupButton}" Command="{Binding BackupCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                                                    AutomationProperties.Name="{loc:Tr BackupButton}" />
                                            <Button Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Style="{DynamicResource Daynote.Desk.Button.Quiet}"
                                                    Content="{loc:Tr RestoreButton}" Command="{Binding RestoreCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                                                    AutomationProperties.Name="{loc:Tr RestoreButton}" />
                                        </Grid>
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsStatus}" Text="{Binding BackupStatusText}"
                                                   Visibility="{Binding BackupStatusText, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                                    </StackPanel>
                                </Border>

                                <!-- AI integration (MCP): one-click registration of the bundled server. -->
                                <Border Style="{DynamicResource Daynote.Desk.Style.SettingsRow}"
                                        AutomationProperties.Name="{loc:Tr SettingsMcpRow}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsLabel}" Text="{loc:Tr SettingsMcpLabel}" />
                                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{loc:Tr SettingsMcpDesc}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource Daynote.Desk.Button.Quiet}"
                                                    Content="{loc:Tr SettingsMcpRegister}" Command="{Binding RegisterMcpCommand}"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                                                    Visibility="{Binding McpAvailable, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                                                    AutomationProperties.Name="{loc:Tr SettingsMcpRegister}" />
                                        </Grid>
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsStatus}" Text="{Binding McpStatusText}"
                                                   Visibility="{Binding McpStatusText, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                                        <!-- A dev run has no packaged server to register; say why the button is gone. -->
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{loc:Tr SettingsMcpUnavailable}"
                                                   Visibility="{Binding McpAvailable, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />

                                        <!-- Claude Code: the same server, added from a terminal instead. -->
                                        <StackPanel Visibility="{Binding McpAvailable, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                            <TextBlock Margin="0,12,0,0" Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{loc:Tr SettingsMcpCodeHint}" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" IsReadOnly="True" TextWrapping="Wrap" VerticalAlignment="Center"
                                                         Style="{DynamicResource Daynote.Desk.TextBox.Inline}"
                                                         FontFamily="{DynamicResource Daynote.Desk.Font.Mono}"
                                                         Text="{Binding McpCodeCommand, Mode=OneWay}" />
                                                <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Style="{DynamicResource Daynote.Desk.Button.Quiet}"
                                                        Content="{loc:Tr SettingsMcpCopy}" Command="{Binding CopyToClipboardCommand}"
                                                        CommandParameter="{Binding McpCodeCommand}"
                                                        AutomationProperties.Name="{loc:Tr SettingsMcpCopy}" />
                                            </Grid>
                                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsStatus}" Text="{loc:Tr SettingsMcpCopied}"
                                                       Visibility="{Binding McpCopied, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                        </StackPanel>

                                        <TextBlock Margin="0,12,0,0" Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{loc:Tr SettingsMcpFooter}" />
                                    </StackPanel>
                                </Border>

                                <!-- The path itself is the content, so it is set in mono. -->
                                <Border Style="{DynamicResource Daynote.Desk.Style.SettingsRow}"
                                        AutomationProperties.Name="{loc:Tr SettingsStorageRow}">
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsLabel}" Text="{loc:Tr SettingsStorageLabel}" />
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}"
                                                   FontFamily="{DynamicResource Daynote.Desk.Font.Mono}" Text="{Binding StorageLocation}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource Daynote.Desk.Style.SettingsRow}" BorderThickness="0"
                                        AutomationProperties.Name="{loc:Tr SettingsPrivacyRow}">
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsLabel}" Text="{loc:Tr SettingsPrivacyLabel}" />
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.SettingsDesc}" Text="{Binding PrivacyText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ═ 계정 ═ -->
                            <StackPanel Visibility="{Binding IsAccountSection, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.H1}" Margin="0,0,0,18" Text="{loc:Tr DeskSettingsAccount}" />
                                <account:AccountSection DataContext="{Binding Account}"
                                                        Visibility="{Binding Account, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
