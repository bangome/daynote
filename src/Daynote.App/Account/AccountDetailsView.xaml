<UserControl
    x:Class="Daynote.App.Account.AccountDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:account="clr-namespace:Daynote.App.Account"
    xmlns:pacct="clr-namespace:Daynote.App.Account;assembly=Daynote.Presentation"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance account:AccountViewModel}">
    <!--
      The signed-in half of the account window, top to bottom: who you are, anything that needs
      attention, what sync is doing, what Pro costs, what the subscription is, and the way out.

      Three blocks from the design mock are deliberately absent, because the data behind them does
      not exist and inventing it would be a lie on a billing screen:
        · the connected-device list — the service keeps no device registry, so every row would be made up;
        · the invoice table and the card's last four digits — those live at the payment provider, and
          the portal button below is the real route to them;
        · the in-app card form — the provider is the merchant of record precisely so this app never
          touches card details, and Store policy 10.8.2 wants the purchase finished in the browser.
      docs/CLOUD_SYNC.md §14 records the same list.
    -->
    <StackPanel Margin="22,20,22,24">

        <!-- ── Identity ── -->
        <Border Style="{DynamicResource Daynote.Product.Style.Settings.Card}" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource Daynote.Product.Brush.Accent}">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.AvatarText}"
                               FontSize="15" Text="{Binding AvatarInitial}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.RowLabel}"
                               FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis"
                               Text="{Binding DisplayName}" />
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" Text="{Binding EntitlementSummary}" />
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,1,0,0"
                               Visibility="{Binding HasStorage, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                        <Run Text="{loc:Tr StorageLabel}" /> <Run Text="{Binding StorageText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource Daynote.Product.Style.Account.PlanPill}">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.PlanPillText}" Text="{Binding PlanBadge}" />
                </Border>
            </Grid>
        </Border>

        <!-- ── Banner: a trial running out, a payment being retried, or sync stopped ── -->
        <Border Style="{DynamicResource Daynote.Product.Style.Account.Banner}"
                Visibility="{Binding HasBanner, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.BannerTitle}" Text="{Binding BannerTitle}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,3,0,0" Text="{Binding BannerBody}" />
                <Button Margin="0,11,0,0" HorizontalAlignment="Left"
                        Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                        Command="{Binding ResolveBannerCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                        Content="{Binding CheckoutLabel}"
                        Visibility="{Binding ShowUpgrade, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                        AutomationProperties.Name="{Binding CheckoutLabel}" />
            </StackPanel>
        </Border>

        <!--
          ── Checkout: the tier and the interval, what it costs, then Paddle in the browser ──
          The desktop design draws this as a dialog; here it is a card at the top of the page, bound
          to the same state (Daynote Desktop B v2). The success state follows the server's billing
          state, never the click. An account already paying changes plan in place instead.
        -->
        <Border Style="{DynamicResource Daynote.Product.Style.Settings.Card}"
                Visibility="{Binding IsCheckoutOpen, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <StackPanel>
                <StackPanel Visibility="{Binding IsCheckoutForm, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.CardTitle}" Text="{Binding CheckoutTitle}" />
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Text="{Binding DisplayName}" />
                    <Border Margin="0,12,0,0" HorizontalAlignment="Left" Style="{DynamicResource Daynote.Product.Style.Account.SegTray}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{DynamicResource Daynote.Product.Style.Account.SegButton}"
                                          IsChecked="{Binding IsCheckoutPro, Mode=OneWay}" IsEnabled="{Binding CanChoosePro}"
                                          Command="{Binding SelectCheckoutProCommand}" Content="{loc:Tr CheckoutTierProSub}"
                                          AutomationProperties.Name="{loc:Tr PlanProName}" />
                            <ToggleButton Style="{DynamicResource Daynote.Product.Style.Account.SegButton}"
                                          IsChecked="{Binding IsCheckoutPremium, Mode=OneWay}" IsEnabled="{Binding CanChoosePremium}"
                                          Command="{Binding SelectCheckoutPremiumCommand}" Content="{loc:Tr CheckoutTierPremiumSub}"
                                          AutomationProperties.Name="{loc:Tr PlanPremiumName}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,8,0,0" HorizontalAlignment="Left" Style="{DynamicResource Daynote.Product.Style.Account.SegTray}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{DynamicResource Daynote.Product.Style.Account.SegButton}"
                                          IsChecked="{Binding IsMonthlySelected, Mode=OneWay}" IsEnabled="{Binding CanChooseMonthly}"
                                          Command="{Binding SelectMonthlyCommand}" AutomationProperties.Name="{loc:Tr BillingPlanMonthly}">
                                <TextBlock><Run Text="{loc:Tr BillingPlanMonthly}" /> <Run Text="{Binding MonthlyPrice, Mode=OneWay}" /></TextBlock>
                            </ToggleButton>
                            <ToggleButton Style="{DynamicResource Daynote.Product.Style.Account.SegButton}"
                                          IsChecked="{Binding IsAnnualSelected, Mode=OneWay}" IsEnabled="{Binding CanChooseAnnual}"
                                          Command="{Binding SelectAnnualCommand}" AutomationProperties.Name="{loc:Tr BillingPlanAnnual}">
                                <TextBlock><Run Text="{loc:Tr BillingPlanAnnual}" /> <Run Text="{Binding AnnualPrice, Mode=OneWay}" /></TextBlock>
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Daynote.Product.Style.Account.RowDivider}" Margin="0,13,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Account.RowLabel}" Text="{Binding CheckoutPlanLabel}" />
                        <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Product.Style.Account.RowValue}" Text="{Binding PriceMain}" />
                    </Grid>
                    <StackPanel Visibility="{Binding IsCheckoutChange, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Account.RowLabel}" Text="{loc:Tr CheckoutRenewRow}" />
                            <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Product.Style.Account.RowValue}" Text="{Binding CheckoutRenewText}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Account.RowLabel}" FontWeight="Bold" Text="{loc:Tr CheckoutTodayRow}" />
                            <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Product.Style.Account.Price}" Text="{Binding PriceMain}" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,6,0,0" Text="{loc:Tr CheckoutChangeNote}"
                               Visibility="{Binding IsCheckoutChange, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,10,0,0" Text="{loc:Tr CheckoutFinePrint}" />
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Status}" Margin="0,8,0,0" Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                                Command="{Binding ConfirmCheckoutCommand}" IsEnabled="{Binding CanConfirmCheckout}"
                                Content="{Binding CheckoutConfirmLabel}" AutomationProperties.Name="{Binding CheckoutConfirmLabel}" />
                        <Button Margin="12,0,0,0" Style="{DynamicResource Daynote.Product.Style.Button.Link}"
                                Command="{Binding CloseCheckoutCommand}" Content="{loc:Tr CheckoutCancel}"
                                AutomationProperties.Name="{loc:Tr CheckoutCancel}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsCheckoutWaiting, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.CardTitle}" Text="{loc:Tr CheckoutWaitingTitle}" />
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Text="{loc:Tr CheckoutWaitingBody}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{DynamicResource Daynote.Product.Style.Button.Secondary}"
                                Command="{Binding ReopenCheckoutCommand}" Content="{loc:Tr CheckoutReopen}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                                AutomationProperties.Name="{loc:Tr CheckoutReopen}" />
                        <Button Margin="12,0,0,0" Style="{DynamicResource Daynote.Product.Style.Button.Link}"
                                Command="{Binding CloseCheckoutCommand}" Content="{loc:Tr CheckoutCancel}"
                                AutomationProperties.Name="{loc:Tr CheckoutCancel}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsCheckoutDone, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.CardTitle}" Text="{Binding CheckoutDoneTitle}" />
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Text="{loc:Tr CheckoutDoneBody}" />
                    <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                            Command="{Binding CloseCheckoutCommand}" Content="{loc:Tr CheckoutDoneOk}"
                            AutomationProperties.Name="{loc:Tr CheckoutDoneOk}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Sync ── -->
        <Border Style="{DynamicResource Daynote.Product.Style.Settings.Card}">
            <StackPanel>
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.CardTitle}" Text="{loc:Tr CloudSyncTitle}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Text="{loc:Tr CloudSyncBlurb}" />
                <Border Style="{DynamicResource Daynote.Product.Style.Account.RowDivider}" Margin="0,13,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Account.SyncDot.Flat}" />
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.RowLabel}"
                                   FontWeight="SemiBold" Text="{Binding Status.Label}" />
                        <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,1,0,0" Text="{Binding LastSyncText}" />
                    </StackPanel>
                    <Button Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                            Style="{DynamicResource Daynote.Product.Style.Button.Mini}"
                            Command="{Binding SyncCommand}" Content="{loc:Tr AccountSyncNow}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                            AutomationProperties.Name="{loc:Tr AccountSyncNow}" />
                </Grid>

                <!-- Signed in to an account whose data key this PC does not hold. Re-fetchable. -->
                <Border Style="{DynamicResource Daynote.Product.Style.Settings.Note}" Margin="0,12,0,0"
                        Visibility="{Binding IsKeyMissing, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0" Text="{loc:Tr AccountKeyMissingBlurb}" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                Style="{DynamicResource Daynote.Product.Style.Button.Mini}"
                                Command="{Binding RestoreKeyCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                                Content="{loc:Tr AccountRestoreKey}"
                                AutomationProperties.Name="{loc:Tr AccountRestoreKey}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Upgrade: the interval picker, the price, what it buys ── -->
        <Border Style="{DynamicResource Daynote.Product.Style.Settings.Card}"
                Visibility="{Binding ShowUpgrade, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{DynamicResource Daynote.Product.Style.Settings.CardTitle}" Text="{loc:Tr BillingUpgradeTitle}" />
                        <Border Margin="10,0,0,0" Style="{DynamicResource Daynote.Product.Style.Account.SegTray}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Style="{DynamicResource Daynote.Product.Style.Account.SegButton}"
                                              IsChecked="{Binding IsCheckoutPro, Mode=OneWay}"
                                              Command="{Binding SelectCheckoutProCommand}" Content="{loc:Tr PlanProName}"
                                              Visibility="{Binding CanChoosePro, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                                              AutomationProperties.Name="{loc:Tr PlanProName}" />
                                <ToggleButton Style="{DynamicResource Daynote.Product.Style.Account.SegButton}"
                                              IsChecked="{Binding IsCheckoutPremium, Mode=OneWay}"
                                              Command="{Binding SelectCheckoutPremiumCommand}" Content="{loc:Tr PlanPremiumName}"
                                              Visibility="{Binding CanChoosePremium, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                                              AutomationProperties.Name="{loc:Tr PlanPremiumName}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{DynamicResource Daynote.Product.Style.Account.SegTray}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{DynamicResource Daynote.Product.Style.Account.SegButton}"
                                          IsChecked="{Binding IsMonthlySelected, Mode=OneWay}"
                                          Command="{Binding SelectMonthlyCommand}" Content="{loc:Tr BillingPlanMonthly}"
                                          Visibility="{Binding CanChooseMonthly, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                                          AutomationProperties.Name="{loc:Tr BillingPlanMonthly}" />
                            <ToggleButton Style="{DynamicResource Daynote.Product.Style.Account.SegButton}"
                                          IsChecked="{Binding IsAnnualSelected, Mode=OneWay}"
                                          Command="{Binding SelectAnnualCommand}" Content="{loc:Tr BillingPlanAnnual}"
                                          Visibility="{Binding CanChooseAnnual, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                                          AutomationProperties.Name="{loc:Tr BillingPlanAnnual}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.Price}" Text="{Binding PriceMain}" />
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.PriceUnit}" Text="{Binding PriceUnit}" />
                    <Border Style="{DynamicResource Daynote.Product.Style.Account.SavingPill}"
                            Visibility="{Binding IsAnnualSelected, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.SavingText}" Text="{Binding CheckoutSavingText}" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,5,0,0" Text="{Binding PriceSub}" />

                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding ProFeatures}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
                                    <Path Width="8" Height="8" Stretch="Uniform" Margin="0,0,0,1"
                                          Data="{DynamicResource Daynote.Product.Geo.Check}"
                                          Stroke="{DynamicResource Daynote.Product.Brush.Accent}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="{x:Null}" />
                                </Grid>
                                <TextBlock Grid.Column="1" Margin="9,0,0,0"
                                           Style="{DynamicResource Daynote.Product.Style.Account.FeatureText}"
                                           Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Margin="0,10,0,0" HorizontalAlignment="Stretch"
                        Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                        Command="{Binding CheckoutSelectedCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                        Content="{Binding CheckoutLabel}"
                        AutomationProperties.Name="{Binding CheckoutLabel}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,10,0,0"
                           TextAlignment="Center" Text="{loc:Tr BillingProviderNote}" />
            </StackPanel>
        </Border>

        <!--
          The plan table: 무료, Pro and Premium side by side (Daynote Desktop B v2). Two rows differ
          from the free plan - image and file sync, and how much of them may be stored - and Pro and
          Premium differ in storage alone, which is the honest shape of the product. The column in use
          (or Pro, as the recommendation) is tinted; a paid account's column says "현재 플랜".
          Shown only while something is on sale; every price is the server's.

          Each of the header, the rows and the footer is its own grid - an ItemsControl cannot lay its
          items out as one table - so the three plan columns are a fixed width and the label column
          takes the rest. That is what makes the four line up.
        -->
        <Border Style="{DynamicResource Daynote.Product.Style.Settings.Card}"
                Visibility="{Binding ShowPlanTable, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.CardTitle}" Margin="0,0,0,12"
                           Text="{loc:Tr PlanTableTitle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Padding="8,10" CornerRadius="12,12,0,0">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Bold" TextAlignment="Center" Text="{Binding PlanColumns[0].Name}" />
                            <TextBlock FontSize="18" FontWeight="ExtraBold" TextAlignment="Center" Margin="0,6,0,0" Text="{Binding PlanColumns[0].Price}" />
                            <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" FontSize="11"
                                       TextAlignment="Center" Margin="0,2,0,0" Text="{Binding PlanColumns[0].Per}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="8,10" CornerRadius="12,12,0,0"
                            Background="{DynamicResource Daynote.Desk.Brush.SunSoft}"
                            Visibility="{Binding PlanColumns[1].IsHighlighted, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    <Border Grid.Column="2" Padding="8,10">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                       Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}" Text="{Binding PlanColumns[1].Name}" />
                            <TextBlock FontSize="18" FontWeight="ExtraBold" TextAlignment="Center" Margin="0,6,0,0" Text="{Binding PlanColumns[1].Price}" />
                            <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" FontSize="11"
                                       TextAlignment="Center" Margin="0,2,0,0" Text="{Binding PlanColumns[1].Per}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Padding="8,10" CornerRadius="12,12,0,0"
                            Background="{DynamicResource Daynote.Desk.Brush.SunSoft}"
                            Visibility="{Binding PlanColumns[2].IsHighlighted, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    <Border Grid.Column="3" Padding="8,10">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                       Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}" Text="{Binding PlanColumns[2].Name}" />
                            <TextBlock FontSize="18" FontWeight="ExtraBold" TextAlignment="Center" Margin="0,6,0,0" Text="{Binding PlanColumns[2].Price}" />
                            <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" FontSize="11"
                                       TextAlignment="Center" Margin="0,2,0,0" Text="{Binding PlanColumns[2].Per}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding PlanRows}" Focusable="False">
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type pacct:PlanCell}">
                            <Grid>
                                <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="{DynamicResource Daynote.Desk.Geo.Check}" Fill="{x:Null}"
                                      Stroke="{DynamicResource Daynote.Desk.Brush.Sun}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding IsCheck, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                <Border Width="10" Height="1.5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource Daynote.Desk.Brush.Text3}"
                                        Visibility="{Binding IsDash, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                <TextBlock FontSize="12.5" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding Text}"
                                           Visibility="{Binding IsText, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.Resources>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pacct:PlanComparisonRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="2" Background="{DynamicResource Daynote.Desk.Brush.SunSoft}"
                                        Visibility="{Binding DataContext.PlanColumns[1].IsHighlighted, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                <Border Grid.Column="3" Background="{DynamicResource Daynote.Desk.Brush.SunSoft}"
                                        Visibility="{Binding DataContext.PlanColumns[2].IsHighlighted, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                <Border Grid.ColumnSpan="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" />
                                <TextBlock Grid.Column="0" FontSize="12.5" TextWrapping="Wrap" Margin="0,11" VerticalAlignment="Center"
                                           Text="{Binding Label}" />
                                <ContentPresenter Grid.Column="1" Content="{Binding Free}" />
                                <ContentPresenter Grid.Column="2" Content="{Binding Pro}" />
                                <ContentPresenter Grid.Column="3" Content="{Binding Premium}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <DataTemplate DataType="{x:Type pacct:PlanColumn}">
                            <Grid Margin="6,10,6,12" MinHeight="30">
                                <Button HorizontalAlignment="Center" Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                                        Command="{Binding ChooseCommand}" Content="{Binding ButtonText}"
                                        AutomationProperties.Name="{Binding ButtonText}"
                                        Visibility="{Binding CanBuy, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                <TextBlock FontSize="11.5" FontWeight="ExtraBold" TextAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Daynote.Desk.Brush.Text3}" Text="{Binding Note}"
                                           Visibility="{Binding HasNote, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </Grid.Resources>
                    <Border Grid.Column="2" CornerRadius="0,0,12,12" Background="{DynamicResource Daynote.Desk.Brush.SunSoft}"
                            Visibility="{Binding PlanColumns[1].IsHighlighted, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    <Border Grid.Column="3" CornerRadius="0,0,12,12" Background="{DynamicResource Daynote.Desk.Brush.SunSoft}"
                            Visibility="{Binding PlanColumns[2].IsHighlighted, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    <ContentPresenter Grid.Column="1" Content="{Binding PlanColumns[0]}" />
                    <ContentPresenter Grid.Column="2" Content="{Binding PlanColumns[1]}" />
                    <ContentPresenter Grid.Column="3" Content="{Binding PlanColumns[2]}" />
                </Grid>

                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,10,0,0" FontSize="11.5"
                           Text="{loc:Tr PlanFairUseNote}" />
            </StackPanel>
        </Border>

        <!-- ── Subscription: only what the entitlement actually knows; the rest is at the provider ── -->
        <Border Style="{DynamicResource Daynote.Product.Style.Settings.Card}"
                Visibility="{Binding ShowSubscription, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <StackPanel>
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.CardTitle}" Text="{loc:Tr BillingDetailTitle}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Account.RowLabel}" Text="{loc:Tr BillingRowPlan}" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Product.Style.Account.RowValue}" Text="{Binding SubscriptionPlanText}" />
                </Grid>
                <Border Style="{DynamicResource Daynote.Product.Style.Account.RowDivider}" Margin="0,9,0,9" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Account.RowLabel}" Text="{loc:Tr BillingRowState}" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Product.Style.Account.RowValue}" Text="{Binding SubscriptionStateText}" />
                </Grid>
                <Border Style="{DynamicResource Daynote.Product.Style.Account.RowDivider}" Margin="0,9,0,9" />
                <Grid Visibility="{Binding HasSubscriptionDate, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Account.RowLabel}" Text="{Binding SubscriptionDateLabel}" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Product.Style.Account.RowValue}" Text="{Binding SubscriptionDateText}" />
                </Grid>
                <Grid Margin="0,9,0,0" Visibility="{Binding HasStorage, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Account.RowLabel}" Text="{loc:Tr StorageLabel}" />
                    <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Product.Style.Account.RowValue}" Text="{Binding StorageText}" />
                </Grid>
                <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                        Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                        Command="{Binding OpenCheckoutPremiumCommand}"
                        Visibility="{Binding CanUpgradeToPremium, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                        Content="{loc:Tr BillingChangeToPremium}"
                        AutomationProperties.Name="{loc:Tr BillingChangeToPremium}" />
                <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                        Style="{DynamicResource Daynote.Product.Style.Button.Secondary}"
                        Command="{Binding ManageSubscriptionCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                        Visibility="{Binding CanManageSubscription, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                        Content="{loc:Tr BillingManage}"
                        AutomationProperties.Name="{loc:Tr BillingManage}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Text="{loc:Tr BillingPortalNote}" />
            </StackPanel>
        </Border>

        <!-- ── The lock, the notices, and the privacy footnote, unchanged from the settings panel ── -->
        <account:AccountLockSection />

        <!-- ── Signing out: keep this account's notes on the PC, or remove them (docs/PROFILES.md
             §5.4). Removing with changes that never synced asks a second time. ── -->
        <Border Style="{DynamicResource Daynote.Product.Style.Settings.Card}" Padding="16,14"
                Visibility="{Binding IsChoosingSignOut, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{loc:Tr SignOutChoiceTitle}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Text="{loc:Tr SignOutChoiceBody}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Status}" Margin="0,8,0,0" Text="{Binding UnsyncedChangesMessage}"
                           Visibility="{Binding HasUnsyncedChanges, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Status}" Margin="0,8,0,0" Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding IsConfirmingRemoveUnsynced, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
                    <Button Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                            Command="{Binding SignOutKeepCommand}" Content="{loc:Tr SignOutKeep}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                            AutomationProperties.Name="{loc:Tr SignOutKeep}" />
                    <Button Margin="12,0,0,0" Style="{DynamicResource Daynote.Product.Style.Button.Link}"
                            Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                            Command="{Binding SignOutRemoveCommand}" Content="{loc:Tr SignOutRemove}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                            AutomationProperties.Name="{loc:Tr SignOutRemove}" />
                    <Button Margin="12,0,0,0" Style="{DynamicResource Daynote.Product.Style.Button.Link}"
                            Command="{Binding CancelSignOutCommand}" Content="{loc:Tr SignOutCancel}"
                            AutomationProperties.Name="{loc:Tr SignOutCancel}" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsConfirmingRemoveUnsynced, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Text="{Binding RemoveUnsyncedMessage}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                                Background="{DynamicResource Daynote.Product.Brush.Danger}"
                                Command="{Binding SignOutRemoveCommand}" Content="{loc:Tr SignOutRemoveConfirm}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                                AutomationProperties.Name="{loc:Tr SignOutRemoveConfirm}" />
                        <Button Margin="12,0,0,0" Style="{DynamicResource Daynote.Product.Style.Button.Link}"
                                Command="{Binding CancelSignOutCommand}" Content="{loc:Tr SignOutCancel}"
                                AutomationProperties.Name="{loc:Tr SignOutCancel}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Deleting the account: asked, then done (App Store 5.1.1(v), Google Play policy) ── -->
        <Border Style="{DynamicResource Daynote.Product.Style.Settings.Card}" Padding="16,14"
                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{loc:Tr AccountDeleteTitle}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Text="{loc:Tr AccountDeleteBody}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Status}" Margin="0,8,0,0" Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                            Background="{DynamicResource Daynote.Product.Brush.Danger}"
                            Command="{Binding DeleteAccountCommand}" Content="{loc:Tr AccountDeleteConfirm}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                            AutomationProperties.Name="{loc:Tr AccountDeleteConfirm}" />
                    <Button Margin="12,0,0,0" Style="{DynamicResource Daynote.Product.Style.Button.Link}"
                            Command="{Binding CancelDeleteAccountCommand}" Content="{loc:Tr AccountDeleteCancel}"
                            AutomationProperties.Name="{loc:Tr AccountDeleteCancel}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Footer: the way out, and the build ── -->
        <Grid Margin="4,2,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Button.Link}"
                    Command="{Binding SignOutCommand}" Content="{loc:Tr AccountSignOut}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                    AutomationProperties.Name="{loc:Tr AccountSignOut}" />
            <Button Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Left"
                    Style="{DynamicResource Daynote.Product.Style.Button.Link}"
                    Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                    Command="{Binding BeginDeleteAccountCommand}" Content="{loc:Tr AccountDelete}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                    AutomationProperties.Name="{loc:Tr AccountDelete}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                       Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0"
                       Text="{Binding AppVersionText}" />
        </Grid>
    </StackPanel>
</UserControl>
