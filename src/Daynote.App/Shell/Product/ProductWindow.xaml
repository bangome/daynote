<Window
    x:Class="Daynote.App.Shell.Product.ProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:settings="clr-namespace:Daynote.App.Settings"
    xmlns:lifecycle="clr-namespace:Daynote.App.Lifecycle"
    xmlns:onboarding="clr-namespace:Daynote.App.Onboarding"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:account="clr-namespace:Daynote.App.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance product:ProductShellViewModel}"
    Title="{loc:Tr AppTitle}"
    Icon="pack://application:,,,/Daynote.App;component/Assets/Brand/daynote-favicon-v1.ico"
    Width="1200" Height="800" MinWidth="640" MinHeight="520"
    WindowStyle="None" ResizeMode="CanResize"
    FontFamily="{DynamicResource Daynote.Product.Font.UI}"
    Foreground="{DynamicResource Daynote.Product.Brush.Text}"
    SizeChanged="OnWindowSizeChanged"
    UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- In-app shortcuts are built at runtime from the user-configurable set (see ProductWindow.AttachShortcuts). -->

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="{DynamicResource Daynote.Product.Color.Bg1}" />
            <GradientStop Offset="1" Color="{DynamicResource Daynote.Product.Color.Bg2}" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═ Titlebar ═ -->
        <Grid Grid.Row="0" Margin="14,0,0,0">
            <Grid.ColumnDefinitions>
                <!-- Fixed 250 at full width (design symmetry); shrinks to content in the compact titlebar -->
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="250" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTitlebarCompact}" Value="True">
                                    <Setter Property="Width" Value="Auto" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Full brand logo (icon + wordmark), trimmed of padding so it fills the titlebar height;
                     icon-only when the titlebar compacts -->
                <Image Source="{Binding Language, Source={x:Static loc:LocalizationService.Instance}, Converter={StaticResource Daynote.Convert.LanguageLogo}}"
                       Height="24" Margin="0,0,0,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{loc:Tr AppTitle}"
                       Visibility="{Binding IsTitlebarCompact, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />
                <Image Source="pack://application:,,,/Daynote.App;component/Assets/Brand/daynote-favicon-trimmed.png"
                       Height="24" Margin="0,0,0,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{loc:Tr AppTitle}"
                       Visibility="{Binding IsTitlebarCompact, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
            </StackPanel>

            <!-- Unified search + dropdown: stretches with the window; capped narrower now that the
                 titlebar also carries the settings (gear) button (was 480, less the 36px button). -->
            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  MaxWidth="444" MinWidth="120" Margin="12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Background="{DynamicResource Daynote.Product.Brush.Input}"
                        BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke}" BorderThickness="1"
                        CornerRadius="17" Height="34" Padding="14,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                              Data="{DynamicResource Daynote.Product.Geo.Search}"
                              Stroke="{DynamicResource Daynote.Product.Brush.Text2}" StrokeThickness="1.5" Fill="{x:Null}" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                 Style="{DynamicResource Daynote.Product.Style.PlainTextBox}"
                                 Text="{Binding Search.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Tr UnifiedSearchHint}" />
                        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="{loc:Tr UnifiedSearchHint}"
                                   Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                                   Visibility="{Binding Search.Query, Converter={StaticResource Daynote.Convert.NullToCollapsed}}" />
                        <Button Grid.Column="2" Width="18" Content="✕" Padding="0"
                                Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                                Command="{Binding Search.ClearCommand}"
                                Visibility="{Binding Search.Query, Converter={StaticResource Daynote.Convert.NullToVisibility}}"
                                AutomationProperties.Name="{loc:Tr ClearSearch}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Right cluster -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="{loc:Tr GoToToday}" Style="{DynamicResource Daynote.Product.Style.Button.Secondary}"
                        Command="{Binding GoToTodayCommand}" VerticalAlignment="Center" Height="30" Margin="0,0,6,0"
                        Visibility="{Binding IsTitlebarCompact, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />
                <!-- Compact titlebar: icon-only 오늘로 이동 with the label as tooltip/accessible name -->
                <Button Style="{DynamicResource Daynote.Product.Style.Button.Round}"
                        Command="{Binding GoToTodayCommand}" VerticalAlignment="Center" Margin="0,0,6,0"
                        ToolTip="{loc:Tr GoToToday}"
                        AutomationProperties.Name="{loc:Tr GoToToday}"
                        Visibility="{Binding IsTitlebarCompact, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.CalendarGlyph}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" />
                </Button>
                <!-- Both-sidebars toggle: the ONLY collapse/expand affordance (the card's corner buttons are
                     gone). The glyph shows the action — >< while expanded (click to collapse), <> while both
                     are collapsed (click to expand). A stacked pair, one visible per state, so the
                     tooltip/accessible name always matches the action. -->
                <Button Style="{DynamicResource Daynote.Product.Style.Button.Round}"
                        Command="{Binding TogglePanelsCommand}" VerticalAlignment="Center" Margin="0,0,6,0"
                        ToolTip="{loc:Tr SidebarsCollapse}"
                        AutomationProperties.Name="{loc:Tr SidebarsCollapse}"
                        Visibility="{Binding PanelsCollapsed, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
                    <Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.PanelsCollapse}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" />
                </Button>
                <Button Style="{DynamicResource Daynote.Product.Style.Button.Round}"
                        Command="{Binding TogglePanelsCommand}" VerticalAlignment="Center" Margin="0,0,6,0"
                        ToolTip="{loc:Tr SidebarsExpand}"
                        AutomationProperties.Name="{loc:Tr SidebarsExpand}"
                        Visibility="{Binding PanelsCollapsed, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.PanelsExpand}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" />
                </Button>
                <Button Style="{DynamicResource Daynote.Product.Style.Button.Round}"
                        Command="{Binding ToggleTimelineCommand}" ToolTip="{loc:Tr TimelineToggle}"
                        VerticalAlignment="Center" Margin="0,0,6,0" Tag="{Binding IsTimelineMode}"
                        AutomationProperties.Name="{loc:Tr TimelineToggle}">
                    <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Timeline}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" />
                </Button>
                <Button Style="{DynamicResource Daynote.Product.Style.Button.Round}"
                        Command="{Binding ToggleThemeCommand}" ToolTip="{loc:Tr ThemeToggle}"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        AutomationProperties.Name="{loc:Tr ThemeToggle}">
                    <Grid>
                        <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Moon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}"
                              Visibility="{Binding IsDark, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />
                        <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Sun}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}"
                              Visibility="{Binding IsDark, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    </Grid>
                </Button>
                <account:SyncStatusChip DataContext="{Binding Account}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button x:Name="TutSettings" Style="{DynamicResource Daynote.Product.Style.Button.Round}"
                        Command="{Binding ToggleSettingsCommand}" ToolTip="{loc:Tr SettingsTitle}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:Tr SettingsTitle}">
                    <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Settings}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" />
                </Button>
                <Button x:Name="MinButton" Style="{DynamicResource Daynote.Product.Style.CaptionButton}" Click="OnMinimize"
                        Margin="8,0,0,0" AutomationProperties.Name="{loc:Tr WindowMinimize}">
                    <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Min}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                </Button>
                <Button x:Name="MaxButton" Style="{DynamicResource Daynote.Product.Style.CaptionButton}" Click="OnMaximizeRestore"
                        AutomationProperties.Name="{loc:Tr WindowMaximize}">
                    <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Max}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Fill="{x:Null}" />
                </Button>
                <Button x:Name="CloseButton" Style="{DynamicResource Daynote.Product.Style.CaptionButton.Close}" Click="OnClose"
                        AutomationProperties.Name="{loc:Tr WindowClose}">
                    <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Close}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═ Body ═ side panels stay put in both editor and timeline mode; only the center swaps -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: full column (calendar + note list); when collapsed it disappears entirely and the
                 expand affordance lives at the editor card's top-left corner (EditorCardView) -->
            <Grid Grid.Column="0" Width="292" Margin="0,0,12,0"
                  Visibility="{Binding LeftCollapsed, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Calendar card -->
                <Border x:Name="TutCalendar" Grid.Row="0" Style="{DynamicResource Daynote.Product.Style.Panel}" Padding="14" Margin="0,0,0,12"
                        DataContext="{Binding Calendar}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding MonthLabel}" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Width="28" Height="28" Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                                        Command="{Binding PreviousMonthCommand}" AutomationProperties.Name="{loc:Tr PreviousMonth}">
                                    <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.ChevronLeft}"
                                          Stroke="{DynamicResource Daynote.Product.Brush.Text2}" StrokeThickness="1.5" />
                                </Button>
                                <Button Width="28" Height="28" Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                                        Command="{Binding NextMonthCommand}" AutomationProperties.Name="{loc:Tr NextMonth}">
                                    <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.ChevronRight}"
                                          Stroke="{DynamicResource Daynote.Product.Brush.Text2}" StrokeThickness="1.5" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Weekday header -->
                        <UniformGrid Columns="7" Margin="0,0,0,2">
                            <TextBlock Text="{loc:Tr WeekdaySun}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Weekend.Sun}" />
                            <TextBlock Text="{loc:Tr WeekdayMon}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                            <TextBlock Text="{loc:Tr WeekdayTue}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                            <TextBlock Text="{loc:Tr WeekdayWed}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                            <TextBlock Text="{loc:Tr WeekdayThu}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                            <TextBlock Text="{loc:Tr WeekdayFri}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                            <TextBlock Text="{loc:Tr WeekdaySat}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Weekend.Sat}" />
                        </UniformGrid>
                        <!-- Day grid -->
                        <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type product:CalendarDayCellViewModel}">
                                    <Button Height="38" Margin="1" Command="{Binding SelectCommand}"
                                            Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                                            AutomationProperties.Name="{Binding DayText}">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- v3: day number in a 24px circle (selected fill / today ring / weekend
                                                     tints); both styles live in Daynote.Product.Styles.xaml -->
                                                <Border Style="{DynamicResource Daynote.Product.Style.Calendar.DayCircle}">
                                                    <TextBlock x:Name="DayNum" Text="{Binding DayText}"
                                                               Style="{DynamicResource Daynote.Product.Style.Calendar.DayNumber}" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="5" Margin="0,2,0,0">
                                                    <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource Daynote.Product.Brush.Accent}"
                                                             Visibility="{Binding HasNotes, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                                    <Ellipse Width="5" Height="5" Margin="1.5,0" Fill="{DynamicResource Daynote.Product.Brush.Extras}"
                                                             Visibility="{Binding HasExtras, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- v3: note count pinned to the cell's top-right corner in accent -->
                                            <TextBlock Text="{Binding CountText}" FontSize="9.5" FontWeight="Bold"
                                                       VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,4,0"
                                                       Foreground="{DynamicResource Daynote.Product.Brush.Accent}"
                                                       Visibility="{Binding HasCount, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Note list card -->
                <Border Grid.Row="1" Style="{DynamicResource Daynote.Product.Style.Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="12,12,12,8">
                            <StackPanel>
                                <TextBlock Text="{Binding DayLabel}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NoteCountText}" FontSize="11" Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                                    Command="{Binding NewNoteCommand}" AutomationProperties.Name="{loc:Tr NewNote}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="10" Height="10" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Plus}"
                                          Stroke="{DynamicResource Daynote.Product.Brush.OnAccent}" StrokeThickness="1.6" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr NewNote}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Notes.Tabs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                                    Visibility="{Binding IsProjection, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}"
                                                    Command="{Binding DataContext.Notes.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Row" Padding="11,9" CornerRadius="{DynamicResource Daynote.Product.Radius.Panel}"
                                                                BorderThickness="0" Background="Transparent">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock x:Name="RowTitle" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Daynote.Product.Brush.Text}" />
                                                                    <Path Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Right"
                                                                          Data="{DynamicResource Daynote.Product.Geo.Star}" Fill="{DynamicResource Daynote.Product.Brush.Extras}"
                                                                          Visibility="{Binding IsFavorite, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Preview}" FontSize="11" Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                                                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,5,0,0"
                                                                              Visibility="{Binding HasTags, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource Daynote.Product.Brush.AccentSoft}"
                                                                                    CornerRadius="{DynamicResource Daynote.Product.Radius.Chip}" Padding="6,1" Margin="0,0,4,0">
                                                                                <TextBlock FontSize="10" Foreground="{DynamicResource Daynote.Product.Brush.Accent}">
                                                                                    <Run Text="#" /><Run Text="{Binding Mode=OneWay}" />
                                                                                </TextBlock>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
                                                                <Setter TargetName="RowTitle" Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Tr DayNotesEmpty}" FontSize="12" TextAlignment="Center"
                                           Margin="0,24" Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                                           Visibility="{Binding IsDayEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- CENTER: editor, or the timeline feed in timeline mode -->
            <product:EditorCardView x:Name="TutEditor" Grid.Column="1" DataContext="{Binding}" StickyNoteRequested="OnStickyNoteRequested"
                                    Visibility="{Binding IsEditorMode, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />

            <!-- Timeline view mode: read-only cross-date feed, shown in place of the editor card -->
            <product:TimelineView Grid.Column="1" DataContext="{Binding Timeline}"
                                  Visibility="{Binding DataContext.IsTimelineMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />

            <!-- RIGHT: tab panel; when collapsed it disappears entirely and the expand affordance lives
                 at the editor card's top-right corner (EditorCardView) -->
            <Border Grid.Column="2" Width="302" Margin="12,0,0,0" Style="{DynamicResource Daynote.Product.Style.Panel}"
                    Visibility="{Binding RightCollapsed, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Tab row: v3 segmented control on a Seg-colored track -->
                    <Border Grid.Row="0" Margin="10,10,10,8" Background="{DynamicResource Daynote.Product.Brush.Seg}"
                            CornerRadius="9" Padding="3">
                        <!-- v3: icon-only tabs (the todo tab keeps its open count); labels stay as tooltips
                             and accessible names. Icon strokes follow the button Foreground so the active
                             accent and hover states color them. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TutTabTodo" Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.TabHeader}" Tag="{Binding TabIsTodo}"
                                    ToolTip="{Binding Todo.TabLabel}" AutomationProperties.Name="{loc:Tr TabTodoName}"
                                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static product:RightTab.Todo}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="13" Height="13" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.TabTodo}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}" />
                                    <TextBlock Text="{Binding Todo.OpenCount}" FontSize="10.5" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TutTabFavorites" Grid.Column="1" Style="{DynamicResource Daynote.Product.Style.TabHeader}" Tag="{Binding TabIsFavorites}"
                                    ToolTip="{loc:Tr TabFavoritesName}" AutomationProperties.Name="{loc:Tr TabFavoritesName}"
                                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static product:RightTab.Favorites}">
                                <Path Width="13" Height="13" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Star}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.1" StrokeLineJoin="Round" Fill="{x:Null}" />
                            </Button>
                            <Button x:Name="TutTabTags" Grid.Column="2" Style="{DynamicResource Daynote.Product.Style.TabHeader}" Tag="{Binding TabIsTags}"
                                    ToolTip="{Binding TagPanel.TabLabel}" AutomationProperties.Name="{loc:Tr TabTagsName}"
                                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static product:RightTab.Tags}">
                                <Path Width="13" Height="13" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.TabTag}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" StrokeLineJoin="Round" Fill="{x:Null}" />
                            </Button>
                            <Button x:Name="TutTabFiles" Grid.Column="3" Style="{DynamicResource Daynote.Product.Style.TabHeader}" Tag="{Binding TabIsFiles}"
                                    ToolTip="{loc:Tr TabFiles}" AutomationProperties.Name="{loc:Tr TabFilesName}"
                                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static product:RightTab.Files}">
                                <Path Width="13" Height="13" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.TabClip}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource Daynote.Product.Brush.Stroke2}" />

                    <!-- Todo tab -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8"
                                  Visibility="{Binding TabIsTodo, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel.Resources>
                                <DataTemplate x:Key="Daynote.Product.Template.TodoItem" DataType="{x:Type product:TodoItemViewModel}">
                                        <Border Background="{DynamicResource Daynote.Product.Brush.Card}" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}"
                                                BorderThickness="1" CornerRadius="{DynamicResource Daynote.Product.Radius.Panel}" Padding="11,9" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,9,0"
                                                        Command="{Binding ToggleCommand}" Style="{DynamicResource Daynote.Product.Style.GhostButton}">
                                                    <Border CornerRadius="5" BorderThickness="1.5"
                                                            BorderBrush="{DynamicResource Daynote.Product.Brush.Text2}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Checked}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Path Width="9" Height="9" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Check}"
                                                              Stroke="{DynamicResource Daynote.Product.Brush.OnAccent}" StrokeThickness="1.8"
                                                              Visibility="{Binding Checked, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                                    </Border>
                                                </Button>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Checked}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding NoteLabel}" FontSize="10.5" Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                                                        <TextBlock Text="{Binding DueLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                                                   Visibility="{Binding HasDue, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Overdue}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Overdue}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding JumpCommand}" />
                                            </Border.InputBindings>
                                        </Border>
                                </DataTemplate>
                            </StackPanel.Resources>
                            <!-- Due-today group pinned on top -->
                            <TextBlock Text="{loc:Tr Today}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Daynote.Product.Brush.Accent}" Margin="2,2,0,6"
                                       Visibility="{Binding Todo.HasToday, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Todo.TodayItems}" ItemTemplate="{StaticResource Daynote.Product.Template.TodoItem}"
                                          Visibility="{Binding Todo.HasToday, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                            <!-- Hairline so the general list below never reads as part of the 오늘 group -->
                            <Border Height="1" Margin="2,4,2,8" Background="{DynamicResource Daynote.Product.Brush.Stroke}"
                                    Visibility="{Binding Todo.HasToday, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Todo.Items}" ItemTemplate="{StaticResource Daynote.Product.Template.TodoItem}" />
                            <TextBlock TextAlignment="Center" Margin="12,28" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                                       Visibility="{Binding Todo.IsEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                <Run Text="{loc:Tr TodoEmptyPrefix}" /><Run Text="{loc:Tr TodoEmptyCode}"
                                     FontFamily="{DynamicResource Daynote.Product.Font.Mono}" Foreground="{DynamicResource Daynote.Product.Brush.Accent}" /><Run
                                     Text="{loc:Tr TodoEmptySuffix}" />
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Favorites tab: every starred note across all dates (own view for reviewability) -->
                    <product:FavoritesPanelView Grid.Row="2" DataContext="{Binding Favorites}"
                                                Visibility="{Binding DataContext.TabIsFavorites, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />

                    <!-- Tags tab: distinct inline #tags across all notes, each expandable to its occurrences -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8"
                                  Visibility="{Binding TabIsTags, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding TagPanel.Tags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type product:TagItemViewModel}">
                                        <Border Background="{DynamicResource Daynote.Product.Brush.Card}" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}"
                                                BorderThickness="1" CornerRadius="{DynamicResource Daynote.Product.Radius.Panel}" Padding="0" Margin="0,0,0,5">
                                            <StackPanel>
                                                <!-- Tag header: click to expand/collapse its occurrences. A Border (not the
                                                     ghost Button, whose template ignores Padding/stretch) so the vertical
                                                     padding actually applies and the count chip right-aligns. -->
                                                <Border Padding="14,12" Cursor="Hand" CornerRadius="{DynamicResource Daynote.Product.Radius.Panel}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}" />
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Tag}" FontSize="12.5" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Daynote.Product.Brush.Accent}" />
                                                        <Border Grid.Column="1" Background="{DynamicResource Daynote.Product.Brush.AccentSoft}"
                                                                CornerRadius="{DynamicResource Daynote.Product.Radius.Chip}" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Daynote.Product.Brush.Accent}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <!-- Occurrences: one clickable row each, jumps into the editor at the tag -->
                                                <ItemsControl ItemsSource="{Binding Occurrences}" Margin="0,2,0,8"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type product:TagOccurrenceViewModel}">
                                                            <Border Background="{DynamicResource Daynote.Product.Brush.Hover}" Padding="12,10" Margin="8,0,8,6"
                                                                    CornerRadius="{DynamicResource Daynote.Product.Radius.Panel}">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding NoteTitle}" FontSize="11.5" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Daynote.Product.Brush.Text}" />
                                                                        <TextBlock Text="{Binding DateLabel}" FontSize="10.5" Margin="8,0,0,0"
                                                                                   Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Preview}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                                                                </StackPanel>
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding JumpCommand}" />
                                                                </Border.InputBindings>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:Tr TagPanelEmpty}" TextAlignment="Center" Margin="12,28" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                                       Visibility="{Binding TagPanel.IsEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Files tab (drop Explorer files anywhere on the panel to import them) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8"
                                  Background="Transparent" AllowDrop="True"
                                  PreviewDragOver="OnFilesPanelDragOver" PreviewDrop="OnFilesPanelDrop"
                                  Visibility="{Binding TabIsFiles, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                        <StackPanel>
                            <Button Style="{DynamicResource Daynote.Product.Style.Button.Dashed}" Margin="0,0,0,4"
                                    Command="{Binding Files.AddFilesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.PlusThin}"
                                          Stroke="{DynamicResource Daynote.Product.Brush.Text2}" StrokeThickness="1.4" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr AddFile}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding Files.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type product:FileItemViewModel}">
                                        <!-- Drag a card into the editor body to drop a [[file:…]] link; a body link click
                                             highlights the card via IsHighlighted (accent border). -->
                                        <Border Background="{DynamicResource Daynote.Product.Brush.Card}"
                                                BorderThickness="1" CornerRadius="{DynamicResource Daynote.Product.Radius.Panel}" Padding="10,8" Margin="0,0,0,4"
                                                PreviewMouseLeftButtonDown="OnFileCardMouseDown"
                                                PreviewMouseMove="OnFileCardMouseMove">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Border Height="110" CornerRadius="{DynamicResource Daynote.Product.Radius.Small}" Margin="0,0,0,8"
                                                        Visibility="{Binding HasThumbnail, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="{DynamicResource Daynote.Product.Radius.Small}"
                                                            Background="{DynamicResource Daynote.Product.Brush.AccentSoft}" Margin="0,0,10,0">
                                                        <Grid>
                                                            <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Image}"
                                                                  Stroke="{DynamicResource Daynote.Product.Brush.Accent}" StrokeThickness="1.3" Fill="{x:Null}"
                                                                  Visibility="{Binding ShowImageBadge, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                                            <TextBlock Text="{Binding Ext}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Accent}"
                                                                       Visibility="{Binding ShowDocBadge, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Daynote.Product.Brush.Text}" />
                                                        <TextBlock Text="{Binding SizeLabel}" FontSize="10.5" Margin="0,1,0,0"
                                                                   Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="{loc:Tr Delete}" FontSize="11" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                                                            Style="{DynamicResource Daynote.Product.Style.GhostButton}" Command="{Binding DeleteCommand}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:Tr FileTabEmpty}" TextAlignment="Center" Margin="12,28" FontSize="12"
                                       Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                                       Visibility="{Binding Files.IsEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Search dropdown overlay -->
        <product:SearchDropdownView Grid.Row="1" Panel.ZIndex="50" DataContext="{Binding Search}"
                                    Visibility="{Binding IsOpen, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />

        <!-- Settings overlay (reused, minimally hosted) -->
        <settings:SettingsView x:Name="SettingsHost" Grid.Row="1" DataContext="{Binding SettingsViewModel}"
                               Visibility="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
        <onboarding:TutorialView x:Name="TutorialHost" Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Tutorial}"
                                 Visibility="{Binding DataContext.Tutorial.IsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Daynote.Convert.BoolToVisibility}, FallbackValue=Collapsed}" />
    </Grid>
</Window>
