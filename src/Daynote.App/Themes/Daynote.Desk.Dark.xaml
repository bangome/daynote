<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
      The desktop's own palette, dark. Same keys as Daynote.Desk.Light.xaml; see that file for why
      this layer exists and how it merges.
    -->
    <SolidColorBrush x:Key="Daynote.Product.Brush.Bg1" Color="#FF0E1020" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Bg2" Color="#FF0E1020" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Panel" Color="#FF141729" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Card" Color="#FF171A2E" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Stroke" Color="#FF262A42" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Stroke2" Color="#FF1F2238" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Text" Color="#FFECEAF2" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Text2" Color="#FF9A9CB3" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Accent" Color="#FFFFAD72" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.AccentSoft" Color="#1FFF9A52" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Hover" Color="#0DFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Seg" Color="#FF1C1F35" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Input" Color="#FF171A2E" po:Freeze="True" />
    <!-- The dark accent is a pale orange; ink on it has to be dark, as the design's on-pri is. -->
    <SolidColorBrush x:Key="Daynote.Product.Brush.OnAccent" Color="#FF1A1206" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.SelectionBg" Color="#FFFFAD72" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.SelectionText" Color="#FF0E1020" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Extras" Color="#FFFF9A52" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sun" Color="#FFFF8076" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sat" Color="#FF6C6F88" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Ok" Color="#FF2FB574" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Danger" Color="#FFFF8076" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.DangerSoft" Color="#1FFF8076" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Overdue" Color="#FFFF8076" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Sticky" Color="#FFFFE99A" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.StickyText" Color="#FF3B2F10" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Scrim.Modal" Color="#660E1020" po:Freeze="True" />

    <SolidColorBrush x:Key="Daynote.Desk.Brush.Text3" Color="#FF6C6F88" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.Pri" Color="#FFFF9A52" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.OnPri" Color="#FF1A1206" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.Sun" Color="#FFFF9A52" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.SunInk" Color="#FFFFB27A" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.SunSoft" Color="#24FF9A52" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.Sunday" Color="#FFFF8076" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.Side" Color="#FF0A0C18" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.SideText" Color="#FFE6E7F2" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.Side2" Color="#FF8B8FAE" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.SideHover" Color="#0DFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.SideActive" Color="#17FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Desk.Brush.SideStroke" Color="#0FFFFFFF" po:Freeze="True" />

    <!-- See the light file: one layer of the design's two-layer drop, blur halved for WPF. -->
    <DropShadowEffect x:Key="Daynote.Desk.Shadow.Pop" BlurRadius="30" ShadowDepth="10"
                      Direction="270" Color="#000000" Opacity="0.60" />
</ResourceDictionary>
