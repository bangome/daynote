<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
      Product Light theme brushes (Daynote v3.dc.html tokens). Same keys as Daynote.Product.Dark.xaml
      so the shell swaps a single dictionary at runtime. v3 drops the gradient/translucency: the window
      ground is a flat neutral (#f4f4f5) and panels/cards are opaque white with hairline strokes.
      Consumed via DynamicResource.
    -->
    <Color x:Key="Daynote.Product.Color.Bg1">#FFF4F4F5</Color>
    <Color x:Key="Daynote.Product.Color.Bg2">#FFF4F4F5</Color>
    <SolidColorBrush x:Key="Daynote.Product.Brush.Bg1" Color="#FFF4F4F5" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Bg2" Color="#FFF4F4F5" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Panel" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Card" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Stroke" Color="#FFE7E7EA" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Stroke2" Color="#FFECECEF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Text" Color="#FF1A1A1E" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Text2" Color="#FF77777E" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Accent" Color="#FF0067C0" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.AccentSoft" Color="#170067C0" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Hover" Color="#0B000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Seg" Color="#FFEDEDF0" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Input" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.OnAccent" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.SwitchKnob" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.OnClose" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Extras" Color="#FFE8A33D" po:Freeze="True" />
    <!-- Calendar activity heat (GitHub-contribution style): 1 note / 2 notes / 3+ notes -->
    <SolidColorBrush x:Key="Daynote.Product.Brush.Heat1" Color="#FFAFD9F5" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Heat2" Color="#FF54A9E8" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Heat3" Color="#FF0067C0" po:Freeze="True" />
    <!-- v3 post-it: fixed warm yellow in both themes, with its own ink color -->
    <SolidColorBrush x:Key="Daynote.Product.Brush.Sticky" Color="#FFFDF0A0" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.StickyStroke" Color="#FFE3D276" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.StickyText" Color="#FF3A3520" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.CloseHover" Color="#FFC42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sun" Color="#FFE5484D" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sat" Color="#FF0067C0" po:Freeze="True" />
    <!-- The onboarding overlay's dimming scrim. Deliberately the same value in both themes: it dims
         the real UI around a cut-out, so it is judged against the app behind it, not the palette. -->
    <SolidColorBrush x:Key="Daynote.Product.Brush.Scrim" Color="#8C000000" po:Freeze="True" />
    <!-- Modal scrim for the settings dialog: lighter than the tutorial cut-out scrim. -->
    <SolidColorBrush x:Key="Daynote.Product.Brush.Scrim.Modal" Color="#52000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Overdue" Color="#FFE5484D" po:Freeze="True" />
    <!-- v3 status colors (the design's ok / warn / danger tokens and their soft fills):
         used by the account window's banners and plan pills. Accent stays the brand color;
         these three carry "fine", "look at this" and "this failed". -->
    <SolidColorBrush x:Key="Daynote.Product.Brush.Ok" Color="#FF0F7B5F" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.OkSoft" Color="#1C0F7B5F" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Warn" Color="#FFB25E09" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.WarnSoft" Color="#24E8A33D" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Danger" Color="#FFC62A2F" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.DangerSoft" Color="#1FE5484D" po:Freeze="True" />
    <!-- Google's brand colors, fixed in both themes: a sign-in button may not be recolored. -->
    <SolidColorBrush x:Key="Daynote.Product.Brush.Google.Blue" Color="#FF4285F4" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Google.Green" Color="#FF34A853" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Google.Yellow" Color="#FFFBBC05" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Product.Brush.Google.Red" Color="#FFEA4335" po:Freeze="True" />

    <DropShadowEffect x:Key="Daynote.Product.Effect.CardShadow" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#000000" />
    <DropShadowEffect x:Key="Daynote.Product.Effect.DropdownShadow" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.16" Color="#000000" />
</ResourceDictionary>
