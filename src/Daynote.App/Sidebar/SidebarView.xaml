<UserControl
    x:Class="Daynote.App.Sidebar.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sidebar="clr-namespace:Daynote.App.Sidebar"
    xmlns:notes="clr-namespace:Daynote.App.Notes"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance sidebar:SidebarViewModel}"
    Background="{DynamicResource Daynote.Brush.Surface.Secondary}">
    <Grid Margin="{DynamicResource Daynote.Inset.Pane.Compact}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <Button
                DockPanel.Dock="Left"
                Style="{DynamicResource Daynote.Style.Button.Ghost}"
                Padding="0,8,12,8"
                MinHeight="{DynamicResource Daynote.Size.Target.Secondary}"
                Command="{Binding GoToTodayCommand}"
                Content="{loc:Tr Today}"
                AutomationProperties.Name="{loc:Tr GoToToday}" />
            <Button
                DockPanel.Dock="Right"
                Style="{DynamicResource Daynote.Style.IconButton.Ghost}"
                Command="{Binding AddNoteCommand}"
                ToolTip="{loc:Tr AddNote}"
                AutomationProperties.Name="{loc:Tr AddNote}">
                <Path Style="{DynamicResource Daynote.Style.IconPresenter}" Data="{DynamicResource Daynote.Icon.Geometry.Add}" IsHitTestVisible="False" />
            </Button>
        </DockPanel>

        <ListBox
            x:Name="NoteList"
            Grid.Row="1"
            Margin="0,8,0,8"
            BorderThickness="0"
            Background="{DynamicResource Daynote.Brush.Transparent}"
            ItemsSource="{Binding Notes.Tabs}"
            SelectedItem="{Binding Notes.SelectedTab, Mode=OneWay}"
            SelectionChanged="OnNoteSelectionChanged"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="{loc:Tr SidebarNoteList}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Daynote.Style.SidebarNoteRow}" />
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type notes:NoteTabViewModel}">
                    <DockPanel LastChildFill="True">
                        <!-- Reorder affordances reveal on row hover or keyboard focus (DESIGN Revision 2026-07-21) -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button
                                Command="{Binding DataContext.Notes.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding MoveUpLabel}"
                                AutomationProperties.Name="{Binding MoveUpLabel}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Daynote.Style.IconButton.Ghost}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Style="{DynamicResource Daynote.Style.IconPresenter.Small}" Data="{DynamicResource Daynote.Icon.Geometry.ChevronUp}" IsHitTestVisible="False" />
                            </Button>
                            <Button
                                Command="{Binding DataContext.Notes.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding MoveDownLabel}"
                                AutomationProperties.Name="{Binding MoveDownLabel}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Daynote.Style.IconButton.Ghost}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Style="{DynamicResource Daynote.Style.IconPresenter.Small}" Data="{DynamicResource Daynote.Icon.Geometry.ChevronDown}" IsHitTestVisible="False" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Style="{DynamicResource Daynote.Style.Type.Label}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding Title}" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" AutomationProperties.Name="{loc:Tr MiniCalendar}">
            <Border Height="{DynamicResource Daynote.Border.Thin}" Background="{DynamicResource Daynote.Brush.Border.Subtle}" Margin="0,8,0,16" />
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Style="{DynamicResource Daynote.Style.IconButton.Ghost}"
                        Command="{Binding Calendar.PreviousMonthCommand}"
                        ToolTip="{loc:Tr PreviousMonth}"
                        AutomationProperties.Name="{loc:Tr PreviousMonth}">
                        <Path Style="{DynamicResource Daynote.Style.IconPresenter}" Data="{DynamicResource Daynote.Icon.Geometry.ChevronLeft}" IsHitTestVisible="False" />
                    </Button>
                    <Button
                        Style="{DynamicResource Daynote.Style.IconButton.Ghost}"
                        Command="{Binding Calendar.NextMonthCommand}"
                        ToolTip="{loc:Tr NextMonth}"
                        AutomationProperties.Name="{loc:Tr NextMonth}">
                        <Path Style="{DynamicResource Daynote.Style.IconPresenter}" Data="{DynamicResource Daynote.Icon.Geometry.ChevronRight}" IsHitTestVisible="False" />
                    </Button>
                </StackPanel>
                <TextBlock
                    Style="{DynamicResource Daynote.Style.CalendarMonthTitle}"
                    Text="{Binding Calendar.MonthDisplay}"
                    AutomationProperties.Name="{loc:Tr CalendarMonth}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Calendar.Weekdays}" AutomationProperties.Name="{loc:Tr CalendarWeekdayHeader}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{DynamicResource Daynote.Style.Type.Status}" HorizontalAlignment="Center" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Calendar.Days}" AutomationProperties.Name="{loc:Tr CalendarDays}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type sidebar:CalendarDayViewModel}">
                        <ToggleButton
                            Style="{DynamicResource Daynote.Style.CalendarDay}"
                            Content="{Binding DayNumber}"
                            IsChecked="{Binding IsSelected, Mode=OneWay}"
                            Command="{Binding DataContext.Calendar.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding AutomationName}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
