<UserControl
    x:Class="Daynote.App.Shell.Product.DeskListsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pvm="clr-namespace:Daynote.App.Shell.Product;assembly=Daynote.Presentation"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance product:ProductShellViewModel}">

    <!--
      The four lists the sidebar opens, filling the middle of the window: to-dos, favourites, tags
      and files. They were the right rail's tabs; the panel view models did not change, only where
      they are drawn.
    -->

    <UserControl.Resources>
        <!-- One to-do, in the full-width list: the tick, the text, the note it came from, the due
             chip. The day panel draws a tighter version of the same row. -->
        <DataTemplate x:Key="Daynote.Desk.Template.TodoListRow" DataType="{x:Type pvm:TodoItemViewModel}">
            <Border BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
                <Button Style="{DynamicResource Daynote.Desk.Button.Row}" product:DeskVisual.CornerRadius="0"
                        Padding="18,14" Command="{Binding JumpCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{DynamicResource Daynote.Desk.Button.CheckLarge}" Margin="0,0,14,0"
                                Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Text}">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Style="{DynamicResource Daynote.Desk.Style.CheckMark}"
                                  Data="{DynamicResource Daynote.Desk.Geo.Check}" />
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="14" TextWrapping="Wrap" Text="{Binding Text}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Checked}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="12" Margin="0,2,0,0"
                                       Text="{Binding NoteLabel}" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource Daynote.Product.Brush.Seg}" CornerRadius="6"
                                Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasDue, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.Due}" FontSize="12" FontWeight="Bold"
                                       product:DeskVisual.IsActive="{Binding Overdue}" Text="{Binding DueLabel}" />
                        </Border>
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Padding="28,32,28,48" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock FontSize="26" FontWeight="ExtraBold" VerticalAlignment="Bottom" Text="{Binding ListTitle}" />
                <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" FontSize="13" Margin="10,0,0,4"
                           VerticalAlignment="Bottom" Text="{Binding ListSubtitle}" />
            </StackPanel>

            <!-- To-dos, every note on every date. -->
            <StackPanel Visibility="{Binding TabIsTodo, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <Border Style="{DynamicResource Daynote.Desk.Style.Panel}" ClipToBounds="True"
                        Visibility="{Binding Todo.IsEmpty, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Todo.TodayItems}"
                                      ItemTemplate="{StaticResource Daynote.Desk.Template.TodoListRow}" />
                        <ItemsControl ItemsSource="{Binding Todo.Items}"
                                      ItemTemplate="{StaticResource Daynote.Desk.Template.TodoListRow}" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{DynamicResource Daynote.Desk.Text.Empty}" Text="{loc:Tr TodoEmptyText}"
                           Visibility="{Binding Todo.IsEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
            </StackPanel>

            <!-- Favourites, as cards. -->
            <StackPanel Visibility="{Binding TabIsFavorites, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Favorites.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemWidth="232" ItemHeight="142" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pvm:FavoriteItemViewModel}">
                            <Button Style="{DynamicResource Daynote.Desk.Button.Card}" Padding="18,16" Margin="0,0,12,12"
                                    Command="{Binding OpenCommand}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="12" Text="{Binding DateLabel}" />
                                    <TextBlock FontSize="15" FontWeight="Bold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Title}" />
                                    <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" FontSize="12.5" Margin="0,6,0,0"
                                               TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Preview}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{DynamicResource Daynote.Desk.Text.Empty}" Text="{loc:Tr FavoritesPanelEmpty}"
                           Visibility="{Binding Favorites.IsEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
            </StackPanel>

            <!-- Tags: a row per tag, opening to the notes that carry it. -->
            <StackPanel Visibility="{Binding TabIsTags, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding TagPanel.Tags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pvm:TagItemViewModel}">
                            <Border Style="{DynamicResource Daynote.Desk.Style.Panel}" ClipToBounds="True" Margin="0,0,0,8">
                                <StackPanel>
                                    <Button Style="{DynamicResource Daynote.Desk.Button.Row}" product:DeskVisual.CornerRadius="0"
                                            Padding="18,14" Command="{Binding ToggleExpandCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Tag already carries its '#'. -->
                                            <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}" Text="{Binding Tag}" />
                                            <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="12"
                                                       VerticalAlignment="Center" Text="{Binding NoteCountText}" />
                                        </Grid>
                                    </Button>
                                    <Border Padding="8,6" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,1,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding Occurrences}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type pvm:TagOccurrenceViewModel}">
                                                    <Button Style="{DynamicResource Daynote.Desk.Button.Row}" product:DeskVisual.CornerRadius="8"
                                                            Padding="10,9" Command="{Binding JumpCommand}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontSize="13" TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding NoteTitle}" />
                                                            <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Desk.Text.Faint}"
                                                                       FontSize="12" Margin="10,0,0,0" Text="{Binding DateLabel}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{DynamicResource Daynote.Desk.Text.Empty}" Text="{loc:Tr TagPanelEmpty}"
                           Visibility="{Binding TagPanel.IsEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
            </StackPanel>

            <!-- Files on the selected day: a drop zone, then the cards. -->
            <StackPanel Visibility="{Binding TabIsFiles, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <Button Style="{DynamicResource Daynote.Desk.Button.Bare}" HorizontalContentAlignment="Stretch"
                        Margin="0,0,0,12" Command="{Binding Files.AddFilesCommand}" AllowDrop="True">
                    <Grid>
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource Daynote.Product.Brush.Stroke}"
                                   StrokeThickness="1.5" StrokeDashArray="4,3" Fill="Transparent" />
                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" FontSize="13" Margin="22"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding FilesDropText}" />
                    </Grid>
                </Button>
                <ItemsControl ItemsSource="{Binding Files.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemWidth="212" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pvm:FileItemViewModel}">
                            <Border Style="{DynamicResource Daynote.Desk.Style.Panel}" ClipToBounds="True" Margin="0,0,12,12"
                                    MouseLeftButtonDown="OnFileCardDoubleClick" ToolTip="{loc:Tr SaveFileTip}">
                                <StackPanel>
                                    <Grid Height="96" Background="{DynamicResource Daynote.Product.Brush.Seg}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               Visibility="{Binding HasThumbnail, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="13" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Ext}"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />
                                    </Grid>
                                    <Grid Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="11.5" Margin="0,1,0,0"
                                                       Text="{Binding SizeLabel}"
                                                       Visibility="{Binding WasSaved, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Daynote.Product.Brush.Ok}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding SavedTo}"
                                                       Visibility="{Binding WasSaved, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                                                       Text="{loc:Tr SaveFileFailed}"
                                                       Visibility="{Binding SaveFailed, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="11.5"
                                                       Text="{loc:Tr FileAwaitingDownload}"
                                                       Visibility="{Binding IsAwaitingDownload, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{DynamicResource Daynote.Desk.Button.LinkFaint}" FontSize="11.5"
                                                VerticalAlignment="Center" Margin="8,0,0,0" Content="{loc:Tr DeskFileDelete}"
                                                Command="{Binding DeleteCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
