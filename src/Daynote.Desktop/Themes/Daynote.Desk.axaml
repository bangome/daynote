<!--
  The desktop's own palette: design "Daynote Desktop B" (.omc/design/Daynote Desktop B.dc.html), whose
  :root and body.dark tokens are transcribed here one for one.

  It is merged after Daynote.Product.axaml and redefines the shared Product keys, so everything that
  already paints with them - the account card, the tutorial, the sticky note - takes the new colours
  without a rename. The shared file itself is left alone on purpose: the phone app compiles it too, and
  PaletteParityTests holds it to the WPF palette. What only this design has (the navy sidebar, the
  orange "sun" marks, the primary fill that turns orange in the dark) gets Daynote.Desk.* keys.

  Token map, design → key:
    bg → Bg1/Bg2 · panel → Panel · card → Card · stroke → Stroke · stroke2 → Stroke2
    text → Text · text2 → Text2 · text3 → Desk.Text3 · accent → Accent · accent-soft → AccentSoft
    pri / on-pri → Desk.Pri / Desk.OnPri · sun / sun-ink / sun-soft → Desk.Sun* · sunday → Desk.Sunday
    danger → Danger/Overdue · hover → Hover · seg → Seg · input → Input · side* → Desk.Side*
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Daynote.Product.Brush.Bg1" Color="#FFF6F5F1" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Bg2" Color="#FFF6F5F1" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Panel" Color="#FFFFFEFB" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Card" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Stroke" Color="#FFE6E3DA" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Stroke2" Color="#FFEFECE5" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Text" Color="#FF161A36" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Text2" Color="#FF62667D" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Accent" Color="#FF1B2356" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.AccentSoft" Color="#121B2356" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Hover" Color="#0B161A36" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Seg" Color="#FFEFEDE6" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Input" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.OnAccent" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.SelectionBg" Color="#FF1B2356" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.SelectionText" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Extras" Color="#FFEE7F35" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sun" Color="#FFCF4A3F" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sat" Color="#FF9A9CAA" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Ok" Color="#FF2FB574" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Danger" Color="#FFCF4A3F" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.DangerSoft" Color="#1ACF4A3F" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Overdue" Color="#FFCF4A3F" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Sticky" Color="#FFFFE99A" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.StickyText" Color="#FF3B2F10" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Scrim.Modal" Color="#660E1020" />

      <SolidColorBrush x:Key="Daynote.Desk.Brush.Text3" Color="#FF9A9CAA" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Pri" Color="#FF1B2356" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.OnPri" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Sun" Color="#FFEE7F35" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SunInk" Color="#FFB4531A" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SunSoft" Color="#21EE7F35" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Sunday" Color="#FFCF4A3F" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Side" Color="#FF161B40" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SideText" Color="#FFECEEF9" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Side2" Color="#FF9CA1C6" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SideHover" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SideActive" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SideStroke" Color="#17FFFFFF" />
      <BoxShadows x:Key="Daynote.Desk.Shadow.Pop">0 20 60 0 #33161A36, 0 2 8 0 #14161A36</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Daynote.Product.Brush.Bg1" Color="#FF0E1020" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Bg2" Color="#FF0E1020" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Panel" Color="#FF141729" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Card" Color="#FF171A2E" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Stroke" Color="#FF262A42" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Stroke2" Color="#FF1F2238" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Text" Color="#FFECEAF2" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Text2" Color="#FF9A9CB3" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Accent" Color="#FFFFAD72" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.AccentSoft" Color="#1FFF9A52" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Hover" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Seg" Color="#FF1C1F35" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Input" Color="#FF171A2E" />
      <!-- The dark accent is a pale orange; ink on it has to be dark, as the design's on-pri is. -->
      <SolidColorBrush x:Key="Daynote.Product.Brush.OnAccent" Color="#FF1A1206" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.SelectionBg" Color="#FFFFAD72" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.SelectionText" Color="#FF0E1020" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Extras" Color="#FFFF9A52" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sun" Color="#FFFF8076" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Weekend.Sat" Color="#FF6C6F88" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Ok" Color="#FF2FB574" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Danger" Color="#FFFF8076" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.DangerSoft" Color="#1FFF8076" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Overdue" Color="#FFFF8076" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Sticky" Color="#FFFFE99A" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.StickyText" Color="#FF3B2F10" />
      <SolidColorBrush x:Key="Daynote.Product.Brush.Scrim.Modal" Color="#660E1020" />

      <SolidColorBrush x:Key="Daynote.Desk.Brush.Text3" Color="#FF6C6F88" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Pri" Color="#FFFF9A52" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.OnPri" Color="#FF1A1206" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Sun" Color="#FFFF9A52" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SunInk" Color="#FFFFB27A" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SunSoft" Color="#24FF9A52" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Sunday" Color="#FFFF8076" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Side" Color="#FF0A0C18" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SideText" Color="#FFE6E7F2" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.Side2" Color="#FF8B8FAE" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SideHover" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SideActive" Color="#17FFFFFF" />
      <SolidColorBrush x:Key="Daynote.Desk.Brush.SideStroke" Color="#0FFFFFFF" />
      <BoxShadows x:Key="Daynote.Desk.Shadow.Pop">0 20 60 0 #99000000, 0 2 8 0 #59000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Theme-independent marks. The avatar disc is the sun in both themes, and its initial stays navy
       on it, as the design draws it. Sunday on the navy sidebar is its own warmer red. -->
  <SolidColorBrush x:Key="Daynote.Desk.Brush.AvatarInk" Color="#FF161A36" />
  <SolidColorBrush x:Key="Daynote.Desk.Brush.SideSunday" Color="#FFFF8F86" />
  <SolidColorBrush x:Key="Daynote.Desk.Brush.Saved" Color="#FF2FB574" />
  <SolidColorBrush x:Key="Daynote.Desk.Brush.PostItShadow" Color="#403C2800" />

  <!-- Pretendard, bundled (OFL). The design asks for weights 400-800; the four static cuts cover
       them, and 500 resolves to the regular cut. -->
  <FontFamily x:Key="Daynote.Desk.Font.Sans">avares://Daynote.Desktop/Assets/Fonts#Pretendard</FontFamily>
  <FontFamily x:Key="Daynote.Desk.Font.Mono">Menlo, Consolas, monospace</FontFamily>
  <!-- Fluent reads this key for every templated control's text; pointing it at Pretendard keeps text
       boxes and buttons in the same face as the TextBlocks around them. -->
  <FontFamily x:Key="ContentControlThemeFontFamily">avares://Daynote.Desktop/Assets/Fonts#Pretendard</FontFamily>

  <!-- The design's line icons, each on the viewBox it was drawn on (noted per mark). -->
  <!-- 10x10 chevrons and the plus. -->
  <StreamGeometry x:Key="Daynote.Desk.Geo.ChevronLeft">M6.5,1 L2.5,5 L6.5,9</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Desk.Geo.ChevronRight">M3.5,1 L7.5,5 L3.5,9</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Desk.Geo.Plus">M5,1 V9 M1,5 H9</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Desk.Geo.Close">M2,2 L8,8 M8,2 L2,8</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Desk.Geo.Check">M1.5,5.5 L4,8 L8.5,2.5</StreamGeometry>
  <!-- 16x16. -->
  <StreamGeometry x:Key="Daynote.Desk.Geo.Search">M7,2.5 A4.5,4.5 0 1 1 7,11.5 A4.5,4.5 0 1 1 7,2.5 Z M10.5,10.5 L14,14</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Desk.Geo.Sliders">M2.5,5 H4.2 M7.8,5 H13.5 M2.5,11 H8.2 M11.8,11 H13.5 M6,3.2 A1.8,1.8 0 1 1 6,6.8 A1.8,1.8 0 1 1 6,3.2 Z M10,9.2 A1.8,1.8 0 1 1 10,12.8 A1.8,1.8 0 1 1 10,9.2 Z</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Desk.Geo.Sun">M8,4.8 A3.2,3.2 0 1 1 8,11.2 A3.2,3.2 0 1 1 8,4.8 Z M8,1 V2.6 M8,13.4 V15 M1,8 H2.6 M13.4,8 H15</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Desk.Geo.Moon">M13.5,9.5 A5.8,5.8 0 1 1 6.5,2.5 A4.6,4.6 0 0 0 13.5,9.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Desk.Geo.Panel">M3.5,2.5 H12.5 A2,2 0 0 1 14.5,4.5 V11.5 A2,2 0 0 1 12.5,13.5 H3.5 A2,2 0 0 1 1.5,11.5 V4.5 A2,2 0 0 1 3.5,2.5 Z M10,2.5 V13.5</StreamGeometry>
  <!-- 12x12 star (filled or stroked by the consumer). -->
  <StreamGeometry x:Key="Daynote.Desk.Geo.Star">M6,0.8 L7.5,4.2 L11.2,4.6 L8.4,7 L9.2,10.7 L6,8.8 L2.8,10.7 L3.6,7 L0.8,4.6 L4.5,4.2 Z</StreamGeometry>
  <!-- 14x14 post-it and trash. -->
  <StreamGeometry x:Key="Daynote.Desk.Geo.PostIt">M2,2 H12 V8.5 L8.5,12 H2 Z M12,8.5 H8.5 V12</StreamGeometry>
  <StreamGeometry x:Key="Daynote.Desk.Geo.Trash">M2,3.5 H12 M5.5,3.5 V2 H8.5 V3.5 M3.5,3.5 L4.2,12 H9.8 L10.5,3.5</StreamGeometry>
</ResourceDictionary>
