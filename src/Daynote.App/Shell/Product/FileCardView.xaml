<UserControl
    x:Class="Daynote.App.Shell.Product.FileCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pvm="clr-namespace:Daynote.App.Shell.Product;assembly=Daynote.Presentation"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance pvm:FileItemViewModel}">
    <!--
      One attachment card in the files tab. Lifted out of ProductWindow.xaml, which the source-size
      guard keeps under 700 lines. It is a control rather than a template in a dictionary because it
      carries event handlers, and a ResourceDictionary cannot: the drag-to-editor gesture and the
      double-click-to-save gesture both live in its own code-behind, where they need nothing from the
      window.
    -->
<!-- Drag a card into the editor body to drop a [[file:…]] link; a body link click
     highlights the card via IsHighlighted (accent border). -->
<Border Background="{DynamicResource Daynote.Product.Brush.Card}"
        BorderThickness="1" CornerRadius="{DynamicResource Daynote.Product.Radius.Panel}" Padding="10,8" Margin="0,0,0,4"
        PreviewMouseLeftButtonDown="OnFileCardMouseDown"
        PreviewMouseMove="OnFileCardMouseMove"
        ToolTip="{loc:Tr SaveFileTip}">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
    <StackPanel>
        <Border Height="110" CornerRadius="{DynamicResource Daynote.Product.Radius.Small}" Margin="0,0,0,8"
                Visibility="{Binding HasThumbnail, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
            <Border.Background>
                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="{DynamicResource Daynote.Product.Radius.Small}"
                    Background="{DynamicResource Daynote.Product.Brush.AccentSoft}" Margin="0,0,10,0">
                <Grid>
                    <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Image}"
                          Stroke="{DynamicResource Daynote.Product.Brush.Accent}" StrokeThickness="1.3" Fill="{x:Null}"
                          Visibility="{Binding ShowImageBadge, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    <TextBlock Text="{Binding Ext}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Accent}"
                               Visibility="{Binding ShowDocBadge, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Daynote.Product.Brush.Text}" />
                <TextBlock Text="{Binding SizeLabel}" FontSize="10.5" Margin="0,1,0,0"
                           Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                           Visibility="{Binding WasSaved, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}" />
                <TextBlock Text="{Binding SavedTo}" FontSize="10.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Daynote.Product.Brush.Ok}"
                           Visibility="{Binding WasSaved, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                <TextBlock Text="{loc:Tr SaveFileFailed}" FontSize="10.5" Margin="0,1,0,0"
                           Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                           Visibility="{Binding SaveFailed, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                <!-- Another device attached this and the bytes are still coming. Said plainly, or a
                     half-arrived attachment is indistinguishable from a ready one. -->
                <TextBlock Text="{loc:Tr FileAwaitingDownload}" FontSize="10.5" Margin="0,1,0,0"
                           Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                           Visibility="{Binding IsAwaitingDownload, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
            </StackPanel>
            <Button Grid.Column="2" Content="{loc:Tr Delete}" FontSize="11" VerticalAlignment="Center"
                    Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                    Style="{DynamicResource Daynote.Product.Style.GhostButton}" Command="{Binding DeleteCommand}" />
        </Grid>
    </StackPanel>
</Border>
</UserControl>
