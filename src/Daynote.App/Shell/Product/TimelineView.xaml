<UserControl
    x:Class="Daynote.App.Shell.Product.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pvm="clr-namespace:Daynote.App.Shell.Product;assembly=Daynote.Presentation"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance product:ProductShellViewModel}">

    <!--
      Every note, newest day first, as the design draws it: each day's date in a column of its own
      with its notes beside it, a hairline between days, and nothing boxed that does not need to be.
      The date opens that day in the editor.

      Bound to the shell rather than to the timeline view model alone, because the rows are folded
      into days by the shell (TimelineGroups) and the date column's command lives there too.
    -->

    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="28,32,28,48"
                      ScrollChanged="OnScrollChanged"
                      Visibility="{Binding Timeline.IsEmpty, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
            <!-- A reading column, not the full width of the window: stretched, so the note cards
                 fill the space beside the date, and capped so a wide window does not run lines
                 halfway across the desk. -->
            <StackPanel MaxWidth="860">
                <ItemsControl ItemsSource="{Binding TimelineGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pvm:TimelineDayGroup}">
                            <Border Padding="0,22" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The date is the way back into that day. -->
                                    <Button Grid.Column="0" VerticalAlignment="Top" Style="{DynamicResource Daynote.Desk.Button.Link}"
                                            Command="{Binding DataContext.OpenTimelineDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Heading}">
                                        <StackPanel>
                                            <TextBlock FontSize="15" FontWeight="ExtraBold" TextWrapping="Wrap" Text="{Binding Heading}" />
                                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" FontSize="12" Margin="0,3,0,0"
                                                       Text="{Binding CountText}" />
                                        </StackPanel>
                                    </Button>

                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type pvm:TimelineNoteRow}">
                                                <Border Style="{DynamicResource Daynote.Desk.Style.Panel}" Padding="20,18" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <Button Style="{DynamicResource Daynote.Desk.Button.Link}" Command="{Binding OpenCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Title}" />
                                                                <Path Width="12" Height="12" Stretch="Uniform" Margin="7,0,0,0" VerticalAlignment="Center"
                                                                      Data="{DynamicResource Daynote.Desk.Geo.Star}"
                                                                      Fill="{DynamicResource Daynote.Desk.Brush.Sun}" Stroke="{x:Null}"
                                                                      Visibility="{Binding IsFavorite, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" FontSize="13.5" LineHeight="24.3"
                                                                   TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding DisplayBody}" />
                                                        <Button Style="{DynamicResource Daynote.Desk.Button.LinkSun}" FontSize="12.5" FontWeight="SemiBold"
                                                                Margin="0,8,0,0" Content="{Binding ExpandLabel}" Command="{Binding ToggleExpandCommand}"
                                                                Visibility="{Binding IsTruncated, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The scroll loads the next page on its own; this is the same thing for a pointer
                     that has stopped, and the only affordance a keyboard user has. -->
                <Button Style="{DynamicResource Daynote.Desk.Button.Quiet}" HorizontalAlignment="Center" Margin="0,20,0,0"
                        Content="{loc:Tr DeskLoadMore}" Command="{Binding Timeline.LoadMoreCommand}"
                        Visibility="{Binding Timeline.HasMore, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Style="{DynamicResource Daynote.Desk.Text.Empty}" TextAlignment="Center"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Text="{loc:Tr TimelineEmpty}"
                   Visibility="{Binding Timeline.IsEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
    </Grid>
</UserControl>
