<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Panel: the rounded white (or graphite) surface every region sits on. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Panel}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Quiet toolbar button: text only, hover wash, pill radius. -->
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Pill}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
  </Style>

  <!-- Windows caption buttons. Square, full-height, no radius: they are the window's own controls,
       not the app's, and Windows users read them by that shape. Close reddens on hover, as everywhere
       else on the platform. -->
  <Style Selector="Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="46" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
  </Style>

  <!-- Primary accent button. -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Pill}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- Calendar day cell: a 36px circle that fills with the accent when selected. -->
  <Style Selector="Button.day">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
  </Style>
  <Style Selector="Button.day:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
  </Style>
  <Style Selector="Button.day.outside">
    <Setter Property="Opacity" Value="0.28" />
  </Style>
  <Style Selector="Button.day.sunday">
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Weekend.Sun}" />
  </Style>
  <Style Selector="Button.day.saturday">
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Weekend.Sat}" />
  </Style>
  <Style Selector="Button.day.today">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.day.selected">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
  </Style>
  <Style Selector="Button.day.selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
  </Style>
  <!--
    The day number follows the cell's Foreground instead of inheriting it. The global TextBlock rule
    above sets Foreground on every TextBlock, which outranks inheritance - so the selected, Sunday and
    Saturday colours were all being set on the button and never reaching the digits. Measured on the
    selected cell: the ink was #1A2877 on a #0067C0 fill, not the on-accent white it was meant to be.
  -->
  <Style Selector="Button.day TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- Calendar day heat dot (v3.1), matching the WPF Daynote.Product.Style.Calendar.HeatDot:
       GitHub-contribution style, light sky / sky / blue for 1, 2 and 3+ notes, with extras alone
       counting as level 1. The dot always occupies its space — it sits in a Grid cell over the day
       number rather than under it, so an empty day cannot pull the number off the shared baseline.
       Three classes rather than one binding on the level: Avalonia style classes take a bool. -->
  <Style Selector="Ellipse.heat">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Ellipse.heat.l1">
    <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Heat1}" />
  </Style>
  <Style Selector="Ellipse.heat.l2">
    <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Heat2}" />
  </Style>
  <Style Selector="Ellipse.heat.l3">
    <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Heat3}" />
  </Style>
  <!-- On the selected day the cell is filled with the accent, and the heat brushes are shades of
       that same accent — so the dot would disappear into it. Paint it in the on-accent colour. -->
  <Style Selector="Button.day.selected Ellipse.heat.l1, Button.day.selected Ellipse.heat.l2, Button.day.selected Ellipse.heat.l3">
    <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
  </Style>

  <!-- The sync dot on the account avatar: grey when there is nothing to say, green when settled,
       accent while working, amber when the user has to act. It is ringed in the window background so
       it reads as a badge on the disc rather than a hole in it; the flat variant inside the menu sits
       on a panel beside its own label and needs no ring. Same buckets as the WPF SyncDot styles. -->
  <Style Selector="Ellipse.syncdot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,-1,-1" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.Bg1}" />
    <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
  </Style>
  <Style Selector="Ellipse.syncdot.flat">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="StrokeThickness" Value="0" />
  </Style>
  <Style Selector="Ellipse.syncdot.settled">
    <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Ok}" />
  </Style>
  <Style Selector="Ellipse.syncdot.working">
    <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
  </Style>
  <Style Selector="Ellipse.syncdot.attention">
    <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Warn}" />
  </Style>

  <!-- Square icon button, used by the title bar's Today and Timeline: the mark carries the meaning
       and the label moves to the tooltip. `selected` is for a toggle that is currently on (timeline),
       and reads as a filled accent-soft chip rather than a border, so it cannot be confused with
       keyboard focus. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Control}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
  </Style>
  <Style Selector="Button.icon.selected">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
  </Style>
  <Style Selector="Button.icon.selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
  </Style>
  <!-- The mark inherits the button's Foreground, so hover and selected reach it without a second
       rule per state. Stroked, never filled: every geometry in Daynote.Icons.axaml is a line drawing. -->
  <Style Selector="Button.icon Path">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
  </Style>

  <!-- Editor-card action: a 30px ghost square, smaller and quieter than the title-bar `icon` because
       it sits beside the note title rather than in the chrome. -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Control}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
  </Style>
  <Style Selector="Button.ghost Path">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <!-- The favourite star: an outline until it is one, then filled in the extras amber. -->
  <Style Selector="Button.ghost.favorite">
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Extras}" />
  </Style>
  <Style Selector="Button.ghost.favorite Path">
    <Setter Property="Fill" Value="{DynamicResource Daynote.Product.Brush.Extras}" />
  </Style>

  <!--
    The tag entry, which flows straight after the last chip rather than sitting in a pill of its own.
    Borderless and muted so the row reads as "these are the tags, and here is where you add one";
    Avalonia draws PlaceholderText itself, so it needs none of the watermark scaffolding the WPF
    version carries.
  -->
  <Style Selector="TextBox.tagentry">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Width" Value="96" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
  </Style>
  <Style Selector="TextBox.tagentry /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.tagentry:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.tagentry:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- The account strip at the foot of the left column: a full-width row, not a chip, so it reads as
       part of the sidebar rather than a floating control. -->
  <Style Selector="Button.accountbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Control}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
  </Style>
  <!-- The resting state has to be set on the ContentPresenter, not just on the button: the Fluent
       template paints its own ButtonBackground there, which outranks a Background on the button and
       left the strip sitting in a grey slab. Measured, not assumed — #E9E9EA against a #F4F4F5 page. -->
  <Style Selector="Button.accountbar /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.accountbar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
  </Style>
  <Style Selector="Button.accountbar Path">
    <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- A row inside the account menu: icon, label, full width, quiet until hovered. -->
  <Style Selector="Button.menurow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Control}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
  </Style>
  <Style Selector="Button.menurow:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
  </Style>
  <Style Selector="Button.menurow Path">
    <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <!-- Note list row. -->
  <Style Selector="Button.noterow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="11,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Control}" />
  </Style>
  <Style Selector="Button.noterow:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
  </Style>
  <Style Selector="Button.noterow.selected">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
  </Style>
  <Style Selector="Button.noterow.selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
  </Style>

  <!-- Editor: borderless text surface on the card. -->
  <Style Selector="TextBox.editor">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.editor:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.editor:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Segmented tab header on the Seg track: the active tab is a raised card with accent text. -->
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,7" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
  </Style>
  <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
  </Style>
  <!-- The tab's mark and its count follow the button's Foreground, so the active accent and the
       hover colour reach them. The TextBlock rule is not optional: the global TextBlock style sets
       Foreground on every TextBlock and that outranks inheritance, which is what kept the todo
       count from ever turning accent on the active tab. -->
  <Style Selector="Button.tab Path">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Button.tab TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- Clickable card row used by the todo, favorites, tags, files, search and timeline lists. -->
  <Style Selector="Button.card">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Panel}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
  </Style>
  <Style Selector="Button.card.highlighted">
    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
  </Style>

  <!-- Todo check circle. -->
  <Style Selector="Button.check">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.check.checked">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
  </Style>
  <Style Selector="Button.check:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
  </Style>
  <Style Selector="Button.check.checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
  </Style>
  <Style Selector="TextBlock.done">
    <Setter Property="TextDecorations" Value="Strikethrough" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
  </Style>
  <Style Selector="TextBlock.due">
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.due.overdue">
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Danger}" />
  </Style>

  <!-- Tag chip: pill with the tag text and a small remove button. -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Pill}" />
    <Setter Property="Padding" Value="10,3,4,3" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.chipx">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Pill}" />
  </Style>

  <!-- Inline input on a panel (tag entry, search). -->
  <Style Selector="TextBox.inline">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Daynote.Product.Radius.Pill}" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
  </Style>
  <Style Selector="TextBox.inline:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
  </Style>
  <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
  </Style>

  <!-- Empty-state caption centred in a panel. -->
  <Style Selector="TextBlock.empty">
    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="12,28" />
  </Style>
</Styles>
