<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The shared mobile app: one Avalonia UI that both heads (Android, iOS) start. It targets plain
      net10.0 rather than the mobile TFMs on purpose — nothing here may touch Java or UIKit, so the
      phone UI stays buildable and testable on any machine, and every platform service arrives
      through a port the head fills in (MobileServiceRegistration).

      Namespaces keep the Daynote.App.* convention of the presentation layer for the view models it
      reuses; this project's own types live under Daynote.Mobile.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Daynote.Mobile</RootNamespace>
    <AssemblyName>Daynote.Mobile</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Nullable>enable</Nullable>
    <!--
      The Android RIDs, for the same reason the Mac ones are here: an Android head always builds
      RID-specific, so it asks this project for an android-arm64 target and locked-mode restore
      rejects one the project never declared. Only arm64 and x64 (the emulator): .NET 10 dropped
      32-bit Android, and its RIDs map to runtime packs that are not published.

      iOS is deliberately absent. Its runtime packs only resolve under a net10.0-ios target, so
      declaring ios-arm64 on a net10.0 project fails outright; the iOS head reaches this assembly
      through the framework-dependent path instead and needs nothing here.
    -->
    <RuntimeIdentifiers>$(RuntimeIdentifiers);android-arm64;android-x64</RuntimeIdentifiers>
    <!-- The version the settings page shows. Keep in step with ApplicationDisplayVersion in both heads. -->
    <Version>1.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daynote.Core\Daynote.Core.csproj" />
    <ProjectReference Include="..\Daynote.Infrastructure\Daynote.Infrastructure.csproj" />
    <ProjectReference Include="..\Daynote.Presentation\Daynote.Presentation.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pretendard, the family the whole phone UI is set in (Themes/Daynote.Mobile.Palette.axaml) and
      the Hangul fallback Android needs anyway, since its system CJK font does not render at regular
      weight; see MainApplication. Five static weights, 400 to 800, because the design uses all of
      them. OFL-licensed; the licence travels with the files.
    -->
    <AvaloniaResource Include="Assets\Fonts\*.otf" />
    <None Include="Assets\Fonts\LICENSE-Pretendard.txt" />
    <AvaloniaResource Include="..\Daynote.App\Assets\Brand\daynote-favicon-v1.png" Link="Assets\daynote-favicon-v1.png" />
    <AvaloniaResource Include="..\Daynote.App\Assets\Brand\daynote-logo-trimmed.png" Link="Assets\daynote-logo-trimmed.png" />
    <AvaloniaResource Include="..\Daynote.App\Assets\Brand\daynote-logo-dark-trimmed.png" Link="Assets\daynote-logo-dark-trimmed.png" />
    <AvaloniaResource Include="..\Daynote.App\Assets\Brand\daynote-logo-en-trimmed.png" Link="Assets\daynote-logo-en-trimmed.png" />
    <AvaloniaResource Include="..\Daynote.App\Assets\Brand\daynote-logo-en-dark-trimmed.png" Link="Assets\daynote-logo-en-dark-trimmed.png" />
  </ItemGroup>
</Project>
