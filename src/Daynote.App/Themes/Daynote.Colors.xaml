    <Color x:Key="Daynote.Color.Status.Success.Surface">#FFEDF3EC</Color>
    <Color x:Key="Daynote.Color.Status.Warning">#FF8A5A00</Color>
    <Color x:Key="Daynote.Color.Status.Warning.Surface">#FFFBF3DB</Color>
    <Color x:Key="Daynote.Color.Status.Error">#FFB42318</Color>
    <Color x:Key="Daynote.Color.Status.Error.Surface">#FFFDEBEC</Color>
    <Color x:Key="Daynote.Color.Transparent">#00FFFFFF</Color>

