<Project Sdk="MSTest.Sdk/4.3.2">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Daynote.Infrastructure\Daynote.Infrastructure.csproj" />
  </ItemGroup>
  <!-- The packaging manifest is parsed by the Todo 11 policy tests; copy it to the
       test output so the assertions run without walking the repo tree. -->
  <ItemGroup>
    <Content Include="..\..\packaging\Daynote.Package\Package.appxmanifest" Link="Packaging\Package.appxmanifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
