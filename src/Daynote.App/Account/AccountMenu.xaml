<UserControl
    x:Class="Daynote.App.Account.AccountMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:account="clr-namespace:Daynote.App.Account"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance account:AccountViewModel}">
    <!--
      The titlebar account button and the menu under it ("Daynote v3.dc.html").

      This replaces the settings gear. Settings did not disappear — it is a button inside this menu —
      but the account is what belongs in the titlebar: it is the thing with a live state to report.
      That state is the dot on the avatar, which is also why the separate worded sync chip is gone: two
      indicators for one fact is one too many, and the words are still on the avatar's tooltip and in
      the menu row.

      Signed out, the avatar is an outline rather than a letter, and the menu offers sign-in instead
      of an account. The button is never hidden: unlike the old chip, it is the way to settings.
    -->
    <Grid>
        <!-- No account view model means this build has no sync endpoint, so there is no account to
             show — but settings still has to be reachable. In that case the old gear stands here
             instead, which is why the fallback lives inside this control rather than in the titlebar:
             the two are one button in two states, not two buttons. -->
        <Button Style="{DynamicResource Daynote.Product.Style.Button.Round}"
                Click="OnOpenSettings" ToolTip="{loc:Tr SettingsTitle}"
                VerticalAlignment="Center"
                Visibility="{Binding Converter={StaticResource Daynote.Convert.NullToCollapsed}}"
                AutomationProperties.Name="{loc:Tr SettingsTitle}">
            <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource Daynote.Product.Geo.Settings}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="{x:Null}" />
        </Button>

        <ToggleButton x:Name="Toggle" Style="{DynamicResource Daynote.Product.Style.Account.AvatarButton}"
                      ToolTip="{Binding AvatarTooltip}"
                      AutomationProperties.Name="{loc:Tr AccountMenuAutomation}"
                      AutomationProperties.HelpText="{Binding Status.Label}"
                      Visibility="{Binding Converter={StaticResource Daynote.Convert.NullToVisibility}}">
            <Grid Width="34" Height="34">
                <!-- Signed in: the accent disc with the address's first letter, and the sync dot. -->
                <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <Border Style="{DynamicResource Daynote.Product.Style.Account.Avatar}">
                        <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.AvatarText}" Text="{Binding AvatarInitial}" />
                    </Border>
                    <Ellipse Style="{DynamicResource Daynote.Product.Style.Account.SyncDot}" />
                </Grid>
                <!-- Signed out: no state to report, so no dot. -->
                <Path Width="17" Height="17" Stretch="Uniform" Fill="{x:Null}"
                      Data="{DynamicResource Daynote.Product.Geo.Person}"
                      Stroke="{DynamicResource Daynote.Product.Brush.Text2}"
                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding IsSignedOut, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
            </Grid>
        </ToggleButton>

        <Popup IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
               HorizontalOffset="-256" VerticalOffset="8"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="{DynamicResource Daynote.Product.Size.AccountMenu.Width}"
                    Background="{DynamicResource Daynote.Product.Brush.Card}"
                    BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="12"
                    Effect="{DynamicResource Daynote.Product.Effect.DropdownShadow}">
                <StackPanel>
                    <!-- ── Signed in ── -->
                    <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                    Background="{DynamicResource Daynote.Product.Brush.Accent}">
                                <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.AvatarText}"
                                           FontSize="14" Text="{Binding AvatarInitial}" />
                            </Border>
                            <TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{DynamicResource Daynote.Product.Style.Settings.RowLabel}"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       Text="{Binding DisplayName}" />
                            <Border Grid.Column="2" Margin="8,0,0,0" Style="{DynamicResource Daynote.Product.Style.Account.PlanPill}">
                                <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.PlanPillText}" Text="{Binding PlanBadge}" />
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0" Padding="12,10"
                                Background="{DynamicResource Daynote.Product.Brush.Panel}"
                                BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Account.SyncDot.Flat}" />
                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.RowLabel}"
                                               FontWeight="SemiBold" FontSize="12" Text="{Binding Status.Label}" />
                                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}"
                                               Margin="0,1,0,0" FontSize="10.5" Text="{Binding LastSyncText}" />
                                </StackPanel>
                                <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Style="{DynamicResource Daynote.Product.Style.Button.Link}"
                                        Command="{Binding SyncCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                                        Content="{loc:Tr AccountSyncNow}"
                                        AutomationProperties.Name="{loc:Tr AccountSyncNow}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ── Signed out: one sentence and the way in. ── -->
                    <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.RowLabel}"
                                   FontWeight="Bold" Text="{loc:Tr AccountSignInTitle}" />
                        <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Text="{loc:Tr AccountSignInLead}" />
                    </StackPanel>

                    <!-- ── Both states: into the account window, or into settings. ── -->
                    <Grid Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{DynamicResource Daynote.Product.Style.Button.Primary}"
                                Click="OnOpenAccount" Content="{loc:Tr AccountManage}"
                                AutomationProperties.Name="{loc:Tr AccountManage}" />
                        <Button Grid.Column="2" Style="{DynamicResource Daynote.Product.Style.Button.Secondary}"
                                Click="OnOpenSettings" Content="{loc:Tr Settings}"
                                AutomationProperties.Name="{loc:Tr Settings}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
