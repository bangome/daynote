<?xml version="1.0" encoding="utf-8"?>
<!-- 4×4 하루 (design B13): the date, the week, the next event, then today's rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">
  <LinearLayout
      android:id="@+id/widget_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="4dp">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="@string/widget_preview_date"
        android:textColor="@color/widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_add"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_primary"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_on_primary"
        android:textSize="22sp" />
  </LinearLayout>
  <LinearLayout
      android:id="@+id/widget_week"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal" />
  <LinearLayout
      android:id="@+id/widget_event"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:background="@drawable/widget_row_single"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:padding="12dp">
    <ImageView
        android:layout_width="4dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_event_bar" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:id="@+id/widget_event_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/widget_text"
          android:textSize="15sp"
          android:textStyle="bold" />
      <TextView
          android:id="@+id/widget_event_span"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textColor="@color/widget_text2"
          android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
      android:id="@+id/widget_rows"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="5dp"
      android:orientation="vertical" />
  <TextView
      android:id="@+id/widget_more"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="14dp"
      android:paddingTop="6dp"
      android:textColor="@color/widget_text2"
      android:textSize="12sp"
      android:visibility="gone" />
  <TextView
      android:id="@+id/widget_message"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:textColor="@color/widget_text2"
      android:textSize="14sp"
      android:visibility="gone" />
</LinearLayout>
