<?xml version="1.0" encoding="utf-8"?>

<!--
  Daynote MSIX manifest — Microsoft Store configuration.

  This is a full-trust WPF desktop package (Windows.FullTrustApplication + the
  runFullTrust restricted capability, the standard Desktop Bridge path the Store
  allows for Win32 apps).

  STORAGE: standard packaged storage, with no unvirtualizedResources capability
  (the earlier sideload build declared it; Store policy avoids it).

  MEASURED 2026-09-07: this package does NOT get its %LocalAppData% writes
  redirected. Running the installed Store build with DAYNOTE_DATA_ROOT unset, the
  database it touched was the real %LocalAppData%\Daynote\daynote.db, and the
  package's LocalCache held no Daynote folder at all. An earlier version of this
  comment asserted the opposite (redirection into LocalCache\Local\Daynote) and was
  wrong; docs/MCP.md repeated it. Whether an uninstall removes that outside-the-
  package folder has NOT been tested; keep treating the in-app Backup as the
  safety net before uninstalling (see docs/DATA_AND_RECOVERY.md).

  The windows.startupTask is DISABLED by default; the app never auto-enables it — the
  user opts in from Settings (Store-compliant).

  IDENTITY: this is the MICROSOFT STORE identity reserved in Partner Center for this app
  (Product identity page). The Store re-signs the package at ingestion, so the sideload
  Build-Package.ps1 -Sign path (self-signed Daynote.Dev cert) will NO LONGER install this
  build locally — use `Build-Package.ps1 -Store` to produce the .msixupload for Partner
  Center. Keep the 4th version part 0 (Store requires revision = 0). See docs/STORE.md.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap3 rescap desktop">

  <Identity
    Name="BreadJinhwaJeong.-Daynote"
    Publisher="CN=7FDB7ABF-3343-4BA9-9F0C-C601ABED42EE"
    Version="1.5.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <!-- Must EXACTLY match a name reserved in Partner Center (Product identity). The app tile can still
         show a shorter name via Application/VisualElements/DisplayName below. -->
    <DisplayName>데이노트 - Daynote</DisplayName>
    <PublisherDisplayName>Bread Jinhwa Jeong</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="Daynote"
      Executable="Daynote.Desktop\Daynote.Desktop.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Daynote"
        Description="A local daily-notes desk with a calendar, to-dos, and day files."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Images\Wide310x150Logo.png"
          Square71x71Logo="Images\Square71x71Logo.png"
          Square310x310Logo="Images\Square310x310Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Images\SplashScreen.png" BackgroundColor="#F7F8FA" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="Daynote.Desktop\Daynote.Desktop.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="DaynoteStartupTask"
            Enabled="false"
            DisplayName="Daynote" />
        </desktop:Extension>

        <!--
          MCP SERVER (docs/MCP.md). The stdio server ships in this package because the alias is the
          only way a client can launch it: the real executable sits under %ProgramFiles%\WindowsApps,
          whose ACLs a client process cannot traverse. (An earlier version of this comment gave a
          second reason, that package identity was needed to reach the same database through
          file-system virtualization. Measured 2026-09-07, this package's %LocalAppData% writes are
          not redirected, so any server opens the same daynote.db regardless. See the STORAGE note
          at the top of this file.) It sits in the app's own folder, so both share one copy of the
          .NET runtime; the
          .wapproj target _DaynoteCoLocateMcpServer does that merge and Build-Package.ps1 verifies it.

          It is declared as an alias on THIS application rather than as an application of its own. An
          <Application> with AppListEntry="none" is a "headless app", which the Store refuses without a
          HeadlessAppBypass entitlement - and giving the server its own visible entry would put a tile
          in the Start menu that does nothing when clicked, since it only speaks stdio. An extension
          may name a different Executable from the application hosting it, which gets the alias
          registered with no second entry point and nothing extra in the app list.

          Windows puts "daynote-mcp.exe" on the user's PATH, so MCP clients are configured with that
          bare command: no path, and nothing under the ACL-locked WindowsApps install folder.
          Settings -> AI integration registers exactly that command.
        -->
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="Daynote.Desktop\Daynote.Mcp.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="daynote-mcp.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>

  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- No internetClient: this build makes no network calls at all. Cloud sync is built but held
         back (DaynoteAppOptions.SyncEnabledByDefault), so declaring a network the app never uses
         would show the user a permission that is not real. Add it back in the same commit that
         flips that flag — the Store lists declared capabilities, and an undeclared network is a
         silent one. See docs/CLOUD_SYNC.md. -->
  </Capabilities>
</Package>
