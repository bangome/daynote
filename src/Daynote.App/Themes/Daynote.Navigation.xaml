<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:showcase="clr-namespace:Daynote.App.Showcase">
    <ControlTemplate x:Key="Daynote.Template.SelectionItem" TargetType="{x:Type TabItem}">
        <Border x:Name="FocusRing" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.Focus}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
            <Border x:Name="FocusGap" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.FocusGap}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Daynote.Radius.Control}" Padding="{TemplateBinding Padding}">
                    <Grid>
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        <Path x:Name="StateIcon" Data="{DynamicResource Daynote.Icon.Geometry.Warning}" Style="{DynamicResource Daynote.Style.IconPresenter.Small}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Border x:Name="SelectionMarker" Height="{DynamicResource Daynote.Border.SelectionMarker}" Background="{DynamicResource Daynote.Brush.Accent.500}" VerticalAlignment="Bottom" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="Tag" Value="Dirty"><Setter TargetName="StateIcon" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="Tag" Value="Error"><Setter TargetName="StateIcon" Property="Data" Value="{DynamicResource Daynote.Icon.Geometry.Error}" /><Setter TargetName="StateIcon" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" /><Setter TargetName="FocusGap" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus.Gap}" /></Trigger>
            <Trigger Property="showcase:ShowcaseForcedState.State" Value="focus"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" /><Setter TargetName="FocusGap" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus.Gap}" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Daynote.Style.TabStrip" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="{x:Type TabControl}"><ItemsPresenter /></ControlTemplate></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Daynote.Style.WorkspaceViewSwitchItem" TargetType="{x:Type TabItem}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.SelectionItem}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource Daynote.Size.Target.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Label.FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Selected}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Disabled}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Daynote.Style.NoteTab" TargetType="{x:Type TabItem}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.SelectionItem}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource Daynote.Size.Target.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Label.FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Primary}" /></Trigger>
            <Trigger Property="Tag" Value="Dirty"><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Status.Warning}" /></Trigger>
            <Trigger Property="Tag" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Status.Error}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="Daynote.Template.CalendarDay" TargetType="{x:Type ToggleButton}">
        <Border x:Name="FocusRing" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.Focus}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
            <Border x:Name="FocusGap" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.FocusGap}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
                <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ContentPresenter Content="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="{DynamicResource Daynote.Inset.Calendar.Cues}" />
                    </Grid>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" /><Setter TargetName="FocusGap" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus.Gap}" /></Trigger>
            <Trigger Property="showcase:ShowcaseForcedState.State" Value="focus"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" /><Setter TargetName="FocusGap" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus.Gap}" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Daynote.Style.CalendarDay" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.CalendarDay}" />
        <Setter Property="Width" Value="{DynamicResource Daynote.Size.Target.Primary}" />
        <Setter Property="Height" Value="{DynamicResource Daynote.Size.Target.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Label.FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Pressed}" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Accent.500}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.OnAccent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Disabled}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Style.CalendarCue.Today" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="{DynamicResource Daynote.Size.Calendar.TodayMarker}" /><Setter Property="Height" Value="{DynamicResource Daynote.Size.Calendar.TodayMarker}" /><Setter Property="Fill" Value="{DynamicResource Daynote.Brush.Accent.500}" />
        <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True"><Setter Property="Fill" Value="{DynamicResource Daynote.Brush.Text.OnAccent}" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Style.CalendarCue.Note" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="{DynamicResource Daynote.Size.Calendar.ContentMarker}" /><Setter Property="Height" Value="{DynamicResource Daynote.Size.Calendar.ContentMarker}" /><Setter Property="Fill" Value="{DynamicResource Daynote.Brush.Accent.500}" />
        <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True"><Setter Property="Fill" Value="{DynamicResource Daynote.Brush.Text.OnAccent}" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Style.CalendarCue.Clipboard" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="{DynamicResource Daynote.Size.Calendar.ContentMarker}" /><Setter Property="Height" Value="{DynamicResource Daynote.Size.Calendar.ContentMarker}" /><Setter Property="Fill" Value="{DynamicResource Daynote.Brush.Transparent}" /><Setter Property="Stroke" Value="{DynamicResource Daynote.Brush.Accent.500}" /><Setter Property="StrokeThickness" Value="{DynamicResource Daynote.Border.Thin}" />
        <Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True"><Setter Property="Stroke" Value="{DynamicResource Daynote.Brush.Text.OnAccent}" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Style.CalendarCue.Spacer" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="{DynamicResource Daynote.Size.Calendar.CueGap}" /><Setter Property="Fill" Value="{DynamicResource Daynote.Brush.Transparent}" />
    </Style>

    <Style x:Key="Daynote.Style.PaneSplitter" TargetType="{x:Type primitives:Thumb}">
        <Setter Property="Width" Value="{DynamicResource Daynote.Size.Splitter.HitTarget}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Subtle}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="{x:Type primitives:Thumb}"><Grid Background="{TemplateBinding Background}"><Border x:Name="Divider" Width="{DynamicResource Daynote.Border.Thin}" Background="{TemplateBinding BorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" /><Border x:Name="FocusRing" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.Focus}" /></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" /><Setter TargetName="Divider" Property="Background" Value="{DynamicResource Daynote.Brush.Accent.500}" /></Trigger><Trigger Property="showcase:ShowcaseForcedState.State" Value="focus"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" /><Setter TargetName="Divider" Property="Background" Value="{DynamicResource Daynote.Brush.Accent.500}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Accent.500}" /></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Accent.700}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Strong}" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
