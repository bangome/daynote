<UserControl
    x:Class="Daynote.App.Shell.Product.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance product:TimelineViewModel}">
    <Border Style="{DynamicResource Daynote.Product.Style.Panel}">
        <Grid>
            <!-- Read-only timeline of every note across all dates, newest day first, with infinite scroll. -->
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="14,4,14,14"
                          ScrollChanged="OnScrollChanged"
                          Visibility="{Binding IsEmpty, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Rows}" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.Resources>
                        <!-- Prominent date boundary: a top hairline divider, a large heading, and the count. -->
                        <DataTemplate DataType="{x:Type product:TimelineDateHeaderRow}">
                            <StackPanel Margin="0,22,0,10">
                                <TextBlock Text="{Binding Heading}" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource Daynote.Product.Brush.Accent}" />
                                <TextBlock Text="{Binding CountText}" FontSize="11" Margin="0,1,0,0"
                                           Foreground="{DynamicResource Daynote.Product.Brush.Text2}" />
                            </StackPanel>
                        </DataTemplate>
                        <!-- Read-only note card: title (+ favorite star), truncated body, expand/collapse. -->
                        <DataTemplate DataType="{x:Type product:TimelineNoteRow}">
                            <Border Background="{DynamicResource Daynote.Product.Brush.Panel}"
                                    CornerRadius="12"
                                    Padding="15,13" Margin="0,0,0,8" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                                                   Foreground="{DynamicResource Daynote.Product.Brush.Text}" />
                                        <Path Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"
                                              Data="{DynamicResource Daynote.Product.Geo.Star}" Fill="{DynamicResource Daynote.Product.Brush.Extras}"
                                              Visibility="{Binding IsFavorite, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding DisplayBody}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Daynote.Product.Brush.Text}" />
                                    <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3"
                                            Style="{DynamicResource Daynote.Product.Style.GhostButton}"
                                            Content="{Binding ExpandLabel}" Command="{Binding ToggleExpandCommand}"
                                            Foreground="{DynamicResource Daynote.Product.Brush.Accent}"
                                            Visibility="{Binding IsTruncated, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock Text="{loc:Tr TimelineEmpty}" FontSize="13" TextAlignment="Center"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Daynote.Product.Brush.Text2}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
        </Grid>
    </Border>
</UserControl>
