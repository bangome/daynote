<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The iOS head. It owns Info.plist, the app delegate and the one service that needs UIKit
      (ASWebAuthenticationSession). The Keychain protector is shared with macOS, because the two
      platforms have the same Security.framework.
    -->
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <RootNamespace>Daynote.Mobile.iOS</RootNamespace>
    <AssemblyName>Daynote.Mobile.iOS</AssemblyName>
    <!-- The same bundle id as the Mac app, which is allowed and is what lets one App Store listing
         carry both. The Mac build is not distributed through the store today, so nothing collides. -->
    <ApplicationId>cc.arachat.daynote</ApplicationId>
    <ApplicationVersion>17</ApplicationVersion>
    <ApplicationDisplayVersion>1.6.0</ApplicationDisplayVersion>
    <!-- iOS 15: the floor Avalonia supports, and the oldest release still receiving security fixes. -->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!--
      No lock file for this project, and that is the honest shape of it rather than a shortcut.
      Its graph depends on two things that are not the same on two machines: the installed mobile
      workload, which supplies Microsoft.NET.ILLink.Tasks at whatever version it happens to carry
      (10.0.8 here, 10.0.11 on the runner), and the RID being built, which is iossimulator-arm64 on
      an Apple silicon Mac and iossimulator-x64 elsewhere. A committed lock file pinned both and
      then failed locked-mode restore for everyone who did not match. The projects it references
      are all locked; only this head is not.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!--
      Partial trimming, as on Android: only assemblies that opt in with IsTrimmable are trimmed. The
      framework does, this app's do not, so the sync payloads that Core and Infrastructure serialize
      with reflection-based System.Text.Json survive whole.

      It used to be MtouchLink=None, which kept every framework binding - and App Store Connect then
      refused the build (ITMS-90683) for missing purpose strings for the microphone, contacts,
      calendars, location, Bluetooth, Siri and Apple Music, none of which Daynote touches. Trimming
      the SDK removes those references instead of papering over them with descriptions of features
      the app does not have. The real fix for the payloads is still a JsonSerializerContext.
    -->
    <TrimMode>partial</TrimMode>
    <!-- The analyzer flags exactly the reflection-based JSON that partial mode leaves untrimmed, and
         the repo builds with warnings as errors; keep reflection serialization switched on, since a
         trimmed publish otherwise turns it off by default and the first sync would throw. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Everything stays AOT-compiled; the interpreter is only there for code that could not be
         compiled ahead of time (generic instantiations the AOT compiler never saw, reflection-emitted
         serialisers). Without it a device running AOT-only aborts the moment it meets one, which a
         simulator, running on the JIT, never shows. -->
    <MtouchInterpreter>-all</MtouchInterpreter>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Clears the repo-wide RuntimeIdentifiers (Directory.Build.props), which exists only to keep the
      Windows MSIX publish from invalidating the lock files. A mobile build reads that list as
      "resolve a Mono runtime pack for each of these" and fails looking for a win-x64 Mono pack that
      does not exist. The mobile SDK picks its own RIDs.
    -->
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- With the widgets and watch embedded, the App Group too (Entitlements.Glance.plist). -->
    <CodesignEntitlements Condition="'$(DaynoteGlance)' == 'true'">Entitlements.Glance.plist</CodesignEntitlements>
    <!-- Function pointers into DaynoteBridge, looked up at run time (Platform/IosGlanceHost.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daynote.Mobile\Daynote.Mobile.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The asset catalog is compiled by actool, not copied, so it is declared as ImageAsset rather
      than BundleResource; a copied .xcassets folder produces an app with no icon and is rejected at
      upload. Which icon it is comes from XSAppIconAssets in Info.plist, because MSBuild's
      ApplicationIcon property is claimed by Avalonia's resource task for its own .ico.
    -->
    <ImageAsset Include="Resources\Assets.xcassets\**" />

    <!--
      Info.plist sits at the project root, which is the only place the iOS SDK looks. Under
      Resources it was silently ignored and the SDK generated its own: the built app had no icon and,
      worse, none of the CFBundleURLTypes the sign-in redirect needs.
    -->
    <None Include="Info.plist" />

    <!-- Copied to the bundle root under exactly this name; App Store Connect looks nowhere else. -->
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <!--
    The Swift bridge to WidgetKit and ActivityKit (docs/APPLE_EXTENSIONS.md §6), built by
    scripts/Build-IosApp.sh into native/apple/build before this project. Optional: without it the
    app still builds and runs, and its widgets refresh on their own timeline rather than at once.
  -->
  <PropertyGroup>
    <DaynoteNativeBuild>$(MSBuildProjectDirectory)/../../native/apple/build</DaynoteNativeBuild>
    <DaynoteBridgeFramework Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">$(DaynoteNativeBuild)/Release-iphoneos/DaynoteBridge.framework</DaynoteBridgeFramework>
    <DaynoteBridgeFramework Condition="'$(RuntimeIdentifier)' != 'ios-arm64'">$(DaynoteNativeBuild)/Debug-iphonesimulator/DaynoteBridge.framework</DaynoteBridgeFramework>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(DaynoteBridgeFramework)')">
    <NativeReference Include="$(DaynoteBridgeFramework)">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

  <!--
    Avalonia's umbrella package ships Avalonia.DesignerSupport as a runtime asset even though it is
    only used by the desktop previewer. On a trimmed iOS device build that assembly is AOT-compiled
    against the pre-trim Avalonia.Base module, while Avalonia.Base itself is rewritten by the iOS
    linker. Mono then aborts before Main because the module IDs no longer match. Keep the previewer
    assembly out of the device app; no production code references it.
  -->
  <Target Name="RemoveAvaloniaDesignerSupportFromIosApp"
          BeforeTargets="_ComputeLinkerInputs;PrepareForILLink"
          DependsOnTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'Avalonia.DesignerSupport'" />
    </ItemGroup>
  </Target>
</Project>
