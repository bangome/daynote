<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      Product visual system for the calendar-notes redesign (DESIGN.md Revision 2026-07-21).
      Theme-independent scalars, icon geometries, and control styles. Brushes are referenced with
      DynamicResource so a Light/Dark dictionary swap re-styles the live tree. Additive: the legacy
      Daynote.* showcase system is untouched.
    -->

    <!-- Fonts -->
    <FontFamily x:Key="Daynote.Product.Font.UI">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Daynote.Product.Font.Mono">Consolas, Cascadia Mono, Malgun Gothic</FontFamily>

    <!-- Type sizes (design: 13 base UI; 12/11.5/11/10.5/10/9 metadata; 18 title; 14 month; 13.5 editor) -->
    <sys:Double x:Key="Daynote.Product.Type.Base">13</sys:Double>
    <sys:Double x:Key="Daynote.Product.Type.Item">12.5</sys:Double>
    <sys:Double x:Key="Daynote.Product.Type.Small">12</sys:Double>
    <sys:Double x:Key="Daynote.Product.Type.Meta">11</sys:Double>
    <sys:Double x:Key="Daynote.Product.Type.MetaSmall">10.5</sys:Double>
    <sys:Double x:Key="Daynote.Product.Type.Tag">10</sys:Double>
    <sys:Double x:Key="Daynote.Product.Type.Badge">9</sys:Double>
    <sys:Double x:Key="Daynote.Product.Type.Title">20</sys:Double>
    <sys:Double x:Key="Daynote.Product.Type.Month">14</sys:Double>
    <sys:Double x:Key="Daynote.Product.Type.Editor">13.5</sys:Double>

    <!-- Radii (v3: 14 cards, 10 rows, 8 controls, pill chips/buttons) -->
    <CornerRadius x:Key="Daynote.Product.Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Daynote.Product.Radius.Panel">10</CornerRadius>
    <CornerRadius x:Key="Daynote.Product.Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Daynote.Product.Radius.Small">7</CornerRadius>
    <!-- WPF renders CornerRadius greater than half the element height as a squashed ellipse (arcs
         overlap, no straight edge), so the "pill" radii are fixed values sized to their consumers:
         Chip = ~20px tag/count chips, Pill = ~28-30px buttons and the 34px search bar. -->
    <CornerRadius x:Key="Daynote.Product.Radius.Chip">9</CornerRadius>
    <CornerRadius x:Key="Daynote.Product.Radius.Pill">13</CornerRadius>

    <!-- Icon geometries (recreated from the design's inline SVG path data) -->
    <Geometry x:Key="Daynote.Product.Geo.ChevronRight">M3.5,1 L7.5,5 L3.5,9</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.ChevronLeft">M6.5,1 L2.5,5 L6.5,9</Geometry>
    <!-- Both-sidebars toggle: >< collapses (chevrons pointing inward), <> expands (pointing outward).
         The 4-unit centre gap is deliberate — tighter than this the inward pair merges into an ✕ and
         reads as a second close button. Both share bounds (0.5..11.5, 1..9) so they size identically. -->
    <Geometry x:Key="Daynote.Product.Geo.PanelsCollapse">M0.5,1 L4,5 L0.5,9 M11.5,1 L8,5 L11.5,9</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.PanelsExpand">M4,1 L0.5,5 L4,9 M8,1 L11.5,5 L8,9</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.CollapseLeft">M6.5,1 L2.5,5 L6.5,9 M1,1 L1,9</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.CollapseRight">M3.5,1 L7.5,5 L3.5,9 M9,1 L9,9</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Plus">M5,0.5 L5,9.5 M0.5,5 L9.5,5</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.PlusThin">M7,2 L7,12 M2,7 L12,7</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Star">M6,0.8 L7.5,4.2 L11.2,4.6 L8.4,7 L9.2,10.7 L6,8.8 L2.8,10.7 L3.6,7 L0.8,4.6 L4.5,4.2 Z</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Trash">M2,3.5 h10 M5.5,3.5 V2 h3 v1.5 M3.5,3.5 l0.7,8.5 h5.6 l0.7,-8.5 M5.8,6 v4 M8.2,6 v4</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Check">M1.5,5.5 L4,8 L8.5,2.5</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Search">M7,2.5 A4.5,4.5 0 1 0 7.01,2.5 M10.5,10.5 L14,14</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Min">M0,5 L10,5</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Max">M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Close">M0,0 L10,10 M10,0 L0,10</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Clipboard">M3,1.5 h8 v3 h-8 Z M2.5,3 h-0.5 v10 h10 v-10 h-0.5</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Sun">M8,4.6 A3.4,3.4 0 1 0 8.01,4.6 M8,0.8 L8,2.6 M8,13.4 L8,15.2 M0.8,8 L2.6,8 M13.4,8 L15.2,8 M2.9,2.9 L4.2,4.2 M11.8,11.8 L13.1,13.1 M2.9,13.1 L4.2,11.8 M11.8,4.2 L13.1,2.9</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Moon">M13.5,9.5 A5.8,5.8 0 1 1 6.5,2.5 A4.6,4.6 0 0 0 13.5,9.5 Z</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.CalendarGlyph">M2,3 h16 v15 h-16 Z M2,7.5 L18,7.5 M6.5,1.5 L6.5,4.5 M13.5,1.5 L13.5,4.5</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.DocGlyph">M5,3 h11 l3,3 v15 h-14 Z M8,9 h8 M8,12.5 h8 M8,16 h5</Geometry>
    <!-- A memo sheet with its bottom-right corner folded over (dog-ear) plus two text lines. -->
    <Geometry x:Key="Daynote.Product.Geo.StickyNote">M2,1.5 H14 V10.5 L10.5,14 H2 Z M14,10.5 H10.5 V14 M5,5 H11 M5,8 H9</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Pin">M5,1 L11,1 L10,5 L12,7 L4,7 L6,5 Z M8,7 L8,13</Geometry>
    <Geometry x:Key="Daynote.Product.Geo.Image">M1.5,2.5 h13 v11 h-13 Z M2.5,12 L6.5,8.5 L9,10.5 L11.5,8 L13.5,10</Geometry>
    <!-- Settings: three sliders (rails + knobs). -->
    <Geometry x:Key="Daynote.Product.Geo.Settings">M1.5,3.5 H14.5 M1.5,8 H14.5 M1.5,12.5 H14.5 M3,3.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M9,8 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M4,12.5 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0</Geometry>
    <!-- Timeline: stacked list rows, each a bullet dot plus a line, reading as a vertical feed. -->
    <Geometry x:Key="Daynote.Product.Geo.Timeline">M2,2.5 h1 M5.5,2.5 H14 M2,8 h1 M5.5,8 H14 M2,13.5 h1 M5.5,13.5 H14</Geometry>

    <!-- Card / panel surfaces (radius 8, 1px stroke, soft shadow) -->
    <Style x:Key="Daynote.Product.Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Daynote.Product.Radius.Card}" />
        <Setter Property="Effect" Value="{DynamicResource Daynote.Product.Effect.CardShadow}" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Panel" TargetType="Border" BasedOn="{StaticResource Daynote.Product.Style.Card}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Panel}" />
    </Style>

    <!-- Base text -->
    <Style x:Key="Daynote.Product.Style.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Daynote.Product.Style.Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Daynote.Product.Style.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
    </Style>

    <!-- Stroked icon path (16/14/10 viewbox glyphs drawn by outline) -->
    <Style x:Key="Daynote.Product.Style.Icon.Stroked" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Ghost hover button (titlebar tools, chevrons): transparent, hover fill -->
    <Style x:Key="Daynote.Product.Style.GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Daynote.Product.Radius.Small}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Full-width list-row button (search results): honors Padding and stretches content edge-to-edge,
         unlike GhostButton (which centers a small icon/caption and drops Padding). -->
    <Style x:Key="Daynote.Product.Style.SearchResultButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Daynote.Product.Radius.Small}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window caption buttons (40x32); close variant flips to red on hover -->
    <Style x:Key="Daynote.Product.Style.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Daynote.Product.Style.CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource Daynote.Product.Style.CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,6,0,0">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.CloseHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnClose}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary bordered pill ("오늘로 이동"): v3 panel-surface pill with hairline stroke -->
    <Style x:Key="Daynote.Product.Style.Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Daynote.Product.Radius.Pill}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round titlebar icon button (v3: 34px circle, panel surface, hairline stroke).
         Tag="Active" flips it to an accent-filled circle (timeline mode toggle). -->
    <Style x:Key="Daynote.Product.Style.Button.Round" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary accent button ("새 노트") -->
    <Style x:Key="Daynote.Product.Style.Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="13,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Daynote.Product.Radius.Pill}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dashed action row ("현재 클립보드 저장", "파일 · 이미지 추가") -->
    <Style x:Key="Daynote.Product.Style.Button.Dashed" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Small}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke}"
                            BorderThickness="1" Padding="8" CornerRadius="{DynamicResource Daynote.Product.Radius.Control}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke}" />
                            </Style>
                        </Border.Style>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent search / title / tag inputs -->
    <Style x:Key="Daynote.Product.Style.PlainTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Base}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
    </Style>

    <!-- Right-panel tab header: v3 segmented control — the row sits on a Seg-colored track and the
         active tab is a raised Card-colored pill with accent text (Tag bound to the active flag). -->
    <Style x:Key="Daynote.Product.Style.TabHeader" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.Product.Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Product.Type.Meta}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Margin="1,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource Daynote.Product.Effect.CardShadow}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendar day cell (v3): the 24px circle behind the day number — accent fill when the cell's
         DataContext (CalendarDayCellViewModel) is selected, accent ring on today — and the day number's
         weekend/today/selected foreground. Kept here so the ProductWindow template stays reviewable. -->
    <Style x:Key="Daynote.Product.Style.Calendar.DayCircle" TargetType="Border">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Product.Style.Calendar.DayNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSunday}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Weekend.Sun}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSaturday}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Weekend.Sat}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Accent}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.OnAccent}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Tag chip (list rows: #tag 10px accent on accent-soft) -->
    <Style x:Key="Daynote.Product.Style.TagChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.AccentSoft}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Daynote.Product.Radius.Chip}" />
        <Setter Property="Padding" Value="6,1" />
    </Style>
</ResourceDictionary>
