<UserControl
    x:Class="Daynote.App.Account.AccountSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:account="clr-namespace:Daynote.App.Account"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance account:AccountViewModel}">
    <!-- Cloud sync lives inside the settings panel rather than in a window of its own: it is an
         opt-in preference, and a modal sign-in box would imply the app needs an account to work. -->
    <ContentControl Style="{DynamicResource Daynote.Style.SettingsRow}" Margin="0,16,0,0"
                    AutomationProperties.Name="{loc:Tr CloudSyncTitle}">
        <StackPanel>
            <TextBlock Style="{DynamicResource Daynote.Style.Type.Label}" Text="{loc:Tr CloudSyncTitle}" />
            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Daynote.Style.Type.Status}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Daynote.Brush.Text.Muted}" Text="{loc:Tr CloudSyncBlurb}" />

            <!-- Signed out: email, password, and the two ways in. -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsSignedOut, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <TextBlock Style="{DynamicResource Daynote.Style.Type.Status}" Text="{loc:Tr AccountEmail}" />
                <TextBox x:Name="EmailBox" Margin="0,4,0,0" Padding="8"
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:Tr AccountEmail}" />
                <TextBlock Margin="0,8,0,0" Style="{DynamicResource Daynote.Style.Type.Status}" Text="{loc:Tr AccountPassword}" />
                <!-- A PasswordBox, so the value never lives in a bindable property that could be
                     serialised, logged, or captured in a crash dump. It is read once, on command. -->
                <PasswordBox x:Name="PasswordBox" Margin="0,4,0,0" Padding="8"
                             AutomationProperties.Name="{loc:Tr AccountPassword}" />
                <TextBlock Margin="0,4,0,0" Style="{DynamicResource Daynote.Style.Type.Status}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Daynote.Brush.Text.Muted}" Text="{Binding PasswordHint}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{DynamicResource Daynote.Style.Button.Primary}" Content="{loc:Tr AccountSignIn}"
                            Click="OnSignIn" IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                            AutomationProperties.Name="{loc:Tr AccountSignIn}" />
                    <Button Margin="8,0,0,0" Style="{DynamicResource Daynote.Style.Button.Secondary}"
                            Content="{loc:Tr AccountCreate}" Click="OnRegister"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                            AutomationProperties.Name="{loc:Tr AccountCreate}" />
                </StackPanel>
            </StackPanel>

            <!-- Shown once, immediately after registering. Dismissal is gated on the confirmation
                 checkbox so the only copy of the key cannot scroll past unnoticed. -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsShowingRecoveryKey, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <TextBlock Style="{DynamicResource Daynote.Style.Type.Label}" Text="{loc:Tr RecoveryKeyTitle}" />
                <TextBlock Margin="0,4,0,0" Style="{DynamicResource Daynote.Style.Type.Status}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Daynote.Brush.Text.Muted}" Text="{loc:Tr RecoveryKeyBlurb}" />
                <TextBox Margin="0,8,0,0" IsReadOnly="True" Padding="10" BorderThickness="0"
                         FontFamily="{DynamicResource Daynote.Product.Font.Mono}" FontSize="15"
                         Background="{DynamicResource Daynote.Brush.Surface.Selected}"
                         Text="{Binding RecoveryKeyDisplay, Mode=OneWay}"
                         AutomationProperties.Name="{loc:Tr RecoveryKeyTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{DynamicResource Daynote.Style.Button.Secondary}"
                            Command="{Binding CopyRecoveryKeyCommand}"
                            Content="{loc:Tr RecoveryKeyCopy}" AutomationProperties.Name="{loc:Tr RecoveryKeyCopy}" />
                    <Button Margin="8,0,0,0" Style="{DynamicResource Daynote.Style.Button.Secondary}"
                            Command="{Binding SaveRecoveryKeyCommand}"
                            Content="{loc:Tr RecoveryKeySaveToFile}"
                            AutomationProperties.Name="{loc:Tr RecoveryKeySaveToFile}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Daynote.Style.Type.Status}"
                               Foreground="{DynamicResource Daynote.Brush.Text.Muted}" Text="{loc:Tr RecoveryKeyCopied}"
                               Visibility="{Binding RecoveryKeyCopied, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                </StackPanel>
                <CheckBox Margin="0,10,0,0" Content="{loc:Tr RecoveryKeyConfirm}"
                          IsChecked="{Binding RecoveryKeyAcknowledged, Mode=TwoWay}"
                          AutomationProperties.Name="{loc:Tr RecoveryKeyConfirm}" />
                <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                        Style="{DynamicResource Daynote.Style.Button.Primary}"
                        Command="{Binding DismissRecoveryKeyCommand}" Content="{loc:Tr RecoveryKeyDone}"
                        AutomationProperties.Name="{loc:Tr RecoveryKeyDone}" />
            </StackPanel>

            <!-- Signed in. -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <TextBlock Style="{DynamicResource Daynote.Style.Type.Status}" Text="{Binding SignedInEmail}" />
                <TextBlock Margin="0,2,0,0" Style="{DynamicResource Daynote.Style.Type.Status}"
                           Foreground="{DynamicResource Daynote.Brush.Text.Muted}" Text="{Binding LastSyncText}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{DynamicResource Daynote.Style.Button.Secondary}"
                            Command="{Binding SyncCommand}" Content="{loc:Tr AccountSyncNow}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                            AutomationProperties.Name="{loc:Tr AccountSyncNow}" />
                    <Button Margin="8,0,0,0" Style="{DynamicResource Daynote.Style.Button.Secondary}"
                            Command="{Binding SignOutCommand}" Content="{loc:Tr AccountSignOut}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Daynote.Convert.InverseBool}}"
                            AutomationProperties.Name="{loc:Tr AccountSignOut}" />
                </StackPanel>
            </StackPanel>

            <!-- Locked: a password reset happened and this device cannot open the cloud copy yet. -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsLocked, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <TextBlock Style="{DynamicResource Daynote.Style.Type.Label}" Text="{loc:Tr AccountLockedTitle}" />
                <TextBlock Margin="0,4,0,0" Style="{DynamicResource Daynote.Style.Type.Status}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Daynote.Brush.Text.Muted}" Text="{loc:Tr AccountLockedBlurb}" />
            </StackPanel>

            <!-- Something the user lost an edit to. Never silent: this is the whole reason
                 last-write-wins is acceptable. -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding HasReplacedNotes, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                <TextBlock Style="{DynamicResource Daynote.Style.Type.Status}" TextWrapping="Wrap"
                           Text="{Binding ReplacedNotesMessage}" />
                <Button Margin="0,6,0,0" HorizontalAlignment="Left"
                        Style="{DynamicResource Daynote.Style.Button.Secondary}"
                        Command="{Binding OpenConflictsFolderCommand}" Content="{loc:Tr AccountOpenConflicts}"
                        AutomationProperties.Name="{loc:Tr AccountOpenConflicts}" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0" Style="{DynamicResource Daynote.Style.Type.Status}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Daynote.Brush.Text.Primary}" Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />

            <!-- Stated in the UI, not just the privacy policy: the posture change is the point. -->
            <TextBlock Margin="0,12,0,0" Style="{DynamicResource Daynote.Style.Type.Status}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Daynote.Brush.Text.Muted}" Text="{loc:Tr CloudSyncPrivacyNote}" />
            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Daynote.Style.Type.Status}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Daynote.Brush.Text.Muted}" Text="{loc:Tr CloudSyncLocalNote}" />
        </StackPanel>
    </ContentControl>
</UserControl>
