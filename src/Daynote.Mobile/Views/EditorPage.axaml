<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daynote.Mobile.ViewModels"
             x:Class="Daynote.Mobile.Views.EditorPage"
             x:DataType="vm:MobileShellViewModel"
             Background="{DynamicResource Daynote.Product.Brush.Bg1}">
  <!--
    The note, full screen. The desktop keeps the editor in the middle column with the note list and
    the right rail flanking it; here it covers them, because a 390-point-wide screen has room for the
    text and nothing else.
  -->
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Header: back, title, and the two actions worth a permanent place. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,4,8,0">
      <Button Grid.Column="0" Classes="icon" Content="‹" FontSize="22"
              Command="{Binding CloseEditorCommand}"
              AutomationProperties.Name="{Binding Strings[Back]}" />
      <!-- The title is a label until it is tapped, then a text box over a draft. A tap rather than
           the desktop's double-click: a phone has no second click, and a note whose name cannot be
           changed from the only screen that shows it is a note stuck with "노트 1". -->
      <Button Grid.Column="1" Classes="titletap" Command="{Binding BeginRenameTitleCommand}"
              IsVisible="{Binding !IsRenamingTitle}"
              AutomationProperties.Name="{Binding Strings[NoteMenuRename]}">
        <TextBlock Classes="h2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding Notes.SelectedTab.Title, FallbackValue=''}" />
      </Button>
      <TextBox Grid.Column="1" x:Name="TitleBox" Classes="titleedit" Text="{Binding TitleDraft}"
               IsVisible="{Binding IsRenamingTitle}" KeyDown="OnTitleKeyDown" LostFocus="OnTitleLostFocus" />
      <Button Grid.Column="2" Classes="icon" Command="{Binding ToggleFavoriteCommand}"
              AutomationProperties.Name="{Binding Strings[Favorite]}">
        <Path Data="{StaticResource Daynote.Geo.Star}"
              Fill="{Binding Notes.SelectedTab.IsFavorite, FallbackValue=False, Converter={x:Static vm:MobileConverters.FavoriteFill}}" />
      </Button>
      <Button Grid.Column="3" Classes="icon" Command="{Binding DeleteNoteCommand}"
              CommandParameter="{Binding Notes.SelectedTab}"
              AutomationProperties.Name="{Binding Strings[NoteMenuDelete]}">
        <Path Data="{StaticResource Daynote.Geo.Trash}" />
      </Button>
    </Grid>

    <!-- Save state and tags. The save line is the phone's only feedback that a note is safe, so it
         is not hidden behind a menu the way a desktop status bar can be. -->
    <StackPanel Grid.Row="1" Margin="16,2,16,6" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Notes.HasSaveStatus}">
        <TextBlock Classes="muted" FontSize="11.5" VerticalAlignment="Center" Text="{Binding Notes.SaveStatusDisplay}" />
        <Button Classes="quiet" FontSize="11.5" MinHeight="32" Padding="10,4"
                Content="{Binding Strings[RetrySave]}" Command="{Binding Notes.RetryCommand}"
                IsVisible="{Binding Notes.HasSaveError}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Notes.SelectedTab.Tags, FallbackValue={x:Null}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Classes="chip" Margin="0,0,6,6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="12" VerticalAlignment="Center" />
                <Button Classes="icon" MinWidth="24" MinHeight="24" Width="24" Height="24" Padding="0" Content="✕" FontSize="10"
                        Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).RemoveTagCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBox Text="{Binding TagInput}" MinHeight="38" FontSize="13"
               PlaceholderText="{Binding Strings[TagAddPlaceholder]}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding CommitTagCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
    </StackPanel>

    <Panel Grid.Row="2">
      <TextBox x:Name="Body" Classes="editor" Text="{Binding Notes.EditorText}" />

      <!--
        The writing helpers, floating over the text rather than pinned to a toolbar. The note body
        carries a small syntax - a checkbox opens a line, a (M/D) or (M/D H:mm) at the end of one
        gives it a due time - and on a desktop you simply type it. On a phone those brackets are two
        keyboard layers away, which is enough friction to stop people using the feature at all.

        Shown only while the body has focus, so it is out of the way when reading. The buttons are
        not focusable on purpose: taking focus would close the keyboard and move the caret, which is
        the opposite of what a helper should do.
      -->
      <Border Classes="floatbar" IsVisible="{Binding #Body.IsFocused}"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="floataction" Focusable="False" Click="OnInsertTodo"
                  Content="{Binding Strings[InsertTodo]}" />
          <Border Width="1" Margin="2,8" Background="{DynamicResource Daynote.Product.Brush.Stroke}" />
          <Button Classes="floataction" Focusable="False" Click="OnInsertDate"
                  Content="{Binding Strings[InsertDate]}" />
          <Button Classes="floataction" Focusable="False" Click="OnInsertTime"
                  Content="{Binding Strings[InsertTime]}" />
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
