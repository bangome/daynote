<UserControl
    x:Class="Daynote.App.Account.AccountSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:account="clr-namespace:Daynote.App.Account"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance account:AccountViewModel}">
    <!--
      The account, as settings now shows it ("Daynote v3.dc.html").

      One row: who you are, what plan, one sentence of state, and a button into the account window.
      Everything that used to be here — sign-in, the subscription, the trial countdown, the note lock,
      the conflict notices — moved into that window. None of it was a preference, and a settings
      panel that also sells a subscription reads as neither.
    -->
    <Border Style="{DynamicResource Daynote.Product.Style.Settings.Card}"
            AutomationProperties.Name="{loc:Tr AccountWindowTitle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Signed in: the avatar. Signed out: the same outline the titlebar shows. -->
            <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                <Border CornerRadius="19" Background="{DynamicResource Daynote.Product.Brush.Accent}"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.AvatarText}"
                               FontSize="14" Text="{Binding AvatarInitial}" />
                </Border>
                <Border CornerRadius="19" Background="{DynamicResource Daynote.Product.Brush.Hover}"
                        Visibility="{Binding IsSignedOut, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{x:Null}"
                          Data="{DynamicResource Daynote.Product.Geo.Person}"
                          Stroke="{DynamicResource Daynote.Product.Brush.Text2}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.RowLabel}"
                               FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Text="{Binding DisplayName}"
                               Visibility="{Binding IsSignedIn, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.RowLabel}"
                               FontWeight="Bold" Text="{loc:Tr AccountSignInTitle}"
                               Visibility="{Binding IsSignedOut, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    <Border Margin="7,0,0,0" Style="{DynamicResource Daynote.Product.Style.Account.PlanPill}"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Daynote.Product.Style.Account.PlanPillText}" Text="{Binding PlanBadge}" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" Text="{Binding LastSyncText}"
                           Visibility="{Binding IsSignedIn, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                <TextBlock Style="{DynamicResource Daynote.Product.Style.Settings.Desc}" Margin="0,2,0,0"
                           Text="{loc:Tr CloudSyncTitle}"
                           Visibility="{Binding IsSignedOut, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
            </StackPanel>

            <Button Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                    Style="{DynamicResource Daynote.Product.Style.Button.Secondary}"
                    Click="OnManage" Content="{loc:Tr AccountManage}"
                    AutomationProperties.Name="{loc:Tr AccountManage}" />
        </Grid>
    </Border>
</UserControl>
