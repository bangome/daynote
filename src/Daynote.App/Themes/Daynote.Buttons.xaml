<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:showcase="clr-namespace:Daynote.App.Showcase">
<ControlTemplate x:Key="Daynote.Template.ButtonChrome" TargetType="{x:Type primitives:ButtonBase}">
        <Border x:Name="FocusRing" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.Focus}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
            <Border x:Name="FocusGap" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.FocusGap}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Daynote.Radius.Control}" Padding="{TemplateBinding Padding}">
                    <StackPanel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Orientation="Horizontal">
                        <ContentPresenter RecognizesAccessKey="True" />
                        <ProgressBar x:Name="BusyIndicator" Width="{DynamicResource Daynote.Icon.Size.Small}" Height="{DynamicResource Daynote.Icon.Size.Small}" IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" />
                <Setter TargetName="FocusGap" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus.Gap}" />
            </Trigger>
            <Trigger Property="showcase:ShowcaseForcedState.State" Value="focus">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" />
                <Setter TargetName="FocusGap" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus.Gap}" />
            </Trigger>
            <Trigger Property="Tag" Value="Busy">
                <Setter TargetName="BusyIndicator" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Daynote.Style.Button.Base" TargetType="{x:Type Button}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.ButtonChrome}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource Daynote.Size.Target.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Label.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.Label.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="Daynote.Style.Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Daynote.Style.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Accent.500}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Accent.500}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Accent.600}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Accent.600}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Accent.700}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Accent.700}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Disabled}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /><Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Style.Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Daynote.Style.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Pressed}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Disabled}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
    <!--
        Segmented single-choice control (the settings language row). A RadioButton rather than a pair
        of Buttons so screen readers get the SelectionItem pattern and arrow keys move between the
        options; it borrows the shared button chrome, so a segment reads as Secondary until it is the
        checked one, at which point it fills with the accent like Primary. The checked setters come
        after the BasedOn triggers, so a selected segment stays accented while hovered.
    -->
    <Style x:Key="Daynote.Style.Segment" TargetType="{x:Type RadioButton}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.ButtonChrome}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource Daynote.Size.Target.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Daynote.FontFamily.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Daynote.Type.Label.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource Daynote.Type.Label.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Pressed}" /></Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Accent.500}" />
                <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.OnAccent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Accent.500}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Disabled}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Style.Button.Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource Daynote.Style.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Pressed}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Daynote.Style.Button.Destructive" TargetType="{x:Type Button}" BasedOn="{StaticResource Daynote.Style.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Status.Error}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Status.Error.Surface}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Pressed}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Daynote.Brush.Surface.Disabled}" /><Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
    <!-- Icon buttons: 36-DIP visual chrome centered inside the 44-DIP hit target (DESIGN Target.Secondary; Revision 2026-07-21). -->
    <ControlTemplate x:Key="Daynote.Template.IconButtonChrome" TargetType="{x:Type primitives:ButtonBase}">
        <Border Background="{DynamicResource Daynote.Brush.Transparent}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid Width="{DynamicResource Daynote.Size.Target.Secondary}" Height="{DynamicResource Daynote.Size.Target.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Daynote.Radius.Control}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource Daynote.Brush.Transparent}" BorderThickness="{DynamicResource Daynote.Thickness.Border.Focus}" CornerRadius="{DynamicResource Daynote.Radius.Control}" IsHitTestVisible="False" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" /></Trigger>
            <Trigger Property="showcase:ShowcaseForcedState.State" Value="focus"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Focus}" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Daynote.Style.IconButton.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Daynote.Style.Button.Secondary}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.IconButtonChrome}" />
        <Setter Property="MinWidth" Value="{DynamicResource Daynote.Size.Target.Primary}" />
    </Style>
    <Style x:Key="Daynote.Style.IconButton.Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource Daynote.Style.Button.Ghost}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.IconButtonChrome}" />
        <Setter Property="MinWidth" Value="{DynamicResource Daynote.Size.Target.Primary}" />
    </Style>
    <Style x:Key="Daynote.Style.IconButton.Destructive" TargetType="{x:Type Button}" BasedOn="{StaticResource Daynote.Style.Button.Destructive}">
        <Setter Property="Template" Value="{StaticResource Daynote.Template.IconButtonChrome}" />
        <Setter Property="MinWidth" Value="{DynamicResource Daynote.Size.Target.Primary}" />
    </Style>
</ResourceDictionary>
