<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Daynote.Desktop.ViewModels"
        xmlns:notes="using:Daynote.App.Notes"
        xmlns:pvm="using:Daynote.App.Shell.Product"
        xmlns:views="using:Daynote.Desktop.Views"
        xmlns:settings="using:Daynote.App.Settings"
        xmlns:onboarding="using:Daynote.App.Onboarding"
        x:Class="Daynote.Desktop.Views.MainWindow"
        x:DataType="vm:DesktopShellViewModel"
        Title="Daynote"
        Width="1240" Height="780" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Daynote.Product.Brush.Bg1}"
        Icon="avares://Daynote.Desktop/Assets/daynote-favicon-v1.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="52">

  <Grid RowDefinitions="52,*">

    <!-- Title bar. The left inset, the caption buttons and the hit-test roles are all applied from
         MainWindow.Chrome.cs: macOS keeps its traffic lights at the left and draws no buttons here,
         Windows draws its own at the right. -->
    <!-- Background="Transparent" is load-bearing: a Grid with no brush does not take part in hit
         testing, so the strip would report HTCLIENT and the window could not be dragged by it. -->
    <Grid x:Name="TitleBarRow" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="84,0,16,0"
          Background="Transparent">
      <!--
        The brand lockup: the calendar mark and the wordmark as one image, in the active language and
        theme (BrandLogos). This used to be the favicon beside the literal text "Daynote", which was
        neither the logo nor localized; the WPF title bar has shown the real lockup all along.
      -->
      <Image x:Name="BrandArea" Grid.Column="0" Source="{Binding BrandLogo}" Height="26"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             VerticalAlignment="Center" HorizontalAlignment="Left"
             AutomationProperties.Name="Daynote" />

      <!--
        Search and the two view switches, centred in the strip. They sit together because they are one
        thought - find something, or change what is on screen - and the middle of the title bar is the
        one place that stays put as the sidebar and the right rail collapse.

        Today and Timeline are marks, with their words on the tooltip and the accessible name: they are
        used often enough to be worth recognising by shape, and it keeps the group from crowding the
        search box.
      -->
      <!-- CenterGroup exists for macOS: MainWindow.Chrome.cs moves the brand lockup into its first
           column so the logo sits beside the search box instead of alone by the traffic lights. On
           Windows the column stays empty and the group is just the search row, as before. -->
      <Grid x:Name="CenterGroup" Grid.Column="1" ColumnDefinitions="Auto,*"
            MaxWidth="620" Margin="24,0" VerticalAlignment="Center">
      <Grid x:Name="TutSearch" Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto">
        <!-- VerticalContentAlignment is load-bearing: Avalonia's TextBox defaults it to Top and the
             inline style gives a 30px MinHeight, so the text sat high inside the pill. -->
        <TextBox x:Name="SearchBox" Grid.Column="0" Classes="inline" VerticalContentAlignment="Center"
                 PlaceholderText="{Binding Strings.SearchHint}" Text="{Binding Search.Query}" />
        <Button Grid.Column="1" Classes="quiet" Content="✕" FontSize="11" Padding="8,4" Margin="4,0,0,0"
                Command="{Binding Search.ClearCommand}" IsVisible="{Binding Search.IsOpen}" />

        <Button Grid.Column="2" Classes="icon" Margin="6,0,0,0" Command="{Binding GoToTodayCommand}"
                ToolTip.Tip="{Binding Strings.Today}" AutomationProperties.Name="{Binding Strings.Today}">
          <Path Data="{StaticResource Daynote.Geo.Today}" />
        </Button>
        <Button Grid.Column="3" Classes="icon" Classes.selected="{Binding IsTimelineMode}"
                Command="{Binding ToggleTimelineCommand}"
                ToolTip.Tip="{Binding Strings.TimelineToggle}"
                AutomationProperties.Name="{Binding Strings.TimelineToggle}">
          <Path Data="{StaticResource Daynote.Geo.Timeline}" />
        </Button>
      </Grid>
      </Grid>

      <!-- Windows caption buttons, drawn by the app so they match the shell instead of the theme.
           Behaviour is still the system's: MainWindow.Chrome.cs gives each one the element role that
           Avalonia maps onto HTMINBUTTON / HTMAXBUTTON / HTCLOSE, so Snap Layouts still open on hover
           over maximize. Collapsed on macOS, where the traffic lights are the system's own. -->
      <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal"
                  Margin="12,0,0,0" VerticalAlignment="Stretch" IsVisible="False">
        <Button x:Name="MinimizeButton" Classes="caption" Click="OnMinimize"
                ToolTip.Tip="{Binding Strings[WindowMinimize]}">
          <Path Data="M0,5 L10,5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
        </Button>
        <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximizeRestore"
                ToolTip.Tip="{Binding Strings[WindowMaximize]}">
          <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
        </Button>
        <Button x:Name="CloseButton" Classes="caption close" Click="OnCloseWindow"
                ToolTip.Tip="{Binding Strings[WindowClose]}">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Body: calendar + notes | editor or timeline | right rail. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="16,0,16,16">

      <Grid Grid.Column="0" Width="292" RowDefinitions="Auto,*,Auto" Margin="0,0,12,0" IsVisible="{Binding !LeftCollapsed}">
        <Border x:Name="TutCalendar" Grid.Row="0" Classes="panel" Padding="14" Margin="0,0,0,12">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Grid.Column="0" Classes="quiet" Content="‹" Padding="10,2" FontSize="16" Command="{Binding Calendar.PreviousMonthCommand}" />
              <TextBlock Grid.Column="1" Text="{Binding Calendar.MonthLabel}" FontWeight="SemiBold" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="quiet" Content="›" Padding="10,2" FontSize="16" Command="{Binding Calendar.NextMonthCommand}" />
            </Grid>
            <UniformGrid Columns="7">
              <TextBlock Text="{Binding Strings.WeekdaySun}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Weekend.Sun}" />
              <TextBlock Classes="muted" Text="{Binding Strings.WeekdayMon}" FontSize="11" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding Strings.WeekdayTue}" FontSize="11" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding Strings.WeekdayWed}" FontSize="11" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding Strings.WeekdayThu}" FontSize="11" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding Strings.WeekdayFri}" FontSize="11" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Strings.WeekdaySat}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Weekend.Sat}" />
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Calendar.Cells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:CalendarDayCellViewModel">
                  <Button Classes="day" Classes.outside="{Binding !IsInMonth}" Classes.sunday="{Binding IsSunday}"
                          Classes.saturday="{Binding IsSaturday}" Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                          Command="{Binding SelectCommand}" Margin="0,2">
                    <!-- The dot gets its own row rather than floating over the number: it is always
                         present, transparent when the day is empty, so every day number in the grid
                         sits on one baseline whether or not that day has notes. -->
                    <Grid RowDefinitions="*,Auto">
                      <TextBlock Grid.Row="0" Text="{Binding DayText}" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                      <Ellipse Grid.Row="1" Classes="heat" Classes.l1="{Binding IsActivity1}"
                               Classes.l2="{Binding IsActivity2}" Classes.l3="{Binding IsActivity3}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="panel" Padding="12">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding DayLabel}" FontWeight="SemiBold" FontSize="13.5" />
                <TextBlock Classes="muted" Text="{Binding NoteCountText}" FontSize="11.5" />
              </StackPanel>
              <Button Grid.Column="1" Classes="accent" Content="{Binding Strings.AddNote}" Command="{Binding NewNoteCommand}" />
            </Grid>
            <ScrollViewer Grid.Row="1">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Notes.Tabs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="notes:NoteTabViewModel">
                      <!-- A projection is the editor's blank "노트 1" for a day with nothing on it yet.
                           It is not a note until something is typed, so the row stays hidden — as the
                           WPF shell has always done. Listing it drew a "노트 1" row under "노트 0개"
                           and above "이 날짜에 노트가 없습니다", all three at once; the first rendered
                           frame of this window (RenderedFrameTests) is what showed it. -->
                      <Button Classes="noterow" Classes.selected="{Binding IsSelected}"
                              IsVisible="{Binding !IsProjection}"
                              Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).SelectDayNoteCommand}"
                              CommandParameter="{Binding}">
                        <!-- Delete on a focused row deletes that row; right-click offers rename, copy, delete. -->
                        <Button.KeyBindings>
                          <KeyBinding Gesture="Delete"
                                      Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).DeleteDayNoteCommand}"
                                      CommandParameter="{Binding}" />
                        </Button.KeyBindings>
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[NoteMenuRename]}"
                                      Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).RenameDayNoteCommand}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[NoteMenuDuplicate]}"
                                      Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).DuplicateDayNoteCommand}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[NoteMenuDelete]}"
                                      Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).DeleteDayNoteCommand}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Spacing="3">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="★" FontSize="11" Foreground="{DynamicResource Daynote.Product.Brush.Extras}" IsVisible="{Binding IsFavorite}" />
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Classes="muted" Text="{Binding Preview}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <!-- The note's tags, as the WPF row has always shown them. Smaller than the
                               chips above the editor: here they label the row rather than being the
                               thing being edited. -->
                          <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" Margin="0,3,0,0">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Border Classes="chip" Padding="6,1" Margin="0,0,4,3">
                                  <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="10" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="empty" Text="{Binding Strings.DayNotesEmpty}" IsVisible="{Binding IsDayEmpty}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- The account strip closes the sidebar: who you are, and the menu for theme and settings.
             At the foot rather than in the title bar because it is about the person using the app,
             not about the notes on screen. -->
        <views:AccountBar x:Name="TutSettings" Grid.Row="2" Margin="0,12,0,0" />
      </Grid>

      <!-- Editor card -->
      <Border x:Name="TutEditor" Grid.Column="1" Classes="panel" Background="{DynamicResource Daynote.Product.Brush.Card}" Padding="28,22"
              IsVisible="{Binding IsEditorMode}">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <!--
            Title first, actions gathered at the right. The favourite used to sit to the LEFT of the
            title, which pushed the heading off the card's edge and put a toggle where a label belongs;
            it is an action, so it goes with the actions.

            The marks are the shared line icons rather than the emoji and arrows this row used to mix
            (✕ 📌 ↻ and a ☆/★ pair): those come from different fonts, so they never matched each other
            in weight or baseline. Retry stays a worded button — it appears only when a save has
            failed, and that is not a moment to make someone decode a glyph.
          -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
            <!-- The heading is a label until it is double-clicked (or a row's Rename is picked);
                 then the same slot holds a text box with a draft. Enter or focus loss commits, Escape
                 drops the draft. The TextBox has no chrome of its own so the swap does not jump. -->
            <TextBlock Grid.Column="0" Classes="h1" FontWeight="Bold"
                       Text="{Binding Notes.SelectedTab.Title, FallbackValue=''}"
                       IsVisible="{Binding !IsRenamingTitle}"
                       DoubleTapped="OnTitleDoubleTapped"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <TextBox x:Name="TitleEditor" Grid.Column="0" Classes="inline titleedit"
                     Text="{Binding TitleDraft}" IsVisible="{Binding IsRenamingTitle}"
                     KeyDown="OnTitleEditorKeyDown" LostFocus="OnTitleEditorLostFocus"
                     VerticalAlignment="Center" Margin="0,0,12,0" />

            <TextBlock Grid.Column="1" Classes="muted" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{Binding Notes.SaveStatusDisplay}" IsVisible="{Binding Notes.HasSaveStatus}" />
            <Button Grid.Column="2" Classes="quiet" FontSize="11.5" Padding="9,4" Margin="0,0,4,0"
                    Content="{Binding Strings[RetrySave]}" Command="{Binding Notes.RetryCommand}"
                    IsVisible="{Binding Notes.HasSaveError}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                        IsVisible="{Binding HasOpenNote}">
              <Button Classes="ghost" Classes.favorite="{Binding Notes.SelectedTab.IsFavorite, FallbackValue=False}"
                      Command="{Binding ToggleFavoriteCommand}"
                      ToolTip.Tip="{Binding Strings.Favorite}" AutomationProperties.Name="{Binding Strings.Favorite}">
                <Path Data="{StaticResource Daynote.Geo.Star}" />
              </Button>
              <Button Classes="ghost" Command="{Binding OpenStickyCommand}"
                      ToolTip.Tip="{Binding Strings.OpenStickyNote}"
                      AutomationProperties.Name="{Binding Strings.OpenStickyNote}">
                <Path Data="{StaticResource Daynote.Geo.StickyNote}" />
              </Button>
              <Button Classes="ghost" Command="{Binding DeleteSelectedNoteCommand}"
                      ToolTip.Tip="{Binding Strings[DeleteNoteTip]}"
                      AutomationProperties.Name="{Binding Strings[DeleteNoteTip]}">
                <Path Data="{StaticResource Daynote.Geo.Trash}" />
              </Button>
            </StackPanel>
          </Grid>

          <!--
            Tags: the chips and the entry in one wrapping row, so "add a tag" reads as the end of the
            list instead of a separate pill input parked beside it. That was the design all along; the
            entry here was a fixed-width bordered box that wrapped as a block of its own.

            Not gated on HasOpenNote any more. A note being written is still a projection, so the row
            was hidden for exactly as long as someone was writing the note they wanted to tag; adding
            a tag now creates the note, so the row can stand from the start.
          -->
          <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Notes.SelectedTab.Tags, FallbackValue={x:Null}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="chip">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="{Binding StringFormat='#{0}'}" VerticalAlignment="Center" />
                      <Button Classes="chipx" Content="✕"
                              Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).RemoveTagCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="TagBox" Classes="tagentry" Margin="0,0,0,6" VerticalAlignment="Center"
                     PlaceholderText="{Binding Strings.TagAddPlaceholder}"
                     Text="{Binding TagInput}" KeyDown="OnTagBoxKeyDown" />
          </WrapPanel>

          <!--
            The body: a highlight layer with the editor over it, the editor's own text drawn in
            nothing so the caret sits over the coloured glyphs. Avalonia's TextBox has no inline
            formatting, so marking up what the app understood — checkboxes, due dates, #tags, links —
            means a second layer that draws the same string with the same metrics.

            The illusion only holds while both layers break lines in the same places, which is why the
            typography is set once on the `editor` class and shared by both, and why
            EditorHighlightTests measures them against each other rather than trusting that.
          -->
          <Grid Grid.Row="2">
            <ScrollViewer x:Name="HighlightScroll" IsHitTestVisible="False"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
              <TextBlock x:Name="Highlight" Classes="editorhighlight" />
            </ScrollViewer>
            <TextBox x:Name="Editor" Classes="editor" Text="{Binding Notes.EditorText}" VerticalContentAlignment="Top"
                     Foreground="Transparent" PlaceholderText="{Binding Strings.EditorEmptyHint}" />
          </Grid>
        </Grid>
      </Border>

      <!-- Timeline: every note, newest date first. -->
      <Border Grid.Column="1" Classes="panel" Padding="20,16" IsVisible="{Binding IsTimelineMode}">
        <Grid>
          <ScrollViewer IsVisible="{Binding !Timeline.IsEmpty}">
            <ItemsControl ItemsSource="{Binding Timeline.Rows}">
              <ItemsControl.DataTemplates>
                <DataTemplate x:DataType="pvm:TimelineDateHeaderRow">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,14,4,8">
                    <TextBlock Text="{Binding Heading}" FontSize="15" FontWeight="Bold" />
                    <TextBlock Classes="muted" Text="{Binding CountText}" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="pvm:TimelineNoteRow">
                  <Button Classes="card" Command="{Binding OpenCommand}">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="★" FontSize="11" Foreground="{DynamicResource Daynote.Product.Brush.Extras}" IsVisible="{Binding IsFavorite}" />
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock Text="{Binding DisplayBody}" FontSize="12.5" TextWrapping="Wrap" Classes="muted" />
                      <Button Classes="quiet" Content="{Binding ExpandLabel}" Command="{Binding ToggleExpandCommand}" FontSize="11.5" Padding="8,2"
                              HorizontalAlignment="Left" IsVisible="{Binding IsTruncated}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Classes="empty" Text="{Binding Strings.TimelineEmpty}" IsVisible="{Binding Timeline.IsEmpty}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Right rail -->
      <Border Grid.Column="2" Classes="panel" Width="302" Margin="12,0,0,0" IsVisible="{Binding !RightCollapsed}">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="seg" Margin="10,10,10,8">
            <UniformGrid Columns="4">
              <!-- The shared line marks, not the ☑ ★ # 📎 this strip used to mix: a checkbox glyph, a
                   dingbat star, an ASCII hash and a colour emoji came from four different fonts, at
                   four weights, and the paperclip rendered in its own colour whatever the tab state.
                   The open-todo count keeps its digits beside the checkbox. -->
              <Button x:Name="TutTabTodo" Classes="tab" Classes.active="{Binding TabIsTodo}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static pvm:RightTab.Todo}"
                      ToolTip.Tip="{Binding Strings.TabTodoName}" AutomationProperties.Name="{Binding Strings.TabTodoName}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Path Data="{StaticResource Daynote.Geo.TabTodo}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Todo.OpenCount}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="TutTabFavorites" Classes="tab" Classes.active="{Binding TabIsFavorites}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static pvm:RightTab.Favorites}"
                      ToolTip.Tip="{Binding Strings.TabFavoritesName}" AutomationProperties.Name="{Binding Strings.TabFavoritesName}">
                <Path Data="{StaticResource Daynote.Geo.Star}" />
              </Button>
              <Button x:Name="TutTabTags" Classes="tab" Classes.active="{Binding TabIsTags}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static pvm:RightTab.Tags}"
                      ToolTip.Tip="{Binding Strings.TabTagsName}" AutomationProperties.Name="{Binding Strings.TabTagsName}">
                <Path Data="{StaticResource Daynote.Geo.TabTag}" />
              </Button>
              <Button x:Name="TutTabFiles" Classes="tab" Classes.active="{Binding TabIsFiles}" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static pvm:RightTab.Files}"
                      ToolTip.Tip="{Binding Strings.TabFilesName}" AutomationProperties.Name="{Binding Strings.TabFilesName}">
                <Path Data="{StaticResource Daynote.Geo.TabClip}" />
              </Button>
            </UniformGrid>
          </Border>

          <!-- Todo -->
          <ScrollViewer Grid.Row="1" Padding="10,4,10,10" IsVisible="{Binding TabIsTodo}">
            <StackPanel>
              <StackPanel.Resources>
                <DataTemplate x:Key="TodoItem" x:DataType="pvm:TodoItemViewModel">
                  <Button Classes="card" Command="{Binding JumpCommand}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Button Grid.Column="0" Classes="check" Classes.checked="{Binding Checked}" Command="{Binding ToggleCommand}" Margin="0,1,10,0"
                              Content="{Binding Checked, Converter={x:Static views:Glyphs.Check}}" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" Classes.done="{Binding Checked}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="muted" Text="{Binding NoteLabel}" FontSize="10.5" />
                          <TextBlock Classes="due" Classes.overdue="{Binding Overdue}" Text="{Binding DueLabel}" FontSize="10.5" IsVisible="{Binding HasDue}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </StackPanel.Resources>
              <TextBlock Text="{Binding Strings.Today}" FontSize="11" FontWeight="SemiBold" Margin="4,4,4,6" IsVisible="{Binding Todo.HasToday}" />
              <ItemsControl ItemsSource="{Binding Todo.TodayItems}" ItemTemplate="{StaticResource TodoItem}" IsVisible="{Binding Todo.HasToday}" />
              <Border Height="1" Margin="2,2,2,10" Background="{DynamicResource Daynote.Product.Brush.Stroke}" IsVisible="{Binding Todo.HasToday}" />
              <ItemsControl ItemsSource="{Binding Todo.Items}" ItemTemplate="{StaticResource TodoItem}" />
              <TextBlock Classes="empty" Text="{Binding Strings.TodoEmpty}" IsVisible="{Binding Todo.IsEmpty}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Favorites -->
          <ScrollViewer Grid.Row="1" Padding="10,4,10,10" IsVisible="{Binding TabIsFavorites}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Favorites.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:FavoriteItemViewModel">
                    <Button Classes="card" Command="{Binding OpenCommand}">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock Grid.Column="0" Text="★" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource Daynote.Product.Brush.Extras}" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Classes="muted" Text="{Binding DateLabel}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Classes="muted" Text="{Binding Preview}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="empty" Text="{Binding Strings.FavoritesPanelEmpty}" IsVisible="{Binding Favorites.IsEmpty}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Tags -->
          <ScrollViewer Grid.Row="1" Padding="10,4,10,10" IsVisible="{Binding TabIsTags}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding TagPanel.Tags}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:TagItemViewModel">
                    <Border Classes="panel" Margin="0,0,0,8" Background="{DynamicResource Daynote.Product.Brush.Card}">
                      <StackPanel>
                        <Button Classes="noterow" Command="{Binding ToggleExpandCommand}" Padding="14,12">
                          <Grid ColumnDefinitions="*,Auto">
                            <!-- No StringFormat: TagItemViewModel.Tag already carries the leading '#',
                                 and adding a second one rendered every row with a doubled hash. The WPF
                                 shell binds it plainly; only this one did not. -->
                            <TextBlock Grid.Column="0" Text="{Binding Tag}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Daynote.Product.Brush.Accent}" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding CountText}" FontSize="11" />
                          </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Occurrences}" Margin="10,0,10,8" IsVisible="{Binding IsExpanded}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pvm:TagOccurrenceViewModel">
                              <Button Classes="noterow" Command="{Binding JumpCommand}">
                                <StackPanel Spacing="2">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding NoteTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding DateLabel}" FontSize="10.5" Margin="8,0,0,0" />
                                  </Grid>
                                  <TextBlock Classes="muted" Text="{Binding Preview}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="empty" Text="{Binding Strings.TagPanelEmpty}" IsVisible="{Binding TagPanel.IsEmpty}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Files -->
          <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding TabIsFiles}" Margin="10,4,10,10">
            <Button Grid.Row="0" Classes="accent" Content="{Binding Strings.AddFile}" Command="{Binding Files.AddFilesCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,10" />
            <ScrollViewer Grid.Row="1">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Files.Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pvm:FileItemViewModel">
                      <!-- Double-tap writes a copy wherever the user points: the stored bytes live under
                           a hashed name, so this is the only way an attachment gets back out. -->
                      <Border Classes="panel" Classes.highlighted="{Binding IsHighlighted}" Margin="0,0,0,8" Background="{DynamicResource Daynote.Product.Brush.Card}" Padding="10"
                              DoubleTapped="OnFileCardDoubleTapped"
                              ToolTip.Tip="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileTip]}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0"
                                  Background="{DynamicResource Daynote.Product.Brush.Seg}">
                            <Panel>
                              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                              <TextBlock Text="🖼" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowImageBadge}" />
                              <TextBlock Text="{Binding Ext}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowDocBadge}" />
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" Text="{Binding SizeLabel}" FontSize="10.5" IsVisible="{Binding !WasSaved}" />
                            <TextBlock Text="{Binding SavedTo}" FontSize="10.5" IsVisible="{Binding WasSaved}"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Daynote.Product.Brush.Ok}" />
                            <TextBlock FontSize="10.5" IsVisible="{Binding SaveFailed}"
                                       Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                                       Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileFailed]}" />
                            <!-- Another device attached this and the bytes are still coming. Said
                                 plainly, or a half-arrived attachment looks like a ready one. -->
                            <TextBlock Classes="muted" FontSize="10.5" IsVisible="{Binding IsAwaitingDownload}"
                                       Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[FileAwaitingDownload]}" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="quiet" Content="✕" FontSize="11" Padding="6,2" Command="{Binding DeleteCommand}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="empty" Text="{Binding Strings.FileTabEmpty}" IsVisible="{Binding Files.IsEmpty}" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <!-- Settings: a modal card over the whole body. -->
      <Border Grid.ColumnSpan="3" ZIndex="20" Background="#66000000" IsVisible="{Binding IsSettingsOpen}">
        <Border Classes="panel" Background="{DynamicResource Daynote.Product.Brush.Card}" Width="560" MaxHeight="640"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" DataContext="{Binding SettingsViewModel}"
                x:DataType="vm:DesktopSettingsViewModel">
          <ScrollViewer>
            <StackPanel Spacing="18">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="h1" Text="{Binding Title}" />
                <Button Grid.Column="1" Classes="quiet" Content="✕" FontSize="12"
                        Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).CloseSettingsCommand}" />
              </Grid>

              <StackPanel Spacing="6">
                <TextBlock Text="{Binding LanguageLabel}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Classes="muted" Text="{Binding LanguageDesc}" FontSize="11.5" TextWrapping="Wrap" />
                <Border Classes="seg" HorizontalAlignment="Left" Width="220">
                  <UniformGrid Columns="2">
                    <Button Classes="tab" Classes.active="{Binding IsKorean}" Content="{Binding KoreanLabel}" Command="{Binding SelectKoreanCommand}" />
                    <Button Classes="tab" Classes.active="{Binding IsEnglish}" Content="{Binding EnglishLabel}" Command="{Binding SelectEnglishCommand}" />
                  </UniformGrid>
                </Border>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).HasAccount}">
                <TextBlock Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[CloudSyncTitle]}" FontWeight="SemiBold" FontSize="13" />
                <Button Classes="quiet" HorizontalAlignment="Left" Padding="8,4" Foreground="{DynamicResource Daynote.Product.Brush.Accent}"
                        Content="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[AccountManage]}"
                        Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).OpenAccountCommand}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{Binding StartupLabel}" FontWeight="SemiBold" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <ToggleSwitch IsChecked="{Binding StartupIsOn, Mode=OneWay}" IsEnabled="{Binding StartupToggleEnabled}"
                                Command="{Binding ToggleStartupCommand}" OnContent="" OffContent="" />
                  <TextBlock Classes="muted" Text="{Binding StartupStateText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{Binding StorageLabel}" FontWeight="SemiBold" FontSize="13" />
                <Button Classes="quiet" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Padding="0,2">
                  <TextBlock Text="{Binding DataRoot}" FontSize="12" Foreground="{DynamicResource Daynote.Product.Brush.Accent}" TextWrapping="Wrap" />
                </Button>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{Binding McpLabel}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Classes="muted" Text="{Binding McpDesc}" FontSize="11.5" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding McpAvailable}">
                  <Button Classes="accent" Content="{Binding McpRegister}" Command="{Binding RegisterMcpCommand}" />
                  <TextBlock Classes="muted" Text="{Binding McpStatusText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Classes="muted" Text="{Binding McpUnavailable}" FontSize="12" IsVisible="{Binding !McpAvailable}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding McpCodeHint}" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding McpAvailable}" />
                <SelectableTextBlock Text="{Binding McpCodeCommand}" FontSize="11.5" FontFamily="Menlo, Consolas, monospace" IsVisible="{Binding McpAvailable}" />
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="{Binding ShortcutsLabel}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Classes="muted" Text="{Binding SummonHotkeyDesc}" FontSize="11.5" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding SummonHotkeyLabel}" FontSize="12.5" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="chip" Margin="0,0,8,0" Padding="10,3"><TextBlock Text="{Binding SummonHotkeyDisplay}" /></Border>
                  <Button Grid.Column="2" Classes="quiet" Content="{Binding HotkeyChange}" Command="{Binding StartHotkeyCaptureCommand}" FontSize="12" Padding="8,3" />
                  <Button Grid.Column="3" Classes="quiet" Content="{Binding HotkeyReset}" Command="{Binding ResetSummonHotkeyCommand}" FontSize="12" Padding="8,3" />
                </Grid>
                <TextBlock Classes="muted" Text="{Binding HotkeyStatusText}" FontSize="11.5" IsVisible="{Binding HotkeyStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding QuickStickyLabel}" FontSize="12.5" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="chip" Padding="10,3"><TextBlock Text="{Binding QuickStickyDisplay}" /></Border>
                </Grid>
                <TextBlock Text="{Binding InAppShortcutsLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding InAppShortcuts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="settings:ShortcutRowViewModel">
                      <StackPanel Spacing="2" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Classes="chip" Margin="0,0,8,0" Padding="10,3"><TextBlock Text="{Binding Display}" /></Border>
                          <Button Grid.Column="2" Classes="quiet" Command="{Binding StartCaptureCommand}" FontSize="12" Padding="8,3"
                                  Content="{Binding $parent[ItemsControl].((vm:DesktopSettingsViewModel)DataContext).HotkeyChange}" />
                          <Button Grid.Column="3" Classes="quiet" Command="{Binding ResetCommand}" FontSize="12" Padding="8,3"
                                  Content="{Binding $parent[ItemsControl].((vm:DesktopSettingsViewModel)DataContext).HotkeyReset}" />
                        </Grid>
                        <TextBlock Classes="muted" Text="{Binding StatusText}" FontSize="11.5" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{Binding BackupLabel}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Classes="muted" Text="{Binding BackupDesc}" FontSize="11.5" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Content="{Binding BackupButton}" Command="{Binding BackupCommand}" />
                  <Button Classes="quiet" Content="{Binding RestoreButton}" Command="{Binding RestoreCommand}" />
                  <TextBlock Classes="muted" Text="{Binding BackupStatusText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{Binding TutorialLabel}" FontWeight="SemiBold" FontSize="13" />
                <Button Classes="quiet" Content="{Binding TutorialButton}" HorizontalAlignment="Left" Padding="10,4"
                        Foreground="{DynamicResource Daynote.Product.Brush.Accent}"
                        Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).OpenTutorialCommand}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{Binding PrivacyLabel}" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Classes="muted" Text="{Binding PrivacyText}" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>

              <!-- About: the last row WPF settings had that this panel did not. -->
              <StackPanel Spacing="2" AutomationProperties.Name="{Binding AboutLabel}">
                <TextBlock Text="{Binding AboutLabel}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                <TextBlock Classes="muted" Text="{Binding AuthorName}" FontSize="11.5" />
                <TextBlock Classes="muted" Text="{Binding AuthorEmail}" FontSize="11.5" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Border>
      <!-- Account: the cloud account card over the body (only when this build has a sync endpoint). -->
      <Border Grid.ColumnSpan="3" ZIndex="25" Background="#66000000" IsVisible="{Binding IsAccountOpen}">
        <Border Classes="panel" Background="{DynamicResource Daynote.Product.Brush.Card}" Width="560" MaxHeight="680"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <!-- One heading for the card, in the header beside the close button: "Sign in to
                   Daynote" while signed out, "Daynote account" once signed in. The panel itself
                   draws no heading, so the title is never printed twice. -->
              <TextBlock Grid.Column="0" Classes="h1" Text="{Binding Strings[AccountSignInTitle]}"
                         IsVisible="{Binding Account.IsSignedOut}" />
              <TextBlock Grid.Column="0" Classes="h1" Text="{Binding Strings[AccountWindowTitle]}"
                         IsVisible="{Binding Account.IsSignedIn}" />
              <Button Grid.Column="1" Classes="quiet" Content="✕" FontSize="12" Command="{Binding CloseAccountCommand}" />
            </Grid>
            <views:AccountPanel Grid.Row="1" DataContext="{Binding Account}" />
          </Grid>
        </Border>
      </Border>

    </Grid>

    <!--
      Onboarding tutorial. The overlay dims the shell and cuts a hole around the step's target
      (TutorialOverlay); this used to be one flat scrim with a centred card, so every step described
      a part of the UI without pointing at it. It spans BOTH rows, as the WPF host does: the search
      step's target is the pill in the title bar, and an overlay that covered only the body clipped
      that hole away to nothing and silently fell back to dimming everything.
    -->
    <views:TutorialOverlay Grid.Row="0" Grid.RowSpan="2" ZIndex="30" DataContext="{Binding Tutorial}"
                           IsVisible="{Binding IsOpen, FallbackValue=False}" />
    <!--
      Search results. In the root grid rather than the body's middle column, which is where they used
      to be: that column sits under the note title, nowhere near the box they belong to, and a body
      child is clipped by it. The horizontal offset comes from the search box's own position
      (MainWindow.Search.cs) — the title bar's inset is applied per platform at runtime, so it cannot
      be a margin in markup. Above the tutorial overlay so a search during onboarding still reads.
    -->
    <Border x:Name="SearchDropdown" Grid.Row="0" Grid.RowSpan="2" ZIndex="40"
            Classes="panel" Width="560" MaxHeight="440" Padding="8"
            VerticalAlignment="Top" HorizontalAlignment="Left"
            Background="{DynamicResource Daynote.Product.Brush.Card}"
            IsVisible="{Binding Search.IsOpen, FallbackValue=False}">
        <ScrollViewer>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Search.Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:SearchResultRowViewModel">
                  <Button Classes="noterow" Command="{Binding ActivateCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Grid.Column="0" Classes="chip" Margin="0,0,10,0" Padding="8,2" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Kind}" FontSize="10.5" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" Text="{Binding Sub}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Sub, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="muted" Text="{Binding DateLabel}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="empty" Text="{Binding Strings.SearchNoResultsRow}" IsVisible="{Binding Search.NoResults}" Margin="12,16" />
            <TextBlock Classes="empty" Text="{Binding Strings.SearchFailedRow}" IsVisible="{Binding Search.Failed}" Margin="12,16"
                       Foreground="{DynamicResource Daynote.Product.Brush.Danger}" />
          </StackPanel>
        </ScrollViewer>
    </Border>

  </Grid>
</Window>
