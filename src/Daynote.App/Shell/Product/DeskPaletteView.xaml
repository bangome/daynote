<UserControl
    x:Class="Daynote.App.Shell.Product.DeskPaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pvm="clr-namespace:Daynote.App.Shell.Product;assembly=Daynote.Presentation"
    xmlns:product="clr-namespace:Daynote.App.Shell.Product"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance product:ProductShellViewModel}">

    <!-- The Ctrl K palette: quick actions until something is typed, then the unified search's
         results. Clicking the scrim, or Escape, closes it. -->

    <Border Style="{DynamicResource Daynote.Desk.Style.Scrim}" MouseLeftButtonDown="OnScrimClick">
        <Border Style="{DynamicResource Daynote.Desk.Style.Modal}" Background="{DynamicResource Daynote.Product.Brush.Card}"
                CornerRadius="16" Width="620" Margin="24,80,24,24" VerticalAlignment="Top"
                HorizontalAlignment="Center" MouseLeftButtonDown="OnCardClick">
            <StackPanel>
                <Grid Height="60" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                          Data="{DynamicResource Daynote.Desk.Geo.Search}"
                          Stroke="{DynamicResource Daynote.Product.Brush.Text2}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{DynamicResource Daynote.Desk.TextBox.Bare}"
                             FontSize="17" Margin="12,0" VerticalAlignment="Center"
                             Text="{Binding Search.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:Tr DeskPalettePlaceholder}" />
                    <TextBlock Grid.Column="1" FontSize="17" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource Daynote.Desk.Brush.Text3}" Text="{loc:Tr DeskPalettePlaceholder}"
                               Visibility="{Binding Search.Query, Converter={StaticResource Daynote.Convert.NullToCollapsed}}" />
                    <Border Grid.Column="2" Style="{DynamicResource Daynote.Desk.Style.Keycap}" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="11" FontWeight="SemiBold" Text="esc" />
                    </Border>
                </Grid>

                <Border Height="1" Background="{DynamicResource Daynote.Product.Brush.Stroke2}" />

                <ScrollViewer MaxHeight="420" Padding="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Visibility="{Binding Search.IsOpen, Converter={StaticResource Daynote.Convert.InverseBoolToVisibility}}">
                            <TextBlock Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="11.5" FontWeight="SemiBold"
                                       Margin="10,8,10,6" Text="{loc:Tr DeskPaletteShortcuts}" />
                            <ItemsControl ItemsSource="{Binding QuickActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type product:PaletteActionViewModel}">
                                        <Button Style="{DynamicResource Daynote.Desk.Button.Row}" Padding="10" Command="{Binding RunCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="13.5" Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1" Style="{DynamicResource Daynote.Desk.Text.Mono}" FontSize="11.5"
                                                           Foreground="{DynamicResource Daynote.Desk.Brush.Text3}"
                                                           VerticalAlignment="Center" Text="{Binding Combo}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Search.Results}"
                                      Visibility="{Binding Search.IsOpen, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pvm:SearchResultRowViewModel}">
                                    <Button Style="{DynamicResource Daynote.Desk.Button.Row}" Padding="10" Command="{Binding ActivateCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource Daynote.Desk.Style.Kind}" Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}" Text="{Binding Kind}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Title}" />
                                                <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" FontSize="12" Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding Sub}"
                                                           Visibility="{Binding Sub, Converter={StaticResource Daynote.Convert.NullToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Style="{DynamicResource Daynote.Desk.Text.Faint}" FontSize="12"
                                                       Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding DateLabel}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{DynamicResource Daynote.Desk.Text.Muted}" Margin="28" HorizontalAlignment="Center"
                                   Text="{loc:Tr SearchNoResultsRow}"
                                   Visibility="{Binding Search.NoResults, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                        <TextBlock Margin="28" HorizontalAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                                   Text="{loc:Tr SearchFailedRow}"
                                   Visibility="{Binding Search.Failed, Converter={StaticResource Daynote.Convert.BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
