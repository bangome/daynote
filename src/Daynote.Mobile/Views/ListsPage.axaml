<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daynote.Mobile.ViewModels"
             xmlns:pvm="using:Daynote.App.Shell.Product"
             xmlns:views="using:Daynote.Mobile.Views"
             x:Class="Daynote.Mobile.Views.ListsPage"
             x:DataType="vm:MobileShellViewModel">
  <!--
    The desktop's right rail: to-dos, favourites and tags. There it is a column beside the editor;
    here the three share one page behind underlined tabs, because they are read one at a time and a
    phone cannot spare a permanent column for them.
  -->
  <ScrollViewer>
    <StackPanel Margin="20,4,20,120">
      <!--
        The title, and on the 할 일 tab the way to a new one: in the header rather than floating, so
        it never meets the dock or the home indicator. It opens the to-do sheet on today, in the
        list whose chip is lit.
      -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,14">
        <TextBlock Grid.Column="0" Classes="pagetitle" Text="{Binding Strings[TabLists]}" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="AddListTodoButton" Classes="pill sun" Height="34" Padding="14,0" FontSize="14"
                VerticalAlignment="Center" IsVisible="{Binding IsTodoList}" Command="{Binding AddListTodoCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <views:Glyph Kind="Plus" Width="13" Height="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource Mobile.SunInk}" />
            <TextBlock Text="{Binding Strings[MobileTodoAddShort]}" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <Border BorderBrush="{DynamicResource Mobile.Stroke}" BorderThickness="0,0,0,1" Margin="0,0,0,18">
        <StackPanel Orientation="Horizontal" Spacing="20">
          <Button Classes="listtab" Classes.active="{Binding IsTodoList}"
                  Command="{Binding SelectListCommand}" CommandParameter="{x:Static pvm:RightTab.Todo}">
            <TextBlock Text="{Binding Strings[SegmentTodo]}" />
          </Button>
          <Button Classes="listtab" Classes.active="{Binding IsFavoritesList}"
                  Command="{Binding SelectListCommand}" CommandParameter="{x:Static pvm:RightTab.Favorites}">
            <TextBlock Text="{Binding Strings[SegmentFavorites]}" />
          </Button>
          <Button Classes="listtab" Classes.active="{Binding IsTagsList}"
                  Command="{Binding SelectListCommand}" CommandParameter="{x:Static pvm:RightTab.Tags}">
            <TextBlock Text="{Binding Strings[SegmentTags]}" />
          </Button>
        </StackPanel>
      </Border>

      <!-- To-do: 지남, 오늘, 예정, 날짜 없음, 완료, each with its colour. -->
      <StackPanel IsVisible="{Binding IsTodoList}">
        <!--
          The lists, as chips over the bands. A list is a filter and not a destination, which is why
          there is no second level of navigation here; the desktop says the same thing with rows in
          its sidebar, and both read the same counts. The leading chip is not a list: it is how the
          filter comes off, and it carries the panel's own total.
        -->
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,18">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="pill" Classes.on="{Binding IsAllAgendaListsSelected}"
                    Command="{Binding SelectAgendaListCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="chipname" Text="{Binding Strings[MobileListAll]}" />
                <TextBlock Classes="chipcount" Text="{Binding Todo.OpenCount}" />
              </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Todo.Lists}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:AgendaListRowViewModel">
                  <Button Classes="pill" Classes.on="{Binding IsSelected}" ContextRequested="OnListChipContextRequested"
                          Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).SelectAgendaListCommand}"
                          CommandParameter="{Binding Id}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="chipname" Text="{Binding Name}" />
                      <TextBlock Classes="chipcount" Text="{Binding CountText}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="pill newlist" Command="{Binding NewAgendaListCommand}">
              <TextBlock Classes="chipname" Text="{Binding Strings[MobileListNew]}" />
            </Button>
          </StackPanel>
        </ScrollViewer>
        <ItemsControl ItemsSource="{Binding TodoGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodoGroupViewModel">
              <StackPanel Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" Classes="band"
                           Classes.overdue="{Binding IsOverdue}" Classes.today="{Binding IsToday}"
                           Classes.upcoming="{Binding IsUpcoming}" Classes.nodate="{Binding IsNoDate}"
                           Classes.done="{Binding IsDone}" />
                  <TextBlock Classes="line" FontSize="13.5" FontWeight="ExtraBold" VerticalAlignment="Center" Text="{Binding Label}" />
                  <TextBlock Classes="count" VerticalAlignment="Center" Text="{Binding CountText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TodoRowViewModel">
                      <Border Classes="rule todorow" Padding="0,11">
                        <Grid ColumnDefinitions="22,*,Auto">
                          <views:TodoCheck Grid.Column="0" VerticalAlignment="Top" Margin="-11,-10,-11,-12"
                                           IsChecked="{Binding Item.Checked}" Toggle="{Binding Item.ToggleCommand}" Key="{Binding Item.Key}" />
                          <Button Grid.Column="1" Classes="row" Margin="12,0,0,0" HorizontalContentAlignment="Left"
                                  Command="{Binding Item.JumpCommand}">
                            <StackPanel>
                              <Panel HorizontalAlignment="Left">
                                <TextBlock Classes="todo" Classes.done="{Binding Item.Checked}" FontSize="15.5" LineHeight="21.7"
                                           Text="{Binding Item.Text}" />
                                <Border Classes="strike" VerticalAlignment="Top" Margin="0,10.5,0,0" />
                              </Panel>
                              <TextBlock Classes="faint line" FontSize="12.5" Margin="0,3,0,0" Text="{Binding NoteCaption}" />
                            </StackPanel>
                          </Button>
                          <TextBlock Grid.Column="2" Classes="due" Classes.overdue="{Binding Item.Overdue}" Margin="12,2,0,0"
                                     VerticalAlignment="Top" Text="{Binding Item.DueLabel}" IsVisible="{Binding Item.HasDue}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="empty" Text="{Binding Strings.TodoEmpty}" IsVisible="{Binding IsTodoListEmpty}" />
      </StackPanel>

      <!-- Favourites -->
      <StackPanel IsVisible="{Binding IsFavoritesList}">
        <ItemsControl ItemsSource="{Binding FavoriteCards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FavoriteCardViewModel">
              <Button Classes="row" CornerRadius="18" Command="{Binding OpenCommand}">
                <Border Classes="card" CornerRadius="18" Padding="18,16">
                  <StackPanel>
                    <TextBlock Classes="line" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Mobile.SunInk}"
                               Text="{Binding DateLabel}" />
                    <TextBlock Classes="line" FontSize="16.5" FontWeight="ExtraBold" LetterSpacing="-0.33" Margin="0,4,0,0"
                               Text="{Binding Title}" />
                    <TextBlock Classes="muted line" FontSize="13.5" Margin="0,4,0,0" Text="{Binding Preview}" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="empty" Text="{Binding Strings[FavoritesPanelEmpty]}" IsVisible="{Binding IsFavoritesListEmpty}" />
      </StackPanel>

      <!-- Tags: every tag as a chip, and the notes under the chosen one. -->
      <StackPanel IsVisible="{Binding IsTagsList}">
        <ItemsControl ItemsSource="{Binding TagChips}" Margin="0,0,0,18">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TagChipViewModel">
              <Button Classes="pill" Classes.on="{Binding IsSelected}" Command="{Binding SelectCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding Name, StringFormat='#{0}'}" />
                  <TextBlock FontSize="12" FontWeight="Medium" Opacity="0.75" VerticalAlignment="Center" Text="{Binding CountText}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding SelectedTag.Notes, FallbackValue={x:Null}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TagNoteRowViewModel">
              <Button Classes="row" Command="{Binding OpenCommand}">
                <Border Classes="rule" Padding="0,14">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="line" FontSize="15.5" FontWeight="Bold" Text="{Binding Title}" />
                    <TextBlock Grid.Column="1" Classes="faint line" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"
                               Text="{Binding DateLabel}" />
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="empty" Text="{Binding Strings[TagPanelEmpty]}" IsVisible="{Binding IsTagListEmpty}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Styles>
    <!-- A tab under the page title: dim, then full ink with a sun underline when chosen. -->
    <Style Selector="Button.listtab">
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2.5" />
    </Style>
    <Style Selector="Button.listtab.active">
      <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Sun}" />
    </Style>
    <Style Selector="Button.listtab TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
      <Setter Property="Margin" Value="0,2.5,0,0" />
    </Style>
    <Style Selector="Button.listtab.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text}" />
    </Style>
    <!-- A chip's two halves: the name, and how much is owed in it, dimmer. -->
    <Style Selector="TextBlock.chipname">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.chipcount">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The last chip is an action, not a filter, so it is outlined rather than filled. -->
    <Style Selector="Button.pill.newlist TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="Ellipse.band.overdue">
      <Setter Property="Fill" Value="{DynamicResource Mobile.Danger}" />
    </Style>
    <Style Selector="Ellipse.band.today">
      <Setter Property="Fill" Value="{DynamicResource Mobile.Sun}" />
    </Style>
    <Style Selector="Ellipse.band.upcoming">
      <Setter Property="Fill" Value="{DynamicResource Mobile.Pri}" />
    </Style>
    <Style Selector="Ellipse.band.nodate">
      <Setter Property="Fill" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="Ellipse.band.done">
      <Setter Property="Fill" Value="{DynamicResource Mobile.Stroke}" />
    </Style>
  </UserControl.Styles>
</UserControl>
