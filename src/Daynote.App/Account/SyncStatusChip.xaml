<UserControl
    x:Class="Daynote.App.Account.SyncStatusChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:account="clr-namespace:Daynote.App.Account"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance account:AccountViewModel}"
    Visibility="{Binding Status.IsVisible, Converter={StaticResource Daynote.Convert.BoolToVisibility}}">
    <!-- Signed out, the chip is absent rather than showing "off": an always-present control would
         advertise a feature the user has declined. Clicking opens settings, where the detail lives. -->
    <Button Style="{DynamicResource Daynote.Product.Style.GhostButton}" Height="26" Padding="8,0"
            Command="{Binding DataContext.ToggleSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            ToolTip="{Binding Status.Label}"
            AutomationProperties.Name="{loc:Tr SyncStatusAutomation}"
            AutomationProperties.HelpText="{Binding Status.Label}">
        <TextBlock VerticalAlignment="Center" FontSize="11" Text="{Binding Status.Label}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
                    <Style.Triggers>
                        <!-- Locked and Error are the two states the user has to act on, so they take
                             the accent rather than the muted secondary colour. -->
                        <DataTrigger Binding="{Binding Status.NeedsAttention}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Accent.500}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Button>
</UserControl>
