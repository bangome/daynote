<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daynote.Mobile.ViewModels"
             xmlns:pvm="using:Daynote.App.Shell.Product"
             xmlns:views="using:Daynote.Mobile.Views"
             x:Class="Daynote.Mobile.Views.MainView"
             x:DataType="vm:MobileShellViewModel"
             FontFamily="{StaticResource Mobile.Font}"
             Background="{DynamicResource Mobile.Bg}">
  <!--
    The phone shell: one page at a time under a floating tab bar, with the editor and the account
    page as layers over the tabs and the month sheet over everything. The desktop puts the same
    surfaces in three columns side by side; a phone that tried that would show three slivers.

    Every page is built and kept alive, and only its visibility changes: swapping visibility keeps
    scroll position and keyboard focus across a tab switch, which recreating them would throw away.
  -->
  <Panel>
    <views:DayPage IsVisible="{Binding IsDayPage}" />
    <views:SearchPage IsVisible="{Binding IsSearchPage}" />
    <views:ListsPage IsVisible="{Binding IsListsPage}" />
    <views:SettingsPage IsVisible="{Binding IsSettingsPage}" />

    <views:EditorPage x:Name="Editor" IsVisible="{Binding IsEditorOpen}" />
    <views:AccountPage IsVisible="{Binding IsAccountOpen}" />

    <!--
      The floating bar and the new-note button beside it. It floats over the page rather than
      taking a row, so every page pads its scroll content by the bar's height instead; the bottom
      margin is set in code from the safe area (MainView.axaml.cs).
    -->
    <Grid x:Name="Dock" VerticalAlignment="Bottom" Margin="16,0,16,12" ColumnDefinitions="*,Auto"
          IsVisible="{Binding ShowDock}">
      <Border Grid.Column="0" Height="62" CornerRadius="31" Padding="6,0"
              Background="{DynamicResource Mobile.Bar}" BorderBrush="{DynamicResource Mobile.Stroke}" BorderThickness="1"
              BoxShadow="0 10 30 0 #24161a36">
        <Grid ColumnDefinitions="*,*,*,*">
          <!-- "Today", not "Day": it goes to the day screen and lands on today. -->
          <Button Grid.Column="0" Classes="tab" Classes.active="{Binding IsDayPage}"
                  Command="{Binding GoToTodayPageCommand}"
                  AutomationProperties.Name="{Binding Strings[Today]}">
            <StackPanel Spacing="3">
              <views:Glyph Kind="TabToday" Width="22" Height="22" Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding Strings[Today]}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="tab" Classes.active="{Binding IsSearchPage}"
                  Command="{Binding GoToPageCommand}" CommandParameter="{x:Static vm:MobilePage.Search}"
                  AutomationProperties.Name="{Binding Strings[TabSearch]}">
            <StackPanel Spacing="3">
              <views:Glyph Kind="TabSearch" Width="22" Height="22" Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding Strings[TabSearch]}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="tab" Classes.active="{Binding IsListsPage}"
                  Command="{Binding GoToPageCommand}" CommandParameter="{x:Static vm:MobilePage.Lists}"
                  AutomationProperties.Name="{Binding Strings[TabLists]}">
            <StackPanel Spacing="3">
              <views:Glyph Kind="TabLists" Width="22" Height="22" Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding Strings[TabLists]}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Classes="tab" Classes.active="{Binding IsSettingsPage}"
                  Command="{Binding GoToPageCommand}" CommandParameter="{x:Static vm:MobilePage.Settings}"
                  AutomationProperties.Name="{Binding Strings[Settings]}">
            <StackPanel Spacing="3">
              <views:Glyph Kind="TabSettings" Width="22" Height="22" Foreground="{Binding $parent[Button].Foreground}"
                           Fill="{DynamicResource Mobile.Card}" />
              <TextBlock Text="{Binding Strings[Settings]}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <Border Grid.Column="1" Margin="10,0,0,0" Width="62" Height="62" CornerRadius="31"
              Background="{DynamicResource Mobile.Pri}" BoxShadow="0 10 24 0 #4d161a36">
        <Button Width="62" Height="62" CornerRadius="31" Command="{Binding NewNoteCommand}"
                AutomationProperties.Name="{Binding Strings[AddNote]}">
          <views:Glyph Kind="Plus" Width="22" Height="22" Foreground="{DynamicResource Mobile.OnPri}" />
        </Button>
      </Border>
    </Grid>

    <!--
      The month sheet: the whole calendar, which the home screen gave up for the week strip. A scrim
      that closes on a tap rather than a cancel button, because there is nothing to confirm - the day
      tapped in the grid is the choice, and it closes the sheet itself.
    -->
    <Panel IsVisible="{Binding IsMonthPickerOpen}">
      <Button Classes="scrim" Command="{Binding CloseMonthPickerCommand}"
              AutomationProperties.Name="{Binding Strings[WindowClose]}" />
      <Border x:Name="Sheet" Classes="sheet" VerticalAlignment="Bottom">
        <!-- Scrolls only when the screen is shorter than the sheet: a phone on its side, or a
             split-screen window, would otherwise push the year header off the top and the last
             week into the home indicator. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,10,16,0">
          <Border Width="40" Height="5" CornerRadius="3" Background="{DynamicResource Mobile.Stroke}" Margin="0,0,0,12" />
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,10">
            <Button Grid.Column="0" Width="40" Height="40" Command="{Binding PickerPreviousYearCommand}"
                    AutomationProperties.Name="{Binding Strings[MobilePreviousYear]}">
              <views:Glyph Kind="ChevronLeft" Width="11" Height="11" Foreground="{DynamicResource Mobile.Text2}" />
            </Button>
            <TextBlock Grid.Column="1" FontSize="17" FontWeight="ExtraBold" TextAlignment="Center" VerticalAlignment="Center"
                       Text="{Binding PickerYearText}" />
            <Button Grid.Column="2" Width="40" Height="40" Command="{Binding PickerNextYearCommand}"
                    AutomationProperties.Name="{Binding Strings[MobileNextYear]}">
              <views:Glyph Kind="ChevronRight" Width="11" Height="11" Foreground="{DynamicResource Mobile.Text2}" />
            </Button>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding PickerMonths}" Margin="4,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MonthOption">
                  <Button Classes="pill month" Classes.on="{Binding IsCurrent}"
                          Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).PickMonthCommand}"
                          CommandParameter="{Binding Number}">
                    <TextBlock Text="{Binding Label}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <UniformGrid Columns="7">
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdaySun]}" Foreground="{DynamicResource Mobile.Sunday}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayMon]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayTue]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayWed]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayThu]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayFri]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdaySat]}" Foreground="{DynamicResource Mobile.Text}" />
          </UniformGrid>
          <ItemsControl ItemsSource="{Binding Calendar.Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pvm:CalendarDayCellViewModel">
                <Button Classes="cell" Classes.outside="{Binding !IsInMonth}" Classes.sunday="{Binding IsSunday}"
                        Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                        Command="{Binding SelectCommand}" IsHitTestVisible="{Binding IsInMonth}">
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Border Classes="cellday">
                      <TextBlock Text="{Binding DayText}" />
                    </Border>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource Mobile.Sun}" IsVisible="{Binding HasNotes}" />
                    <Border Width="4" Height="4" IsVisible="{Binding !HasNotes}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Panel>
  </Panel>

  <UserControl.Styles>
    <!-- A tab in the floating bar: the mark over a ten-point label, dim until it is the page. -->
    <Style Selector="Button.tab">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text}" />
    </Style>
    <Style Selector="Button.tab TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <Style Selector="Button.scrim">
      <Setter Property="Background" Value="{DynamicResource Mobile.Scrim}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.scrim:pressed">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.sheet">
      <Setter Property="Background" Value="{DynamicResource Mobile.Panel}" />
      <Setter Property="CornerRadius" Value="28,28,0,0" />
      <Setter Property="BoxShadow" Value="0 -10 40 0 #33000000" />
    </Style>
    <Style Selector="TextBlock.sheetwd">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,4,0,6" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>

    <!-- A day in the sheet: a 38-point rounded square over the activity dot, 46 points a row. -->
    <Style Selector="Button.cell">
      <Setter Property="Height" Value="46" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.cell:pressed">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.cellday">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.cellday TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Button.cell.sunday Border.cellday TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Sunday}" />
    </Style>
    <Style Selector="Button.cell.today Border.cellday">
      <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Sun}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.cell.today Border.cellday TextBlock">
      <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="Button.cell.selected Border.cellday">
      <Setter Property="Background" Value="{DynamicResource Mobile.Pri}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.cell.selected Border.cellday TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.OnPri}" />
      <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="Button.cell.outside">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </UserControl.Styles>
</UserControl>
