<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Daynote.Desktop.ViewModels"
        xmlns:notes="using:Daynote.App.Notes"
        xmlns:pvm="using:Daynote.App.Shell.Product"
        xmlns:views="using:Daynote.Desktop.Views"
        xmlns:motion="using:Daynote.Motion"
        xmlns:account="using:Daynote.App.Account"
        xmlns:agenda="using:Daynote.Core.Agenda"
        x:Class="Daynote.Desktop.Views.MainWindow"
        x:DataType="vm:DesktopShellViewModel"
        Title="Daynote"
        Width="1240" Height="780" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Daynote.Product.Brush.Bg1}"
        Icon="avares://Daynote.Desktop/Assets/daynote-favicon-v1.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="62">
  <!--
    Design "Daynote Desktop B" (.omc/design/Daynote Desktop B.dc.html): a navy sidebar, a header with
    the big date and the week, the editor (or the timeline, or a list) in the middle, the day's to-dos
    and files at the right. Overlays - the palette, settings, the account card, the tutorial - sit over
    all of it in the same root grid.

    There is no title bar of its own any more. On macOS the traffic lights sit over the sidebar's brand
    row, which leaves them room (MainWindow.Chrome.cs), and the header and that row drag the window. On
    Windows a thin strip at the top of the main column carries the caption buttons.
  -->

  <Grid x:Name="Root" ColumnDefinitions="Auto,*">

    <!-- ── Sidebar ───────────────────────────────────────────────────────────────────────── -->
    <Border x:Name="Sidebar" Grid.Column="0" Classes="sidebar" Width="256" IsVisible="{Binding !LeftCollapsed}">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- Brand: the mark, the name, and the collapse chevron. Background="Transparent" is
             load-bearing: it is a drag handle on macOS, and a Grid with no brush takes no clicks. -->
        <Grid x:Name="BrandRow" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="18,18,18,14" Background="Transparent">
          <!-- The wordmark carries the mark and the name together, cut out of the plate it was
               drawn on so it sits on the sidebar's navy in either theme. -->
          <Image Grid.Column="0" Grid.ColumnSpan="2" Height="28" HorizontalAlignment="Left"
                 Source="{Binding BrandLogo}"
                 RenderOptions.BitmapInterpolationMode="HighQuality" AutomationProperties.Name="Daynote" />
          <Button x:Name="SidebarCollapse" Grid.Column="2" Classes="sideicon" Width="26" Height="26" Command="{Binding ToggleLeftCommand}"
                  ToolTip.Tip="{Binding SidebarCollapseTip}" AutomationProperties.Name="{Binding Strings[SidebarsCollapse]}">
            <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
          </Button>
        </Grid>

        <!-- Search: opens the palette. -->
        <Button x:Name="TutSearch" Grid.Row="1" Classes="sidesearch" Margin="12,0,12,10" Command="{Binding OpenPaletteCommand}"
                AutomationProperties.Name="{Binding Strings[DeskSearch]}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0" Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Search}"
                  RenderTransform="scale(0.875)" Width="16" Height="16" />
            <TextBlock Grid.Column="1" Margin="9,0,0,0" FontSize="13" VerticalAlignment="Center" Text="{Binding Strings[DeskSearch]}" />
            <Border Grid.Column="2" BorderBrush="{DynamicResource Daynote.Desk.Brush.SideStroke}" BorderThickness="1"
                    CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
              <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{x:Static vm:DesktopShellViewModel.PaletteHint}" />
            </Border>
          </Grid>
        </Button>

        <!-- The views: today's notes, the timeline, and the four lists that used to be right-rail tabs. -->
        <StackPanel Grid.Row="2" Spacing="1" Margin="12,4">
          <Button Classes="navitem" Classes.active="{Binding IsNavEditor}" Command="{Binding ShowEditorCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavToday]}" />
            </Grid>
          </Button>
          <Button Classes="navitem" Classes.active="{Binding IsNavTimeline}" Command="{Binding ShowTimelineCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavTimeline]}" />
            </Grid>
          </Button>
          <Button x:Name="TutTabTodo" Classes="navitem" Classes.active="{Binding IsNavTodo}"
                  Command="{Binding ShowListCommand}" CommandParameter="{x:Static pvm:RightTab.Todo}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavTodo]}" />
              <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center" Text="{Binding Todo.OpenCount}" />
            </Grid>
          </Button>
          <Button x:Name="TutTabFavorites" Classes="navitem" Classes.active="{Binding IsNavFavorites}"
                  Command="{Binding ShowListCommand}" CommandParameter="{x:Static pvm:RightTab.Favorites}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavFavorites]}" />
              <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center" Text="{Binding Favorites.Items.Count}" />
            </Grid>
          </Button>
          <Button x:Name="TutTabTags" Classes="navitem" Classes.active="{Binding IsNavTags}"
                  Command="{Binding ShowListCommand}" CommandParameter="{x:Static pvm:RightTab.Tags}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavTags]}" />
              <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center" Text="{Binding TagPanel.Tags.Count}" />
            </Grid>
          </Button>
          <Button x:Name="TutTabFiles" Classes="navitem" Classes.active="{Binding IsNavFiles}"
                  Command="{Binding ShowListCommand}" CommandParameter="{x:Static pvm:RightTab.Files}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavFiles]}" />
              <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center" Text="{Binding Files.Items.Count}" />
            </Grid>
          </Button>
        </StackPanel>

        <!-- Mini month: the selected day a sun square, today a lighter one, a dot under days with notes. -->
        <Border x:Name="TutCalendar" Grid.Row="4" Margin="12,0" Padding="6,14,6,12"
                BorderBrush="{DynamicResource Daynote.Desk.Brush.SideStroke}" BorderThickness="0,1,0,0">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,0,4,8">
              <TextBlock Grid.Column="0" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"
                         Foreground="{DynamicResource Daynote.Desk.Brush.SideText}" Text="{Binding Calendar.MonthLabel}" />
              <Button Grid.Column="1" Classes="sideicon" Width="24" Height="24" CornerRadius="6" Margin="0,0,2,0"
                      Command="{Binding Calendar.PreviousMonthCommand}" AutomationProperties.Name="{Binding Strings[PreviousMonth]}">
                <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
              </Button>
              <Button Grid.Column="2" Classes="sideicon" Width="24" Height="24" CornerRadius="6"
                      Command="{Binding Calendar.NextMonthCommand}" AutomationProperties.Name="{Binding Strings[NextMonth]}">
                <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
              </Button>
            </Grid>
            <UniformGrid Columns="7">
              <UniformGrid.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="FontSize" Value="10.5" />
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="Margin" Value="0,3" />
                  <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Side2}" />
                </Style>
              </UniformGrid.Styles>
              <TextBlock Text="{Binding Strings.WeekdaySun}" />
              <TextBlock Text="{Binding Strings.WeekdayMon}" />
              <TextBlock Text="{Binding Strings.WeekdayTue}" />
              <TextBlock Text="{Binding Strings.WeekdayWed}" />
              <TextBlock Text="{Binding Strings.WeekdayThu}" />
              <TextBlock Text="{Binding Strings.WeekdayFri}" />
              <TextBlock Text="{Binding Strings.WeekdaySat}" />
            </UniformGrid>
            <ItemsControl x:Name="MiniCalendar" ItemsSource="{Binding Calendar.Cells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:CalendarDayCellViewModel">
                  <Button Classes="minicell" Classes.sunday="{Binding IsSunday}" Classes.today="{Binding IsToday}"
                          Classes.selected="{Binding IsSelected}" IsHitTestVisible="{Binding IsInMonth}"
                          Command="{Binding SelectCommand}">
                    <Panel>
                      <Border Classes="face">
                        <TextBlock Text="{Binding DayText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Ellipse Width="3" Height="3" Fill="{DynamicResource Daynote.Desk.Brush.Sun}" VerticalAlignment="Bottom"
                               HorizontalAlignment="Center" Margin="0,0,0,-1" IsVisible="{Binding HasNotes}" />
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Who is signed in, the sync state, and the way to settings. Opens the account popover. -->
        <views:AccountBar x:Name="TutSettings" Grid.Row="5" />
      </Grid>
    </Border>

    <!-- ── Main column ───────────────────────────────────────────────────────────────────── -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

      <!-- Windows only: the caption buttons, drawn by the app so they match it (MainWindow.Chrome.cs
           gives each the element role Win32 hit-testing maps to minimize / maximize / close). -->
      <Grid x:Name="TitleBarRow" Grid.Row="0" Height="32" ColumnDefinitions="*,Auto" Background="Transparent" IsVisible="False">
        <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Classes="caption" Click="OnMinimize" ToolTip.Tip="{Binding Strings[WindowMinimize]}">
            <Path Data="M0,5 L10,5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
          </Button>
          <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximizeRestore" ToolTip.Tip="{Binding Strings[WindowMaximize]}">
            <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
          </Button>
          <Button x:Name="CloseButton" Classes="caption close" Click="OnCloseWindow" ToolTip.Tip="{Binding Strings[WindowClose]}">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Header: the big date, the week, and the view toggles. The week strip moves to a row of its
           own when the header is too narrow for one line (MainWindow.Header.cs), as the design's
           flex-wrap does. -->
      <Border x:Name="Header" Grid.Row="1" Padding="28,18,28,16" Background="Transparent"
              BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
        <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">
          <Button Grid.Column="0" Classes="ghost outlined" Margin="0,0,24,0" IsVisible="{Binding LeftCollapsed}"
                  Command="{Binding ToggleLeftCommand}" ToolTip.Tip="{Binding Strings[SidebarsExpand]}"
                  AutomationProperties.Name="{Binding Strings[SidebarsExpand]}">
            <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
          </Button>

          <Button x:Name="BigDate" Grid.Column="1" Theme="{StaticResource Daynote.Bare}" Command="{Binding GoToTodayCommand}"
                  ToolTip.Tip="{Binding TodayTip}" AutomationProperties.Name="{Binding Strings[GoToToday]}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <!-- line-height:1 in the design; Avalonia sets the glyphs lower in a line box shorter than
                   the font's own, so the margin puts the digits back where the browser draws them. -->
              <TextBlock FontSize="44" FontWeight="ExtraBold" LetterSpacing="-2.2" LineHeight="44" VerticalAlignment="Center"
                         Margin="0,-8,0,8" FontFeatures="+tnum" Text="{Binding BigDay}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="Bold" LetterSpacing="-0.3" Text="{Binding BigMeta}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                  <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding BigSub}" />
                  <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding IsTodaySelected}">
                    <TextBlock Text="{Binding Strings.Today}" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Button>

          <StackPanel x:Name="WeekStrip" Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="24,0"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Classes="weekstep" Command="{Binding Week.PreviousWeekCommand}" AutomationProperties.Name="{Binding Strings[DeskPreviousWeek]}">
              <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
            </Button>
            <ItemsControl ItemsSource="{Binding Week.Days}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:WeekStripDayViewModel">
                  <Button Classes="weekday" Classes.selected="{Binding IsSelected}" Classes.today="{Binding IsTodayRing}"
                          Classes.sunday="{Binding IsSunday}" Classes.notes="{Binding HasNotes}" Command="{Binding SelectCommand}">
                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Classes="wd" HorizontalAlignment="Center" Text="{Binding WeekdayLabel}" />
                      <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding DayText}" />
                      <Ellipse Classes="dot" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="weekstep" Command="{Binding Week.NextWeekCommand}" AutomationProperties.Name="{Binding Strings[DeskNextWeek]}">
              <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
            </Button>
          </StackPanel>

          <StackPanel x:Name="HeaderActions" Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="tool" Classes.primaryon="{Binding IsTimelineMode}" Padding="12,0" Command="{Binding ToggleTimelineCommand}"
                    ToolTip.Tip="{Binding Strings.TimelineToggle}" Content="{Binding Strings[DeskTimelineButton]}" />
            <Button Classes="tool" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeTip}"
                    AutomationProperties.Name="{Binding Strings.ThemeToggle}">
              <Panel>
                <Path Classes="icon" StrokeThickness="1.4" Data="{StaticResource Daynote.Desk.Geo.Moon}" IsVisible="{Binding !IsDark}" />
                <Path Classes="icon" StrokeThickness="1.4" Data="{StaticResource Daynote.Desk.Geo.Sun}" IsVisible="{Binding IsDark}" />
              </Panel>
            </Button>
            <Button Classes="tool" Classes.on="{Binding !RightCollapsed}" Command="{Binding ToggleRightCommand}"
                    ToolTip.Tip="{Binding DayPanelTip}" AutomationProperties.Name="{Binding DayPanelTip}">
              <Path Classes="icon" StrokeThickness="1.3" Data="{StaticResource Daynote.Desk.Geo.Panel}" />
            </Button>
            <Button Classes="accent" Height="34" Padding="14,0" Margin="4,0,0,0" Command="{Binding NewNoteCommand}"
                    ToolTip.Tip="{Binding NewNoteTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" StrokeThickness="1.7" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Strings[NewNote]}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Body: the middle view, and the day panel at the right. -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">

        <!-- Editor -->
        <Grid x:Name="TutEditor" Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding IsEditorMode}">
          <!-- The day's notes as tabs, the selected one underlined in sun. Right-click a tab to rename,
               copy or delete it; Delete on a focused tab deletes it. -->
          <Border Grid.Row="0" Padding="28,0" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <ItemsControl x:Name="NoteTabs" ItemsSource="{Binding Notes.Tabs}" VerticalAlignment="Bottom">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="notes:NoteTabViewModel">
                      <!-- A projection (the blank "노트 1" of an empty day) is not a note yet, so it
                           gets no tab; the empty-day card stands in for it. -->
                      <Button Classes="notetab" Classes.selected="{Binding IsSelected}" IsVisible="{Binding !IsProjection}"
                              Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).SelectDayNoteCommand}"
                              CommandParameter="{Binding}">
                        <Button.KeyBindings>
                          <KeyBinding Gesture="Delete"
                                      Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).DeleteDayNoteCommand}"
                                      CommandParameter="{Binding}" />
                        </Button.KeyBindings>
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[NoteMenuRename]}"
                                      Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).RenameDayNoteCommand}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[NoteMenuDuplicate]}"
                                      Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).DuplicateDayNoteCommand}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[NoteMenuDelete]}"
                                      Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).DeleteDayNoteCommand}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Data="{StaticResource Daynote.Desk.Geo.Star}" Fill="{DynamicResource Daynote.Desk.Brush.Sun}"
                                VerticalAlignment="Center" IsVisible="{Binding IsFavorite}" />
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="ghost small" Margin="4,0,0,6" VerticalAlignment="Bottom" Command="{Binding NewNoteCommand}"
                        ToolTip.Tip="{Binding Strings[NewNote]}" AutomationProperties.Name="{Binding Strings[NewNote]}">
                  <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
                </Button>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- The note: a 760px column, title and actions, the meta line, the body, the footer. -->
          <Grid x:Name="NoteColumn" Grid.Row="1" RowDefinitions="Auto,*,Auto" MaxWidth="760" IsVisible="{Binding !IsDayEmpty}">
            <StackPanel Grid.Row="0" Margin="48,35,48,0">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <!-- The heading is a label until it is clicked (or a tab's Rename is picked); then the
                     same slot holds a text box with a draft. Enter or focus loss commits, Escape drops
                     the draft. Both are set in the same type so the swap does not jump. -->
                <TextBlock Grid.Column="0" FontSize="24" FontWeight="ExtraBold" LetterSpacing="-0.8"
                           Text="{Binding Notes.SelectedTab.Title, FallbackValue=''}" Cursor="IBeam"
                           IsVisible="{Binding !IsRenamingTitle}" Tapped="OnTitleTapped" DoubleTapped="OnTitleDoubleTapped"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <TextBox x:Name="TitleEditor" Grid.Column="0" Classes="bare title" Text="{Binding TitleDraft}"
                         PlaceholderText="{Binding Strings[DeskTitlePlaceholder]}" IsVisible="{Binding IsRenamingTitle}"
                         KeyDown="OnTitleEditorKeyDown" LostFocus="OnTitleEditorLostFocus"
                         VerticalAlignment="Center" Margin="0,0,8,0" />

                <Button Grid.Column="1" Classes="quiet" Margin="0,0,6,0" VerticalAlignment="Center"
                        Content="{Binding Strings[RetrySave]}" Command="{Binding Notes.RetryCommand}" IsVisible="{Binding Notes.HasSaveError}" />
                <Button Grid.Column="2" Classes="ghost" Classes.favorite="{Binding Notes.SelectedTab.IsFavorite, FallbackValue=False}"
                        Command="{Binding ToggleFavoriteCommand}" IsEnabled="{Binding HasOpenNote}"
                        ToolTip.Tip="{Binding Strings.Favorite}" AutomationProperties.Name="{Binding Strings.Favorite}">
                  <Path Classes="star" Data="{StaticResource Daynote.Desk.Geo.Star}" Stretch="Uniform" Width="17" Height="17" />
                </Button>
                <Button Grid.Column="3" Classes="ghost" Command="{Binding OpenStickyCommand}" IsEnabled="{Binding HasOpenNote}"
                        ToolTip.Tip="{Binding StickyTip}" AutomationProperties.Name="{Binding Strings.OpenStickyNote}">
                  <Path Classes="icon" StrokeThickness="1.3" Data="{StaticResource Daynote.Desk.Geo.PostIt}"
                        Stretch="Uniform" Width="15" Height="15" />
                </Button>
                <Button Grid.Column="4" Classes="ghost danger" Command="{Binding DeleteSelectedNoteCommand}" IsEnabled="{Binding HasOpenNote}"
                        ToolTip.Tip="{Binding Strings[DeleteNoteTip]}" AutomationProperties.Name="{Binding Strings[DeleteNoteTip]}">
                  <Path Classes="icon" StrokeThickness="1.2" Data="{StaticResource Daynote.Desk.Geo.Trash}"
                        Stretch="Uniform" Width="15" Height="15" />
                </Button>
              </Grid>

              <!-- Meta: the date, the tags (sun ink, a cross to remove), the entry for another. -->
              <WrapPanel Orientation="Horizontal" Margin="0,12,0,20">
                <TextBlock Classes="muted" FontSize="12.5" Margin="0,0,14,0" VerticalAlignment="Center" Text="{Binding NoteDateText}" />
                <ItemsControl ItemsSource="{Binding Notes.SelectedTab.Tags, FallbackValue={x:Null}}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,0">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}"
                                   VerticalAlignment="Center" Text="{Binding StringFormat='#{0}'}" />
                        <Button Classes="tagx" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).RemoveTagCommand}"
                                CommandParameter="{Binding}">
                          <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Close}" RenderTransform="scale(1)" />
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="TagBox" Classes="bare tagentry" VerticalAlignment="Center"
                         PlaceholderText="{Binding Strings.TagAddPlaceholder}" Text="{Binding TagInput}" KeyDown="OnTagBoxKeyDown" />
              </WrapPanel>
            </StackPanel>

            <!--
              The body: a highlight layer with the editor over it, the editor's own text drawn in
              nothing so the caret sits over the coloured glyphs. Avalonia's TextBox has no inline
              formatting, so marking up what the app understood - checkboxes, due dates, #tags, links -
              means a second layer that draws the same string with the same metrics (the `editor` and
              `editorhighlight` classes, and EditorHighlightTests, which measures them).
            -->
            <Grid Grid.Row="1" Margin="48,0">
              <ScrollViewer x:Name="HighlightScroll" IsHitTestVisible="False"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <TextBlock x:Name="Highlight" Classes="editorhighlight" Padding="0,0,0,40" />
              </ScrollViewer>
              <TextBox x:Name="Editor" Classes="editor" Padding="0,0,0,40" Text="{Binding Notes.EditorText}"
                       VerticalContentAlignment="Top" Foreground="Transparent" PlaceholderText="{Binding Strings.EditorEmptyHint}" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="48,10,48,14">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource Daynote.Desk.Brush.Saved}" IsVisible="{Binding IsSaveSettled}" />
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource Daynote.Desk.Brush.Text3}" IsVisible="{Binding !IsSaveSettled}" />
                <TextBlock Classes="faint" FontSize="11.5" VerticalAlignment="Center" Text="{Binding SaveFooterText}" />
              </StackPanel>
              <TextBlock Classes="faint" FontSize="11.5" VerticalAlignment="Center" Text="{Binding CharLineText}" />
            </StackPanel>
          </Grid>

          <!-- An empty day: say so, and offer the one thing to do about it. -->
          <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDayEmpty}">
            <TextBlock FontSize="20" FontWeight="Bold" LetterSpacing="-0.4" HorizontalAlignment="Center" Text="{Binding Strings[DeskEmptyDayTitle]}" />
            <TextBlock Classes="muted" FontSize="13" HorizontalAlignment="Center" Text="{Binding Strings[DeskEmptyDayBody]}" />
            <Button Classes="accent" Height="38" Padding="18,0" CornerRadius="10" Margin="0,8,0,0" HorizontalAlignment="Center"
                    Command="{Binding NewNoteCommand}" Content="{Binding EmptyDayButtonText}" />
          </StackPanel>
        </Grid>

        <!-- Timeline: each day's date in a column, its notes as cards beside it. -->
        <ScrollViewer Grid.Column="0" Padding="28,32,28,48" IsVisible="{Binding IsTimelineMode}">
          <StackPanel MaxWidth="860">
            <ItemsControl ItemsSource="{Binding TimelineGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:TimelineDayGroup">
                  <Border Padding="0,22" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="140,28,*">
                      <Button Grid.Column="0" Classes="link" VerticalAlignment="Top"
                              Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).OpenTimelineDayCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock FontSize="15" FontWeight="ExtraBold" LetterSpacing="-0.3" Text="{Binding Heading}" />
                          <TextBlock Classes="muted" FontSize="12" Margin="0,3,0,0" Text="{Binding CountText}" />
                        </StackPanel>
                      </Button>
                      <ItemsControl Grid.Column="2" ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="pvm:TimelineNoteRow">
                            <Border Classes="panel" Padding="20,18">
                              <StackPanel>
                                <Button Classes="link" Command="{Binding OpenCommand}">
                                  <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock FontSize="16" FontWeight="Bold" LetterSpacing="-0.3" Text="{Binding Title}" />
                                    <Path Data="{StaticResource Daynote.Desk.Geo.Star}" Fill="{DynamicResource Daynote.Desk.Brush.Sun}"
                                          VerticalAlignment="Center" IsVisible="{Binding IsFavorite}" />
                                  </StackPanel>
                                </Button>
                                <TextBlock Classes="muted" FontSize="13.5" LineHeight="24.3" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{Binding DisplayBody}" />
                                <Button Classes="link sun" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0"
                                        Content="{Binding ExpandLabel}" Command="{Binding ToggleExpandCommand}" IsVisible="{Binding IsTruncated}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="quiet" HorizontalAlignment="Center" Margin="0,20,0,0" Content="{Binding Strings[DeskLoadMore]}"
                    Command="{Binding Timeline.LoadMoreCommand}" IsVisible="{Binding Timeline.HasMore}" />
            <TextBlock Classes="empty" HorizontalAlignment="Center" Margin="0,40" Text="{Binding Strings.TimelineEmpty}"
                       IsVisible="{Binding Timeline.IsEmpty}" />
          </StackPanel>
        </ScrollViewer>

        <!-- Lists: to-dos, favourites, tags, files. -->
        <ScrollViewer Grid.Column="0" Padding="28,32,28,48" IsVisible="{Binding IsListMode}">
          <StackPanel MaxWidth="760">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,20">
              <TextBlock Grid.Column="0" FontSize="26" FontWeight="ExtraBold" LetterSpacing="-0.8" VerticalAlignment="Bottom" Text="{Binding ListTitle}" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="13" VerticalAlignment="Bottom" Margin="10,0,0,4" Text="{Binding ListSubtitle}" />
              <!-- On the 할 일 view: a to-do on today, in the list being looked at. -->
              <Button Grid.Column="3" x:Name="ListAddTodo" Classes="accent pill small" VerticalAlignment="Bottom"
                      IsVisible="{Binding TabIsTodo}" Content="{Binding Strings[TodoAddButton]}" Command="{Binding AddListTodoCommand}" />
            </Grid>

            <!-- To-dos, every note on every date. -->
            <StackPanel IsVisible="{Binding TabIsTodo}">
              <StackPanel.Resources>
                <DataTemplate x:Key="TodoListRow" x:DataType="pvm:TodoItemViewModel">
                  <Border Classes="todorow" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
                    <Button Classes="row" CornerRadius="0" Padding="18,14" Command="{Binding JumpCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <views:DeskTodoCheck Grid.Column="0" Classes="large" Margin="0,0,14,0"
                                             IsChecked="{Binding Checked}" Toggle="{Binding ToggleCommand}" Key="{Binding Key}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <Panel HorizontalAlignment="Left">
                            <TextBlock FontSize="14" TextWrapping="Wrap" Classes.done="{Binding Checked}" Text="{Binding Text}" />
                            <Border Classes="strike" Margin="0,9.5,0,0" />
                          </Panel>
                          <TextBlock Classes="faint" FontSize="12" Margin="0,2,0,0" Text="{Binding NoteLabel}" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource Daynote.Product.Brush.Seg}" CornerRadius="6" Padding="8,3"
                                Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasDue}">
                          <TextBlock Classes="due" Classes.overdue="{Binding Overdue}" FontSize="12" FontWeight="Bold" Text="{Binding DueLabel}" />
                        </Border>
                      </Grid>
                    </Button>
                  </Border>
                </DataTemplate>
              </StackPanel.Resources>
              <Border Classes="panel" ClipToBounds="True" IsVisible="{Binding !Todo.IsEmpty}">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Todo.TodayItems}" ItemTemplate="{StaticResource TodoListRow}" />
                  <ItemsControl ItemsSource="{Binding Todo.Items}" ItemTemplate="{StaticResource TodoListRow}" />
                </StackPanel>
              </Border>
              <TextBlock Classes="empty" Text="{Binding Strings.TodoEmpty}" IsVisible="{Binding Todo.IsEmpty}" />
            </StackPanel>

            <!-- Favourites, as cards. -->
            <StackPanel IsVisible="{Binding TabIsFavorites}">
              <ItemsControl ItemsSource="{Binding Favorites.Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><views:AutoFillGrid MinItemWidth="220" Gap="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:FavoriteItemViewModel">
                    <!-- MinHeight is the design's 96px content box plus its padding and border. -->
                    <Button Classes="card" Padding="18,16" MinHeight="130" Command="{Binding OpenCommand}">
                      <StackPanel>
                        <TextBlock Classes="faint" FontSize="12" Text="{Binding DateLabel}" />
                        <TextBlock FontSize="15" FontWeight="Bold" LetterSpacing="-0.3" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Title}" />
                        <TextBlock Classes="muted" FontSize="12.5" LineHeight="20" Margin="0,6,0,0" TextWrapping="Wrap" MaxLines="3"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Preview}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="empty" Text="{Binding Strings.FavoritesPanelEmpty}" IsVisible="{Binding Favorites.IsEmpty}" />
            </StackPanel>

            <!-- Tags: a row per tag, opening to the notes that carry it. -->
            <StackPanel IsVisible="{Binding TabIsTags}">
              <ItemsControl ItemsSource="{Binding TagPanel.Tags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:TagItemViewModel">
                    <Border Classes="panel" ClipToBounds="True">
                      <StackPanel>
                        <Button Classes="row" CornerRadius="0" Padding="18,14" Command="{Binding ToggleExpandCommand}">
                          <Grid ColumnDefinitions="*,Auto">
                            <!-- Tag already carries its '#'. -->
                            <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}"
                                       Text="{Binding Tag}" />
                            <TextBlock Grid.Column="1" Classes="faint" FontSize="12" VerticalAlignment="Center" Text="{Binding NoteCountText}" />
                          </Grid>
                        </Button>
                        <Border Padding="8,6" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,1,0,0"
                                IsVisible="{Binding IsExpanded}">
                          <ItemsControl ItemsSource="{Binding Occurrences}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="pvm:TagOccurrenceViewModel">
                                <Button Classes="row" CornerRadius="8" Padding="10,9" Command="{Binding JumpCommand}">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding NoteTitle}" />
                                    <TextBlock Grid.Column="1" Classes="faint" FontSize="12" Margin="10,0,0,0" Text="{Binding DateLabel}" />
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="empty" Text="{Binding Strings.TagPanelEmpty}" IsVisible="{Binding TagPanel.IsEmpty}" />
            </StackPanel>

            <!-- Files on the selected day: a drop zone, then the cards. -->
            <StackPanel IsVisible="{Binding TabIsFiles}">
              <Button x:Name="FileDropZone" Theme="{StaticResource Daynote.Bare}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" Margin="0,0,0,12"
                      Command="{Binding Files.AddFilesCommand}" DragDrop.AllowDrop="True">
                <Panel>
                  <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource Daynote.Product.Brush.Stroke}" StrokeThickness="1.5"
                             StrokeDashArray="4,3" Fill="Transparent" />
                  <TextBlock Classes="muted" FontSize="13" Margin="22" HorizontalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding FilesDropText}" />
                </Panel>
              </Button>
              <ItemsControl ItemsSource="{Binding Files.Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><views:AutoFillGrid MinItemWidth="200" Gap="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:FileItemViewModel">
                    <!-- Double-tap writes a copy wherever the user points: the stored bytes live under a
                         hashed name, so this is the only way an attachment gets back out. -->
                    <Border Classes="panel" ClipToBounds="True" DoubleTapped="OnFileCardDoubleTapped"
                            ToolTip.Tip="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileTip]}">
                      <StackPanel>
                        <Panel Height="96" Background="{DynamicResource Daynote.Product.Brush.Seg}">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                          <TextBlock Classes="faint" FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Text="{Binding Ext}" IsVisible="{Binding !HasThumbnail}" />
                        </Panel>
                        <Grid ColumnDefinitions="*,Auto" Margin="12,10">
                          <StackPanel Grid.Column="0">
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <TextBlock Classes="faint" FontSize="11.5" Margin="0,1,0,0" Text="{Binding SizeLabel}" IsVisible="{Binding !WasSaved}" />
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Daynote.Product.Brush.Ok}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SavedTo}" IsVisible="{Binding WasSaved}" />
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Daynote.Product.Brush.Danger}" IsVisible="{Binding SaveFailed}"
                                       Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileFailed]}" />
                            <!-- Another device attached this and the bytes are still coming. -->
                            <TextBlock Classes="faint" FontSize="11.5" IsVisible="{Binding IsAwaitingDownload}"
                                       Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[FileAwaitingDownload]}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="link faint" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"
                                  Content="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskFileDelete]}"
                                  Command="{Binding DeleteCommand}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- The day panel: this date's to-dos, then its files. -->
        <Border x:Name="DayPanel" Grid.Column="1" Width="300" Background="{DynamicResource Daynote.Product.Brush.Panel}"
                BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="1,0,0,0"
                IsVisible="{Binding !RightCollapsed}" DragDrop.AllowDrop="True">
          <ScrollViewer>
            <StackPanel x:Name="DayPanelContent">
              <!-- + 할 일: the way to a to-do on this date. A note's body never makes one. -->
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="20,20,20,10">
                <TextBlock Grid.Column="0" FontSize="14" FontWeight="ExtraBold" LetterSpacing="-0.3" VerticalAlignment="Bottom" Text="{Binding Strings[DeskDayTodoTitle]}" />
                <TextBlock Grid.Column="1" Classes="faint" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,1" Text="{Binding DayTodoCountText}" />
                <Button Grid.Column="3" x:Name="DayAddTodo" Classes="link sun" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom"
                        Content="{Binding Strings[TodoAddButton]}" Command="{Binding AddDayTodoCommand}" />
              </Grid>
              <!-- A to-do made since the panel last showed arrives (motion spec M2); a tick draws itself (M3). -->
              <ItemsControl x:Name="DayTodoList" ItemsSource="{Binding DayTodos}" Margin="10,0"
                            motion:RowArrivals.IsEnabled="True" motion:RowArrivals.Context="{Binding SelectedDate}"
                            motion:RowArrivals.KnownItems="{Binding DayTodosDone}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:TodoItemViewModel">
                    <Panel Classes="todorow">
                      <Border Classes="rowflash" />
                      <Button Classes="row rowcontent" Padding="10,9" Command="{Binding JumpCommand}">
                        <Grid ColumnDefinitions="Auto,*">
                          <views:DeskTodoCheck Grid.Column="0" Margin="0,1,11,0" IsChecked="{Binding Checked}" Toggle="{Binding ToggleCommand}" Key="{Binding Key}" />
                          <StackPanel Grid.Column="1">
                            <Panel HorizontalAlignment="Left">
                              <TextBlock FontSize="13" LineHeight="18.85" TextWrapping="Wrap" Classes.done="{Binding Checked}" Text="{Binding Text}" />
                              <Border Classes="strike" Margin="0,9.4,0,0" />
                            </Panel>
                            <TextBlock Classes="due" Classes.overdue="{Binding Overdue}" FontSize="11.5" Margin="0,2,0,0"
                                       Text="{Binding DueLabel}" IsVisible="{Binding HasDue}" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- No fixed LineHeight: the code chip is an inline box taller than the text, and a fixed
                   line height clips the words beside it. -->
              <TextBlock Classes="empty" Margin="20,6,20,10" LineHeight="NaN" IsVisible="{Binding IsDayTodoEmpty}">
                <Run Text="{Binding Strings[TodoEmptyPrefix]}" /><InlineUIContainer BaselineAlignment="Center"><Border
                    Background="{DynamicResource Daynote.Product.Brush.Seg}" CornerRadius="4" Padding="5,1" Margin="0,2"><TextBlock
                    Classes="mono muted" FontSize="11.5" Text="{Binding Strings[TodoEmptyCode]}" /></Border></InlineUIContainer><Run
                    Text="{Binding Strings[DeskDayTodoEmptySuffix]}" />
              </TextBlock>

              <Border Height="1" Margin="20,14" Background="{DynamicResource Daynote.Product.Brush.Stroke2}" />

              <Grid ColumnDefinitions="*,Auto" Margin="20,0,20,10">
                <TextBlock Grid.Column="0" FontSize="14" FontWeight="ExtraBold" LetterSpacing="-0.3" Text="{Binding Strings[DeskNavFiles]}" />
                <Button Grid.Column="1" Classes="link sun" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom"
                        Content="{Binding Strings[DeskFilesAdd]}" Command="{Binding Files.AddFilesCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Files.Items}" Margin="10,0,10,20">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:FileItemViewModel">
                    <Border CornerRadius="9" Padding="10,8" Background="Transparent" DoubleTapped="OnFileCardDoubleTapped"
                            ToolTip.Tip="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileTip]}">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0"
                                Background="{DynamicResource Daynote.Product.Brush.Seg}">
                          <Panel>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                            <TextBlock Classes="muted" FontSize="8.5" FontWeight="ExtraBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Text="{Binding Ext}" IsVisible="{Binding !HasThumbnail}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Classes="faint" FontSize="11" Text="{Binding SizeLabel}" IsVisible="{Binding !WasSaved}" />
                          <!-- The same state lines as the files list, so a double-tap here says what happened. -->
                          <TextBlock FontSize="11" Foreground="{DynamicResource Daynote.Product.Brush.Ok}" TextTrimming="CharacterEllipsis"
                                     Text="{Binding SavedTo}" IsVisible="{Binding WasSaved}" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource Daynote.Product.Brush.Danger}" IsVisible="{Binding SaveFailed}"
                                     Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileFailed]}" />
                          <TextBlock Classes="faint" FontSize="11" IsVisible="{Binding IsAwaitingDownload}"
                                     Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[FileAwaitingDownload]}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="empty" Margin="20,-16,20,20" Text="{Binding Strings[DeskFilesEmpty]}" IsVisible="{Binding Files.IsEmpty}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- ── Overlays ──────────────────────────────────────────────────────────────────────── -->

    <!-- Settings: a 760x560 dialog with the four sections down its left. -->
    <!-- Each overlay opens and closes as the motion spec's desktop M6 has it (Popover). -->
    <Border Grid.ColumnSpan="2" Classes="scrim" ZIndex="20" IsVisible="False" motion:Popover.IsOpen="{Binding IsSettingsOpen}"
            PointerPressed="OnSettingsScrimPressed">
      <views:SettingsPanel x:Name="SettingsDialog" MaxWidth="760" MaxHeight="560" Margin="24" />
    </Border>

    <!--
      Add a to-do (the phone's to-do sheet, as a card): 할 일 / 일정, 제목, 날짜, 시간 or start and end,
      반복, 내용 and 목록, over the window. Opened from + 할 일 in the day panel and the 할 일 view; a
      note's body never makes a to-do. Each picker opens under its own row, one at a time.
    -->
    <Border x:Name="AddTodoScrim" Grid.ColumnSpan="2" Classes="scrim" ZIndex="22" IsVisible="False"
            motion:Popover.IsOpen="{Binding IsAddTodoOpen}" PointerPressed="OnAddTodoScrimPressed">
      <Border x:Name="AddTodoCard" Classes="modal" Width="460" MaxHeight="660" Margin="24" Padding="22,18,22,18"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Classes="h1" VerticalAlignment="Center" Text="{Binding Strings[TodoAddTitle]}" />
            <Button Grid.Column="1" Classes="ghost small" Command="{Binding CloseAddTodoCommand}"
                    AutomationProperties.Name="{Binding Strings[TodoEntryCancel]}">
              <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Close}" />
            </Button>
          </Grid>

          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
            <Button x:Name="AddTodoKindTask" Classes="opt" Classes.on="{Binding TodoEntry.IsTask}"
                    Command="{Binding TodoEntry.SelectKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Task}"
                    Content="{Binding Strings[AgendaCaptureTask]}" />
            <Button x:Name="AddTodoKindEvent" Classes="opt" Classes.on="{Binding TodoEntry.IsEvent}"
                    Command="{Binding TodoEntry.SelectKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Event}"
                    Content="{Binding Strings[AgendaCaptureEvent]}" />
          </StackPanel>

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
            <Button Grid.Column="1" Classes="quiet" Margin="0,0,8,0" Padding="16,8" FontSize="13"
                    Command="{Binding CloseAddTodoCommand}" Content="{Binding Strings[TodoEntryCancel]}" />
            <Button Grid.Column="2" x:Name="AddTodoCommit" Classes="accent" Padding="20,8"
                    IsEnabled="{Binding TodoEntry.CanAdd}" Command="{Binding CommitAddTodoCommand}"
                    Content="{Binding Strings[TodoEntryAdd]}" />
          </Grid>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              <!-- 제목. Enter adds, as the phone's return key does. -->
              <TextBox x:Name="AddTodoTitle" Classes="inline" FontSize="14" MinHeight="38"
                       Text="{Binding TodoEntry.Title, Mode=TwoWay}" PlaceholderText="{Binding TodoEntry.TitlePlaceholder}"
                       AutomationProperties.Name="{Binding Strings[TodoEntryTitle]}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitAddTodoCommand}" />
                </TextBox.KeyBindings>
              </TextBox>

              <Border Classes="panel" CornerRadius="12">
                <StackPanel>
                  <Button x:Name="AddTodoDateRow" Classes="field" Classes.open="{Binding TodoEntry.IsDatePickerOpen}"
                          Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Date}">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Classes="fieldlabel" Text="{Binding Strings[TodoEntryDate]}" />
                      <TextBlock Grid.Column="1" Classes="fieldvalue" Classes.none="{Binding !TodoEntry.HasDate}" Text="{Binding TodoEntry.DateText}" />
                    </Grid>
                  </Button>
                  <StackPanel IsVisible="{Binding TodoEntry.IsDatePickerOpen}" Margin="12,0,12,10">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,0,2,6">
                      <TextBlock Grid.Column="0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding TodoEntry.Calendar.MonthLabel}" />
                      <Button Grid.Column="1" Classes="ghost small" Command="{Binding TodoEntry.Calendar.PreviousMonthCommand}"
                              AutomationProperties.Name="{Binding Strings[PreviousMonth]}">
                        <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
                      </Button>
                      <Button Grid.Column="2" Classes="ghost small" Command="{Binding TodoEntry.Calendar.NextMonthCommand}"
                              AutomationProperties.Name="{Binding Strings[NextMonth]}">
                        <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
                      </Button>
                    </Grid>
                    <UniformGrid Columns="7">
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdaySun}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayMon}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayTue}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayWed}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayThu}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayFri}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdaySat}" />
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding TodoEntry.Calendar.Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:CalendarDayCellViewModel">
                          <Button Classes="minicell" Classes.outside="{Binding !IsInMonth}" Classes.sunday="{Binding IsSunday}"
                                  Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                                  IsHitTestVisible="{Binding IsInMonth}" Command="{Binding SelectCommand}">
                            <Border Classes="face">
                              <TextBlock Text="{Binding DayText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="opt" HorizontalAlignment="Left" Margin="0,6,0,0" IsVisible="{Binding TodoEntry.IsTask}"
                            Classes.on="{Binding !TodoEntry.HasDate}" Command="{Binding TodoEntry.ClearDateCommand}"
                            Content="{Binding Strings[TodoEntryNoDate]}" />
                  </StackPanel>

                  <Border Classes="fieldrule" />
                  <Button x:Name="AddTodoTimeRow" Classes="field" Classes.open="{Binding TodoEntry.IsTimePickerOpen}"
                          IsEnabled="{Binding TodoEntry.CanPickTime}"
                          Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Time}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Panel Grid.Column="0">
                        <TextBlock Classes="fieldlabel" IsVisible="{Binding TodoEntry.IsTask}" Text="{Binding Strings[TodoEntryTime]}" />
                        <TextBlock Classes="fieldlabel" IsVisible="{Binding TodoEntry.IsEvent}" Text="{Binding Strings[TodoEntryStart]}" />
                      </Panel>
                      <TextBlock Grid.Column="1" Classes="fieldvalue" Classes.none="{Binding !TodoEntry.HasTime}" Text="{Binding TodoEntry.TimeText}" />
                    </Grid>
                  </Button>
                  <StackPanel IsVisible="{Binding TodoEntry.IsEvent}">
                    <Border Classes="fieldrule" />
                    <Button x:Name="AddTodoEndRow" Classes="field"
                            Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.End}">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="fieldlabel" Text="{Binding Strings[TodoEntryEnd]}" />
                        <TextBlock Grid.Column="1" Classes="fieldvalue" Text="{Binding TodoEntry.EndText}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding TodoEntry.IsTimePickerOpen}" Margin="12,0,12,12" Spacing="5">
                    <TextBlock Classes="faint" FontSize="11.5" FontWeight="SemiBold" Text="{Binding Strings[ReminderTimeHour]}" />
                    <ItemsControl ItemsSource="{Binding TodoEntry.HourOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:TimeOption">
                          <Button Classes="opt cell" Classes.on="{Binding IsCurrent}" Margin="2" Content="{Binding Label}"
                                  Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).TodoEntry.PickHourCommand}"
                                  CommandParameter="{Binding Value}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="faint" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" Text="{Binding Strings[ReminderTimeMinute]}" />
                    <ItemsControl ItemsSource="{Binding TodoEntry.MinuteOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:TimeOption">
                          <Button Classes="opt cell" Classes.on="{Binding IsCurrent}" Margin="2" Content="{Binding Label}"
                                  Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).TodoEntry.PickMinuteCommand}"
                                  CommandParameter="{Binding Value}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="opt" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding TodoEntry.IsTask}"
                            Classes.on="{Binding !TodoEntry.HasTime}" Command="{Binding TodoEntry.ClearTimeCommand}"
                            Content="{Binding Strings[TodoEntryNoTime]}" />
                  </StackPanel>

                  <Border Classes="fieldrule" />
                  <Button x:Name="AddTodoRepeatRow" Classes="field" Classes.open="{Binding TodoEntry.IsRepeatPickerOpen}"
                          IsEnabled="{Binding TodoEntry.CanRepeat}"
                          Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Repeat}">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Classes="fieldlabel" Text="{Binding Strings[TodoEntryRepeat]}" />
                      <TextBlock Grid.Column="1" Classes="fieldvalue" Classes.none="{Binding !TodoEntry.Repeats}" Text="{Binding TodoEntry.RepeatText}" />
                    </Grid>
                  </Button>
                  <ItemsControl IsVisible="{Binding TodoEntry.IsRepeatPickerOpen}" Margin="10,0,10,12" ItemsSource="{Binding TodoEntry.RepeatOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pvm:TodoRepeatOption">
                        <Button Classes="opt cell" Classes.on="{Binding IsCurrent}" Margin="2" Content="{Binding Label}"
                                Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).TodoEntry.PickRepeatCommand}"
                                CommandParameter="{Binding Repeat}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- 내용: a few lines kept with the item, apart from its title. -->
              <TextBox x:Name="AddTodoNotes" Classes="inline" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="140"
                       VerticalContentAlignment="Top" Text="{Binding TodoEntry.Description, Mode=TwoWay}"
                       PlaceholderText="{Binding Strings[TodoEntryNotesPlaceholder]}"
                       AutomationProperties.Name="{Binding Strings[TodoEntryNotes]}" />

              <!-- 목록, only when there is more than the built-in one to choose from. -->
              <StackPanel IsVisible="{Binding TodoEntry.ShowLists}" Spacing="6">
                <TextBlock Classes="faint" FontSize="11.5" FontWeight="SemiBold" Text="{Binding Strings[TodoEntryList]}" />
                <ItemsControl ItemsSource="{Binding TodoEntry.ListOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pvm:TodoListOption">
                      <Button Classes="opt" Classes.on="{Binding IsCurrent}"
                              Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).TodoEntry.PickListCommand}"
                              CommandParameter="{Binding Id}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Dot}" />
                          <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <Border.Styles>
          <Style Selector="Button.opt">
            <Setter Property="Theme" Value="{StaticResource Daynote.Bare}" />
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
            <Setter Property="CornerRadius" Value="99" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
          <Style Selector="Button.opt.cell">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
          </Style>
          <Style Selector="Button.opt:pointerover">
            <Setter Property="Opacity" Value="0.85" />
          </Style>
          <Style Selector="Button.opt.on">
            <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.Pri}" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.OnPri}" />
          </Style>
          <Style Selector="Button.field">
            <Setter Property="Theme" Value="{StaticResource Daynote.Bare}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
          </Style>
          <Style Selector="Button.field:pointerover">
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
          </Style>
          <Style Selector="Button.field:disabled">
            <Setter Property="Opacity" Value="0.45" />
          </Style>
          <Style Selector="TextBlock.fieldlabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
            <Setter Property="Width" Value="64" />
          </Style>
          <Style Selector="TextBlock.fieldvalue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
          </Style>
          <Style Selector="TextBlock.fieldvalue.none">
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
          </Style>
          <Style Selector="Border.fieldrule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
          </Style>
          <Style Selector="TextBlock.wd">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
          </Style>
          <Style Selector="Button.minicell">
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
          </Style>
          <Style Selector="Button.minicell.outside">
            <Setter Property="Opacity" Value="0.35" />
          </Style>
          <Style Selector="Button.minicell.today Border.face">
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
          </Style>
          <Style Selector="Button.minicell.selected">
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.OnPri}" />
          </Style>
          <Style Selector="Button.minicell.selected Border.face">
            <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.Pri}" />
          </Style>
        </Border.Styles>
      </Border>
    </Border>

    <!-- Account: the cloud account card (sign-in, lock, subscription), opened from the popover or settings. -->
    <Border Grid.ColumnSpan="2" Classes="scrim" ZIndex="25" IsVisible="False" motion:Popover.IsOpen="{Binding IsAccountOpen}">
      <Border Classes="modal" Width="560" MaxHeight="680" Margin="24" Padding="28,24"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <!-- One heading, here beside the close button; the panel draws none of its own. -->
            <TextBlock Grid.Column="0" Classes="h1" Text="{Binding Strings[AccountSignInTitle]}" IsVisible="{Binding Account.ShowsSignIn, FallbackValue=False}" />
            <TextBlock Grid.Column="0" Classes="h1" Text="{Binding Strings[AccountWindowTitle]}" IsVisible="{Binding Account.IsSignedIn, FallbackValue=False}" />
            <Button Grid.Column="1" Classes="ghost small" Command="{Binding CloseAccountCommand}" AutomationProperties.Name="{Binding Strings[CloseSettings]}">
              <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Close}" />
            </Button>
          </Grid>
          <views:AccountPanel Grid.Row="1" DataContext="{Binding Account}" />
        </Grid>
      </Border>
    </Border>

    <!--
      Checkout (Daynote Desktop B v2): the tier, the interval, what it costs, then Paddle's page in
      the browser. Above settings and the account card, which are what open it. Bound to the account
      through a template, so a build with no sync endpoint never evaluates it.
    -->
    <ContentControl Grid.ColumnSpan="2" ZIndex="28" Content="{Binding Account}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="account:AccountViewModel">
          <views:CheckoutDialog />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!--
      Onboarding tutorial. The overlay dims the shell and cuts a hole around the step's target
      (TutorialOverlay). It spans the whole window: the targets are in the sidebar and the body alike.
    -->
    <views:TutorialOverlay Grid.ColumnSpan="2" ZIndex="30" DataContext="{Binding Tutorial}"
                           IsVisible="{Binding IsOpen, FallbackValue=False}" />

    <!-- The ⌘K palette: quick actions until something is typed, then the unified search's results. -->
    <Border x:Name="PaletteScrim" Grid.ColumnSpan="2" Classes="scrim" ZIndex="40" IsVisible="False" motion:Popover.IsOpen="{Binding IsPaletteOpen}"
            PointerPressed="OnPaletteScrimPressed">
      <Border x:Name="Palette" Classes="modal" Background="{DynamicResource Daynote.Product.Brush.Card}" CornerRadius="16"
              RenderTransformOrigin="50%,0%"
              Width="620" Margin="24,0" VerticalAlignment="Top" HorizontalAlignment="Center" ClipToBounds="True">
        <StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" Height="60" Margin="18,0">
            <Path Grid.Column="0" Data="{StaticResource Daynote.Desk.Geo.Search}" Stroke="{DynamicResource Daynote.Product.Brush.Text2}"
                  StrokeThickness="1.5" StrokeLineCap="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Classes="bare" FontSize="17" Margin="12,0" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" PlaceholderText="{Binding Strings[DeskPalettePlaceholder]}"
                     Text="{Binding Search.Query}" />
            <Border Grid.Column="2" Classes="keycap" VerticalAlignment="Center">
              <TextBlock Classes="faint" FontSize="11" FontWeight="SemiBold" Text="esc" />
            </Border>
          </Grid>
          <Border Height="1" Background="{DynamicResource Daynote.Product.Brush.Stroke2}" />
          <ScrollViewer x:Name="SearchDropdown" MaxHeight="420" Padding="8">
            <StackPanel>
              <StackPanel IsVisible="{Binding !Search.IsOpen}">
                <TextBlock Classes="faint" FontSize="11.5" FontWeight="SemiBold" Margin="10,8,10,6" Text="{Binding Strings[DeskPaletteShortcuts]}" />
                <ItemsControl x:Name="QuickActionList" ItemsSource="{Binding QuickActions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaletteActionViewModel">
                      <Button Classes="row" Padding="10" Command="{Binding RunCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" FontSize="13.5" Text="{Binding Label}" />
                          <TextBlock Grid.Column="1" Classes="faint mono" FontSize="11.5" VerticalAlignment="Center" Text="{Binding Combo}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <ItemsControl x:Name="ResultList" ItemsSource="{Binding Search.Results}" IsVisible="{Binding Search.IsOpen}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:SearchResultRowViewModel">
                    <Button Classes="row" Padding="10" Command="{Binding ActivateCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Classes="kind" Margin="0,0,12,0" VerticalAlignment="Center">
                          <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}" Text="{Binding Kind}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                          <TextBlock Classes="muted" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Sub}"
                                     IsVisible="{Binding Sub, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="faint" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding DateLabel}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Margin="28" HorizontalAlignment="Center" Text="{Binding Strings.SearchNoResultsRow}"
                         IsVisible="{Binding Search.NoResults}" />
              <TextBlock Margin="28" HorizontalAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                         Text="{Binding Strings.SearchFailedRow}" IsVisible="{Binding Search.Failed}" />
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
