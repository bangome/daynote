    <SolidColorBrush x:Key="Daynote.Brush.Status.Success.Surface" Color="{StaticResource Daynote.Color.Status.Success.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Brush.Status.Warning" Color="{StaticResource Daynote.Color.Status.Warning}" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Brush.Status.Warning.Surface" Color="{StaticResource Daynote.Color.Status.Warning.Surface}" po:Freeze="True" />
