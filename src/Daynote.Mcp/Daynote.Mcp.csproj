<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Multi-targeted alongside Daynote.Infrastructure: the WPF app (windows TFM) references this project
      so the MSIX carries ONE build of every shared assembly, and the Avalonia app (net10.0) does the
      same for its bundle. A single-TFM Mcp would force one of them onto a mismatched Infrastructure.
    -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">x64</PlatformTarget>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>Daynote.Mcp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Daynote.Core\Daynote.Core.csproj" />
    <ProjectReference Include="..\Daynote.Infrastructure\Daynote.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
</Project>
