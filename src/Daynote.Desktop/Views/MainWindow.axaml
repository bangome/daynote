<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Daynote.Desktop.ViewModels"
        xmlns:notes="using:Daynote.App.Notes"
        xmlns:pvm="using:Daynote.App.Shell.Product"
        xmlns:views="using:Daynote.Desktop.Views"
        xmlns:motion="using:Daynote.Motion"
        xmlns:account="using:Daynote.App.Account"
        xmlns:agenda="using:Daynote.Core.Agenda"
        x:Class="Daynote.Desktop.Views.MainWindow"
        x:DataType="vm:DesktopShellViewModel"
        Title="Daynote"
        Width="1240" Height="780" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Daynote.Product.Brush.Bg1}"
        Icon="avares://Daynote.Desktop/Assets/daynote-favicon-v1.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="62">
  <!--
    Design "Daynote Desktop B" (.omc/design/Daynote Desktop B.dc.html): a navy sidebar, a header with
    the big date and the week, the editor (or the timeline, or a list) in the middle, the day's to-dos
    and files at the right. Overlays - the palette, settings, the account card, the tutorial - sit over
    all of it in the same root grid.

    There is no title bar of its own any more. On macOS the traffic lights sit over the sidebar's brand
    row, which leaves them room (MainWindow.Chrome.cs), and the header and that row drag the window. On
    Windows a thin strip at the top of the main column carries the caption buttons.
  -->

  <Window.Resources>
    <!-- One line in the month view's day card: a ring (or the file's type), the title, its time or size. -->
    <DataTemplate x:Key="BoardHoverRow" x:DataType="pvm:CalendarBoardItem">
      <Button Classes="row" CornerRadius="8" Padding="8,0" MinHeight="30" Command="{Binding OpenCommand}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Panel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
            <Ellipse Width="9" Height="9" StrokeThickness="2" Stroke="{Binding ListColor}" IsVisible="{Binding IsEvent}" />
            <Panel IsVisible="{Binding IsTodo}">
              <Ellipse Width="13" Height="13" StrokeThickness="2" Stroke="{Binding ListColor}" />
              <Ellipse Width="13" Height="13" Fill="{Binding ListColor}" IsVisible="{Binding IsDone}" />
            </Panel>
            <Border Width="22" Height="16" CornerRadius="4" Background="{DynamicResource Daynote.Product.Brush.Seg}" IsVisible="{Binding IsFile}">
              <TextBlock Classes="muted" FontSize="8" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Ext}" />
            </Border>
          </Panel>
          <TextBlock Grid.Column="1" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes.done="{Binding IsDone}" Text="{Binding Title}" />
          <TextBlock Grid.Column="2" Classes="faint" FontSize="11.5" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" FontFeatures="+tnum" Text="{Binding Meta}" />
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root" ColumnDefinitions="Auto,*">

    <!-- ── Sidebar ───────────────────────────────────────────────────────────────────────── -->
    <Border x:Name="Sidebar" Grid.Column="0" Classes="sidebar" Width="256" IsVisible="{Binding !LeftCollapsed}">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- Brand: the mark, the name, and the collapse chevron. Background="Transparent" is
             load-bearing: it is a drag handle on macOS, and a Grid with no brush takes no clicks. -->
        <Grid x:Name="BrandRow" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="18,18,18,14" Background="Transparent">
          <!-- The wordmark carries the mark and the name together, cut out of the plate it was
               drawn on so it sits on the sidebar's navy in either theme. -->
          <Image Grid.Column="0" Grid.ColumnSpan="2" Height="28" HorizontalAlignment="Left"
                 Source="{Binding BrandLogo}"
                 RenderOptions.BitmapInterpolationMode="HighQuality" AutomationProperties.Name="Daynote" />
          <Button x:Name="SidebarCollapse" Grid.Column="2" Classes="sideicon" Width="26" Height="26" Command="{Binding ToggleLeftCommand}"
                  ToolTip.Tip="{Binding SidebarCollapseTip}" AutomationProperties.Name="{Binding Strings[SidebarsCollapse]}">
            <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
          </Button>
        </Grid>

        <!-- Search: opens the palette. -->
        <Button x:Name="TutSearch" Grid.Row="1" Classes="sidesearch" Margin="12,0,12,10" Command="{Binding OpenPaletteCommand}"
                AutomationProperties.Name="{Binding Strings[DeskSearch]}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0" Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Search}"
                  RenderTransform="scale(0.875)" Width="16" Height="16" />
            <TextBlock Grid.Column="1" Margin="9,0,0,0" FontSize="13" VerticalAlignment="Center" Text="{Binding Strings[DeskSearch]}" />
            <Border Grid.Column="2" BorderBrush="{DynamicResource Daynote.Desk.Brush.SideStroke}" BorderThickness="1"
                    CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
              <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{x:Static vm:DesktopShellViewModel.PaletteHint}" />
            </Border>
          </Grid>
        </Button>

        <!-- The views: today's notes, the timeline, and the four lists that used to be right-rail tabs. -->
        <!-- Scrolls when there are more lists than room; the calendar below keeps its place. -->
        <ScrollViewer Grid.Row="2" VerticalAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="1" Margin="12,4">
          <Button Classes="navitem" Classes.active="{Binding IsNavEditor}" Command="{Binding ShowEditorCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavToday]}" />
            </Grid>
          </Button>
          <Button Classes="navitem" Classes.active="{Binding IsNavTimeline}" Command="{Binding ShowTimelineCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavTimeline]}" />
            </Grid>
          </Button>
          <Button x:Name="NavCalendar" Classes="navitem" Classes.active="{Binding IsNavCalendar}" Command="{Binding ShowCalendarCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavCalendar]}" />
            </Grid>
          </Button>
          <Button x:Name="TutTabTodo" Classes="navitem" Classes.active="{Binding IsNavTodo}" Command="{Binding ShowAllTodosCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavTodo]}" />
              <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center" Text="{Binding Todo.OpenCount}" />
              <!-- The lists fold away behind this, and open by themselves while one narrows the view. -->
              <Button x:Name="SidebarListsToggle" Grid.Column="3" Classes="navchev" Margin="6,0,-4,0" Command="{Binding ToggleSidebarListsCommand}"
                      ToolTip.Tip="{Binding SidebarListsTip}" AutomationProperties.Name="{Binding SidebarListsTip}">
                <Path Classes="icon" StrokeThickness="1.8" Data="{StaticResource Daynote.Desk.Geo.ChevronDown}" Classes.closed="{Binding !AreSidebarListsShown}" />
              </Button>
            </Grid>
          </Button>
          <!-- The lists under 할 일: a ring in the list's colour, its name, what is owed in it. A list
               narrows the 할 일 view; right-click renames it in place or deletes it. -->
          <ItemsControl x:Name="SidebarLists" ItemsSource="{Binding Todo.Lists}" IsVisible="{Binding AreSidebarListsShown}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pvm:AgendaListRowViewModel">
                <Panel>
                  <Button Classes="navitem sub" IsVisible="{Binding !IsRenaming}" Classes.active="{Binding IsCurrent}"
                          Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).ShowAgendaListCommand}"
                          CommandParameter="{Binding}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[AgendaListRename]}" Command="{Binding RenameCommand}" />
                        <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[AgendaListDelete]}" Command="{Binding DeleteCommand}"
                                  IsVisible="{Binding CanDelete}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Ellipse Grid.Column="0" Classes="ring" Stroke="{Binding Color}" />
                      <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                      <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center" Text="{Binding CountText}" />
                    </Grid>
                  </Button>
                  <TextBox Classes="listrename" IsVisible="{Binding IsRenaming}" Text="{Binding DraftName, Mode=TwoWay}"
                           PropertyChanged="OnListRenamePropertyChanged" LostFocus="OnListRenameLostFocus">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                      <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="NewAgendaListButton" Classes="navitem sub new" Command="{Binding NewAgendaListCommand}" IsVisible="{Binding AreSidebarListsShown}">
            <TextBlock VerticalAlignment="Center" Text="{Binding Strings[AgendaListNew]}" />
          </Button>
          <Button x:Name="TutTabFavorites" Classes="navitem" Classes.active="{Binding IsNavFavorites}"
                  Command="{Binding ShowListCommand}" CommandParameter="{x:Static pvm:RightTab.Favorites}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavFavorites]}" />
              <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center" Text="{Binding Favorites.Items.Count}" />
            </Grid>
          </Button>
          <Button x:Name="TutTabTags" Classes="navitem" Classes.active="{Binding IsNavTags}"
                  Command="{Binding ShowListCommand}" CommandParameter="{x:Static pvm:RightTab.Tags}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavTags]}" />
              <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center" Text="{Binding TagPanel.Tags.Count}" />
            </Grid>
          </Button>
          <Button x:Name="TutTabFiles" Classes="navitem" Classes.active="{Binding IsNavFiles}"
                  Command="{Binding ShowListCommand}" CommandParameter="{x:Static pvm:RightTab.Files}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="mark" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Strings[DeskNavFiles]}" />
              <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center" Text="{Binding Files.LibraryCount}" />
            </Grid>
          </Button>
        </StackPanel>
        </ScrollViewer>

        <!-- Mini month: the selected day a sun square, today a lighter one, a dot under days with notes. -->
        <Border x:Name="TutCalendar" Grid.Row="4" Margin="12,0" Padding="6,14,6,12"
                BorderBrush="{DynamicResource Daynote.Desk.Brush.SideStroke}" BorderThickness="0,1,0,0">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,0,4,8">
              <TextBlock Grid.Column="0" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"
                         Foreground="{DynamicResource Daynote.Desk.Brush.SideText}" Text="{Binding Calendar.MonthLabel}" />
              <Button Grid.Column="1" Classes="sideicon" Width="24" Height="24" CornerRadius="6" Margin="0,0,2,0"
                      Command="{Binding Calendar.PreviousMonthCommand}" AutomationProperties.Name="{Binding Strings[PreviousMonth]}">
                <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
              </Button>
              <Button Grid.Column="2" Classes="sideicon" Width="24" Height="24" CornerRadius="6"
                      Command="{Binding Calendar.NextMonthCommand}" AutomationProperties.Name="{Binding Strings[NextMonth]}">
                <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
              </Button>
            </Grid>
            <UniformGrid Columns="7">
              <UniformGrid.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="FontSize" Value="10.5" />
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="Margin" Value="0,3" />
                  <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Side2}" />
                </Style>
              </UniformGrid.Styles>
              <TextBlock Text="{Binding Strings.WeekdaySun}" />
              <TextBlock Text="{Binding Strings.WeekdayMon}" />
              <TextBlock Text="{Binding Strings.WeekdayTue}" />
              <TextBlock Text="{Binding Strings.WeekdayWed}" />
              <TextBlock Text="{Binding Strings.WeekdayThu}" />
              <TextBlock Text="{Binding Strings.WeekdayFri}" />
              <TextBlock Text="{Binding Strings.WeekdaySat}" />
            </UniformGrid>
            <ItemsControl x:Name="MiniCalendar" ItemsSource="{Binding Calendar.Cells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:CalendarDayCellViewModel">
                  <Button Classes="minicell" Classes.sunday="{Binding IsSunday}" Classes.today="{Binding IsToday}"
                          Classes.selected="{Binding IsSelected}" IsHitTestVisible="{Binding IsInMonth}"
                          Command="{Binding SelectCommand}">
                    <Panel>
                      <Border Classes="face">
                        <TextBlock Text="{Binding DayText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Ellipse Width="3" Height="3" Fill="{DynamicResource Daynote.Desk.Brush.Sun}" VerticalAlignment="Bottom"
                               HorizontalAlignment="Center" Margin="0,0,0,-1" IsVisible="{Binding ShowsDot}" />
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Who is signed in, the sync state, and the way to settings. Opens the account popover. -->
        <views:AccountBar x:Name="TutSettings" Grid.Row="5" />
      </Grid>
    </Border>

    <!-- ── Main column ───────────────────────────────────────────────────────────────────── -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

      <!-- Windows only: the caption buttons, drawn by the app so they match it (MainWindow.Chrome.cs
           gives each the element role Win32 hit-testing maps to minimize / maximize / close). -->
      <Grid x:Name="TitleBarRow" Grid.Row="0" Height="32" ColumnDefinitions="*,Auto" Background="Transparent" IsVisible="False">
        <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Classes="caption" Click="OnMinimize" ToolTip.Tip="{Binding Strings[WindowMinimize]}">
            <Path Data="M0,5 L10,5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
          </Button>
          <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximizeRestore" ToolTip.Tip="{Binding Strings[WindowMaximize]}">
            <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
          </Button>
          <Button x:Name="CloseButton" Classes="caption close" Click="OnCloseWindow" ToolTip.Tip="{Binding Strings[WindowClose]}">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Header: the big date, the week, and the view toggles. The week strip moves to a row of its
           own when the header is too narrow for one line (MainWindow.Header.cs), as the design's
           flex-wrap does. -->
      <Border x:Name="Header" Grid.Row="1" Padding="28,18,28,0" Background="Transparent" ZIndex="1"
              BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
        <Grid RowDefinitions="Auto,Auto">
        <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
          <Button Grid.Column="0" Classes="ghost outlined" Margin="0,0,24,0" IsVisible="{Binding LeftCollapsed}"
                  Command="{Binding ToggleLeftCommand}" ToolTip.Tip="{Binding Strings[SidebarsExpand]}"
                  AutomationProperties.Name="{Binding Strings[SidebarsExpand]}">
            <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
          </Button>

          <Button x:Name="BigDate" Grid.Column="1" Theme="{StaticResource Daynote.Bare}" Width="228" HorizontalContentAlignment="Left"
                  Command="{Binding GoToTodayCommand}" ToolTip.Tip="{Binding TodayTip}" AutomationProperties.Name="{Binding Strings[GoToToday]}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <!-- line-height:1 in the design; Avalonia sets the glyphs lower in a line box shorter than
                   the font's own, so the margin puts the digits back where the browser draws them. -->
              <TextBlock Width="58" TextAlignment="Right" FontSize="44" FontWeight="ExtraBold" LetterSpacing="-2.2" LineHeight="44" VerticalAlignment="Center"
                         Margin="0,-8,0,8" FontFeatures="+tnum" Text="{Binding BigDay}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="Bold" LetterSpacing="-0.3" Text="{Binding BigMeta}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                  <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding BigSub}" />
                  <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding IsTodaySelected}">
                    <TextBlock Text="{Binding Strings.Today}" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Button>

          <StackPanel x:Name="WeekStrip" Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="24,0,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Classes="weekstep" Command="{Binding Week.PreviousWeekCommand}" AutomationProperties.Name="{Binding Strings[DeskPreviousWeek]}">
              <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
            </Button>
            <ItemsControl ItemsSource="{Binding Week.Days}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:WeekStripDayViewModel">
                  <Button Classes="weekday" Classes.selected="{Binding IsSelected}" Classes.today="{Binding IsTodayRing}"
                          Classes.sunday="{Binding IsSunday}" Classes.notes="{Binding ShowsDot}" Command="{Binding SelectCommand}">
                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Classes="wd" HorizontalAlignment="Center" Text="{Binding WeekdayLabel}" />
                      <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding DayText}" />
                      <Ellipse Classes="dot" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="weekstep" Command="{Binding Week.NextWeekCommand}" AutomationProperties.Name="{Binding Strings[DeskNextWeek]}">
              <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
            </Button>
          </StackPanel>

        </Grid>

        <!-- The second line, on the header's rule: the day's note tabs in the editor, or the view's
             name and a word about it elsewhere; the view toggles at the right behind a rule. -->
        <Grid x:Name="HeaderBottom" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0" Height="41">
          <Grid Grid.Column="0" Margin="0,0,4,0" IsVisible="{Binding IsEditorMode}">
<Grid ColumnDefinitions="*,Auto">
              <!-- No bar: the wheel (either direction) and the round steps at the ends scroll it. -->
              <ScrollViewer x:Name="NoteTabsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="NoteTabs" ItemsSource="{Binding Notes.Tabs}" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="notes:NoteTabViewModel">
                        <!-- A projection (the blank "노트 1" of an empty day) is not a note yet, so it
                             gets no tab; the empty-day card stands in for it. -->
                        <Button Classes="notetab" Classes.selected="{Binding IsSelected}" IsVisible="{Binding !IsProjection}"
                                Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).SelectDayNoteCommand}"
                                CommandParameter="{Binding}">
                          <Button.KeyBindings>
                            <KeyBinding Gesture="Delete"
                                        Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).DeleteDayNoteCommand}"
                                        CommandParameter="{Binding}" />
                          </Button.KeyBindings>
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[NoteMenuRename]}"
                                        Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).RenameDayNoteCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[NoteMenuDuplicate]}"
                                        Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).DuplicateDayNoteCommand}"
                                        CommandParameter="{Binding}" />
                              <Separator />
                              <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[NoteMenuDelete]}"
                                        Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).DeleteDayNoteCommand}"
                                        CommandParameter="{Binding}" />
                            </ContextMenu>
                          </Button.ContextMenu>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource Daynote.Desk.Geo.Star}" Fill="{DynamicResource Daynote.Desk.Brush.Sun}"
                                  VerticalAlignment="Center" IsVisible="{Binding IsFavorite}" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
              </ScrollViewer>
              <!-- Each end, while there is more past it: the page fading over the tabs, and a step. -->
              <Panel x:Name="NoteTabsLeft" Grid.Column="0" Width="72" HorizontalAlignment="Left" IsVisible="False">
                <Border Background="{DynamicResource Daynote.Product.Brush.Bg1}" IsHitTestVisible="False">
                  <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                      <GradientStop Offset="0.42" Color="Black" />
                      <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                  </Border.OpacityMask>
                </Border>
                <Button Classes="tabstep" HorizontalAlignment="Left" Click="OnNoteTabsLeft"
                        ToolTip.Tip="{Binding Strings[NoteTabsPrevious]}" AutomationProperties.Name="{Binding Strings[NoteTabsPrevious]}">
                  <Path Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
                </Button>
              </Panel>
              <Panel x:Name="NoteTabsRight" Grid.Column="0" Width="72" HorizontalAlignment="Right" IsVisible="False">
                <Border Background="{DynamicResource Daynote.Product.Brush.Bg1}" IsHitTestVisible="False">
                  <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,0%">
                      <GradientStop Offset="0.42" Color="Black" />
                      <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                  </Border.OpacityMask>
                </Border>
                <Button Classes="tabstep" HorizontalAlignment="Right" Click="OnNoteTabsRight"
                        ToolTip.Tip="{Binding Strings[NoteTabsNext]}" AutomationProperties.Name="{Binding Strings[NoteTabsNext]}">
                  <Path Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
                </Button>
              </Panel>
              <!-- "1 / 8 ▾": every note of the day in a menu, then +; a rule before them (design v2). -->
              <Border Grid.Column="1" Margin="6,8,0,8" Padding="10,0,0,0" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="1,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button x:Name="TabMenuButton" Classes="tabmenu" Classes.open="{Binding IsTabMenuOpen}" Command="{Binding ToggleTabMenuCommand}"
                          ToolTip.Tip="{Binding Strings[DeskTabMenuTip]}" AutomationProperties.Name="{Binding Strings[DeskTabMenuTip]}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock VerticalAlignment="Center" FontFeatures="+tnum" Text="{Binding TabPositionText}" />
                      <Path Classes="icon" StrokeThickness="1.6" Data="{StaticResource Daynote.Desk.Geo.ChevronDown}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost small" Command="{Binding NewNoteCommand}"
                          ToolTip.Tip="{Binding Strings[NewNote]}" AutomationProperties.Name="{Binding Strings[NewNote]}">
                    <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
                  </Button>
                </StackPanel>
              </Border>
              </Grid>
          </Grid>
          <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,8,0" IsVisible="{Binding !IsEditorMode}">
            <Border Grid.Column="0" Classes="viewtab" VerticalAlignment="Stretch" BorderBrush="{DynamicResource Daynote.Desk.Brush.Sun}" BorderThickness="0,0,0,2">
              <TextBlock x:Name="ViewTitleText" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding ViewTitle}" />
            </Border>
            <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding ViewSubtitle}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <!-- 리스트 삭제: its to-dos move to the built-in list, so it is not asked twice. -->
              <Button x:Name="DeleteListButton" Classes="link faint" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                      IsVisible="{Binding CanDeleteSelectedList}" Content="{Binding Strings[AgendaListDelete]}"
                      Command="{Binding DeleteSelectedListCommand}" />
              <!-- On the 할 일 view: the full card, on today, in the list being looked at. -->
              <Button x:Name="ListAddTodo" Classes="ghost small" VerticalAlignment="Center" IsVisible="{Binding IsNavTodoView}"
                      Command="{Binding AddListTodoCommand}" ToolTip.Tip="{Binding Strings[TodoAddTitle]}"
                      AutomationProperties.Name="{Binding Strings[TodoAddTitle]}">
                <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Column="1" Padding="8,0,0,5" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="1,0,0,0">
            <StackPanel x:Name="HeaderActions" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Name="TimelineToggle" Classes="tool square" Classes.primaryon="{Binding IsTimelineMode}" Command="{Binding ToggleTimelineCommand}"
                      ToolTip.Tip="{Binding Strings[DeskTimelineViewTip]}" AutomationProperties.Name="{Binding Strings[DeskTimelineViewTip]}">
                <Panel>
                  <Path Classes="icon" StrokeThickness="1.3" Data="{StaticResource Daynote.Desk.Geo.TimelineView}" />
                  <Path Data="{StaticResource Daynote.Desk.Geo.TimelineDots}" Fill="{Binding $parent[Button].Foreground}" />
                </Panel>
              </Button>
              <Button x:Name="CalendarToggle" Classes="tool square" Classes.primaryon="{Binding IsCalendarMode}" Command="{Binding ToggleCalendarCommand}"
                      ToolTip.Tip="{Binding Strings[DeskCalendarViewTip]}" AutomationProperties.Name="{Binding Strings[DeskCalendarViewTip]}">
                <Panel>
                  <Path Classes="icon" StrokeThickness="1.3" Data="{StaticResource Daynote.Desk.Geo.Calendar}" />
                  <Path Data="{StaticResource Daynote.Desk.Geo.CalendarCells}" Fill="{Binding $parent[Button].Foreground}" />
                </Panel>
              </Button>
              <Button Classes="tool square" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeTip}"
                      AutomationProperties.Name="{Binding Strings.ThemeToggle}">
                <Panel>
                  <Path Classes="icon" StrokeThickness="1.4" Data="{StaticResource Daynote.Desk.Geo.Moon}" IsVisible="{Binding !IsDark}" />
                  <Path Classes="icon" StrokeThickness="1.4" Data="{StaticResource Daynote.Desk.Geo.Sun}" IsVisible="{Binding IsDark}" />
                </Panel>
              </Button>
              <Button Classes="tool square" Classes.on="{Binding !RightCollapsed}" Command="{Binding ToggleRightCommand}"
                      ToolTip.Tip="{Binding DayPanelTip}" AutomationProperties.Name="{Binding DayPanelTip}">
                <Path Classes="icon" StrokeThickness="1.3" Data="{StaticResource Daynote.Desk.Geo.Panel}" />
              </Button>
              <Button Classes="accent" Height="34" Padding="14,0" Margin="4,0,0,0" Command="{Binding NewNoteCommand}"
                      ToolTip.Tip="{Binding NewNoteTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" StrokeThickness="1.7" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Strings[NewNote]}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
        </Grid>
      </Border>

      <!-- Body: the middle view, and the day panel at the right. -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">

        <!-- Editor -->
        <Grid x:Name="TutEditor" Grid.Column="0" RowDefinitions="0,*" IsVisible="{Binding IsEditorMode}">
          <!-- The note: a 760px column, title and actions, the meta line, the body, the footer. -->
          <Grid x:Name="NoteColumn" Grid.Row="1" RowDefinitions="Auto,*,Auto" MaxWidth="760" IsVisible="{Binding !IsDayEmpty}">
            <StackPanel Grid.Row="0" Margin="48,35,48,0">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <!-- The heading is a label until it is clicked (or a tab's Rename is picked); then the
                     same slot holds a text box with a draft. Enter or focus loss commits, Escape drops
                     the draft. Both are set in the same type so the swap does not jump. -->
                <TextBlock Grid.Column="0" FontSize="24" FontWeight="ExtraBold" LetterSpacing="-0.8"
                           Text="{Binding Notes.SelectedTab.Title, FallbackValue=''}" Cursor="IBeam"
                           IsVisible="{Binding !IsRenamingTitle}" Tapped="OnTitleTapped" DoubleTapped="OnTitleDoubleTapped"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <TextBox x:Name="TitleEditor" Grid.Column="0" Classes="bare title" Text="{Binding TitleDraft}"
                         PlaceholderText="{Binding Strings[DeskTitlePlaceholder]}" IsVisible="{Binding IsRenamingTitle}"
                         KeyDown="OnTitleEditorKeyDown" LostFocus="OnTitleEditorLostFocus"
                         VerticalAlignment="Center" Margin="0,0,8,0" />

                <Button Grid.Column="1" Classes="quiet" Margin="0,0,6,0" VerticalAlignment="Center"
                        Content="{Binding Strings[RetrySave]}" Command="{Binding Notes.RetryCommand}" IsVisible="{Binding Notes.HasSaveError}" />
                <Button Grid.Column="2" Classes="ghost" Classes.favorite="{Binding Notes.SelectedTab.IsFavorite, FallbackValue=False}"
                        Command="{Binding ToggleFavoriteCommand}" IsEnabled="{Binding HasOpenNote}"
                        ToolTip.Tip="{Binding Strings.Favorite}" AutomationProperties.Name="{Binding Strings.Favorite}">
                  <Path Classes="star" Data="{StaticResource Daynote.Desk.Geo.Star}" Stretch="Uniform" Width="17" Height="17" />
                </Button>
                <Button Grid.Column="3" Classes="ghost" Command="{Binding OpenStickyCommand}" IsEnabled="{Binding HasOpenNote}"
                        ToolTip.Tip="{Binding StickyTip}" AutomationProperties.Name="{Binding Strings.OpenStickyNote}">
                  <Path Classes="icon" StrokeThickness="1.3" Data="{StaticResource Daynote.Desk.Geo.PostIt}"
                        Stretch="Uniform" Width="15" Height="15" />
                </Button>
                <Button Grid.Column="4" Classes="ghost danger" Command="{Binding DeleteSelectedNoteCommand}" IsEnabled="{Binding HasOpenNote}"
                        ToolTip.Tip="{Binding Strings[DeleteNoteTip]}" AutomationProperties.Name="{Binding Strings[DeleteNoteTip]}">
                  <Path Classes="icon" StrokeThickness="1.2" Data="{StaticResource Daynote.Desk.Geo.Trash}"
                        Stretch="Uniform" Width="15" Height="15" />
                </Button>
              </Grid>

              <!-- Meta: the date, the tags (sun ink, a cross to remove), the entry for another. -->
              <WrapPanel Orientation="Horizontal" Margin="0,12,0,20">
                <TextBlock Classes="muted" FontSize="12.5" Margin="0,0,14,0" VerticalAlignment="Center" Text="{Binding NoteDateText}" />
                <ItemsControl ItemsSource="{Binding Notes.SelectedTab.Tags, FallbackValue={x:Null}}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,0">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}"
                                   VerticalAlignment="Center" Text="{Binding StringFormat='#{0}'}" />
                        <Button Classes="tagx" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).RemoveTagCommand}"
                                CommandParameter="{Binding}">
                          <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Close}" RenderTransform="scale(1)" />
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="TagBox" Classes="bare tagentry" VerticalAlignment="Center"
                         PlaceholderText="{Binding Strings.TagAddPlaceholder}" Text="{Binding TagInput}" KeyDown="OnTagBoxKeyDown" />
              </WrapPanel>
            </StackPanel>

            <!--
              The body: a highlight layer with the editor over it, the editor's own text drawn in
              nothing so the caret sits over the coloured glyphs. Avalonia's TextBox has no inline
              formatting, so marking up what the app understood - file markers and links -
              means a second layer that draws the same string with the same metrics (the `editor` and
              `editorhighlight` classes, and EditorHighlightTests, which measures them).
            -->
            <Grid Grid.Row="1" Margin="48,0">
              <ScrollViewer x:Name="HighlightScroll" IsHitTestVisible="False"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <TextBlock x:Name="Highlight" Classes="editorhighlight" Padding="0,0,0,40" />
              </ScrollViewer>
              <TextBox x:Name="Editor" Classes="editor" Padding="0,0,0,40" Text="{Binding Notes.EditorText}"
                       VerticalContentAlignment="Top" Foreground="Transparent" PlaceholderText="{Binding Strings.EditorEmptyHint}" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,12,Auto,*,Auto" Margin="48,10,48,14">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource Daynote.Desk.Brush.Saved}" IsVisible="{Binding IsSaveSettled}" />
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource Daynote.Desk.Brush.Text3}" IsVisible="{Binding !IsSaveSettled}" />
                <TextBlock Classes="faint" FontSize="11.5" VerticalAlignment="Center" Text="{Binding SaveFooterText}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="faint" FontSize="11.5" VerticalAlignment="Center" Text="{Binding CharLineText}" />
              <!-- With the day panel closed, where something just made went is said here instead. -->
              <StackPanel Grid.Column="4" x:Name="FooterNotice" Orientation="Horizontal" IsVisible="False"
                          motion:Popover.IsOpen="{Binding IsNoticeInFooter}">
                <TextBlock FontSize="11.5" VerticalAlignment="Center" Text="{Binding NoticeText}" />
                <TextBlock Classes="faint" FontSize="11.5" VerticalAlignment="Center" Text=" · " />
                <Button Classes="link sun" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"
                        Content="{Binding Strings[DeskNoticeView]}" Command="{Binding ViewNoticeCommand}" />
              </StackPanel>
            </Grid>
          </Grid>

          <!-- An empty day: say so, and offer the one thing to do about it. -->
          <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDayEmpty}">
            <TextBlock FontSize="20" FontWeight="Bold" LetterSpacing="-0.4" HorizontalAlignment="Center" Text="{Binding Strings[DeskEmptyDayTitle]}" />
            <TextBlock Classes="muted" FontSize="13" HorizontalAlignment="Center" Text="{Binding Strings[DeskEmptyDayBody]}" />
            <Button Classes="accent" Height="38" Padding="18,0" CornerRadius="10" Margin="0,8,0,0" HorizontalAlignment="Center"
                    Command="{Binding NewNoteCommand}" Content="{Binding EmptyDayButtonText}" />
          </StackPanel>
        </Grid>

        <!-- Timeline: each day's date in a column, its notes as cards beside it. -->
        <ScrollViewer Grid.Column="0" Padding="28,32,28,48" IsVisible="{Binding IsTimelineMode}">
          <StackPanel MaxWidth="860">
            <ItemsControl ItemsSource="{Binding TimelineGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:TimelineDayGroup">
                  <Border Padding="0,22" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="140,28,*">
                      <Button Grid.Column="0" Classes="link" VerticalAlignment="Top"
                              Command="{Binding $parent[ItemsControl].((vm:DesktopShellViewModel)DataContext).OpenTimelineDayCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel>
                          <TextBlock FontSize="15" FontWeight="ExtraBold" LetterSpacing="-0.3" Text="{Binding Heading}" />
                          <TextBlock Classes="muted" FontSize="12" Margin="0,3,0,0" Text="{Binding CountText}" />
                        </StackPanel>
                      </Button>
                      <!-- The day's record and its schedule in one column (docs/TODOS.md §11): what has no
                           hour in a box above, the notes, then the hours in order with the now line. -->
                      <StackPanel Grid.Column="2" Spacing="10">
                        <Grid ColumnDefinitions="44,12,*" IsVisible="{Binding HasUntimed}">
                          <TextBlock Grid.Column="0" Classes="faint" FontSize="11" FontWeight="Bold" TextAlignment="Right" Margin="0,10,0,0"
                                     Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskTimelineUntimed]}" />
                          <Border Grid.Column="2" Background="{DynamicResource Daynote.Product.Brush.Panel}" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}"
                                  BorderThickness="1" CornerRadius="12" Padding="5">
                            <ItemsControl ItemsSource="{Binding Untimed}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pvm:TodoItemViewModel">
                                  <Button Classes="row" CornerRadius="8" Padding="8,0" MinHeight="32" Command="{Binding JumpCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                      <Panel Grid.Column="0" Width="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <views:DeskTodoCheck VerticalAlignment="Center" IsVisible="{Binding IsTask}" IsChecked="{Binding Checked}"
                                                             Toggle="{Binding ToggleCommand}" Key="{Binding Key}" Tint="{Binding ListColor}" />
                                        <Ellipse Classes="eventring" HorizontalAlignment="Center" IsVisible="{Binding IsEvent}" Stroke="{Binding ListColor}" />
                                      </Panel>
                                      <Panel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" TextTrimming="CharacterEllipsis" Classes.done="{Binding Checked}" Text="{Binding Text}" />
                                        <Border Classes="strike" Margin="0,9,0,0" />
                                      </Panel>
                                      <Path Grid.Column="2" Classes="repeat" Margin="6,0,0,0" IsVisible="{Binding IsRepeat}" />
                                      <Panel Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Classes="faint" FontSize="11" FontWeight="Bold" IsVisible="{Binding IsTask}"
                                                   Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskTimelineTodoTag]}" />
                                        <TextBlock Classes="faint" FontSize="11" FontWeight="Bold" IsVisible="{Binding IsEvent}"
                                                   Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskEventAllDay]}" />
                                      </Panel>
                                    </Grid>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Notes}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pvm:TimelineNoteRow">
                              <Grid ColumnDefinitions="44,12,*">
                                <Border Grid.Column="2" Classes="panel" Padding="20,18">
                                  <StackPanel>
                                    <Button Classes="link" Command="{Binding OpenCommand}">
                                      <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock FontSize="16" FontWeight="Bold" LetterSpacing="-0.3" Text="{Binding Title}" />
                                        <Path Data="{StaticResource Daynote.Desk.Geo.Star}" Fill="{DynamicResource Daynote.Desk.Brush.Sun}"
                                              VerticalAlignment="Center" IsVisible="{Binding IsFavorite}" />
                                      </StackPanel>
                                    </Button>
                                    <TextBlock Classes="muted" FontSize="13.5" LineHeight="24.3" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="{Binding DisplayBody}" />
                                    <Button Classes="link sun" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0"
                                            Content="{Binding ExpandLabel}" Command="{Binding ToggleExpandCommand}" IsVisible="{Binding IsTruncated}" />
                                  </StackPanel>
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Timed}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pvm:TimelineSlot">
                              <!-- An event's card and a to-do's row stretch to 440 and no further (design v2). -->
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="44" />
                                  <ColumnDefinition Width="12" />
                                  <ColumnDefinition Width="1000*" MaxWidth="440" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Classes="tltime" Classes.now="{Binding IsNow}" Classes.event="{Binding IsEvent}"
                                           TextAlignment="Right" Text="{Binding Time}" />
                                <!-- Now: a red dot and a line across the column. -->
                                <Grid Grid.Column="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Height="18" IsVisible="{Binding IsNow}">
                                  <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource Daynote.Product.Brush.Danger}" VerticalAlignment="Center" />
                                  <Border Grid.Column="1" Height="1.5" Background="{DynamicResource Daynote.Product.Brush.Danger}" VerticalAlignment="Center" />
                                </Grid>
                                <!-- An event: a narrow card with its span. -->
                                <Button Grid.Column="2" Classes="card" Classes.past="{Binding Row.IsPast}"
                                        CornerRadius="12" Padding="14,10" IsVisible="{Binding IsEvent}" Command="{Binding Row.JumpCommand}">
                                  <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Ellipse Grid.Column="0" Classes="eventring" Width="10" Height="10" Margin="0,0,11,0" Stroke="{Binding Row.ListColor}" />
                                    <StackPanel Grid.Column="1">
                                      <TextBlock FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding Row.Text}" />
                                      <TextBlock Classes="muted" FontSize="12" Margin="0,1,0,0" Text="{Binding Row.RangeLabel}" />
                                    </StackPanel>
                                    <Path Grid.Column="2" Classes="repeat" Margin="8,0,0,0" IsVisible="{Binding Row.IsRepeat}" />
                                  </Grid>
                                </Button>
                                <!-- A to-do at an hour: its ring, its title, "할 일". -->
                                <Button Grid.Column="2" Classes="row" CornerRadius="10" MinHeight="34" Padding="10,0"
                                        IsVisible="{Binding IsTodo}" Command="{Binding Row.JumpCommand}">
                                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <views:DeskTodoCheck Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="{Binding Row.Checked}"
                                                         Toggle="{Binding Row.ToggleCommand}" Key="{Binding Row.Key}" Tint="{Binding Row.ListColor}" />
                                    <Panel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                      <TextBlock FontSize="13.5" TextTrimming="CharacterEllipsis" Classes.done="{Binding Row.Checked}" Text="{Binding Row.Text}" />
                                      <Border Classes="strike" Margin="0,9.5,0,0" />
                                    </Panel>
                                    <Path Grid.Column="2" Classes="repeat" Margin="6,0,0,0" IsVisible="{Binding Row.IsRepeat}" />
                                    <TextBlock Grid.Column="3" Classes="faint" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskTimelineTodoTag]}" />
                                  </Grid>
                                </Button>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="quiet" HorizontalAlignment="Center" Margin="0,20,0,0" Content="{Binding Strings[DeskLoadMore]}"
                    Command="{Binding Timeline.LoadMoreCommand}" IsVisible="{Binding Timeline.HasMore}" />
            <TextBlock Classes="empty" HorizontalAlignment="Center" Margin="0,40" Text="{Binding Strings.TimelineEmpty}"
                       IsVisible="{Binding Timeline.IsEmpty}" />
          </StackPanel>
        </ScrollViewer>

        <!-- 캘린더: the month of the selected day, each day with its events, to-dos and files; the
             filters at the right hide a kind. Resting on a day brings up its whole card. -->
        <Grid x:Name="CalendarView" Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="24,18,24,18" IsVisible="{Binding IsCalendarMode}">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" FontSize="24" FontWeight="ExtraBold" LetterSpacing="-0.7" VerticalAlignment="Center" Text="{Binding Calendar.MonthLabel}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="14,0,0,0" VerticalAlignment="Center">
              <Button Classes="ghost outlined board" Command="{Binding Calendar.PreviousMonthCommand}" AutomationProperties.Name="{Binding Strings[PreviousMonth]}">
                <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
              </Button>
              <Button Classes="ghost outlined board" Command="{Binding Calendar.NextMonthCommand}" AutomationProperties.Name="{Binding Strings[NextMonth]}">
                <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
              </Button>
              <Button x:Name="CalendarTodayButton" Classes="tool boardtoday" Command="{Binding CalendarTodayCommand}" Content="{Binding Strings.Today}" />
            </StackPanel>
            <ItemsControl Grid.Column="3" ItemsSource="{Binding CalendarBoard.Filters}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:CalendarBoardFilter">
                  <Button Classes="boardfilter" Classes.on="{Binding IsOn}" Command="{Binding ToggleCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                      <TextBlock VerticalAlignment="Center" FontWeight="Normal" Opacity="0.75" Text="{Binding CountText}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
            <UniformGrid Columns="7">
              <UniformGrid.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="FontSize" Value="11.5" />
                  <Setter Property="FontWeight" Value="Bold" />
                  <Setter Property="Margin" Value="8,6" />
                  <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
                </Style>
              </UniformGrid.Styles>
              <TextBlock Foreground="{DynamicResource Daynote.Desk.Brush.Sunday}" Text="{Binding Strings.WeekdaySun}" />
              <TextBlock Text="{Binding Strings.WeekdayMon}" />
              <TextBlock Text="{Binding Strings.WeekdayTue}" />
              <TextBlock Text="{Binding Strings.WeekdayWed}" />
              <TextBlock Text="{Binding Strings.WeekdayThu}" />
              <TextBlock Text="{Binding Strings.WeekdayFri}" />
              <TextBlock Foreground="{DynamicResource Daynote.Product.Brush.Accent}" Text="{Binding Strings.WeekdaySat}" />
            </UniformGrid>
          </Border>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="1,0,0,0">
            <ItemsControl x:Name="CalendarBoardGrid" ItemsSource="{Binding CalendarBoard.Cells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:CalendarBoardDay">
                  <Button Classes="boardcell" Classes.inmonth="{Binding IsInMonth}" Classes.selected="{Binding IsSelected}"
                          Command="{Binding SelectCommand}" PointerEntered="OnBoardCellEntered" PointerExited="OnBoardCellExited">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="Auto,*,Auto" Height="22">
                        <Button Grid.Column="0" Classes="boardnum" Classes.today="{Binding IsToday}" Classes.sunday="{Binding IsSunday}"
                                Classes.selected="{Binding IsSelected}" Classes.inmonth="{Binding IsInMonth}"
                                Command="{Binding OpenCommand}" ToolTip.Tip="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskCalendarOpenDay]}">
                          <TextBlock Text="{Binding DayText}" FontFeatures="+tnum" />
                        </Button>
                        <TextBlock Grid.Column="2" Classes="faint" FontSize="10.5" VerticalAlignment="Center" Text="{Binding NoteText}" IsVisible="{Binding HasNotes}" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="pvm:CalendarBoardItem">
                            <Button Classes="boardline" Classes.allday="{Binding IsAllDay}" Classes.past="{Binding IsPast}" Classes.done="{Binding IsDone}"
                                    Classes.todo="{Binding IsTodo}" Classes.file="{Binding IsFile}" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Title}">
                              <Grid ColumnDefinitions="Auto,Auto,*">
                                <Panel Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center">
                                  <Ellipse Width="7" Height="7" StrokeThickness="2" Stroke="{Binding ListColor}" IsVisible="{Binding IsEvent}" />
                                  <Panel IsVisible="{Binding IsTodo}">
                                    <Ellipse Width="9" Height="9" StrokeThickness="1.5" Stroke="{Binding ListColor}" />
                                    <Ellipse Width="9" Height="9" Fill="{Binding ListColor}" IsVisible="{Binding IsDone}" />
                                  </Panel>
                                  <Path Classes="icon" Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.2" Data="{StaticResource Daynote.Desk.Geo.Clip}"
                                        Stroke="{DynamicResource Daynote.Desk.Brush.Text3}" IsVisible="{Binding IsFile}" />
                                </Panel>
                                <TextBlock Grid.Column="1" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center" FontFeatures="+tnum" Text="{Binding Time}"
                                           IsVisible="{Binding HasTime}" />
                                <TextBlock Grid.Column="2" Classes="title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="faint" FontSize="11" FontWeight="Bold" Margin="5,0" Text="{Binding MoreText}" IsVisible="{Binding HasMore}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Grid>

        <!-- Lists: to-dos, favourites, tags, files. -->
        <ScrollViewer Grid.Column="0" Padding="28,32,28,48" IsVisible="{Binding IsListMode}">
          <StackPanel MaxWidth="760">

            <!-- To-dos, every note on every date. -->
            <StackPanel IsVisible="{Binding TabIsTodo}">
              <StackPanel.Resources>
                <DataTemplate x:Key="TodoListRow" x:DataType="pvm:TodoItemViewModel">
                  <Border Classes="todorow" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,0,0,1">
                    <Button Classes="row" CornerRadius="0" Padding="18,14" Command="{Binding JumpCommand}">
                      <Button.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
                      </Button.KeyBindings>
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[TodoRowEdit]}" Command="{Binding EditCommand}" />
                          <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[TodoRowDelete]}" Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <views:DeskTodoCheck Grid.Column="0" Classes="large" Margin="0,0,14,0"
                                             IsChecked="{Binding Checked}" Toggle="{Binding ToggleCommand}" Key="{Binding Key}" Tint="{Binding ListColor}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Panel HorizontalAlignment="Left">
                            <TextBlock FontSize="14" TextWrapping="Wrap" Classes.done="{Binding Checked}" Text="{Binding Text}" />
                            <Border Classes="strike" Margin="0,9.5,0,0" />
                          </Panel>
                          <Path Classes="repeat" IsVisible="{Binding IsRepeat}" />
                        </StackPanel>
                        <!-- The list's name, while the view shows every list. -->
                        <TextBlock Grid.Column="2" Classes="faint" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" Text="{Binding NoteLabel}"
                                   IsVisible="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Todo.SelectedListId, Converter={x:Static ObjectConverters.IsNull}}" />
                        <Border Grid.Column="3" Background="{DynamicResource Daynote.Product.Brush.Seg}" CornerRadius="6" Padding="8,3"
                                Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasDue}">
                          <TextBlock Classes="due" Classes.overdue="{Binding Overdue}" FontSize="12" FontWeight="Bold" Text="{Binding DueLabel}" />
                        </Border>
                      </Grid>
                    </Button>
                  </Border>
                </DataTemplate>
              </StackPanel.Resources>
              <Border Classes="panel" ClipToBounds="True">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Todo.TodayItems}" ItemTemplate="{StaticResource TodoListRow}" />
                  <ItemsControl ItemsSource="{Binding Todo.Items}" ItemTemplate="{StaticResource TodoListRow}" />
                  <!-- 오늘 할 일 추가: a to-do for today, in the list being looked at. -->
                  <Grid ColumnDefinitions="Auto,*" Margin="18,10">
                    <Path Grid.Column="0" Classes="icon" Width="19" Margin="0,0,14,0" StrokeThickness="1.5"
                          Stroke="{DynamicResource Daynote.Desk.Brush.Text3}" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
                    <TextBox Grid.Column="1" x:Name="ListQuickAdd" Classes="bare quickadd" FontSize="14" Text="{Binding ListQuickText, Mode=TwoWay}"
                             PlaceholderText="{Binding Strings[DeskQuickAddToday]}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding QuickAddListCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Classes="empty" Margin="0,14,0,0" Text="{Binding Strings.TodoEmpty}" IsVisible="{Binding Todo.IsEmpty}" />
            </StackPanel>

            <!-- Favourites, as cards. -->
            <StackPanel IsVisible="{Binding TabIsFavorites}">
              <ItemsControl ItemsSource="{Binding Favorites.Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><views:AutoFillGrid MinItemWidth="220" Gap="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:FavoriteItemViewModel">
                    <!-- MinHeight is the design's 96px content box plus its padding and border. -->
                    <Button Classes="card" Padding="18,16" MinHeight="130" Command="{Binding OpenCommand}">
                      <StackPanel>
                        <TextBlock Classes="faint" FontSize="12" Text="{Binding DateLabel}" />
                        <TextBlock FontSize="15" FontWeight="Bold" LetterSpacing="-0.3" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Title}" />
                        <TextBlock Classes="muted" FontSize="12.5" LineHeight="20" Margin="0,6,0,0" TextWrapping="Wrap" MaxLines="3"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Preview}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="empty" Text="{Binding Strings.FavoritesPanelEmpty}" IsVisible="{Binding Favorites.IsEmpty}" />
            </StackPanel>

            <!-- Tags: a row per tag, opening to the notes that carry it. -->
            <StackPanel IsVisible="{Binding TabIsTags}">
              <ItemsControl ItemsSource="{Binding TagPanel.Tags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:TagItemViewModel">
                    <Border Classes="panel" ClipToBounds="True">
                      <StackPanel>
                        <Button Classes="row" CornerRadius="0" Padding="18,14" Command="{Binding ToggleExpandCommand}">
                          <Grid ColumnDefinitions="*,Auto">
                            <!-- Tag already carries its '#'. -->
                            <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}"
                                       Text="{Binding Tag}" />
                            <TextBlock Grid.Column="1" Classes="faint" FontSize="12" VerticalAlignment="Center" Text="{Binding NoteCountText}" />
                          </Grid>
                        </Button>
                        <Border Padding="8,6" BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,1,0,0"
                                IsVisible="{Binding IsExpanded}">
                          <ItemsControl ItemsSource="{Binding Occurrences}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="pvm:TagOccurrenceViewModel">
                                <Button Classes="row" CornerRadius="8" Padding="10,9" Command="{Binding JumpCommand}">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding NoteTitle}" />
                                    <TextBlock Grid.Column="1" Classes="faint" FontSize="12" Margin="10,0,0,0" Text="{Binding DateLabel}" />
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="empty" Text="{Binding Strings.TagPanelEmpty}" IsVisible="{Binding TagPanel.IsEmpty}" />
            </StackPanel>

            <!-- Every date's files, newest first, under the date they belong to; a search over their
                 names, and + to add to the day being looked at. Dropping files still adds them there. -->
            <StackPanel IsVisible="{Binding TabIsFiles}">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,22">
                <Border Grid.Column="0" Height="38" Padding="12,0" CornerRadius="10" Background="{DynamicResource Daynote.Product.Brush.Card}"
                        BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Grid.Column="0" Classes="icon" Margin="0,0,9,0" StrokeThickness="1.5" Stroke="{DynamicResource Daynote.Desk.Brush.Text3}"
                          Data="{StaticResource Daynote.Desk.Geo.Search}" />
                    <TextBox Grid.Column="1" x:Name="FileSearch" Classes="bare" FontSize="13.5" VerticalAlignment="Center"
                             Text="{Binding Files.LibraryQuery, Mode=TwoWay}" PlaceholderText="{Binding Strings[DeskFilesSearchPlaceholder]}" />
                    <Button Grid.Column="2" Classes="ghost tiny" IsVisible="{Binding Files.HasLibraryQuery}" Command="{Binding Files.ClearLibraryQueryCommand}">
                      <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Close}" />
                    </Button>
                  </Grid>
                </Border>
                <Button Grid.Column="1" x:Name="FileDropZone" Classes="accent" Height="38" Padding="14,0" CornerRadius="10" Margin="10,0,0,0"
                        Command="{Binding Files.AddFilesCommand}" DragDrop.AllowDrop="True">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon" StrokeThickness="1.7" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Files.LibraryAddText}" />
                  </StackPanel>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Files.Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:FileDateGroupViewModel">
                    <StackPanel Margin="0,0,0,26">
                      <Button Classes="link" Margin="0,0,0,10" Command="{Binding OpenCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock FontSize="14" FontWeight="ExtraBold" LetterSpacing="-0.3" VerticalAlignment="Bottom" Text="{Binding Heading}" />
                          <TextBlock Classes="faint" FontSize="12" VerticalAlignment="Bottom" Text="{Binding CountText}" />
                        </StackPanel>
                      </Button>
                      <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><views:AutoFillGrid MinItemWidth="200" Gap="12" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pvm:FileItemViewModel">
                              <!-- Double-tap writes a copy wherever the user points: the stored bytes live under a
                                   hashed name, so this is the only way an attachment gets back out. -->
                              <Border Classes="panel" ClipToBounds="True" DoubleTapped="OnFileCardDoubleTapped"
                                      ToolTip.Tip="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileTip]}">
                                <StackPanel>
                                  <Panel Height="96" Background="{DynamicResource Daynote.Product.Brush.Seg}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                                    <TextBlock Classes="faint" FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding Ext}" IsVisible="{Binding !HasThumbnail}" />
                                  </Panel>
                                  <Grid ColumnDefinitions="*,Auto" Margin="12,10">
                                    <StackPanel Grid.Column="0">
                                      <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                      <TextBlock Classes="faint" FontSize="11.5" Margin="0,1,0,0" Text="{Binding SizeLabel}" IsVisible="{Binding !WasSaved}" />
                                      <TextBlock FontSize="11.5" Foreground="{DynamicResource Daynote.Product.Brush.Ok}" TextTrimming="CharacterEllipsis"
                                                 Text="{Binding SavedTo}" IsVisible="{Binding WasSaved}" />
                                      <TextBlock FontSize="11.5" Foreground="{DynamicResource Daynote.Product.Brush.Danger}" IsVisible="{Binding SaveFailed}"
                                                 Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileFailed]}" />
                                      <!-- Another device attached this and the bytes are still coming. -->
                                      <TextBlock Classes="faint" FontSize="11.5" IsVisible="{Binding IsAwaitingDownload}"
                                                 Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[FileAwaitingDownload]}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="link faint" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Content="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskFileDelete]}"
                                            Command="{Binding DeleteCommand}" />
                                  </Grid>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" FontSize="13" HorizontalAlignment="Center" Margin="0,48" Text="{Binding Files.LibraryEmptyText}"
                         IsVisible="{Binding Files.IsLibraryEmpty}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- The day panel: this date's to-dos, then its files. -->
        <Border x:Name="DayPanel" Grid.Column="1" Width="300" Background="{DynamicResource Daynote.Product.Brush.Panel}"
                BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="1,0,0,0"
                IsVisible="{Binding !RightCollapsed}" DragDrop.AllowDrop="True">
          <ScrollViewer>
            <StackPanel x:Name="DayPanelContent">
              <StackPanel.Resources>
                <!-- One to-do in the day panel: the ring in its list's colour, the title with ↻ on a
                     repeat, the time under it. A click edits; the ring ticks (motion spec M3). -->
                <DataTemplate x:Key="DayTodoRow" x:DataType="pvm:TodoItemViewModel">
                  <Panel Classes="todorow">
                    <Border Classes="rowflash" />
                    <Button Classes="row rowcontent" Padding="10,7" Command="{Binding JumpCommand}">
                      <Button.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
                      </Button.KeyBindings>
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[TodoRowEdit]}" Command="{Binding EditCommand}" />
                          <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[TodoRowDelete]}" Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid ColumnDefinitions="Auto,*">
                        <views:DeskTodoCheck Grid.Column="0" Margin="0,1,10,0" IsChecked="{Binding Checked}" Toggle="{Binding ToggleCommand}"
                                             Key="{Binding Key}" Tint="{Binding ListColor}" />
                        <StackPanel Grid.Column="1">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Panel HorizontalAlignment="Left">
                              <TextBlock FontSize="13" LineHeight="18.2" TextWrapping="Wrap" Classes.done="{Binding Checked}" Text="{Binding Text}" />
                              <Border Classes="strike" Margin="0,9.1,0,0" />
                            </Panel>
                            <Path Classes="repeat" IsVisible="{Binding IsRepeat}"
                                  ToolTip.Tip="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskRepeatTip]}" />
                          </StackPanel>
                          <TextBlock Classes="due" Classes.overdue="{Binding Overdue}" FontSize="11.5" Margin="0,1,0,0"
                                     Text="{Binding DueLabel}" IsVisible="{Binding HasDue}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </Panel>
                </DataTemplate>
              </StackPanel.Resources>

              <!-- Where something just made went, when it is not on this day: 보기 goes there. -->
              <Border x:Name="DayNotice" Classes="notice" Margin="14,14,14,0" IsVisible="False"
                      motion:Popover.IsOpen="{Binding IsNoticeInPanel}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding NoticeText}" />
                  <Button Grid.Column="1" x:Name="DayNoticeView" Classes="link sun" FontSize="12.5" FontWeight="Bold" Padding="6"
                          VerticalAlignment="Center" Content="{Binding Strings[DeskNoticeView]}" Command="{Binding ViewNoticeCommand}" />
                </Grid>
              </Border>

              <!-- 일정: this date's events, all-day first, then by start. -->
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="20,16,14,4">
                <TextBlock Grid.Column="0" FontSize="14" FontWeight="ExtraBold" LetterSpacing="-0.3" VerticalAlignment="Center" Text="{Binding Strings[DeskDayEventTitle]}" />
                <TextBlock Grid.Column="1" Classes="faint" FontSize="12" VerticalAlignment="Center" Margin="8,1,0,0" Text="{Binding DayEventCountText}" />
                <Button Grid.Column="3" x:Name="DayAddEvent" Classes="ghost tiny" Command="{Binding AddDayEventCommand}"
                        ToolTip.Tip="{Binding Strings[DeskAddTip]}" AutomationProperties.Name="{Binding Strings[DeskAddTip]}">
                  <Path Classes="icon" StrokeThickness="1.6" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
                </Button>
              </Grid>
              <ItemsControl x:Name="DayEventList" ItemsSource="{Binding DayEvents}" Margin="10,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:TodoItemViewModel">
                    <Button Classes="row" Classes.past="{Binding IsPast}" Padding="10,6" Command="{Binding JumpCommand}">
                      <Button.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
                      </Button.KeyBindings>
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[TodoRowEdit]}" Command="{Binding EditCommand}" />
                          <MenuItem Header="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[TodoRowDelete]}" Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid ColumnDefinitions="42,8,*">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding StartLabel}" />
                          <TextBlock Classes="faint" FontSize="11" Text="{Binding EndLabel}" IsVisible="{Binding !IsAllDay}" />
                        </StackPanel>
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                          <Ellipse Grid.Column="0" Classes="eventring" Margin="0,0,7,0" Stroke="{Binding ListColor}" />
                          <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Text}" />
                          <Path Grid.Column="2" Classes="repeat" Margin="5,0,0,0" IsVisible="{Binding IsRepeat}" />
                        </Grid>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="faint" FontSize="12.5" Margin="20,2,20,6" Text="{Binding Strings[DeskDayEventNone]}" IsVisible="{Binding IsDayEventEmpty}" />

              <Border Height="1" Margin="20,10,20,0" Background="{DynamicResource Daynote.Product.Brush.Stroke2}" />

              <!-- 할 일: what is left on this date, a line to add one, then what was finished behind its count. -->
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="20,12,14,4">
                <TextBlock Grid.Column="0" FontSize="14" FontWeight="ExtraBold" LetterSpacing="-0.3" VerticalAlignment="Center" Text="{Binding Strings[DeskDayTodoHeading]}" />
                <TextBlock Grid.Column="1" Classes="faint" FontSize="12" VerticalAlignment="Center" Margin="8,1,0,0" Text="{Binding DayTodoCountText}" />
                <Button Grid.Column="3" x:Name="DayAddTodo" Classes="ghost tiny" Command="{Binding AddDayTodoCommand}"
                        ToolTip.Tip="{Binding Strings[DeskAddTip]}" AutomationProperties.Name="{Binding Strings[DeskAddTip]}">
                  <Path Classes="icon" StrokeThickness="1.6" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
                </Button>
              </Grid>
              <!-- A to-do made since the panel last showed arrives (motion spec M2); a tick draws itself (M3). -->
              <ItemsControl x:Name="DayTodoList" ItemsSource="{Binding DayTodos}" Margin="10,0" ItemTemplate="{StaticResource DayTodoRow}"
                            motion:RowArrivals.IsEnabled="True" motion:RowArrivals.Context="{Binding SelectedDate}"
                            motion:RowArrivals.KnownItems="{Binding DayTodosDone}" />
              <Grid ColumnDefinitions="Auto,*" Margin="20,2,20,0">
                <Path Grid.Column="0" Classes="icon" Width="17" Margin="0,0,10,0" StrokeThickness="1.5"
                      Stroke="{DynamicResource Daynote.Desk.Brush.Text3}" Data="{StaticResource Daynote.Desk.Geo.Plus}" />
                <TextBox Grid.Column="1" x:Name="DayQuickAdd" Classes="bare quickadd" Text="{Binding DayQuickText, Mode=TwoWay}"
                         PlaceholderText="{Binding Strings[DeskQuickAddDay]}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding QuickAddDayCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </Grid>
              <Button x:Name="DayDoneToggle" Classes="link faint" Margin="20,8,20,4" FontSize="12" FontWeight="Bold"
                      IsVisible="{Binding HasDayDone}" Command="{Binding ToggleDayDoneCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock VerticalAlignment="Center" Text="{Binding DayDoneCountText}" />
                  <Path Classes="icon" Width="9" Height="9" StrokeThickness="1.6" Data="{StaticResource Daynote.Desk.Geo.ChevronDown}"
                        Stretch="Uniform" Classes.closed="{Binding !IsDayDoneOpen}" />
                </StackPanel>
              </Button>
              <ItemsControl x:Name="DayDoneList" ItemsSource="{Binding DayTodosDone}" Margin="10,0" ItemTemplate="{StaticResource DayTodoRow}"
                            IsVisible="{Binding IsDayDoneOpen}" />

              <Border Height="1" Margin="20,14" Background="{DynamicResource Daynote.Product.Brush.Stroke2}" />

              <Grid ColumnDefinitions="*,Auto" Margin="20,0,20,10">
                <TextBlock Grid.Column="0" FontSize="14" FontWeight="ExtraBold" LetterSpacing="-0.3" Text="{Binding Strings[DeskNavFiles]}" />
                <Button Grid.Column="1" Classes="link sun" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom"
                        Content="{Binding Strings[DeskFilesAdd]}" Command="{Binding Files.AddFilesCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Files.Items}" Margin="10,0,10,20">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:FileItemViewModel">
                    <Border CornerRadius="9" Padding="10,8" Background="Transparent" DoubleTapped="OnFileCardDoubleTapped"
                            ToolTip.Tip="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileTip]}">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0"
                                Background="{DynamicResource Daynote.Product.Brush.Seg}">
                          <Panel>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                            <TextBlock Classes="muted" FontSize="8.5" FontWeight="ExtraBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Text="{Binding Ext}" IsVisible="{Binding !HasThumbnail}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Classes="faint" FontSize="11" Text="{Binding SizeLabel}" IsVisible="{Binding !WasSaved}" />
                          <!-- The same state lines as the files list, so a double-tap here says what happened. -->
                          <TextBlock FontSize="11" Foreground="{DynamicResource Daynote.Product.Brush.Ok}" TextTrimming="CharacterEllipsis"
                                     Text="{Binding SavedTo}" IsVisible="{Binding WasSaved}" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource Daynote.Product.Brush.Danger}" IsVisible="{Binding SaveFailed}"
                                     Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[SaveFileFailed]}" />
                          <TextBlock Classes="faint" FontSize="11" IsVisible="{Binding IsAwaitingDownload}"
                                     Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[FileAwaitingDownload]}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="empty" Margin="20,-16,20,20" Text="{Binding Strings[DeskFilesEmpty]}" IsVisible="{Binding Files.IsEmpty}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- ── Overlays ──────────────────────────────────────────────────────────────────────── -->

    <!-- The day's notes, from "1 / 8 ▾": number, title, a star, the first line; a sun dot on the open
         one. A press anywhere else closes it. Placed under its button by MainWindow.NoteTabs.cs. -->
    <Panel x:Name="TabMenuLayer" Grid.ColumnSpan="2" ZIndex="19" IsVisible="{Binding IsTabMenuOpen}" Background="Transparent"
           PointerPressed="OnTabMenuLayerPressed">
      <Border x:Name="TabMenu" Classes="popmenu" Width="320" MaxHeight="380" HorizontalAlignment="Left" VerticalAlignment="Top">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,8,10,6">
              <TextBlock FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Bottom" Text="{Binding TabMenuHeading}" />
              <TextBlock Classes="faint" FontSize="11.5" VerticalAlignment="Bottom" Text="{Binding TabMenuCountText}" />
            </StackPanel>
            <ItemsControl x:Name="TabMenuList" ItemsSource="{Binding Notes.Tabs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="notes:NoteTabViewModel">
                  <Button Classes="row menuitem" Classes.current="{Binding IsSelected}" Padding="10,9" IsVisible="{Binding !IsProjection}"
                          Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).PickTabMenuNoteCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="18,10,*,Auto">
                      <TextBlock Grid.Column="0" Classes="faint" FontSize="11" FontWeight="Bold" Margin="0,2,0,0" VerticalAlignment="Top" Text="{Binding DisplayNumber}" />
                      <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                          <Path Data="{StaticResource Daynote.Desk.Geo.Star}" Fill="{DynamicResource Daynote.Desk.Brush.Sun}" VerticalAlignment="Center"
                                IsVisible="{Binding IsFavorite}" />
                        </StackPanel>
                        <TextBlock Classes="muted" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Preview}" />
                      </StackPanel>
                      <Ellipse Grid.Column="3" Width="6" Height="6" Margin="10,6,0,0" VerticalAlignment="Top"
                               Fill="{DynamicResource Daynote.Desk.Brush.Sun}" IsVisible="{Binding IsSelected}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Panel>

    <!-- The month view's day card: everything on the day under the pointer, by kind. It stays while
         the pointer moves onto it; its heading opens the day. -->
    <Border x:Name="BoardHover" Grid.ColumnSpan="2" Classes="popmenu" ZIndex="18" Width="288" MaxHeight="380" Padding="6,8"
            HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding CalendarBoard.Hover, Converter={x:Static ObjectConverters.IsNotNull}}"
            PointerEntered="OnBoardHoverEntered" PointerExited="OnBoardCellExited">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel DataContext="{Binding CalendarBoard.Hover}" x:DataType="pvm:CalendarBoardDay">
          <Button Classes="link" Margin="8,4" Command="{Binding OpenCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock FontSize="14" FontWeight="ExtraBold" LetterSpacing="-0.3" VerticalAlignment="Bottom" Text="{Binding Heading}" />
              <TextBlock Classes="faint" FontSize="11.5" VerticalAlignment="Bottom" Text="{Binding NoteText}" IsVisible="{Binding HasNotes}" />
            </StackPanel>
          </Button>
          <TextBlock Classes="hovhead" IsVisible="{Binding HasEvents}">
            <Run Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskDayEventTitle]}" /><Run Text=" " /><Run FontWeight="Normal" Text="{Binding EventCountText}" />
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource BoardHoverRow}" />
          <TextBlock Classes="hovhead" IsVisible="{Binding HasTodos}">
            <Run Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskDayTodoHeading]}" /><Run Text=" " /><Run FontWeight="Normal" Text="{Binding TodoCountText}" />
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Todos}" ItemTemplate="{StaticResource BoardHoverRow}" />
          <TextBlock Classes="hovhead" IsVisible="{Binding HasFiles}">
            <Run Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskNavFiles]}" /><Run Text=" " /><Run FontWeight="Normal" Text="{Binding FileCountText}" />
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource BoardHoverRow}" />
          <TextBlock Classes="faint" FontSize="12.5" Margin="8,6,8,4" IsVisible="{Binding IsEmpty}"
                     Text="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).Strings[DeskCalendarHoverEmpty]}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Settings: a 760x560 dialog with the four sections down its left. -->
    <!-- Each overlay opens and closes as the motion spec's desktop M6 has it (Popover). -->
    <Border Grid.ColumnSpan="2" Classes="scrim" ZIndex="20" IsVisible="False" motion:Popover.IsOpen="{Binding IsSettingsOpen}"
            PointerPressed="OnSettingsScrimPressed">
      <views:SettingsPanel x:Name="SettingsDialog" MaxWidth="760" MaxHeight="560" Margin="24" />
    </Border>

    <!--
      A repeating to-do's question, before a delete or an edit from its row's menu: this day only,
      or every repeat. Over the add-to-do card, which an edit opens after it.
    -->
    <Border x:Name="RepeatChoiceScrim" Grid.ColumnSpan="2" Classes="scrim" ZIndex="23" IsVisible="False"
            motion:Popover.IsOpen="{Binding IsRepeatChoiceOpen}" PointerPressed="OnRepeatChoiceScrimPressed">
      <Border Classes="modal" Width="340" Margin="24" Padding="22,18" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="8">
          <TextBlock Classes="h1" TextTrimming="CharacterEllipsis" Text="{Binding RepeatChoiceTitle}" />
          <TextBlock Classes="muted" FontSize="13" Margin="0,0,0,6" Text="{Binding Strings[TodoRepeatQuestion]}" />
          <StackPanel Spacing="8" IsVisible="{Binding IsRepeatChoiceDelete}">
            <Button x:Name="DeleteThisOccurrence" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="12,9" FontSize="13" Command="{Binding ChooseThisOccurrenceCommand}">
              <TextBlock Foreground="{DynamicResource Daynote.Product.Brush.Danger}" Text="{Binding Strings[TodoRepeatDeleteThis]}" />
            </Button>
            <Button x:Name="DeleteEveryRepeat" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="12,9" FontSize="13" Command="{Binding ChooseEveryRepeatCommand}">
              <TextBlock Foreground="{DynamicResource Daynote.Product.Brush.Danger}" Text="{Binding Strings[TodoRepeatDeleteAll]}" />
            </Button>
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding !IsRepeatChoiceDelete}">
            <Button x:Name="EditThisOccurrence" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="12,9" FontSize="13" Command="{Binding ChooseThisOccurrenceCommand}"
                    Content="{Binding Strings[TodoRepeatEditThis]}" />
            <Button x:Name="EditEveryRepeat" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="12,9" FontSize="13" Command="{Binding ChooseEveryRepeatCommand}"
                    Content="{Binding Strings[TodoRepeatEditAll]}" />
          </StackPanel>
          <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" FontSize="13"
                  Margin="0,4,0,0" Command="{Binding CloseRepeatChoiceCommand}" Content="{Binding Strings[TodoEntryCancel]}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- 삭제됨 · 실행 취소: four seconds after a to-do is deleted, at the foot of the window. -->
    <Border x:Name="UndoNotice" Grid.ColumnSpan="2" ZIndex="21" IsVisible="False" motion:Popover.IsOpen="{Binding IsUndoShown}"
            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Padding="16,0,6,0" Height="44"
            CornerRadius="12" Background="{DynamicResource Daynote.Product.Brush.Text}" BoxShadow="{DynamicResource Daynote.Desk.Shadow.Pop}">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Panel}"
                   Text="{Binding Strings[TodoDeleted]}" />
        <Button x:Name="UndoDeleteButton" Theme="{StaticResource Daynote.Bare}" Padding="10,6" VerticalAlignment="Center"
                Command="{Binding UndoDeleteCommand}">
          <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource Daynote.Desk.Brush.Sun}" Text="{Binding Strings[TodoUndo]}" />
        </Button>
      </StackPanel>
    </Border>

    <!--
      Add a to-do (the phone's to-do sheet, as a card): 할 일 / 일정, 제목, 날짜, 시간 or start and end,
      반복, 내용 and 목록, over the window. Opened from + 할 일 in the day panel and the 할 일 view; a
      note's body never makes a to-do. Each picker opens under its own row, one at a time.
    -->
    <Border x:Name="AddTodoScrim" Grid.ColumnSpan="2" Classes="scrim" ZIndex="22" IsVisible="False"
            motion:Popover.IsOpen="{Binding IsAddTodoOpen}" PointerPressed="OnAddTodoScrimPressed">
      <Border x:Name="AddTodoCard" Classes="modal" Width="460" MaxHeight="680" Margin="24,110,24,24" Padding="0" CornerRadius="16"
              Background="{DynamicResource Daynote.Product.Brush.Card}" VerticalAlignment="Top" HorizontalAlignment="Center">
        <DockPanel>
          <!-- 할 일 / 일정, and where it is going: the day it opened on, or "할 일 편집". -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="18,16,14,0">
            <Border Grid.Column="0" Background="{DynamicResource Daynote.Product.Brush.Seg}" CornerRadius="9" Padding="2">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="AddTodoKindTask" Classes="kind" Classes.on="{Binding TodoEntry.IsTask}"
                        Command="{Binding TodoEntry.SelectKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Task}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock FontSize="11" VerticalAlignment="Center" Text="✓" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Strings[AgendaCaptureTask]}" />
                  </StackPanel>
                </Button>
                <Button x:Name="AddTodoKindEvent" Classes="kind" Classes.on="{Binding TodoEntry.IsEvent}"
                        Command="{Binding TodoEntry.SelectKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Event}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock FontSize="11" VerticalAlignment="Center" Text="▦" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Strings[AgendaCaptureEvent]}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <TextBlock Grid.Column="1" Classes="faint" FontSize="12" Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="{Binding AddTodoSource}" IsVisible="{Binding !TodoEntry.IsEditing}" />
            <TextBlock x:Name="EditTodoHeading" Grid.Column="1" FontSize="13" FontWeight="Bold" Margin="10,0" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Text="{Binding Strings[TodoEditTitle]}" IsVisible="{Binding TodoEntry.IsEditing}" />
            <Button Grid.Column="2" Classes="ghost tiny" Command="{Binding CloseAddTodoCommand}"
                    AutomationProperties.Name="{Binding Strings[TodoEntryCancel]}">
              <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Close}" />
            </Button>
          </Grid>

          <!-- The foot: what the keys do, 취소 and 만들기; editing, 삭제 in their place. -->
          <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Padding="18,10,14,10"
                  BorderBrush="{DynamicResource Daynote.Product.Brush.Stroke2}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Grid.Column="0" Classes="faint" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding Strings[TodoEntryKeysHint]}" IsVisible="{Binding !TodoEntry.IsEditing}" />
              <Button Grid.Column="0" x:Name="AddTodoDelete" Classes="link faint" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                      Content="{Binding Strings[TodoEntryDelete]}" Command="{Binding DeleteEditedTodoCommand}" IsVisible="{Binding TodoEntry.IsEditing}" />
              <Button Grid.Column="1" Classes="quiet" Margin="0,0,8,0" Padding="12,0" Height="32" FontSize="13"
                      Command="{Binding CloseAddTodoCommand}" Content="{Binding Strings[TodoEntryCancel]}" />
              <Button Grid.Column="2" x:Name="AddTodoCommit" Classes="accent" Padding="14,0" Height="32" CornerRadius="9"
                      IsEnabled="{Binding TodoEntry.CanAdd}" Command="{Binding CommitAddTodoCommand}">
                <Panel>
                  <TextBlock Text="{Binding Strings[TodoEntryCreate]}" IsVisible="{Binding !TodoEntry.IsEditing}" />
                  <TextBlock Text="{Binding Strings[TodoEditSave]}" IsVisible="{Binding TodoEntry.IsEditing}" />
                </Panel>
              </Button>
            </Grid>
          </Border>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0">
              <!-- 제목. Enter makes it, as the phone's return key does. -->
              <TextBox x:Name="AddTodoTitle" Classes="bare" FontSize="20" FontWeight="ExtraBold" LetterSpacing="-0.4" Margin="18,14,18,8"
                       Text="{Binding TodoEntry.Title, Mode=TwoWay}" PlaceholderText="{Binding TodoEntry.TitlePlaceholder}"
                       AutomationProperties.Name="{Binding Strings[TodoEntryTitle]}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitAddTodoCommand}" />
                </TextBox.KeyBindings>
              </TextBox>

              <!-- 언제: the day, the hour and the repeat in words, read back underneath. The calendar and
                   the clock open the same pickers the fields below use. -->
              <StackPanel IsVisible="{Binding !TodoEntry.IsEditing}">
                <Border Margin="18,4,18,0" Height="40" Padding="12,0,5,0" CornerRadius="10" Background="{DynamicResource Daynote.Product.Brush.Seg}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" FontSize="12" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Daynote.Product.Brush.Text2}" Text="{Binding Strings[TodoEntryWhen]}" />
                    <TextBox Grid.Column="1" x:Name="AddTodoWhen" Classes="bare" FontSize="14" VerticalAlignment="Center"
                             Text="{Binding TodoEntry.When, Mode=TwoWay}" PlaceholderText="{Binding Strings[TodoEntryWhenPlaceholder]}"
                             AutomationProperties.Name="{Binding Strings[TodoEntryWhen]}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CommitAddTodoCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Border Grid.Column="2" Width="1" Margin="6,8" Background="{DynamicResource Daynote.Product.Brush.Stroke}" />
                    <Button Grid.Column="3" x:Name="AddTodoPickDate" Classes="ghost small" Classes.lit="{Binding TodoEntry.IsDatePickerOpen}"
                            Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Date}"
                            ToolTip.Tip="{Binding Strings[TodoEntryPickDate]}" AutomationProperties.Name="{Binding Strings[TodoEntryPickDate]}">
                      <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Calendar}" />
                    </Button>
                    <Button Grid.Column="4" x:Name="AddTodoPickTime" Classes="ghost small" Classes.lit="{Binding TodoEntry.IsTimePickerOpen}"
                            Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Time}"
                            ToolTip.Tip="{Binding Strings[TodoEntryPickTime]}" AutomationProperties.Name="{Binding Strings[TodoEntryPickTime]}">
                      <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Clock}" />
                    </Button>
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="18,10,18,0" MinHeight="20">
                  <Panel VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}" Text="✓" IsVisible="{Binding TodoEntry.IsTask}" />
                    <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}" Text="▦" IsVisible="{Binding TodoEntry.IsEvent}" />
                  </Panel>
                  <TextBlock x:Name="AddTodoReadback" Classes="readback" Classes.bad="{Binding TodoEntry.IsWhenUnreadable}" FontSize="13" FontWeight="Bold"
                             VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding TodoEntry.Readback}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding TodoEntry.WhenWarnings}" Margin="18,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                        <TextBlock Grid.Column="0" FontSize="12" FontWeight="ExtraBold" Margin="0,0,7,0" Foreground="{DynamicResource Daynote.Product.Brush.Danger}" Text="!" />
                        <TextBlock Grid.Column="1" FontSize="12" LineHeight="17.4" TextWrapping="Wrap" Foreground="{DynamicResource Daynote.Product.Brush.Danger}" Text="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="10" Margin="18,12,18,0">
              <Border Classes="panel" CornerRadius="12" IsVisible="{Binding TodoEntry.ShowsFields}">
                <StackPanel>
                  <Button x:Name="AddTodoDateRow" Classes="field" Classes.open="{Binding TodoEntry.IsDatePickerOpen}"
                          Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Date}">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Classes="fieldlabel" Text="{Binding Strings[TodoEntryDate]}" />
                      <TextBlock Grid.Column="1" Classes="fieldvalue" Classes.none="{Binding !TodoEntry.HasDate}" Text="{Binding TodoEntry.DateText}" />
                    </Grid>
                  </Button>
                  <StackPanel IsVisible="{Binding TodoEntry.IsDatePickerOpen}" Margin="12,0,12,10">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,0,2,6">
                      <TextBlock Grid.Column="0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding TodoEntry.Calendar.MonthLabel}" />
                      <Button Grid.Column="1" Classes="ghost small" Command="{Binding TodoEntry.Calendar.PreviousMonthCommand}"
                              AutomationProperties.Name="{Binding Strings[PreviousMonth]}">
                        <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronLeft}" />
                      </Button>
                      <Button Grid.Column="2" Classes="ghost small" Command="{Binding TodoEntry.Calendar.NextMonthCommand}"
                              AutomationProperties.Name="{Binding Strings[NextMonth]}">
                        <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.ChevronRight}" />
                      </Button>
                    </Grid>
                    <UniformGrid Columns="7">
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdaySun}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayMon}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayTue}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayWed}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayThu}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdayFri}" />
                      <TextBlock Classes="wd" Text="{Binding Strings.WeekdaySat}" />
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding TodoEntry.Calendar.Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:CalendarDayCellViewModel">
                          <Button Classes="minicell" Classes.outside="{Binding !IsInMonth}" Classes.sunday="{Binding IsSunday}"
                                  Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                                  IsHitTestVisible="{Binding IsInMonth}" Command="{Binding SelectCommand}">
                            <Border Classes="face">
                              <TextBlock Text="{Binding DayText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="opt" HorizontalAlignment="Left" Margin="0,6,0,0" IsVisible="{Binding TodoEntry.IsTask}"
                            Classes.on="{Binding !TodoEntry.HasDate}" Command="{Binding TodoEntry.ClearDateCommand}"
                            Content="{Binding Strings[TodoEntryNoDate]}" />
                  </StackPanel>

                  <Border Classes="fieldrule" />
                  <Button x:Name="AddTodoTimeRow" Classes="field" Classes.open="{Binding TodoEntry.IsTimePickerOpen}"
                          IsEnabled="{Binding TodoEntry.CanPickTime}"
                          Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Time}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Panel Grid.Column="0">
                        <TextBlock Classes="fieldlabel" IsVisible="{Binding TodoEntry.IsTask}" Text="{Binding Strings[TodoEntryTime]}" />
                        <TextBlock Classes="fieldlabel" IsVisible="{Binding TodoEntry.IsEvent}" Text="{Binding Strings[TodoEntryStart]}" />
                      </Panel>
                      <TextBlock Grid.Column="1" Classes="fieldvalue" Classes.none="{Binding !TodoEntry.HasTime}" Text="{Binding TodoEntry.TimeText}" />
                    </Grid>
                  </Button>
                  <StackPanel IsVisible="{Binding TodoEntry.IsEvent}">
                    <Border Classes="fieldrule" />
                    <Button x:Name="AddTodoEndRow" Classes="field"
                            Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.End}">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="fieldlabel" Text="{Binding Strings[TodoEntryEnd]}" />
                        <TextBlock Grid.Column="1" Classes="fieldvalue" Text="{Binding TodoEntry.EndText}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding TodoEntry.IsTimePickerOpen}" Margin="12,0,12,12" Spacing="5">
                    <TextBlock Classes="faint" FontSize="11.5" FontWeight="SemiBold" Text="{Binding Strings[ReminderTimeHour]}" />
                    <ItemsControl ItemsSource="{Binding TodoEntry.HourOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:TimeOption">
                          <Button Classes="opt cell" Classes.on="{Binding IsCurrent}" Margin="2" Content="{Binding Label}"
                                  Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).TodoEntry.PickHourCommand}"
                                  CommandParameter="{Binding Value}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="faint" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" Text="{Binding Strings[ReminderTimeMinute]}" />
                    <ItemsControl ItemsSource="{Binding TodoEntry.MinuteOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:TimeOption">
                          <Button Classes="opt cell" Classes.on="{Binding IsCurrent}" Margin="2" Content="{Binding Label}"
                                  Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).TodoEntry.PickMinuteCommand}"
                                  CommandParameter="{Binding Value}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="opt" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding TodoEntry.IsTask}"
                            Classes.on="{Binding !TodoEntry.HasTime}" Command="{Binding TodoEntry.ClearTimeCommand}"
                            Content="{Binding Strings[TodoEntryNoTime]}" />
                  </StackPanel>

                  <Border Classes="fieldrule" />
                  <Button x:Name="AddTodoRepeatRow" Classes="field" Classes.open="{Binding TodoEntry.IsRepeatPickerOpen}"
                          IsEnabled="{Binding TodoEntry.CanRepeat}"
                          Command="{Binding TodoEntry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Repeat}">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Classes="fieldlabel" Text="{Binding Strings[TodoEntryRepeat]}" />
                      <TextBlock Grid.Column="1" Classes="fieldvalue" Classes.none="{Binding !TodoEntry.Repeats}" Text="{Binding TodoEntry.RepeatText}" />
                    </Grid>
                  </Button>
                  <ItemsControl IsVisible="{Binding TodoEntry.IsRepeatPickerOpen}" Margin="10,0,10,12" ItemsSource="{Binding TodoEntry.RepeatOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pvm:TodoRepeatOption">
                        <Button Classes="opt cell" Classes.on="{Binding IsCurrent}" Margin="2" Content="{Binding Label}"
                                Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).TodoEntry.PickRepeatCommand}"
                                CommandParameter="{Binding Repeat}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- 내용: a few lines kept with the item, apart from its title. Editing only: making one is title and when. -->
              <TextBox x:Name="AddTodoNotes" Classes="inline" IsVisible="{Binding TodoEntry.IsEditing}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="140"
                       VerticalContentAlignment="Top" Text="{Binding TodoEntry.Description, Mode=TwoWay}"
                       PlaceholderText="{Binding Strings[TodoEntryNotesPlaceholder]}"
                       AutomationProperties.Name="{Binding Strings[TodoEntryNotes]}" />

              <!-- 목록, only when there is more than the built-in one to choose from. -->
              <StackPanel IsVisible="{Binding TodoEntry.ShowLists}" Spacing="6">
                <TextBlock Classes="faint" FontSize="11.5" FontWeight="SemiBold" Text="{Binding Strings[TodoEntryList]}" />
                <ItemsControl ItemsSource="{Binding TodoEntry.ListOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pvm:TodoListOption">
                      <Button Classes="opt" Classes.on="{Binding IsCurrent}"
                              Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).TodoEntry.PickListCommand}"
                              CommandParameter="{Binding Id}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Dot}" />
                          <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <!-- 타임라인 표시: only a repeating to-do is asked (docs/TODOS.md §11). -->
              <Border Classes="timelinechoice" IsVisible="{Binding TodoEntry.ShowsTimelineChoice}">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                      <Run Text="{Binding Strings[TodoEntryTimeline]}" />
                      <Run Text=" " />
                      <Run FontWeight="Normal" Foreground="{DynamicResource Daynote.Desk.Brush.Text3}" Text="{Binding Strings[TodoEntryTimelineScope]}" />
                    </TextBlock>
                    <Border Grid.Column="1" Background="{DynamicResource Daynote.Product.Brush.Seg}" CornerRadius="8" Padding="2">
                      <ItemsControl ItemsSource="{Binding TodoEntry.TimelineOptions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="pvm:TimelineVisibilityOption">
                            <Button Classes="kind small" Classes.on="{Binding IsCurrent}" Content="{Binding Label}"
                                    Command="{Binding $parent[Window].((vm:DesktopShellViewModel)DataContext).TodoEntry.PickTimelineCommand}"
                                    CommandParameter="{Binding Visibility}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </Grid>
                  <TextBlock Classes="muted" FontSize="11.5" LineHeight="17" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding TodoEntry.TimelineHint}" />
                </StackPanel>
              </Border>
            </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <Border.Styles>
          <!-- A face of a segmented control: the kind, 타임라인 표시. Lit on the card colour. -->
          <Style Selector="Button.kind">
            <Setter Property="Theme" Value="{StaticResource Daynote.Bare}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
          </Style>
          <Style Selector="Button.kind.small">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11.5" />
          </Style>
          <Style Selector="Button.kind.on">
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
          </Style>
          <Style Selector="Button.ghost.lit">
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.SunInk}" />
          </Style>
          <Style Selector="TextBlock.readback">
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
          </Style>
          <Style Selector="TextBlock.readback.bad">
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Danger}" />
          </Style>
          <Style Selector="Border.timelinechoice">
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
          </Style>
          <Style Selector="Button.opt">
            <Setter Property="Theme" Value="{StaticResource Daynote.Bare}" />
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
            <Setter Property="CornerRadius" Value="99" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
          <Style Selector="Button.opt.cell">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
          </Style>
          <Style Selector="Button.opt:pointerover">
            <Setter Property="Opacity" Value="0.85" />
          </Style>
          <Style Selector="Button.opt.on">
            <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.Pri}" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.OnPri}" />
          </Style>
          <Style Selector="Button.field">
            <Setter Property="Theme" Value="{StaticResource Daynote.Bare}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
          </Style>
          <Style Selector="Button.field:pointerover">
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Hover}" />
          </Style>
          <Style Selector="Button.field:disabled">
            <Setter Property="Opacity" Value="0.45" />
          </Style>
          <Style Selector="TextBlock.fieldlabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text2}" />
            <Setter Property="Width" Value="64" />
          </Style>
          <Style Selector="TextBlock.fieldvalue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
          </Style>
          <Style Selector="TextBlock.fieldvalue.none">
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
          </Style>
          <Style Selector="Border.fieldrule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Stroke2}" />
          </Style>
          <Style Selector="TextBlock.wd">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.Text3}" />
          </Style>
          <Style Selector="Button.minicell">
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Product.Brush.Text}" />
          </Style>
          <Style Selector="Button.minicell.outside">
            <Setter Property="Opacity" Value="0.35" />
          </Style>
          <Style Selector="Button.minicell.today Border.face">
            <Setter Property="Background" Value="{DynamicResource Daynote.Product.Brush.Seg}" />
          </Style>
          <Style Selector="Button.minicell.selected">
            <Setter Property="Foreground" Value="{DynamicResource Daynote.Desk.Brush.OnPri}" />
          </Style>
          <Style Selector="Button.minicell.selected Border.face">
            <Setter Property="Background" Value="{DynamicResource Daynote.Desk.Brush.Pri}" />
          </Style>
        </Border.Styles>
      </Border>
    </Border>

    <!-- Account: the cloud account card (sign-in, lock, subscription), opened from the popover or settings. -->
    <Border Grid.ColumnSpan="2" Classes="scrim" ZIndex="25" IsVisible="False" motion:Popover.IsOpen="{Binding IsAccountOpen}">
      <Border Classes="modal" Width="560" MaxHeight="680" Margin="24" Padding="28,24"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <!-- One heading, here beside the close button; the panel draws none of its own. -->
            <TextBlock Grid.Column="0" Classes="h1" Text="{Binding Strings[AccountSignInTitle]}" IsVisible="{Binding Account.ShowsSignIn, FallbackValue=False}" />
            <TextBlock Grid.Column="0" Classes="h1" Text="{Binding Strings[AccountWindowTitle]}" IsVisible="{Binding Account.IsSignedIn, FallbackValue=False}" />
            <Button Grid.Column="1" Classes="ghost small" Command="{Binding CloseAccountCommand}" AutomationProperties.Name="{Binding Strings[CloseSettings]}">
              <Path Classes="icon" Data="{StaticResource Daynote.Desk.Geo.Close}" />
            </Button>
          </Grid>
          <views:AccountPanel Grid.Row="1" DataContext="{Binding Account}" />
        </Grid>
      </Border>
    </Border>

    <!--
      Checkout (Daynote Desktop B v2): the tier, the interval, what it costs, then Paddle's page in
      the browser. Above settings and the account card, which are what open it. Bound to the account
      through a template, so a build with no sync endpoint never evaluates it.
    -->
    <ContentControl Grid.ColumnSpan="2" ZIndex="28" Content="{Binding Account}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="account:AccountViewModel">
          <views:CheckoutDialog />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!--
      Onboarding tutorial. The overlay dims the shell and cuts a hole around the step's target
      (TutorialOverlay). It spans the whole window: the targets are in the sidebar and the body alike.
    -->
    <views:TutorialOverlay Grid.ColumnSpan="2" ZIndex="30" DataContext="{Binding Tutorial}"
                           IsVisible="{Binding IsOpen, FallbackValue=False}" />

    <!-- The ⌘K palette: quick actions until something is typed, then the unified search's results. -->
    <Border x:Name="PaletteScrim" Grid.ColumnSpan="2" Classes="scrim" ZIndex="40" IsVisible="False" motion:Popover.IsOpen="{Binding IsPaletteOpen}"
            PointerPressed="OnPaletteScrimPressed">
      <Border x:Name="Palette" Classes="modal" Background="{DynamicResource Daynote.Product.Brush.Card}" CornerRadius="16"
              RenderTransformOrigin="50%,0%"
              Width="620" Margin="24,0" VerticalAlignment="Top" HorizontalAlignment="Center" ClipToBounds="True">
        <StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto" Height="60" Margin="18,0">
            <Path Grid.Column="0" Data="{StaticResource Daynote.Desk.Geo.Search}" Stroke="{DynamicResource Daynote.Product.Brush.Text2}"
                  StrokeThickness="1.5" StrokeLineCap="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Classes="bare" FontSize="17" Margin="12,0" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" PlaceholderText="{Binding Strings[DeskPalettePlaceholder]}"
                     Text="{Binding Search.Query}" />
            <Border Grid.Column="2" Classes="keycap" VerticalAlignment="Center">
              <TextBlock Classes="faint" FontSize="11" FontWeight="SemiBold" Text="esc" />
            </Border>
          </Grid>
          <Border Height="1" Background="{DynamicResource Daynote.Product.Brush.Stroke2}" />
          <ScrollViewer x:Name="SearchDropdown" MaxHeight="420" Padding="8">
            <StackPanel>
              <StackPanel IsVisible="{Binding !Search.IsOpen}">
                <TextBlock Classes="faint" FontSize="11.5" FontWeight="SemiBold" Margin="10,8,10,6" Text="{Binding Strings[DeskPaletteShortcuts]}" />
                <ItemsControl x:Name="QuickActionList" ItemsSource="{Binding QuickActions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaletteActionViewModel">
                      <Button Classes="row" Padding="10" Command="{Binding RunCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" FontSize="13.5" Text="{Binding Label}" />
                          <TextBlock Grid.Column="1" Classes="faint mono" FontSize="11.5" VerticalAlignment="Center" Text="{Binding Combo}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <ItemsControl x:Name="ResultList" ItemsSource="{Binding Search.Results}" IsVisible="{Binding Search.IsOpen}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="pvm:SearchResultRowViewModel">
                    <Button Classes="row" Padding="10" Command="{Binding ActivateCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Classes="kind" Margin="0,0,12,0" VerticalAlignment="Center">
                          <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Daynote.Desk.Brush.SunInk}" Text="{Binding Kind}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                          <TextBlock Classes="muted" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Sub}"
                                     IsVisible="{Binding Sub, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="faint" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding DateLabel}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Margin="28" HorizontalAlignment="Center" Text="{Binding Strings.SearchNoResultsRow}"
                         IsVisible="{Binding Search.NoResults}" />
              <TextBlock Margin="28" HorizontalAlignment="Center" Foreground="{DynamicResource Daynote.Product.Brush.Danger}"
                         Text="{Binding Strings.SearchFailedRow}" IsVisible="{Binding Search.Failed}" />
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
