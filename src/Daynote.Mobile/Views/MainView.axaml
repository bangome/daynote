<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daynote.Mobile.ViewModels"
             xmlns:pvm="using:Daynote.App.Shell.Product"
             xmlns:views="using:Daynote.Mobile.Views"
             xmlns:agenda="using:Daynote.Core.Agenda"
             x:Class="Daynote.Mobile.Views.MainView"
             x:DataType="vm:MobileShellViewModel"
             FontFamily="{StaticResource Mobile.Font}"
             Background="{DynamicResource Mobile.Bg}">
  <!--
    The phone shell: one page at a time under a floating tab bar, with the editor and the account
    page as layers over the tabs and the month sheet over everything. The desktop puts the same
    surfaces in three columns side by side; a phone that tried that would show three slivers.

    Every page is built and kept alive, and only its visibility changes: swapping visibility keeps
    scroll position and keyboard focus across a tab switch, which recreating them would throw away.
  -->
  <Panel>
    <!--
      The frame the width chooses (MobileLayout; MainView.axaml.cs places each part in it). On a
      phone the page fills it and the editor covers the page. Between 600 and 839 points the rail,
      the page as a panel and the note stand side by side (Foldables §01). From 840 the tablet's
      Desktop B: the sidebar (from 1100), the day or the note in the middle, and the day panel.

      The same page and editor instances move between columns rather than being rebuilt per
      layout, so a fold or a Split View resize keeps the scroll, the draft and the caret.
    -->
    <Grid x:Name="Frame" ColumnDefinitions="0,0,*,0">
      <views:NavRail x:Name="Rail" Grid.Column="0" IsVisible="{Binding IsTwoPaneLayout}" />
      <views:TabletSidebar x:Name="Sidebar" Grid.Column="0" IsVisible="{Binding IsSidebarDocked}" />
      <Grid x:Name="PageColumn" Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding ShowPageColumn}">
        <!--
          The tablet with its sidebar folded away: the button that brings it over the page (T6, T7),
          in a row of its own above every page, since the sidebar is the only way between them.
        -->
        <Button x:Name="SidebarButton" Grid.Row="0" Classes="iconbtn" Width="44" Height="44" Margin="8,4,0,0"
                HorizontalAlignment="Left" IsVisible="{Binding IsSidebarButtonShown}"
                Command="{Binding ToggleSidebarCommand}" AutomationProperties.Name="{Binding Strings[MobileWideSidebar]}">
          <views:Glyph Kind="Menu" Width="18" Height="18" Foreground="{DynamicResource Mobile.Text}" />
        </Button>
        <views:DayPage Grid.Row="1" IsVisible="{Binding IsDayPage}" />
        <views:SearchPage Grid.Row="1" IsVisible="{Binding IsSearchPage}" />
        <views:ListsPage Grid.Row="1" IsVisible="{Binding IsListsPage}" />
        <views:SettingsPage Grid.Row="1" IsVisible="{Binding IsSettingsPage}" />
      </Grid>
      <views:EditorPage x:Name="Editor" Grid.Column="2" IsVisible="{Binding ShowEditor}" />
      <views:DayTodoPanel x:Name="DayPanel" Grid.Column="3" IsVisible="{Binding IsTabletLayout}" />
    </Grid>

    <!-- The folded-away sidebar, over the day, closed by a tap beside it. -->
    <Panel x:Name="SidebarLayer" IsVisible="{Binding IsSidebarOpen}">
      <Button Classes="scrim" Command="{Binding ToggleSidebarCommand}"
              AutomationProperties.Name="{Binding Strings[MobileClose]}" />
      <views:TabletSidebar x:Name="SidebarOverlay" HorizontalAlignment="Left" />
    </Panel>

    <views:AccountPage IsVisible="{Binding IsAccountOpen}" />
    <views:StorePage IsVisible="{Binding IsStoreOpen}" />

    <!--
      The floating bar and the new-note button beside it. It floats over the page rather than
      taking a row, so every page pads its scroll content by the bar's height instead; the bottom
      margin is set in code from the safe area (MainView.axaml.cs).
    -->
    <Grid x:Name="Dock" VerticalAlignment="Bottom" Margin="16,0,16,12" ColumnDefinitions="*,Auto"
          IsVisible="{Binding ShowDock}">
      <Border Grid.Column="0" Height="62" CornerRadius="31" Padding="6,0"
              Background="{DynamicResource Mobile.Bar}" BorderBrush="{DynamicResource Mobile.Stroke}" BorderThickness="1"
              BoxShadow="0 10 30 0 #24161a36">
        <Grid ColumnDefinitions="*,*,*,*">
          <!-- "Today", not "Day": it goes to the day screen and lands on today. -->
          <Button Grid.Column="0" Classes="tab" Classes.active="{Binding IsDayPage}"
                  Command="{Binding GoToTodayPageCommand}"
                  AutomationProperties.Name="{Binding Strings[Today]}">
            <StackPanel Spacing="3">
              <views:Glyph Kind="TabToday" Width="22" Height="22" Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding Strings[Today]}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="tab" Classes.active="{Binding IsSearchPage}"
                  Command="{Binding GoToPageCommand}" CommandParameter="{x:Static vm:MobilePage.Search}"
                  AutomationProperties.Name="{Binding Strings[TabSearch]}">
            <StackPanel Spacing="3">
              <views:Glyph Kind="TabSearch" Width="22" Height="22" Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding Strings[TabSearch]}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="tab" Classes.active="{Binding IsListsPage}"
                  Command="{Binding GoToPageCommand}" CommandParameter="{x:Static vm:MobilePage.Lists}"
                  AutomationProperties.Name="{Binding Strings[TabLists]}">
            <StackPanel Spacing="3">
              <views:Glyph Kind="TabLists" Width="22" Height="22" Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="{Binding Strings[TabLists]}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Classes="tab" Classes.active="{Binding IsSettingsPage}"
                  Command="{Binding GoToPageCommand}" CommandParameter="{x:Static vm:MobilePage.Settings}"
                  AutomationProperties.Name="{Binding Strings[Settings]}">
            <StackPanel Spacing="3">
              <views:Glyph Kind="TabSettings" Width="22" Height="22" Foreground="{Binding $parent[Button].Foreground}"
                           Fill="{DynamicResource Mobile.Card}" />
              <TextBlock Text="{Binding Strings[Settings]}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <Border Grid.Column="1" Margin="10,0,0,0" Width="62" Height="62" CornerRadius="31"
              Background="{DynamicResource Mobile.Pri}" BoxShadow="0 10 24 0 #4d161a36">
        <Button Width="62" Height="62" CornerRadius="31" Command="{Binding NewNoteCommand}"
                AutomationProperties.Name="{Binding Strings[AddNote]}">
          <views:Glyph Kind="Plus" Width="22" Height="22" Foreground="{DynamicResource Mobile.OnPri}" />
        </Button>
      </Border>
    </Grid>

    <!--
      The month sheet: the whole calendar, which the home screen gave up for the week strip. A scrim
      that closes on a tap rather than a cancel button, because there is nothing to confirm - the day
      tapped in the grid is the choice, and it closes the sheet itself.

      Every sheet here is a SheetLayer: it rises and closes as the motion spec's M6 has it, and its
      top strip can be dragged down to close it.
    -->
    <views:SheetLayer IsOpen="{Binding IsMonthPickerOpen}">
      <Button Classes="scrim" Command="{Binding CloseMonthPickerCommand}"
              AutomationProperties.Name="{Binding Strings[WindowClose]}" />
      <Border x:Name="Sheet" Classes="sheet" VerticalAlignment="Bottom">
        <!-- Scrolls only when the screen is shorter than the sheet: a phone on its side, or a
             split-screen window, would otherwise push the year header off the top and the last
             week into the home indicator. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,10,16,0">
          <Border Width="40" Height="5" CornerRadius="3" Background="{DynamicResource Mobile.Stroke}" Margin="0,0,0,12" />
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,10">
            <Button Grid.Column="0" Width="40" Height="40" Command="{Binding PickerPreviousYearCommand}"
                    AutomationProperties.Name="{Binding Strings[MobilePreviousYear]}">
              <views:Glyph Kind="ChevronLeft" Width="11" Height="11" Foreground="{DynamicResource Mobile.Text2}" />
            </Button>
            <TextBlock Grid.Column="1" FontSize="17" FontWeight="ExtraBold" TextAlignment="Center" VerticalAlignment="Center"
                       Text="{Binding PickerYearText}" />
            <Button Grid.Column="2" Width="40" Height="40" Command="{Binding PickerNextYearCommand}"
                    AutomationProperties.Name="{Binding Strings[MobileNextYear]}">
              <views:Glyph Kind="ChevronRight" Width="11" Height="11" Foreground="{DynamicResource Mobile.Text2}" />
            </Button>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding PickerMonths}" Margin="4,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MonthOption">
                  <Button Classes="pill month" Classes.on="{Binding IsCurrent}"
                          Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).PickMonthCommand}"
                          CommandParameter="{Binding Number}">
                    <TextBlock Text="{Binding Label}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <UniformGrid Columns="7">
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdaySun]}" Foreground="{DynamicResource Mobile.Sunday}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayMon]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayTue]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayWed]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayThu]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayFri]}" />
            <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdaySat]}" Foreground="{DynamicResource Mobile.Text}" />
          </UniformGrid>
          <ItemsControl ItemsSource="{Binding Calendar.Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="pvm:CalendarDayCellViewModel">
                <Button Classes="cell" Classes.outside="{Binding !IsInMonth}" Classes.sunday="{Binding IsSunday}"
                        Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                        Command="{Binding SelectCommand}" IsHitTestVisible="{Binding IsInMonth}">
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Border Classes="cellday">
                      <TextBlock Text="{Binding DayText}" />
                    </Border>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource Mobile.Sun}" IsVisible="{Binding HasNotes}" />
                    <Border Width="4" Height="4" IsVisible="{Binding !HasNotes}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </views:SheetLayer>

    <!--
      The default reminder time (settings): the hour from a grid of twenty-four pills, the minute
      from four, the draft large on top, and nothing kept until 완료. Scrolls like the month sheet
      when a phone on its side is shorter than it.
    -->
    <views:SheetLayer IsOpen="{Binding IsReminderTimeSheetOpen}">
      <Button Classes="scrim" Command="{Binding CloseReminderTimeSheetCommand}"
              AutomationProperties.Name="{Binding Strings[MobileCancel]}" />
      <Border x:Name="ReminderTimeSheet" Classes="sheet" VerticalAlignment="Bottom">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,10,16,0" Spacing="8">
            <Border Width="40" Height="5" CornerRadius="3" Background="{DynamicResource Mobile.Stroke}" Margin="0,0,0,6" />
            <TextBlock Classes="section" Margin="4,0,0,0" Text="{Binding Strings[ReminderTimeTitle]}" />
            <TextBlock FontSize="34" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,2,0,4"
                       Text="{Binding DraftReminderTimeText}" />
            <TextBlock Classes="subhead" Margin="4,0,0,0" Text="{Binding Strings[ReminderTimeHour]}" />
            <ItemsControl ItemsSource="{Binding ReminderHourOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:TimeOption">
                  <Button Classes="pill time" Classes.on="{Binding IsCurrent}" Margin="3"
                          Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).PickReminderHourCommand}"
                          CommandParameter="{Binding Value}">
                    <TextBlock Text="{Binding Label}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="subhead" Margin="4,4,0,0" Text="{Binding Strings[ReminderTimeMinute]}" />
            <ItemsControl ItemsSource="{Binding ReminderMinuteOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pvm:TimeOption">
                  <Button Classes="pill time" Classes.on="{Binding IsCurrent}" Margin="3"
                          Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).PickReminderMinuteCommand}"
                          CommandParameter="{Binding Value}">
                    <TextBlock Text="{Binding Label}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,10,*" Margin="0,8,0,0">
              <Button Grid.Column="0" Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding CloseReminderTimeSheetCommand}">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileCancel]}" />
              </Button>
              <Button Grid.Column="2" Classes="solid" HorizontalAlignment="Stretch" Command="{Binding CommitReminderTimeCommand}">
                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Mobile.OnPri}" Text="{Binding Strings[ReminderTimeDone]}" />
              </Button>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </views:SheetLayer>

    <!--
      A picture, full screen, over everything. The ground runs under the notch and the home
      indicator (MainView.axaml.cs sets the bleed); the bar and the actions stay inside the safe area.
      A double tap, or a pinch, zooms.
    -->
    <Border x:Name="Viewer" Background="#0b0c14" IsVisible="{Binding IsImageViewerOpen}">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Height="52" Margin="6,0" ColumnDefinitions="44,*,44">
          <Button Grid.Column="0" x:Name="ViewerClose" Classes="iconbtn" Command="{Binding CloseImageViewerCommand}"
                  AutomationProperties.Name="{Binding Strings[MobileClose]}">
            <views:Glyph Kind="Close" Width="18" Height="18" Foreground="White" />
          </Button>
          <TextBlock Grid.Column="1" Classes="line" FontSize="14" FontWeight="SemiBold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ViewerTitle}" />
        </Grid>
        <Border Grid.Row="1" x:Name="ViewerStage" Background="Transparent" ClipToBounds="True"
                DoubleTapped="OnViewerDoubleTapped">
          <Border.GestureRecognizers>
            <PinchGestureRecognizer />
          </Border.GestureRecognizers>
          <Image x:Name="ViewerImage" Source="{Binding ViewerImage}" Stretch="Uniform" RenderTransformOrigin="50%,50%" />
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,12,*" Margin="20,8,20,12">
          <Button Grid.Column="0" Classes="viewerbtn" Command="{Binding SaveFileCopyCommand}">
            <TextBlock Text="{Binding Strings[MobileFileSaveCopy]}" />
          </Button>
          <Button Grid.Column="2" Classes="viewerbtn" Command="{Binding DeleteViewerFileCommand}">
            <TextBlock Text="{Binding Strings[MobileFileDelete]}" Foreground="#ff8076" />
          </Button>
        </Grid>
      </Grid>
    </Border>

    <!--
      The attachment sheets: "사진 or 파일" when attaching, and a file's menu, which turns into the
      delete question in place. One sheet with three faces rather than three sheets, because only one
      is ever up and they share the scrim and the bleed.
    -->
    <views:SheetLayer IsOpen="{Binding IsAttachSheetOpen}">
      <Button Classes="scrim" Command="{Binding CloseAttachSheetCommand}"
              AutomationProperties.Name="{Binding Strings[MobileCancel]}" />
      <Border x:Name="AttachSheet" Classes="sheet" VerticalAlignment="Bottom">
        <StackPanel Margin="16,10,16,0" Spacing="8">
          <Border Width="40" Height="5" CornerRadius="3" Background="{DynamicResource Mobile.Stroke}" Margin="0,0,0,6" />
          <TextBlock Classes="section" Margin="4,0,0,4" Text="{Binding Strings[MobileAttachTitle]}" />
          <Button Classes="sheetrow" Command="{Binding AttachPhotosCommand}">
            <Grid ColumnDefinitions="40,*">
              <Border Grid.Column="0" Classes="sheeticon">
                <views:Glyph Kind="Photo" Width="22" Height="22" Foreground="{DynamicResource Mobile.SunInk}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="15.5" FontWeight="Bold" Text="{Binding Strings[MobileAttachPhotos]}" />
                <TextBlock Classes="muted" FontSize="12.5" Text="{Binding Strings[MobileAttachPhotosHint]}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="sheetrow" Command="{Binding AttachFilesFromPickerCommand}">
            <Grid ColumnDefinitions="40,*">
              <Border Grid.Column="0" Classes="sheeticon">
                <views:Glyph Kind="Document" Width="22" Height="22" Foreground="{DynamicResource Mobile.SunInk}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="15.5" FontWeight="Bold" Text="{Binding Strings[MobileAttachFiles]}" />
                <TextBlock Classes="muted" FontSize="12.5" Text="{Binding Strings[MobileAttachFilesHint]}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="quiet" HorizontalAlignment="Stretch" Margin="0,4,0,0" Command="{Binding CloseAttachSheetCommand}">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileCancel]}" />
          </Button>
        </StackPanel>
      </Border>
    </views:SheetLayer>

    <views:SheetLayer IsOpen="{Binding IsFileMenuOpen}">
      <Button Classes="scrim" Command="{Binding CloseFileMenuCommand}"
              AutomationProperties.Name="{Binding Strings[MobileCancel]}" />
      <Border x:Name="FileSheet" Classes="sheet" VerticalAlignment="Bottom">
        <StackPanel Margin="16,10,16,0" Spacing="8">
          <Border Width="40" Height="5" CornerRadius="3" Background="{DynamicResource Mobile.Stroke}" Margin="0,0,0,6" />
          <TextBlock Classes="line" FontSize="15.5" FontWeight="ExtraBold" Margin="4,0,4,4" Text="{Binding FileMenuTitle}" />

          <StackPanel Spacing="8" IsVisible="{Binding !IsConfirmingDelete}">
            <Button Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding SaveFileCopyCommand}">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileFileSaveCopy]}" />
            </Button>
            <Button Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding RequestDeleteFileCommand}">
              <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Mobile.Danger}"
                         Text="{Binding Strings[MobileFileDelete]}" />
            </Button>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsConfirmingDelete}">
            <TextBlock FontSize="15" FontWeight="Bold" Margin="4,0" Text="{Binding Strings[MobileFileDeleteQuestion]}" />
            <TextBlock Classes="muted" FontSize="13.5" Margin="4,0,4,6" Text="{Binding Strings[MobileFileDeleteBody]}" />
            <Button x:Name="ConfirmDeleteFile" Classes="danger" HorizontalAlignment="Stretch" Command="{Binding ConfirmDeleteFileCommand}">
              <TextBlock FontSize="15" FontWeight="Bold" Foreground="White" Text="{Binding Strings[MobileFileDelete]}" />
            </Button>
          </StackPanel>

          <Button Classes="quiet" HorizontalAlignment="Stretch" Margin="0,4,0,0" Command="{Binding CloseFileMenuCommand}">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileCancel]}" />
          </Button>
        </StackPanel>
      </Border>
    </views:SheetLayer>

    <!--
      A list's menu, and the one field that both makes and renames one. Two faces of a sheet rather
      than two sheets: only one is ever up, and a phone has nowhere to rename in place the way the
      desktop sidebar does. Colour and connecting a list to Reminders are in the design's menu and
      are not built yet, so they are absent rather than disabled.
    -->
    <views:SheetLayer IsOpen="{Binding IsAgendaListSheetOpen}">
      <Button Classes="scrim" Command="{Binding CloseAgendaListSheetCommand}"
              AutomationProperties.Name="{Binding Strings[MobileCancel]}" />
      <Border x:Name="ListSheet" Classes="sheet" VerticalAlignment="Bottom">
        <StackPanel Margin="16,10,16,0" Spacing="8">
          <Border Width="40" Height="5" CornerRadius="3" Background="{DynamicResource Mobile.Stroke}" Margin="0,0,0,6" />
          <TextBlock Classes="line" FontSize="15.5" FontWeight="ExtraBold" Margin="4,0,4,0"
                     Text="{Binding AgendaListSheetTitle}" />
          <TextBlock Classes="muted" FontSize="12.5" Margin="4,0,4,4" IsVisible="{Binding IsSheetListDefault}"
                     Text="{Binding Strings[MobileListDefault]}" />

          <StackPanel Spacing="8" IsVisible="{Binding !IsNamingAgendaList}">
            <Button Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding RenameAgendaListFromSheetCommand}">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[AgendaListRename]}" />
            </Button>
            <Button Classes="quiet" HorizontalAlignment="Stretch" IsVisible="{Binding CanDeleteSheetList}"
                    Command="{Binding DeleteAgendaListFromSheetCommand}">
              <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Mobile.Danger}"
                         Text="{Binding Strings[AgendaListDelete]}" />
            </Button>
            <TextBlock Classes="muted" FontSize="12.5" Margin="4,2,4,0" TextWrapping="Wrap"
                       IsVisible="{Binding IsSheetListDefault}" Text="{Binding Strings[MobileListDefaultHint]}" />
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsNamingAgendaList}">
            <TextBox x:Name="ListNameBox" Text="{Binding AgendaListDraftName, Mode=TwoWay}"
                     PlaceholderText="{Binding Strings[MobileListNamePlaceholder]}">
              <!-- The keyboard is already up with the field; its return key should finish the job. -->
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding CommitAgendaListNameCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Grid ColumnDefinitions="*,10,*" Margin="0,4,0,0">
              <Button Grid.Column="0" Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding CloseAgendaListSheetCommand}">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileCancel]}" />
              </Button>
              <Button Grid.Column="2" Classes="solid" HorizontalAlignment="Stretch" Command="{Binding CommitAgendaListNameCommand}">
                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Mobile.OnPri}"
                           Text="{Binding Strings[MobileListCreate]}" />
              </Button>
            </Grid>
          </StackPanel>

          <Button Classes="quiet" HorizontalAlignment="Stretch" Margin="0,4,0,0" IsVisible="{Binding !IsNamingAgendaList}"
                  Command="{Binding CloseAgendaListSheetCommand}">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileCancel]}" />
          </Button>
        </StackPanel>
      </Border>
    </views:SheetLayer>

    <!--
      The to-do sheet: a to-do or an event in fields of its own - 제목, 날짜, 시간, 반복, 내용, 목록 -
      opened from the to-do surfaces (the day's 할 일, the 할 일 tab, the tablet's day panel), a
      widget's "+ 할 일" and the capture link, and never from a note. The title field takes the
      keyboard as the sheet opens, and the sheet then sits on the keyboard (MainView.axaml.cs).
      Each picker opens under its own row, one at a time. The kind switch stays at the top and
      취소 / 추가 at the bottom; only the fields between them scroll, so on a small phone with the
      keyboard up 추가 is still in reach.
    -->
    <views:SheetLayer IsOpen="{Binding IsTodoSheetOpen}">
      <Button Classes="scrim" Command="{Binding CloseTodoSheetCommand}"
              AutomationProperties.Name="{Binding Strings[MobileCancel]}" />
      <Border x:Name="TodoSheet" Classes="sheet todosheet" VerticalAlignment="Bottom">
        <DockPanel Margin="16,10,16,0">
          <Border DockPanel.Dock="Top" Width="40" Height="5" CornerRadius="3" Background="{DynamicResource Mobile.Stroke}" Margin="0,0,0,12" />

          <!-- Opened from a row's 편집: the same sheet, filled in, saving over the item. -->
          <TextBlock x:Name="TodoEditTitle" DockPanel.Dock="Top" Classes="line" FontSize="15.5" FontWeight="ExtraBold" Margin="4,0,4,10"
                     IsVisible="{Binding Entry.IsEditing}" Text="{Binding Strings[MobileTodoEditTitle]}" />

          <!-- 할 일 or 일정: the same two words, in the same order, as the desktop's @ card. -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
              <Button x:Name="TodoKindTask" Classes="pill small" Classes.on="{Binding Entry.IsTask}"
                      Command="{Binding Entry.SelectKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Task}">
                <TextBlock Text="{Binding Strings[AgendaCaptureTask]}" />
              </Button>
              <Button x:Name="TodoKindEvent" Classes="pill small" Classes.on="{Binding Entry.IsEvent}"
                      Command="{Binding Entry.SelectKindCommand}" CommandParameter="{x:Static agenda:AgendaKind.Event}">
                <TextBlock Text="{Binding Strings[AgendaCaptureEvent]}" />
              </Button>
            </StackPanel>
            <Button Grid.Column="1" Classes="iconbtn" Width="36" Height="36" Command="{Binding CloseTodoSheetCommand}"
                    AutomationProperties.Name="{Binding Strings[MobileClose]}">
              <views:Glyph Kind="Close" Width="13" Height="13" Foreground="{DynamicResource Mobile.Text2}" />
            </Button>
          </Grid>

          <!-- Docked before the fields, so they get what is left over and scroll inside it. -->
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,10,*" Margin="0,10,0,0">
            <Button Grid.Column="0" Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding CloseTodoSheetCommand}">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileCancel]}" />
            </Button>
            <Button Grid.Column="2" x:Name="TodoAdd" Classes="solid" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding Entry.CanAdd}" Command="{Binding CommitTodoSheetCommand}">
              <Panel>
                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Mobile.OnPri}" Text="{Binding Strings[TodoEntryAdd]}"
                           IsVisible="{Binding !Entry.IsEditing}" />
                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Mobile.OnPri}" Text="{Binding Strings[MobileTodoSave]}"
                           IsVisible="{Binding Entry.IsEditing}" />
              </Panel>
            </Button>
          </Grid>

          <ScrollViewer x:Name="TodoFields" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              <!-- 제목. One line; the keyboard's return key adds, as 완료 does on the list sheet. -->
              <TextBox x:Name="TodoTextBox" Text="{Binding Entry.Title, Mode=TwoWay}"
                       PlaceholderText="{Binding Entry.TitlePlaceholder}"
                       AutomationProperties.Name="{Binding Strings[TodoEntryTitle]}"
                       TextInputOptions.ReturnKeyType="Done">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitTodoSheetCommand}" />
                </TextBox.KeyBindings>
              </TextBox>

              <!-- 날짜 and 시간, as rows on one card: what each says is the value, and a tap opens its picker. -->
              <Border Classes="todofields">
                <StackPanel>
                  <Button x:Name="TodoDateRow" Classes="todofield" Classes.open="{Binding Entry.IsDatePickerOpen}"
                          Command="{Binding Entry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Date}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Classes="fieldlabel" Text="{Binding Strings[TodoEntryDate]}" />
                      <TextBlock Grid.Column="1" Classes="fieldvalue" Classes.none="{Binding !Entry.HasDate}" Text="{Binding Entry.DateText}" />
                      <views:Glyph Grid.Column="2" Kind="ChevronDown" Width="11" Height="11" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Mobile.Text3}" />
                    </Grid>
                  </Button>

                  <!-- The month sheet's grid, a size down, under its row. -->
                  <StackPanel IsVisible="{Binding Entry.IsDatePickerOpen}" Margin="8,0,8,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                      <Button Grid.Column="0" Width="40" Height="40" Command="{Binding Entry.Calendar.PreviousMonthCommand}"
                              AutomationProperties.Name="{Binding Strings[PreviousMonth]}">
                        <views:Glyph Kind="ChevronLeft" Width="11" Height="11" Foreground="{DynamicResource Mobile.Text2}" />
                      </Button>
                      <TextBlock Grid.Column="1" FontSize="15" FontWeight="ExtraBold" TextAlignment="Center" VerticalAlignment="Center"
                                 Text="{Binding Entry.Calendar.MonthLabel}" />
                      <Button Grid.Column="2" Width="40" Height="40" Command="{Binding Entry.Calendar.NextMonthCommand}"
                              AutomationProperties.Name="{Binding Strings[NextMonth]}">
                        <views:Glyph Kind="ChevronRight" Width="11" Height="11" Foreground="{DynamicResource Mobile.Text2}" />
                      </Button>
                    </Grid>
                    <UniformGrid Columns="7">
                      <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdaySun]}" Foreground="{DynamicResource Mobile.Sunday}" />
                      <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayMon]}" />
                      <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayTue]}" />
                      <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayWed]}" />
                      <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayThu]}" />
                      <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdayFri]}" />
                      <TextBlock Classes="sheetwd" Text="{Binding Strings[WeekdaySat]}" Foreground="{DynamicResource Mobile.Text}" />
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding Entry.Calendar.Cells}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:CalendarDayCellViewModel">
                          <Button Classes="cell" Classes.outside="{Binding !IsInMonth}" Classes.sunday="{Binding IsSunday}"
                                  Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                                  Command="{Binding SelectCommand}" IsHitTestVisible="{Binding IsInMonth}">
                            <Border Classes="cellday">
                              <TextBlock Text="{Binding DayText}" />
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- A to-do may be owed with no day at all; an event is a block of one. -->
                    <Button Classes="pill small" HorizontalAlignment="Left" Margin="0,6,0,0" IsVisible="{Binding Entry.IsTask}"
                            Classes.on="{Binding !Entry.HasDate}" Command="{Binding Entry.ClearDateCommand}">
                      <TextBlock Text="{Binding Strings[TodoEntryNoDate]}" />
                    </Button>
                  </StackPanel>

                  <Border Classes="fieldrule" />

                  <!-- A to-do's time, or an event's start. Greyed while an undated to-do has no day to put it on. -->
                  <Button x:Name="TodoTimeRow" Classes="todofield" Classes.open="{Binding Entry.IsTimePickerOpen}"
                          IsEnabled="{Binding Entry.CanPickTime}"
                          Command="{Binding Entry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Time}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Panel Grid.Column="0">
                        <TextBlock Classes="fieldlabel" IsVisible="{Binding Entry.IsTask}" Text="{Binding Strings[TodoEntryTime]}" />
                        <TextBlock Classes="fieldlabel" IsVisible="{Binding Entry.IsEvent}" Text="{Binding Strings[TodoEntryStart]}" />
                      </Panel>
                      <TextBlock Grid.Column="1" Classes="fieldvalue" Classes.none="{Binding !Entry.HasTime}" Text="{Binding Entry.TimeText}" />
                      <views:Glyph Grid.Column="2" Kind="ChevronDown" Width="11" Height="11" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Mobile.Text3}" />
                    </Grid>
                  </Button>

                  <!-- An event's end: an hour after its start until it is picked. -->
                  <StackPanel IsVisible="{Binding Entry.IsEvent}">
                    <Border Classes="fieldrule" />
                    <Button x:Name="TodoEndRow" Classes="todofield"
                            Command="{Binding Entry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.End}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="fieldlabel" Text="{Binding Strings[TodoEntryEnd]}" />
                        <TextBlock Grid.Column="1" Classes="fieldvalue" Text="{Binding Entry.EndText}" />
                        <views:Glyph Grid.Column="2" Kind="ChevronDown" Width="11" Height="11" Margin="10,0,0,0"
                                     Foreground="{DynamicResource Mobile.Text3}" />
                      </Grid>
                    </Button>
                  </StackPanel>

                  <!--
                    The reminder sheet's grid of pills: an hour, then a minute, two taps for any time.
                    Avalonia has no touch-native wheel, and a grid is every option at full size.
                  -->
                  <StackPanel IsVisible="{Binding Entry.IsTimePickerOpen}" Margin="10,0,10,12" Spacing="6">
                    <TextBlock Classes="faint" FontSize="12" FontWeight="Bold" Margin="4,0,0,0" Text="{Binding Strings[ReminderTimeHour]}" />
                    <ItemsControl ItemsSource="{Binding Entry.HourOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:TimeOption">
                          <Button Classes="pill time todotime" Classes.on="{Binding IsCurrent}" Margin="2"
                                  Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Entry.PickHourCommand}"
                                  CommandParameter="{Binding Value}">
                            <TextBlock Text="{Binding Label}" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="faint" FontSize="12" FontWeight="Bold" Margin="4,2,0,0" Text="{Binding Strings[ReminderTimeMinute]}" />
                    <ItemsControl ItemsSource="{Binding Entry.MinuteOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pvm:TimeOption">
                          <Button Classes="pill time todotime" Classes.on="{Binding IsCurrent}" Margin="2"
                                  Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Entry.PickMinuteCommand}"
                                  CommandParameter="{Binding Value}">
                            <TextBlock Text="{Binding Label}" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- A to-do may have a day and no time; an event always has a start. -->
                    <Button Classes="pill small" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding Entry.IsTask}"
                            Classes.on="{Binding !Entry.HasTime}" Command="{Binding Entry.ClearTimeCommand}">
                      <TextBlock Text="{Binding Strings[TodoEntryNoTime]}" />
                    </Button>
                  </StackPanel>

                  <Border Classes="fieldrule" />

                  <!-- 반복, spelled out against the chosen day. Greyed while an undated to-do has no day to count from. -->
                  <Button x:Name="TodoRepeatRow" Classes="todofield" Classes.open="{Binding Entry.IsRepeatPickerOpen}"
                          IsEnabled="{Binding Entry.CanRepeat}"
                          Command="{Binding Entry.TogglePickerCommand}" CommandParameter="{x:Static pvm:TodoEntryPicker.Repeat}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Classes="fieldlabel" Text="{Binding Strings[TodoEntryRepeat]}" />
                      <TextBlock Grid.Column="1" Classes="fieldvalue" Classes.none="{Binding !Entry.Repeats}" Text="{Binding Entry.RepeatText}" />
                      <views:Glyph Grid.Column="2" Kind="ChevronDown" Width="11" Height="11" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Mobile.Text3}" />
                    </Grid>
                  </Button>
                  <ItemsControl IsVisible="{Binding Entry.IsRepeatPickerOpen}" Margin="12,0,12,12" ItemsSource="{Binding Entry.RepeatOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pvm:TodoRepeatOption">
                        <Button Classes="pill time todotime" Classes.on="{Binding IsCurrent}" Margin="2"
                                Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Entry.PickRepeatCommand}"
                                CommandParameter="{Binding Repeat}">
                          <TextBlock Text="{Binding Label}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- 내용: a few lines about it, kept apart from the title. Three lines tall, growing to six. -->
              <TextBox x:Name="TodoNotesBox" Classes="todonotes" Text="{Binding Entry.Description, Mode=TwoWay}"
                       PlaceholderText="{Binding Strings[TodoEntryNotesPlaceholder]}"
                       AutomationProperties.Name="{Binding Strings[TodoEntryNotes]}"
                       TextInputOptions.Multiline="True" TextInputOptions.ReturnKeyType="Return" />

              <!-- 목록, only when there is more than the built-in one to choose from. -->
              <StackPanel IsVisible="{Binding Entry.ShowLists}" Spacing="8">
                <TextBlock Classes="faint" FontSize="12.5" FontWeight="Bold" Margin="4,0,0,0" Text="{Binding Strings[TodoEntryList]}" />
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Entry.ListOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="pvm:TodoListOption">
                        <Button Classes="pill small" Classes.on="{Binding IsCurrent}"
                                Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Entry.PickListCommand}"
                                CommandParameter="{Binding Id}">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Dot}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </views:SheetLayer>

    <!--
      A repeating to-do's question, before a delete or an edit from its row: this day only, or
      every repeat. The file menu's shape - a title, the choices, 취소.
    -->
    <views:SheetLayer IsOpen="{Binding IsRepeatChoiceOpen}">
      <Button Classes="scrim" Command="{Binding CloseRepeatChoiceCommand}"
              AutomationProperties.Name="{Binding Strings[MobileCancel]}" />
      <Border x:Name="RepeatChoiceSheet" Classes="sheet" VerticalAlignment="Bottom">
        <StackPanel Margin="16,10,16,0" Spacing="8">
          <Border Width="40" Height="5" CornerRadius="3" Background="{DynamicResource Mobile.Stroke}" Margin="0,0,0,6" />
          <TextBlock Classes="line" FontSize="15.5" FontWeight="ExtraBold" Margin="4,0,4,0" Text="{Binding RepeatChoiceTitle}" />
          <TextBlock Classes="muted" FontSize="13" Margin="4,0,4,6" Text="{Binding Strings[MobileRepeatDeleteQuestion]}" />

          <StackPanel Spacing="8" IsVisible="{Binding IsRepeatChoiceDelete}">
            <Button x:Name="DeleteThisOccurrence" Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding ChooseThisOccurrenceCommand}">
              <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Mobile.Danger}"
                         Text="{Binding Strings[MobileRepeatDeleteThis]}" />
            </Button>
            <Button x:Name="DeleteEveryRepeat" Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding ChooseEveryRepeatCommand}">
              <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Mobile.Danger}"
                         Text="{Binding Strings[MobileRepeatDeleteAll]}" />
            </Button>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding !IsRepeatChoiceDelete}">
            <Button x:Name="EditThisOccurrence" Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding ChooseThisOccurrenceCommand}">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileRepeatEditThis]}" />
            </Button>
            <Button x:Name="EditEveryRepeat" Classes="quiet" HorizontalAlignment="Stretch" Command="{Binding ChooseEveryRepeatCommand}">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileRepeatEditAll]}" />
            </Button>
          </StackPanel>

          <Button Classes="quiet" HorizontalAlignment="Stretch" Margin="0,4,0,0" Command="{Binding CloseRepeatChoiceCommand}">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Strings[MobileCancel]}" />
          </Button>
        </StackPanel>
      </Border>
    </views:SheetLayer>

    <!--
      삭제됨 · 실행 취소: four seconds after a delete, over the tab bar or, with no bar, near the
      bottom edge. Its own layer, so it is above the page and below nothing that is up.
    -->
    <Border x:Name="UndoToast" Classes="undo" Classes.nodock="{Binding !ShowDock}" IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="line" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource Mobile.Bg}" Text="{Binding Strings[MobileTodoDeleted]}" />
        <Button Grid.Column="1" x:Name="UndoButton" Classes="undoaction" Command="{Binding UndoDeleteCommand}">
          <TextBlock FontSize="14.5" FontWeight="ExtraBold" Foreground="{DynamicResource Mobile.Sun}" Text="{Binding Strings[MobileTodoUndo]}" />
        </Button>
      </Grid>
    </Border>
  </Panel>

  <UserControl.Styles>
    <Style Selector="Border.undo">
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Height" Value="50" />
      <Setter Property="Margin" Value="16,0,16,92" />
      <Setter Property="Padding" Value="18,0,6,0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Text}" />
      <Setter Property="BoxShadow" Value="0 10 30 0 #33161a36" />
    </Style>
    <Style Selector="Border.undo.nodock">
      <Setter Property="Margin" Value="16,0,16,24" />
    </Style>
    <Style Selector="Button.undoaction">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- A tab in the floating bar: the mark over a ten-point label, dim until it is the page. -->
    <Style Selector="Button.tab">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text}" />
    </Style>
    <Style Selector="Button.tab TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <!-- A choice in the attach sheet: an icon on the sun tint, a name, and where it picks from. -->
    <Style Selector="Button.sheetrow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Stroke2}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.sheeticon">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Mobile.SunSoft}" />
    </Style>
    <!-- The viewer's two actions, light on the dark ground in either theme. -->
    <Style Selector="Button.viewerbtn">
      <Setter Property="Height" Value="46" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#26ffffff" />
    </Style>
    <Style Selector="Button.viewerbtn TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style Selector="Button.scrim">
      <Setter Property="Background" Value="{DynamicResource Mobile.Scrim}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.scrim:pressed">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.sheet">
      <Setter Property="Background" Value="{DynamicResource Mobile.Panel}" />
      <Setter Property="CornerRadius" Value="28,28,0,0" />
      <Setter Property="BoxShadow" Value="0 -10 40 0 #33000000" />
    </Style>
    <Style Selector="TextBlock.sheetwd">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,4,0,6" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>

    <!-- A day in the sheet: a 38-point rounded square over the activity dot, 46 points a row. -->
    <Style Selector="Button.cell">
      <Setter Property="Height" Value="46" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.cell:pressed">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.cellday">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.cellday TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Button.cell.sunday Border.cellday TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Sunday}" />
    </Style>
    <Style Selector="Button.cell.today Border.cellday">
      <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Sun}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.cell.today Border.cellday TextBlock">
      <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="Button.cell.selected Border.cellday">
      <Setter Property="Background" Value="{DynamicResource Mobile.Pri}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.cell.selected Border.cellday TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.OnPri}" />
      <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="Button.cell.outside">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- The to-do sheet: its rows on one card, label left and value right, and a smaller month grid. -->
    <Style Selector="Border.todofields">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Mobile.Stroke2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.todofield">
      <Setter Property="Height" Value="50" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.fieldrule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="Background" Value="{DynamicResource Mobile.Stroke2}" />
    </Style>
    <Style Selector="TextBlock.fieldlabel">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text2}" />
    </Style>
    <Style Selector="TextBlock.fieldvalue">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="TextBlock.fieldvalue.none">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Mobile.Text3}" />
    </Style>
    <Style Selector="Button.todofield.open TextBlock.fieldvalue">
      <Setter Property="Foreground" Value="{DynamicResource Mobile.SunInk}" />
    </Style>
    <Style Selector="Button.pill.time.todotime">
      <Setter Property="Height" Value="38" />
    </Style>
    <Style Selector="TextBox.todonotes">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="84" />
      <Setter Property="MaxHeight" Value="150" />
    </Style>
    <Style Selector="Border.todosheet Button.cell">
      <Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="Border.todosheet Border.cellday">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
  </UserControl.Styles>
</UserControl>
