<UserControl
    x:Class="Daynote.App.Search.SearchOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:search="clr-namespace:Daynote.App.Search"
    xmlns:loc="clr-namespace:Daynote.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance search:SearchViewModel}"
    KeyDown="OnKeyDown">
    <ContentControl
        Style="{DynamicResource Daynote.Style.SearchOverlay}"
        AutomationProperties.Name="{loc:Tr SearchResultsOverlay}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Fixed query / count / scope header -->
            <StackPanel Grid.Row="0" AutomationProperties.Name="{loc:Tr SearchSummary}">
                <TextBlock
                    Style="{DynamicResource Daynote.Style.Type.ItemTitle}"
                    TextTrimming="CharacterEllipsis"
                    Text="{Binding Query}"
                    AutomationProperties.Name="{loc:Tr SearchQuery}" />
                <DockPanel Margin="0,4,0,0" LastChildFill="False">
                    <TextBlock
                        DockPanel.Dock="Left"
                        Style="{DynamicResource Daynote.Style.Type.Status}"
                        Text="{Binding ResultCountDisplay}"
                        AutomationProperties.Name="{loc:Tr SearchResultCount}"
                        AutomationProperties.LiveSetting="Polite" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        Style="{DynamicResource Daynote.Style.Type.Status}"
                        Foreground="{DynamicResource Daynote.Brush.Text.Muted}"
                        Text="{Binding ScopeDisplay}"
                        AutomationProperties.Name="{loc:Tr SearchScope}" />
                </DockPanel>
            </StackPanel>

            <!-- Stale / non-payload recovery message -->
            <ContentControl
                Grid.Row="1"
                Margin="0,8,0,0"
                Style="{DynamicResource Daynote.Style.StatusBanner.Error}"
                Visibility="{Binding StaleMessage, Converter={StaticResource Daynote.Convert.NullToVisibility}}"
                AutomationProperties.Name="{loc:Tr StaleSearchResultAutomation}"
                AutomationProperties.LiveSetting="Assertive">
                <TextBlock Text="{Binding StaleMessage}" TextWrapping="Wrap" />
            </ContentControl>

            <!-- Body: results own overlay scroll; empty / loading / error share the same bounds -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <ContentControl
                    Style="{DynamicResource Daynote.Style.LoadingPattern}"
                    AutomationProperties.Name="{loc:Tr SearchLoadingAutomation}"
                    Visibility="{Binding LoadState, Converter={StaticResource Daynote.Convert.EqualsToVisibility}, ConverterParameter=Searching}">
                    <TextBlock Style="{DynamicResource Daynote.Style.Type.Status}" Text="{loc:Tr SearchLoading}" />
                </ContentControl>

                <ContentControl
                    Style="{DynamicResource Daynote.Style.EmptyPattern}"
                    AutomationProperties.Name="{loc:Tr SearchEmptyAutomation}"
                    Visibility="{Binding LoadState, Converter={StaticResource Daynote.Convert.EqualsToVisibility}, ConverterParameter=Empty}">
                    <TextBlock Style="{DynamicResource Daynote.Style.Type.Body}" TextWrapping="Wrap"
                               Text="{loc:Tr SearchEmpty}" />
                </ContentControl>

                <ContentControl
                    Style="{DynamicResource Daynote.Style.ErrorPattern}"
                    AutomationProperties.Name="{loc:Tr SearchErrorAutomation}"
                    Visibility="{Binding LoadState, Converter={StaticResource Daynote.Convert.EqualsToVisibility}, ConverterParameter=Error}">
                    <TextBlock Style="{DynamicResource Daynote.Style.Type.Status}" TextWrapping="Wrap"
                               Text="{loc:Tr SearchError}" />
                </ContentControl>

                <ListBox
                    x:Name="ResultList"
                    ItemsSource="{Binding Results}"
                    SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                    Visibility="{Binding HasResults, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                    BorderThickness="0"
                    Background="{DynamicResource Daynote.Brush.Transparent}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch"
                    MouseDoubleClick="OnResultInvoked"
                    AutomationProperties.Name="{loc:Tr SearchResults}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Daynote.Style.SearchResult}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type search:SearchResultViewModel}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <ContentControl
                                        DockPanel.Dock="Left"
                                        Style="{DynamicResource Daynote.Style.SearchSource.Note}"
                                        Visibility="{Binding IsNote, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                                        AutomationProperties.Name="{loc:Tr NoteSource}">
                                        <TextBlock Style="{DynamicResource Daynote.Style.Type.Status}" Text="{Binding KindDisplay}" />
                                    </ContentControl>
                                    <ContentControl
                                        DockPanel.Dock="Left"
                                        Style="{DynamicResource Daynote.Style.SearchSource.Clipboard}"
                                        Visibility="{Binding IsClipboard, Converter={StaticResource Daynote.Convert.BoolToVisibility}}"
                                        AutomationProperties.Name="{loc:Tr ClipboardSourceLabel}">
                                        <TextBlock Style="{DynamicResource Daynote.Style.Type.Status}" Text="{Binding KindDisplay}" />
                                    </ContentControl>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Style="{DynamicResource Daynote.Style.Type.Status}"
                                        Foreground="{DynamicResource Daynote.Brush.Text.Muted}"
                                        HorizontalAlignment="Right"
                                        Text="{Binding DateDisplay}"
                                        AutomationProperties.Name="{loc:Tr ResultDate}" />
                                    <TextBlock
                                        Style="{DynamicResource Daynote.Style.Type.ItemTitle}"
                                        Margin="8,0,0,0"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding Title}"
                                        AutomationProperties.Name="{Binding Title}"
                                        ToolTip="{Binding Title}" />
                                </DockPanel>
                                <TextBlock
                                    Style="{DynamicResource Daynote.Style.SearchSnippet}"
                                    Margin="0,4,0,0"
                                    Text="{Binding Snippet}"
                                    AutomationProperties.Name="{loc:Tr SearchResultSnippet}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </ContentControl>
</UserControl>

