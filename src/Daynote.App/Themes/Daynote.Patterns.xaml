<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Daynote.Style.EmptyPattern" TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Text.Primary}" />
        <Setter Property="Padding" Value="{DynamicResource Daynote.Inset.Pane.Regular}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ContentControl}"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Daynote.Style.LoadingPattern" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.EmptyPattern}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ContentControl}"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><StackPanel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"><ProgressBar Width="{DynamicResource Daynote.Size.Target.Primary}" Height="{DynamicResource Daynote.Icon.Size.Small}" IsIndeterminate="True" /><ContentPresenter /></StackPanel></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Daynote.Style.ErrorPattern" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Daynote.Style.EmptyPattern}">
        <Setter Property="Background" Value="{DynamicResource Daynote.Brush.Status.Error.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Daynote.Brush.Status.Error}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Daynote.Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Daynote.Thickness.Border.Thin}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ContentControl}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Daynote.Radius.Control}" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><Path Data="{DynamicResource Daynote.Icon.Geometry.Error}" Style="{DynamicResource Daynote.Style.IconPresenter.Small}" /><ContentPresenter /></StackPanel></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
