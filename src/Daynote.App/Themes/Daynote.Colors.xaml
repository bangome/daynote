    <SolidColorBrush x:Key="Daynote.Brush.Surface.Primary" Color="{StaticResource Daynote.Color.Surface.Primary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Brush.Surface.Secondary" Color="{StaticResource Daynote.Color.Surface.Secondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Daynote.Brush.Surface.Hover" Color="{StaticResource Daynote.Color.Surface.Hover}" po:Freeze="True" />
